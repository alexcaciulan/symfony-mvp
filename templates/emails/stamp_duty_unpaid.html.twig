{% extends 'emails/_layout.html.twig' %}

{% block content %}
    <h2 style="color:#b45309;margin-bottom:16px;">{{ heading }}</h2>

    <p style="font-size:15px;line-height:1.6;">{{ body }}</p>

    {% if courtCaseNumber %}
        <p style="font-size:14px;line-height:1.6;color:#475569;">
            {{ 'email.stamp_duty_unpaid.court_case_number'|trans({'%number%': courtCaseNumber}) }}
        </p>
    {% endif %}

    <p style="text-align:center;margin:32px 0;">
        <a href="{{ payUrl }}"
           style="display:inline-block;padding:14px 28px;background:#2563eb;color:#ffffff;text-decoration:none;border-radius:6px;font-size:16px;font-weight:bold;">
            {{ 'email.stamp_duty_unpaid.cta_pay'|trans }}
        </a>
    </p>

    <p style="text-align:center;margin:16px 0;">
        <a href="{{ caseUrl }}" style="color:#2563eb;font-size:14px;">{{ 'email.cta.view_case'|trans }}</a>
    </p>

    <p style="font-size:13px;line-height:1.6;color:#64748b;">
        {{ 'email.stamp_duty_unpaid.disclaimer'|trans }}
    </p>
{% endblock %}
