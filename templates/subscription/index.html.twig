{% extends 'base.html.twig' %}

{% block title %}{{ 'subscription.title'|trans }}{% endblock %}

{% block body %}
    <div class="max-w-4xl mx-auto">
        <h1 class="text-2xl font-bold text-gray-900 mb-6">{{ 'subscription.heading'|trans }}</h1>

        {# Current plan #}
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 sm:p-8 mb-6">
            {% if subscription %}
                <div class="flex items-center justify-between flex-wrap gap-3">
                    <div>
                        <div class="text-sm text-gray-500">{{ 'subscription.current.plan'|trans }}</div>
                        <div class="text-lg font-semibold text-gray-900">{{ subscription.plan.name }}</div>
                    </div>
                    <span class="inline-block px-2.5 py-0.5 text-xs font-medium rounded-full bg-blue-50 text-blue-700">
                        {{ subscription.status.label|trans }}
                    </span>
                </div>
                <dl class="grid grid-cols-2 sm:grid-cols-3 gap-4 mt-6 text-sm">
                    <div>
                        <dt class="text-gray-500">{{ 'subscription.current.cases'|trans }}</dt>
                        <dd class="text-gray-900 font-medium tabular-nums">{{ subscription.casesConsumed }} / {{ subscription.plan.includedCases }}</dd>
                    </div>
                    <div>
                        <dt class="text-gray-500">{{ 'subscription.current.period_end'|trans }}</dt>
                        <dd class="text-gray-900 font-medium">{{ subscription.currentPeriodEnd|date('d.m.Y') }}</dd>
                    </div>
                    <div>
                        <dt class="text-gray-500">{{ 'subscription.current.price_per_extra'|trans }}</dt>
                        <dd class="text-gray-900 font-medium tabular-nums">{{ subscription.plan.pricePerExtra|number_format(2, ',', '.') }} RON</dd>
                    </div>
                </dl>

                {% if recommended_upgrade %}
                    <div class="mt-6 rounded-lg bg-amber-50 border border-amber-200 px-4 py-3 text-sm text-amber-800 flex items-center justify-between flex-wrap gap-3">
                        <span>{{ 'subscription.upgrade_nudge'|trans({'%plan%': recommended_upgrade.name, '%cases%': recommended_upgrade.includedCases}) }}</span>
                        <form method="post" action="{{ path('app_subscription_change_plan', {planId: recommended_upgrade.id}) }}" data-turbo="false">
                            <input type="hidden" name="_token" value="{{ csrf_token('change_plan_' ~ recommended_upgrade.id) }}">
                            <button type="submit" class="px-3 py-1.5 bg-amber-700 text-white rounded-lg font-medium hover:opacity-90 transition text-xs whitespace-nowrap">
                                {{ 'subscription.plans.upgrade_cta'|trans({'%plan%': recommended_upgrade.name}) }}
                            </button>
                        </form>
                    </div>
                {% endif %}

                {% if subscription.pendingPlan %}
                    <div class="mt-6 rounded-lg bg-gray-50 border border-gray-200 px-4 py-3 text-sm text-gray-700 flex items-center justify-between flex-wrap gap-3">
                        <span>
                            {{ 'subscription.scheduled_change.message'|trans({
                                '%plan%': subscription.pendingPlan.name,
                                '%date%': subscription.currentPeriodEnd|date('d.m.Y'),
                            }) }}
                        </span>
                        <form method="post" action="{{ path('app_subscription_cancel_plan_change') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('cancel_plan_change') }}">
                            <button type="submit" class="text-xs font-medium text-lex-navy hover:underline whitespace-nowrap">
                                {{ 'subscription.scheduled_change.cancel'|trans }}
                            </button>
                        </form>
                    </div>
                {% endif %}

                {% if pending_plan_change %}
                    <div class="mt-6 rounded-lg bg-blue-50 border border-blue-200 px-4 py-3 text-sm text-blue-900 flex items-center justify-between flex-wrap gap-3">
                        <span>
                            {{ 'subscription.pending_change.message'|trans({
                                '%plan%': pending_plan_change.targetPlan.name,
                                '%price%': pending_plan_change.amount|number_format(2, ',', '.'),
                            }) }}
                        </span>
                        <a href="{{ path('app_subscription_checkout', {invoiceId: pending_plan_change.id}) }}"
                           class="px-3 py-1.5 bg-lex-navy text-white rounded-lg font-medium hover:opacity-90 transition text-xs whitespace-nowrap no-underline">
                            {{ 'subscription.pending_change.pay'|trans }}
                        </a>
                    </div>
                {% endif %}
            {% else %}
                <p class="text-gray-600">{{ 'subscription.current.none'|trans }}</p>
            {% endif %}

            <div class="mt-6 pt-4 border-t border-gray-100 flex items-center justify-between flex-wrap gap-3">
                <a href="{{ path('app_invoices') }}" class="text-sm font-medium text-lex-navy hover:underline no-underline">
                    {{ 'subscription.invoices_link'|trans }}
                </a>
                {% if subscription and not subscription.plan.isTrial and subscription.status.value != 'canceled' %}
                    {# Stimulus, not an inline onsubmit: script-src has no
                       'unsafe-inline', and a nonce does not cover event attributes,
                       so an inline handler would never run. #}
                    <form method="post" action="{{ path('app_subscription_cancel') }}"
                          data-controller="confirm"
                          data-confirm-message-value="{{ 'subscription.cancel.confirm'|trans }}"
                          data-action="submit->confirm#confirm">
                        <input type="hidden" name="_token" value="{{ csrf_token('cancel_subscription') }}">
                        <button type="submit" class="text-sm font-medium text-gray-500 hover:text-red-700 hover:underline">
                            {{ 'subscription.cancel.button'|trans }}
                        </button>
                    </form>
                {% endif %}
            </div>
        </div>

        {# Plans. Always rendered: hiding the grid on a paid plan left the user with
           no way to move off the plan they picked. #}
        <h2 class="text-lg font-semibold text-gray-900 mb-4">{{ 'subscription.plans.heading'|trans }}</h2>
        <div class="grid gap-4 sm:grid-cols-2">
            {% for entry in plans %}
                {% set plan = entry.plan %}
                <div class="bg-white rounded-xl shadow-sm border p-6 flex flex-col {{ entry.is_current ? 'border-lex-navy' : 'border-gray-200' }}">
                    <div class="flex items-start justify-between gap-2">
                        <div class="text-lg font-semibold text-gray-900">{{ plan.name }}</div>
                        {% if entry.is_current %}
                            <span class="inline-block px-2.5 py-0.5 text-xs font-medium rounded-full bg-blue-50 text-blue-700 whitespace-nowrap">
                                {{ 'subscription.plans.current_badge'|trans }}
                            </span>
                        {% elseif entry.is_scheduled %}
                            <span class="inline-block px-2.5 py-0.5 text-xs font-medium rounded-full bg-gray-100 text-gray-700 whitespace-nowrap">
                                {{ 'subscription.plans.scheduled_badge'|trans }}
                            </span>
                        {% endif %}
                    </div>
                    <div class="mt-1 text-2xl font-bold text-gray-900 tabular-nums">
                        {{ plan.priceMonthly|number_format(2, ',', '.') }} <span class="text-sm font-normal text-gray-500">RON / {{ 'subscription.plans.month'|trans }}</span>
                    </div>
                    <ul class="mt-4 space-y-1.5 text-sm text-gray-600 flex-1">
                        <li>{{ 'subscription.plans.included_cases'|trans({'%count%': plan.includedCases}) }}</li>
                        <li>{{ 'subscription.plans.extra_case'|trans({'%price%': plan.pricePerExtra|number_format(2, ',', '.')}) }}</li>
                    </ul>

                    {% if entry.is_current %}
                        <div class="mt-6">
                            <button type="button" disabled class="w-full px-4 py-2 bg-gray-100 text-gray-400 rounded-lg font-medium text-sm cursor-not-allowed">
                                {{ 'subscription.plans.current_badge'|trans }}
                            </button>
                        </div>
                    {% elseif can_subscribe %}
                        {# data-turbo=false: this POST answers 302 to the payment processor.
                           Turbo would follow it with fetch(), which CSP connect-src blocks as
                           cross-origin; a native submit navigates instead (allowed by the
                           processor origins in form-action, see SecurityHeadersSubscriber). #}
                        <form method="post" action="{{ path('app_subscription_subscribe', {planId: plan.id}) }}" class="mt-6" data-turbo="false">
                            <input type="hidden" name="_token" value="{{ csrf_token('subscribe_' ~ plan.id) }}">
                            <button type="submit" class="w-full px-4 py-2 bg-lex-navy text-white rounded-lg font-medium hover:opacity-90 transition text-sm">
                                {{ 'subscription.plans.choose'|trans }}
                            </button>
                            <p class="mt-3 text-xs text-gray-500 leading-relaxed">
                                {{ 'subscription.plans.recurring_disclosure'|trans({'%price%': plan.priceMonthly|number_format(2, ',', '.')}) }}
                            </p>
                        </form>
                    {% else %}
                        <form method="post" action="{{ path('app_subscription_change_plan', {planId: plan.id}) }}" class="mt-6" data-turbo="{{ entry.is_upgrade ? 'false' : 'true' }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('change_plan_' ~ plan.id) }}">
                            <button type="submit" class="w-full px-4 py-2 rounded-lg font-medium text-sm transition {{ entry.is_upgrade ? 'bg-lex-navy text-white hover:opacity-90' : 'border border-gray-300 text-gray-700 hover:bg-gray-50' }}">
                                {{ 'subscription.plans.upgrade_cta'|trans({'%plan%': plan.name}) }}
                            </button>
                            <p class="mt-3 text-xs text-gray-500 leading-relaxed">
                                {% if entry.is_upgrade %}
                                    {{ 'subscription.plans.upgrade_note'|trans({'%price%': plan.priceMonthly|number_format(2, ',', '.')}) }}
                                {% else %}
                                    {{ 'subscription.plans.downgrade_note'|trans({'%date%': subscription.currentPeriodEnd|date('d.m.Y')}) }}
                                {% endif %}
                            </p>
                        </form>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
