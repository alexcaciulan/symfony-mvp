{% extends 'base.html.twig' %}

{% block title %}{{ 'subscription.invoices.title'|trans }}{% endblock %}

{% block body %}
    <div class="max-w-4xl mx-auto">
        <div class="flex items-center justify-between mb-6">
            <h1 class="text-2xl font-bold text-gray-900">{{ 'subscription.invoices.title'|trans }}</h1>
            <a href="{{ path('app_subscription') }}" class="text-sm font-medium text-lex-navy hover:underline no-underline">
                {{ 'subscription.invoices.back'|trans }}
            </a>
        </div>

        <div class="rounded-lg bg-amber-50 border border-amber-200 px-4 py-3 text-sm text-amber-800 mb-4">
            {{ 'subscription.invoices.fiscal_disclaimer'|trans }}
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            {% if invoices is empty %}
                <p class="p-6 text-gray-600 text-sm">{{ 'subscription.invoices.empty'|trans }}</p>
            {% else %}
                <table class="w-full text-sm">
                    <thead class="bg-gray-50 text-gray-500 text-left">
                        <tr>
                            <th class="px-4 py-3 font-medium">{{ 'subscription.invoices.date'|trans }}</th>
                            <th class="px-4 py-3 font-medium">{{ 'subscription.invoices.type'|trans }}</th>
                            <th class="px-4 py-3 font-medium text-right">{{ 'subscription.invoices.amount'|trans }}</th>
                            <th class="px-4 py-3 font-medium">{{ 'subscription.invoices.status'|trans }}</th>
                            <th class="px-4 py-3 font-medium text-right">{{ 'subscription.invoices.action'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        {% for invoice in invoices %}
                            <tr>
                                <td class="px-4 py-3 text-gray-700">{{ invoice.createdAt|date('d.m.Y') }}</td>
                                <td class="px-4 py-3 text-gray-700">{{ invoice.type.label|trans }}</td>
                                <td class="px-4 py-3 text-gray-900 font-medium text-right tabular-nums">{{ invoice.amount|number_format(2, ',', '.') }} RON</td>
                                <td class="px-4 py-3">
                                    {% set badge = {'pending': 'bg-amber-100 text-amber-800', 'paid': 'bg-green-100 text-green-800', 'canceled': 'bg-gray-100 text-gray-600'} %}
                                    <span class="inline-block px-2 py-0.5 text-xs font-medium rounded-full {{ badge[invoice.status.value] }}">
                                        {{ invoice.status.label|trans }}
                                    </span>
                                </td>
                                <td class="px-4 py-3 text-right">
                                    {% if invoice.status.value == 'pending' %}
                                        <a href="{{ path('app_subscription_checkout', {invoiceId: invoice.id}) }}" class="text-lex-navy font-medium hover:underline no-underline">
                                            {{ 'subscription.invoices.pay'|trans }}
                                        </a>
                                    {% else %}
                                        <span class="text-gray-300">—</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    </div>
{% endblock %}
