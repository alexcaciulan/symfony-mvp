{% extends 'base.html.twig' %}

{% block title %}{{ 'subscription.checkout.title'|trans }}{% endblock %}

{% block body %}
    <div class="max-w-lg mx-auto">
        <h1 class="text-2xl font-bold text-gray-900 mb-6">{{ 'subscription.checkout.title'|trans }}</h1>

        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 sm:p-8">
            <dl class="space-y-4">
                <div class="flex justify-between text-sm">
                    <dt class="text-gray-500">{{ 'subscription.checkout.type'|trans }}</dt>
                    <dd class="text-gray-800 font-medium">{{ invoice.type.label|trans }}</dd>
                </div>
                <div class="flex justify-between text-sm border-t border-gray-100 pt-4">
                    <dt class="text-gray-500">{{ 'subscription.checkout.amount'|trans }}</dt>
                    <dd class="text-gray-900 font-bold tabular-nums">{{ invoice.amount|number_format(2, ',', '.') }} RON</dd>
                </div>
                <div class="flex justify-between text-sm border-t border-gray-100 pt-4">
                    <dt class="text-gray-500">{{ 'subscription.checkout.status'|trans }}</dt>
                    <dd class="text-gray-800">{{ invoice.status.label|trans }}</dd>
                </div>
            </dl>

            {% if invoice.status.value == 'pending' and is_stub %}
                <div class="mt-6 rounded-lg bg-blue-50 border border-blue-200 px-4 py-3 text-xs text-blue-800">
                    {{ 'subscription.checkout.stub_notice'|trans }}
                </div>
                <form method="post" action="{{ path('app_subscription_checkout_pay', {invoiceId: invoice.id}) }}" class="mt-6">
                    <input type="hidden" name="_token" value="{{ csrf_token('pay_invoice_' ~ invoice.id) }}">
                    <button type="submit" class="w-full px-4 py-2.5 bg-lex-navy text-white rounded-lg font-medium hover:opacity-90 transition text-sm">
                        {{ 'subscription.checkout.mark_paid'|trans }}
                    </button>
                </form>
            {% elseif invoice.status.value == 'pending' %}
                {# On a real gateway this page is informational, so it needs its own
                   way back to the processor: the redirect only happens on POST. #}
                <p class="mt-6 text-sm text-gray-600">{{ 'subscription.checkout.resume_notice'|trans }}</p>
                <form method="post" action="{{ path('app_subscription_pay', {invoiceId: invoice.id}) }}" class="mt-4" data-turbo="false">
                    <input type="hidden" name="_token" value="{{ csrf_token('pay_pending_' ~ invoice.id) }}">
                    <button type="submit" class="w-full px-4 py-2.5 bg-lex-navy text-white rounded-lg font-medium hover:opacity-90 transition text-sm">
                        {{ 'subscription.checkout.pay_now'|trans }}
                    </button>
                </form>
            {% else %}
                <p class="mt-6 text-sm text-green-700 font-medium">{{ 'subscription.checkout.already_paid'|trans }}</p>
            {% endif %}

            <div class="mt-6 pt-4 border-t border-gray-100">
                <a href="{{ path('app_invoices') }}" class="text-sm text-gray-500 hover:underline no-underline">
                    {{ 'subscription.checkout.back'|trans }}
                </a>
            </div>
        </div>
    </div>
{% endblock %}
