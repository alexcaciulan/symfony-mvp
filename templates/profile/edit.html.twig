{% extends 'base.html.twig' %}

{% macro field(f) %}
    <div class="mb-4">
        {{ form_label(f, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
        {{ form_widget(f, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-light focus:border-transparent'}}) }}
        {{ form_help(f, {'help_attr': {'class': 'mt-1 text-xs text-gray-500'}}) }}
        {{ form_errors(f) }}
    </div>
{% endmacro %}

{% block title %}{{ 'profile.edit.title'|trans }}{% endblock %}

{% block body %}
    {% import _self as ui %}
    <div class="max-w-lg mx-auto px-4 py-8 sm:py-12">
        <div class="mb-4">
            <a href="{{ path('app_profile') }}" class="text-sm text-primary-light hover:text-primary no-underline">&larr; {{ 'profile.edit.back'|trans }}</a>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 sm:p-8">
            <h1 class="text-2xl font-bold text-gray-900 mb-6">{{ 'profile.edit.title'|trans }}</h1>

            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                {{ ui.field(form.firstName) }}
                {{ ui.field(form.lastName) }}
                {{ ui.field(form.phone) }}
                {{ ui.field(form.barNumber) }}

                <div class="mt-8 mb-4 pt-6 border-t border-gray-100">
                    <h2 class="text-sm font-bold uppercase tracking-wider text-gray-500">{{ 'profile.edit.fiscal_section'|trans }}</h2>
                    <p class="mt-1 text-sm text-gray-500">{{ 'profile.edit.fiscal_section_help'|trans }}</p>
                </div>

                {{ ui.field(form.companyName) }}
                {{ ui.field(form.cui) }}

                <div class="grid grid-cols-2 gap-4">
                    <div>{{ ui.field(form.street) }}</div>
                    <div>{{ ui.field(form.streetNumber) }}</div>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>{{ ui.field(form.city) }}</div>
                    <div>{{ ui.field(form.county) }}</div>
                </div>
                {{ ui.field(form.postalCode) }}

                <button type="submit" class="w-full mt-2 py-3 bg-primary-light text-white font-semibold rounded-lg hover:bg-primary transition">
                    {{ 'profile.edit.submit'|trans }}
                </button>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
