{% extends 'base.html.twig' %}

{% block title %}{{ 'layout.brand'|trans }} — {{ 'home.hero.title'|trans }}{% endblock %}

{% block body %}
    {# Hero Section #}
    <section class="bg-primary text-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-28 text-center">
            <p class="text-sm uppercase tracking-wider text-blue-200 mb-4">{{ 'home.hero.eyebrow'|trans }}</p>
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight mb-6">
                {{ 'home.hero.title'|trans }}
            </h1>
            <p class="text-lg sm:text-xl text-blue-100 max-w-2xl mx-auto mb-10">
                {{ 'home.hero.subtitle'|trans }}
            </p>
            <div class="flex flex-col sm:flex-row gap-3 justify-center">
                <a href="{{ path('app_register') }}" class="inline-block px-8 py-4 bg-white text-primary font-semibold rounded-lg hover:bg-blue-50 no-underline text-lg transition">
                    {{ 'home.hero.cta_primary'|trans }}
                </a>
                <a href="#how-it-works" class="inline-block px-8 py-4 border border-white/30 text-white font-semibold rounded-lg hover:bg-white/10 no-underline text-lg transition">
                    {{ 'home.hero.cta_secondary'|trans }}
                </a>
            </div>
        </div>
    </section>

    {# How It Works #}
    <section id="how-it-works" class="py-16 sm:py-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-2xl sm:text-3xl font-bold text-center text-gray-900 mb-12">{{ 'home.steps.title'|trans }}</h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10">
                {% for n in 1..4 %}
                    <div class="text-center">
                        <div class="w-16 h-16 mx-auto mb-5 bg-primary-light/10 rounded-2xl flex items-center justify-center">
                            <span class="text-2xl font-bold text-primary-light">{{ n }}</span>
                        </div>
                        <div class="text-sm font-semibold text-primary-light mb-2">{{ ('home.steps.step_' ~ n ~ '.label')|trans }}</div>
                        <h3 class="text-lg font-semibold text-gray-900 mb-2">{{ ('home.steps.step_' ~ n ~ '.title')|trans }}</h3>
                        <p class="text-gray-500">{{ ('home.steps.step_' ~ n ~ '.description')|trans }}</p>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    {# Benefits #}
    <section class="bg-white py-16 sm:py-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-2xl sm:text-3xl font-bold text-center text-gray-900 mb-12">{{ 'home.benefits.title'|trans }}</h2>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                {% for slug in ['rapid', 'sigur', 'clar'] %}
                    <div class="bg-surface rounded-xl p-6 border border-gray-100">
                        <h3 class="font-semibold text-gray-900 mb-2">{{ ('home.benefits.' ~ slug ~ '.title')|trans }}</h3>
                        <p class="text-sm text-gray-500">{{ ('home.benefits.' ~ slug ~ '.description')|trans }}</p>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>
{% endblock %}
