{# Fetched fresh into the bell panel by notification_center_controller on each open. #}
{# @var notifications App\Entity\Notification[] #}
{# @var unreadCount int #}
    <div id="notification-dropdown" class="w-80 max-w-[90vw]">
        <div class="flex items-center justify-between px-4 py-2.5 border-b border-slate-100 dark:border-slate-800">
            <span class="text-sm font-semibold text-slate-800 dark:text-slate-100">{{ 'notifications.heading'|trans }}</span>
            {% if unreadCount > 0 %}
                <span class="text-[11px] font-medium text-blue-600 dark:text-blue-400">{{ 'notifications.unread_count'|trans({ '%count%': unreadCount }) }}</span>
            {% endif %}
        </div>

        <div class="max-h-96 overflow-y-auto">
            {% if notifications is empty %}
                <p class="px-4 py-8 text-center text-sm text-slate-500 dark:text-slate-400">{{ 'notifications.empty.title'|trans }}</p>
            {% else %}
                <ul>
                    {% for notification in notifications %}
                        {{ include('notifications/_item.html.twig', { notification: notification }) }}
                    {% endfor %}
                </ul>
            {% endif %}
        </div>

        <div class="flex items-center justify-between gap-2 px-4 py-2.5 border-t border-slate-100 dark:border-slate-800">
            {% if unreadCount > 0 %}
                <form method="post" action="{{ path('app_notifications_read_all') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('notification_read_all') }}">
                    <button type="submit" class="text-xs font-medium text-slate-600 dark:text-slate-300 hover:text-lex-navy dark:hover:text-blue-400">{{ 'notifications.mark_all_read'|trans }}</button>
                </form>
            {% else %}
                <span></span>
            {% endif %}
            <a href="{{ path('app_notifications') }}" class="text-xs font-semibold text-lex-navy dark:text-blue-400 no-underline hover:underline">{{ 'notifications.see_all'|trans }}</a>
        </div>
    </div>
