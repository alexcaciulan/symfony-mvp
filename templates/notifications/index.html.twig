{% extends 'base.html.twig' %}

{% block title %}{{ 'notifications.title'|trans }} - {{ parent() }}{% endblock %}

{% block breadcrumb %}
    <li class="font-medium text-slate-700 dark:text-slate-300">{{ 'notifications.heading'|trans }}</li>
{% endblock %}

{% block body %}
<div class="space-y-6">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-3">
        <div>
            <h1 class="text-2xl md:text-3xl font-bold tracking-tight">{{ 'notifications.heading'|trans }}</h1>
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{{ 'notifications.subtitle'|trans }}</p>
        </div>
        {% set unread = unread_notifications_count() %}
        {% if unread > 0 %}
            <form method="post" action="{{ path('app_notifications_read_all') }}" class="self-start">
                <input type="hidden" name="_token" value="{{ csrf_token('notification_read_all') }}">
                <button type="submit" class="inline-flex items-center gap-1.5 py-1.5 px-3 rounded-lg border border-slate-200 dark:border-slate-700 text-sm font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-800 transition">
                    {{ 'notifications.mark_all_read'|trans }} ({{ unread }})
                </button>
            </form>
        {% endif %}
    </div>

    <twig:DataTable key="notifications" />
</div>
{% endblock %}
