{% extends 'base.html.twig' %}

{% block title %}{{ 'notifications.title'|trans }} - {{ parent() }}{% endblock %}

{% block breadcrumb %}
    <li class="font-medium text-slate-700 dark:text-slate-300">{{ 'notifications.heading'|trans }}</li>
{% endblock %}

{% block body %}
<div class="space-y-6">
    <div>
        <h1 class="text-2xl md:text-3xl font-bold tracking-tight">{{ 'notifications.heading'|trans }}</h1>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{{ 'notifications.subtitle'|trans }}</p>
    </div>

    <twig:DataTable key="notifications" />
</div>
{% endblock %}
