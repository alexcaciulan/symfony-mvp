{# Sticky topbar for authenticated layout. Provides breadcrumb + dark toggle + lang switcher + "Dosar nou" CTA. #}
{% set current_route = app.request.attributes.get('_route') %}
<header class="sticky top-0 z-20 h-14 bg-white/85 dark:bg-slate-900/85 backdrop-blur-md border-b border-slate-200 dark:border-slate-800"
        data-controller="mobile-menu">
    <div class="h-full px-4 lg:px-8 flex items-center gap-4">

        {# Mobile menu trigger (sidebar is hidden < lg, drawer below is shown when toggled). #}
        <button type="button"
                data-action="click->mobile-menu#toggle"
                class="lg:hidden p-2 -ml-2 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800"
                aria-label="{{ 'layout.nav.menu_label'|trans }}">
            <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>

        {# Breadcrumb — tunneled from extending pages via `breadcrumb` include var (base.html.twig wraps the overridable {% block breadcrumb %}).
           Falls back to the default "Dashboard" entry when the include is rendered outside the authenticated shell. #}
        <ol class="flex items-center gap-1.5 text-xs flex-1" aria-label="Breadcrumb">
            {%- if breadcrumb is defined and breadcrumb -%}
                {{ breadcrumb|raw }}
            {%- else -%}
                <li class="font-medium text-slate-700 dark:text-slate-300">{{ 'layout.topbar.breadcrumb_default'|trans }}</li>
            {%- endif -%}
        </ol>

        {# Notification bell — server-rendered badge, client poller keeps it live. #}
        {% set unread = unread_notifications_count() %}
        <div class="hs-dropdown relative inline-flex"
             data-controller="notification-center"
             data-notification-center-unread-count-url-value="{{ path('app_notifications_unread_count') }}"
             data-notification-center-dropdown-url-value="{{ path('app_notifications_dropdown') }}"
             data-notification-center-interval-value="45000"
             data-notification-center-new-message-value="{{ 'notifications.toast.new'|trans }}">
            <button type="button"
                    class="hs-dropdown-toggle relative p-2 rounded-lg text-slate-500 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800"
                    aria-label="{{ 'notifications.bell.aria'|trans({ '%count%': unread }) }}"
                    aria-haspopup="menu">
                <svg class="size-[18px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
                <span data-notification-center-target="badge"
                      id="notification-bell-badge"
                      class="{{ unread > 0 ? '' : 'hidden' }} absolute -top-0.5 -right-0.5 min-w-[16px] h-4 px-1 inline-flex items-center justify-center rounded-full bg-red-500 text-white text-[10px] font-semibold leading-none">{{ unread > 9 ? '9+' : unread }}</span>
            </button>
            <div class="hs-dropdown-menu transition-[opacity,margin] duration-150 hs-dropdown-open:opacity-100 opacity-0 hidden z-50 mt-2 rounded-xl bg-white dark:bg-slate-900 shadow-card border border-slate-200 dark:border-slate-800 overflow-hidden"
                 role="menu">
                <div data-notification-center-target="panel">
                    <div class="w-80 max-w-[90vw] px-4 py-8 text-center text-sm text-slate-400 dark:text-slate-500">{{ 'common.loading'|trans }}</div>
                </div>
            </div>
        </div>

        {# Dark mode toggle #}
        <button type="button"
                data-controller="dark-mode-toggle"
                data-action="click->dark-mode-toggle#toggle"
                aria-label="{{ 'layout.topbar.toggle_dark'|trans }}"
                class="p-2 rounded-lg text-slate-500 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800">
            <span data-dark-mode-toggle-target="icon">
                <svg class="size-[18px] hidden dark:inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                <svg class="size-[18px] inline dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
            </span>
        </button>

        {# Language switcher #}
        <div class="hidden sm:flex items-center gap-1 text-xs text-slate-400 dark:text-slate-500">
            {% for locale in ['ro', 'en'] %}
                {% if app.request.locale == locale %}
                    <span class="font-semibold text-lex-navy dark:text-blue-400">{{ locale|upper }}</span>
                {% else %}
                    <a href="{{ path('app_switch_locale', {locale: locale}) }}" class="hover:text-lex-navy dark:hover:text-blue-400 no-underline">{{ locale|upper }}</a>
                {% endif %}
                {% if not loop.last %}<span aria-hidden="true">·</span>{% endif %}
            {% endfor %}
        </div>

        {# Primary CTA — Dosar nou (wired to wizard step 0 in Pas 3.0). #}
        <a href="{{ path('case_wizard_start') }}" class="inline-flex items-center gap-1.5 py-1.5 px-3 rounded-lg bg-lex-navy hover:bg-lex-navy-dark text-white text-sm font-semibold transition no-underline">
            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
            <span class="hidden sm:inline">{{ 'layout.topbar.cta_new_case'|trans }}</span>
        </a>
    </div>

    {# Mobile drawer (< lg). Toggle target for mobile-menu controller. Backdrop + slide-in panel with sidebar nav subset. #}
    <div data-mobile-menu-target="menu"
         class="hidden lg:hidden fixed inset-0 z-40">
        <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-sm" aria-hidden="true"></div>
        <aside class="absolute inset-y-0 left-0 w-72 max-w-[85%] bg-white dark:bg-slate-900 shadow-card flex flex-col">
            <div class="h-14 flex items-center justify-between px-5 border-b border-slate-100 dark:border-slate-800">
                <a href="{{ path('app_dashboard') }}" class="flex items-center gap-2 text-lex-navy dark:text-white font-bold text-base tracking-tight no-underline">
                    <span class="inline-flex items-center justify-center size-7 rounded-lg bg-gradient-to-br from-lex-navy to-lex-navy-dark text-white">
                        <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16l-3-3m3 3l3-3"/></svg>
                    </span>
                    {{ 'layout.brand'|trans }}
                </a>
                <button type="button"
                        data-action="click->mobile-menu#toggle"
                        class="p-2 rounded-lg text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800"
                        aria-label="{{ 'layout.nav.menu_label'|trans }}">
                    <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
            <nav class="flex-1 overflow-y-auto px-3 py-4 space-y-1" aria-label="Mobile navigation">
                {% set is_dashboard = current_route == 'app_dashboard' %}
                <a href="{{ path('app_dashboard') }}"
                   class="{{ is_dashboard ? 'nav-active text-lex-navy dark:text-blue-400 font-semibold' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 font-medium' }} flex items-center gap-2.5 py-2 px-2.5 rounded-lg text-sm transition no-underline">
                    <svg class="size-[18px] {{ is_dashboard ? '' : 'text-slate-400' }}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                    {{ 'layout.sidebar.nav.dashboard'|trans }}
                </a>
                {% set is_settings = current_route starts with 'app_profile' %}
                <a href="{{ path('app_profile') }}"
                   class="{{ is_settings ? 'nav-active text-lex-navy dark:text-blue-400 font-semibold' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 font-medium' }} flex items-center gap-2.5 py-2 px-2.5 rounded-lg text-sm transition no-underline">
                    <svg class="size-[18px] {{ is_settings ? '' : 'text-slate-400' }}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    {{ 'layout.sidebar.nav.settings'|trans }}
                </a>
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('admin') }}"
                       class="flex items-center gap-2.5 py-2 px-2.5 rounded-lg text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 transition no-underline">
                        <svg class="size-[18px] text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                        {{ 'layout.nav.admin'|trans }}
                    </a>
                {% endif %}
            </nav>
            <div class="border-t border-slate-100 dark:border-slate-800 p-3">
                <form method="post" action="{{ path('app_logout') }}">
                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('logout') }}">
                    <button type="submit" class="w-full flex items-center gap-2.5 py-2 px-2.5 rounded-lg text-sm font-medium text-red-600 hover:bg-red-50 dark:hover:bg-red-950/30">
                        {{ 'layout.nav.logout'|trans }}
                    </button>
                </form>
            </div>
        </aside>
    </div>
</header>
