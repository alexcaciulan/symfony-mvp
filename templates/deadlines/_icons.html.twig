{# Inline SVG macros for the deadlines agenda. Kept in one file so a row, the risk
   bar and the blockage zone all draw the same shape for the same meaning.
   The shape carries the meaning together with the badge text, never colour alone. #}

{# Octagon: an irreversible consequence (annulment, forfeiture, extinction). #}
{% macro octagon(class) %}
    <svg class="{{ class|default('size-3') }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8.6 2h6.8L22 8.6v6.8L15.4 22H8.6L2 15.4V8.6L8.6 2z"/></svg>
{% endmacro %}

{# Triangle: a consequence that costs an opportunity, not the right. #}
{% macro triangle(class) %}
    <svg class="{{ class|default('size-3') }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l10 19H2L12 2z"/></svg>
{% endmacro %}

{# Circle: a term that carries no sanction for the creditor. #}
{% macro circle(class) %}
    <svg class="{{ class|default('size-3') }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="12" r="9"/></svg>
{% endmacro %}

{# Square: a reminder with no legal basis. #}
{% macro square(class) %}
    <svg class="{{ class|default('size-3') }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2"/></svg>
{% endmacro %}

{% macro clock(class) %}
    <svg class="{{ class|default('size-4') }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" d="M12 7v5l3 2"/></svg>
{% endmacro %}

{% macro lock(class) %}
    <svg class="{{ class|default('size-4') }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 118 0v3"/></svg>
{% endmacro %}

{# Open lock: a term of the debtor that expired, so the filing is no longer blocked. #}
{% macro unlock(class) %}
    <svg class="{{ class|default('size-4') }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 018 0"/></svg>
{% endmacro %}

{% macro check(class) %}
    <svg class="{{ class|default('size-3.5') }} shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
{% endmacro %}

{% macro chevron(class) %}
    <svg class="{{ class|default('size-4') }}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
{% endmacro %}

{% macro calendar(class) %}
    <svg class="{{ class|default('size-4') }}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
{% endmacro %}

{% macro document(class) %}
    <svg class="{{ class|default('size-4') }}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
{% endmacro %}

{% macro plus(class) %}
    <svg class="{{ class|default('size-4') }}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
{% endmacro %}

{# The badge icon that belongs to a DeadlineConsequence value. #}
{% macro consequence(value, class) %}
    {% import _self as icons %}
    {% if value in ['CASE_ANNULMENT', 'FORFEITURE', 'RIGHT_EXTINCTION'] %}
        {{ icons.octagon(class) }}
    {% elseif value == 'APPEARANCE' %}
        {{ icons.triangle(class) }}
    {% elseif value == 'RECORD_KEEPING' %}
        {{ icons.square(class) }}
    {% else %}
        {{ icons.circle(class) }}
    {% endif %}
{% endmacro %}
