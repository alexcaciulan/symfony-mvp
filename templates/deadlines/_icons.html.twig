{# Inline SVG macros for the deadlines agenda. Kept in one file so a row, the risk
   bar and the blockage zone all draw the same shape for the same meaning.
   The shape carries the meaning together with the badge text, never colour alone. #}

{# Octagon: an irreversible consequence (annulment, forfeiture, extinction). #}
{% macro octagon(class) %}
    <svg class="{{ class|default('size-3') }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8.6 2h6.8L22 8.6v6.8L15.4 22H8.6L2 15.4V8.6L8.6 2z"/></svg>
{% endmacro %}

{# Triangle: a consequence that costs an opportunity, not the right. #}
{% macro triangle(class) %}
    <svg class="{{ class|default('size-3') }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l10 19H2L12 2z"/></svg>
{% endmacro %}

{# Circle: a term that carries no sanction for the creditor. #}
{% macro circle(class) %}
    <svg class="{{ class|default('size-3') }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="12" r="9"/></svg>
{% endmacro %}

{# Square: a reminder with no legal basis. #}
{% macro square(class) %}
    <svg class="{{ class|default('size-3') }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2"/></svg>
{% endmacro %}

{% macro clock(class) %}
    <svg class="{{ class|default('size-4') }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" d="M12 7v5l3 2"/></svg>
{% endmacro %}

{% macro lock(class) %}
    <svg class="{{ class|default('size-4') }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 118 0v3"/></svg>
{% endmacro %}

{# Open lock: a term of the debtor that expired, so the filing is no longer blocked. #}
{% macro unlock(class) %}
    <svg class="{{ class|default('size-4') }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 018 0"/></svg>
{% endmacro %}

{% macro check(class) %}
    <svg class="{{ class|default('size-3.5') }} shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
{% endmacro %}

{% macro chevron(class) %}
    <svg class="{{ class|default('size-4') }}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
{% endmacro %}

{% macro calendar(class) %}
    <svg class="{{ class|default('size-4') }}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
{% endmacro %}

{% macro document(class) %}
    <svg class="{{ class|default('size-4') }}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
{% endmacro %}

{% macro plus(class) %}
    <svg class="{{ class|default('size-4') }}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
{% endmacro %}

{# The badge icon that belongs to a DeadlineConsequence value. #}
{% macro consequence(value, class) %}
    {% import _self as icons %}
    {% if value in ['CASE_ANNULMENT', 'FORFEITURE', 'RIGHT_EXTINCTION'] %}
        {{ icons.octagon(class) }}
    {% elseif value == 'APPEARANCE' %}
        {{ icons.triangle(class) }}
    {% elseif value == 'RECORD_KEEPING' %}
        {{ icons.square(class) }}
    {% else %}
        {{ icons.circle(class) }}
    {% endif %}
{% endmacro %}

{# Slot 1 of a row: into the case. #}
{% macro folder(class) %}
    <svg class="{{ class|default('size-4') }}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9.776c.112-.017.227-.026.344-.026h15.812c.117 0 .232.009.344.026m-16.5 0a2.25 2.25 0 00-1.883 2.542l.857 6a2.25 2.25 0 002.227 1.932H19.05a2.25 2.25 0 002.227-1.932l.857-6a2.25 2.25 0 00-1.883-2.542m-16.5 0V6A2.25 2.25 0 016 3.75h3.879a1.5 1.5 0 011.06.44l2.122 2.12a1.5 1.5 0 001.06.44H18A2.25 2.25 0 0120.25 9v.776"/></svg>
{% endmacro %}

{# Slot 1 of a hearing: the Portal tab of the case. #}
{% macro court(class) %}
    <svg class="{{ class|default('size-4') }}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0012 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75z"/></svg>
{% endmacro %}

{# Slot 1 of a case whose filing package is ready. #}
{% macro send(class) %}
    <svg class="{{ class|default('size-4') }}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5"/></svg>
{% endmacro %}

{# Slot 2: closing archives the row. Never a tick: a tick reads as "the act was done". #}
{% macro archive(class) %}
    <svg class="{{ class|default('size-4') }}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5m6 4.125l2.25 2.25m0 0l2.25 2.25M12 13.875l2.25-2.25M12 13.875l-2.25 2.25M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"/></svg>
{% endmacro %}

{% macro info(class) %}
    <svg class="{{ class|default('size-4') }}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z"/></svg>
{% endmacro %}

{% macro close_x(class) %}
    <svg class="{{ class|default('size-5') }}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
{% endmacro %}

{% macro chevron_right(class) %}
    <svg class="{{ class|default('size-4') }}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
{% endmacro %}

{# Upload and number glyphs of the short buttons on the blocked cases tab. #}
{% macro upload(class) %}
    <svg class="{{ class|default('size-4') }}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5"/></svg>
{% endmacro %}

{% macro hash(class) %}
    <svg class="{{ class|default('size-4') }}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5.25 8.25h15m-16.5 7.5h15m-1.8-13.5l-3.9 19.5m-2.1-19.5l-3.9 19.5"/></svg>
{% endmacro %}

{# The icon of a control, named by the caller. #}
{% macro glyph(name, class) %}
    {%- if name == 'court' -%}{{ _self.court(class) }}
    {%- elseif name == 'send' -%}{{ _self.send(class) }}
    {%- elseif name == 'archive' -%}{{ _self.archive(class) }}
    {%- elseif name == 'calendar' -%}{{ _self.calendar(class) }}
    {%- elseif name == 'upload' -%}{{ _self.upload(class) }}
    {%- elseif name == 'hash' -%}{{ _self.hash(class) }}
    {%- else -%}{{ _self.folder(class) }}{%- endif -%}
{% endmacro %}
