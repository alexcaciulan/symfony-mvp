{# The global deadlines agenda: what has to be done today, across every case.

   The page is server rendered from `view`, which already carries every row with its
   controls resolved, so nothing here decides anything legal. The selection travels in the
   query string, so a tab survives a refresh and can be handed to a colleague as a link.

   The three ids below are the targets an action fired from a row replaces, so the page
   updates in place. The dialogs and the side panel sit outside them but under the same
   controllers, so acting never destroys what asked the question.

   @var view         App\Service\Deadline\DeadlinePageView
   @var add_cases    list<App\Entity\LegalCase> choices of the add dialog
   @var add_modal_id string #}
{% extends 'base.html.twig' %}

{% block title %}{{ 'deadlines.title'|trans }} - {{ parent() }}{% endblock %}

{% block breadcrumb %}
    <li class="font-medium text-slate-700 dark:text-slate-300">{{ 'deadlines.heading'|trans }}</li>
{% endblock %}

{% block body %}
{% from 'deadlines/_icons.html.twig' import plus %}

<div class="space-y-5"
     data-controller="agenda-dialog deadline-panel tooltip deadline-page"
     data-agenda-dialog-confirm-modal-id-value="hs-modal-agenda-confirm-close"
     data-deadline-page-selection-failed-value="{{ 'deadlines.selection_load_failed'|trans }}"
     data-deadline-page-action-failed-value="{{ 'deadlines.action_no_answer'|trans }}">

    {# Tabs, the fatal switch and "show more" load here, so the selection changes without a
       page load and still lands in the address bar. Every other link leaves for the top. #}
    <turbo-frame id="deadline-page" target="_top" data-turbo-action="advance"
                 data-deadline-page-target="frame"
                 class="block space-y-5 transition-opacity aria-busy:opacity-60">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
            <div id="deadline-verdict" class="min-w-0">{{ include('deadlines/_verdict_region.html.twig', { view: view }, with_context = false) }}</div>

            {# Offered only when there is a case to attach a reminder to: an empty select
               would promise something the account cannot do yet. #}
            {% if add_cases|length > 0 %}
                <button type="button"
                        class="self-start shrink-0 inline-flex items-center gap-1.5 h-9 px-3 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-sm font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-800 transition"
                        data-agenda-action="add-deadline"
                        data-hs-overlay="#{{ add_modal_id }}">
                    {{ plus('size-4 text-slate-400') }}
                    {{ 'deadlines.add.open'|trans }}
                </button>
            {% endif %}
        </div>

        <div id="deadline-riskbar">{{ include('deadlines/_riskbar_region.html.twig', { view: view }, with_context = false) }}</div>

        <div id="deadline-agenda" tabindex="-1" class="outline-none">{{ include('deadlines/_agenda_region.html.twig', { view: view }, with_context = false) }}</div>
    </turbo-frame>

    {{ include('deadlines/_dialogs.html.twig', {
        add_cases: add_cases,
        add_modal_id: add_modal_id,
    }, with_context = false) }}

    {{ include('deadlines/_panel_shell.html.twig', {}, with_context = false) }}
    {{ include('deadlines/_tooltip.html.twig', {}, with_context = false) }}
</div>
{% endblock %}
