{# The first tab under the fatal switch with nothing to show. Not the "nothing to do" state:
   that one states something about the account, and here only the selection is empty. #}
<div data-state="filter-empty" class="px-6 py-12 text-center">
    <h2 class="text-base font-semibold text-slate-900 dark:text-white">{{ 'deadlines.filter.empty_heading'|trans }}</h2>
    <p class="mt-1 text-sm text-slate-600 dark:text-slate-400 max-w-md mx-auto">{{ 'deadlines.filter.empty_body'|trans }}</p>
    <a href="{{ path('app_deadlines') }}" data-turbo-frame="deadline-page"
       class="mt-4 inline-flex items-center h-9 px-3 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-sm font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-800 no-underline">{{ 'deadlines.filter.show_all'|trans }}</a>
</div>
