{# One time bucket of the agenda. The header stays sticky under the topbar so the
   lawyer always knows which day the rows below belong to.

   The 30-day bucket is collapsed when it holds more than ten rows: it is the only
   one that can push the urgent sections off the first screen. It uses <details>,
   so the disclosure works without JavaScript and announces its state on its own.

   @var group    App\Service\Deadline\DeadlineGroupView
   @var heading  string  already translated
   @var hint     string  optional short note next to the heading
   @var note     string  optional paragraph under the heading
   @var accent   string  left border of the whole section
   @var icon_key string  'fatal' | 'unlock' | none
   @var filter_fields map active filter, passed down to the forms of every row #}

{% from 'deadlines/_icons.html.twig' import octagon, chevron, unlock %}

{% set collapsible = collapsible|default(false) %}
{% set card_class = 'rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-soft' ~ (accent|default('') ? ' border-l-2 ' ~ accent : '') %}

{% if collapsible %}
    <details class="group {{ card_class }} overflow-hidden">
        <summary class="px-4 py-3 flex items-center gap-2 cursor-pointer list-none [&::-webkit-details-marker]:hidden border-b border-slate-100 dark:border-slate-800">
            <h2 class="text-sm font-semibold flex-1">{{ heading }} <span class="tnum text-slate-500 dark:text-slate-400">{{ 'deadlines.section.count'|trans({ '%count%': group.count() }) }}</span></h2>
            <span class="inline-flex items-center gap-1 text-xs font-medium text-slate-600 dark:text-slate-300">
                <span class="group-open:hidden">{{ 'deadlines.section.show'|trans }}</span>
                <span class="hidden group-open:inline">{{ 'deadlines.section.hide'|trans }}</span>
                {{ chevron('size-4 transition-transform group-open:rotate-180') }}
            </span>
        </summary>
        <div class="divide-y divide-slate-100 dark:divide-slate-800">
            {% for row in group.rows %}
                {{ include('deadlines/_row.html.twig', { row: row, filter_fields: filter_fields|default({}) }, with_context = false) }}
            {% endfor %}
        </div>
    </details>
{% else %}
    <section class="{{ card_class }}">
        <header class="rounded-t-2xl sticky top-14 z-10 px-4 py-3 bg-white/95 dark:bg-slate-900/95 backdrop-blur border-b border-slate-100 dark:border-slate-800">
            <div class="flex items-center gap-2">
                {% if icon_key|default('') == 'fatal' %}
                    <span class="text-red-600 dark:text-red-400 shrink-0">{{ octagon('size-4') }}</span>
                {% elseif icon_key|default('') == 'unlock' %}
                    <span class="text-emerald-600 dark:text-emerald-400 shrink-0">{{ unlock('size-4') }}</span>
                {% endif %}
                <h2 class="text-sm font-semibold">{{ heading }} <span class="tnum text-slate-500 dark:text-slate-400">{{ 'deadlines.section.count'|trans({ '%count%': group.count() }) }}</span></h2>
                {% if hint|default('') %}<span class="text-xs text-slate-500 dark:text-slate-400">{{ hint }}</span>{% endif %}
            </div>
            {% if note|default('') %}<p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">{{ note }}</p>{% endif %}
        </header>
        <div class="divide-y divide-slate-100 dark:divide-slate-800 rounded-b-2xl overflow-hidden">
            {% for row in group.rows %}
                {{ include('deadlines/_row.html.twig', { row: row, filter_fields: filter_fields|default({}) }, with_context = false) }}
            {% endfor %}
        </div>
    </section>
{% endif %}
