{# One time bucket of the first tab: a band with the name and the count, then the rows.
   The band stays under the topbar while scrolling, so the lawyer always knows which group
   the rows below belong to. The later group folds when it holds more than ten rows, the
   only one that can push the urgent ones off the first screen. It uses <details>, so the
   disclosure works without JavaScript.

   @var group       App\Service\Deadline\DeadlineGroupView
   @var heading     string already translated
   @var hint        string optional short note next to the heading
   @var info        string optional legal note behind an icon
   @var dot         string optional colour class of the dot
   @var collapsible bool
   @var filter      App\Service\Deadline\DeadlineAgendaFilter #}

{% from 'deadlines/_icons.html.twig' import chevron, info as info_icon %}

{% set band = 'flex items-center gap-2 px-5 sm:px-6 py-2 bg-slate-50 dark:bg-slate-800 border-y border-slate-100 dark:border-slate-800 text-[11px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400' %}
{% set soft = 'normal-case tracking-normal font-normal text-slate-400 dark:text-slate-500' %}

{% set title %}
    {% if dot|default('') %}<span class="size-1.5 rounded-full {{ dot }}" aria-hidden="true"></span>{% endif %}
    <span>{{ heading }}</span>
    <span class="tnum font-medium text-slate-400 dark:text-slate-500">{{ group.count() }}</span>
    {% if hint|default('') %}<span class="{{ soft }}">{{ hint }}</span>{% endif %}
    {% if info|default('') %}
        <button type="button" class="inline-flex items-center justify-center size-4 rounded-full text-slate-400 hover:text-slate-700 dark:hover:text-slate-200"
                data-tip="{{ 'deadlines.section.today_note_title'|trans }}" data-tip-note="{{ info }}" aria-label="{{ 'deadlines.section.today_note_title'|trans }}: {{ info }}">{{ info_icon('size-4') }}</button>
    {% endif %}
{% endset %}

{% set rows %}
    <ul class="divide-y divide-slate-100 dark:divide-slate-800">
        {% for row in group.rows %}
            {{ include('deadlines/_row.html.twig', { row: row, filter: filter }, with_context = false) }}
        {% endfor %}
    </ul>
{% endset %}

{% if collapsible|default(false) %}
    <details class="group" data-group="{{ group.key }}"{% if filter.fatalOnly %} open{% endif %}>
        <summary class="{{ band }} sticky top-14 z-[15] cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            <h2 class="contents">{{ title|raw }}</h2>
            <span class="ml-auto inline-flex items-center gap-1 normal-case tracking-normal font-medium">
                <span class="group-open:hidden">{{ 'deadlines.section.show'|trans }}</span>
                <span class="hidden group-open:inline">{{ 'deadlines.section.hide'|trans }}</span>
                {{ chevron('size-4 transition-transform group-open:rotate-180') }}
            </span>
        </summary>
        {{ rows|raw }}
    </details>
{% else %}
    <section data-group="{{ group.key }}">
        <h2 class="{{ band }} sticky top-14 z-[15]">{{ title|raw }}</h2>
        {{ rows|raw }}
    </section>
{% endif %}
