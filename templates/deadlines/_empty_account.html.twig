{# Nothing at all: no deadline, no blockage, no limitation period. The risk bar and
   the blockage zone are not rendered. Four counters on zero read as a broken screen
   and say nothing. What the screen says instead is which terms the application will
   watch and on what legal ground, because that is exactly what the lawyer is
   buying. #}

{% from 'deadlines/_icons.html.twig' import calendar, plus %}

<div class="py-8" data-state="no-deadlines">
    <div class="max-w-2xl mx-auto text-center">
        <div class="relative inline-flex mb-6">
            <div class="absolute inset-0 bg-gradient-to-br from-blue-400 to-indigo-500 rounded-2xl blur-2xl opacity-20" aria-hidden="true"></div>
            <div class="relative inline-flex items-center justify-center size-20 rounded-2xl bg-gradient-to-br from-blue-50 to-blue-100 dark:from-blue-950/50 dark:to-blue-900/30 text-blue-600 dark:text-blue-400 shadow-soft">
                {{ calendar('size-10') }}
            </div>
        </div>
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight">{{ 'deadlines.empty.heading'|trans }}</h2>
        <p class="mt-3 text-base text-slate-600 dark:text-slate-400 max-w-xl mx-auto">{{ 'deadlines.empty.body'|trans }}</p>
        <div class="mt-7 flex justify-center">
            <a href="{{ path('case_wizard_start') }}"
               class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-lg bg-gradient-to-br from-lex-navy to-lex-navy-dark text-white font-semibold hover:shadow-lg transition shadow-sm no-underline">
                {{ plus('size-5') }}
                {{ 'deadlines.empty.cta'|trans }}
            </a>
        </div>
    </div>

    <div class="mt-10 max-w-3xl mx-auto rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-soft overflow-hidden">
        <header class="px-4 py-3 border-b border-slate-100 dark:border-slate-800">
            <h3 class="text-sm font-semibold">{{ 'deadlines.empty.list_heading'|trans }}</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">{{ 'deadlines.empty.list_subtitle'|trans }}</p>
        </header>
        <ul class="divide-y divide-slate-100 dark:divide-slate-800 text-sm">
            {% for entry in [
                { key: 'summons_answer', dot: 'bg-sky-500' },
                { key: 'stamp_duty', dot: 'bg-red-500' },
                { key: 'annulment', dot: 'bg-red-500' },
                { key: 'prescription', dot: 'bg-red-500' },
                { key: 'hearing', dot: 'bg-amber-500' },
            ] %}
                <li class="px-4 py-2.5 flex items-start gap-3">
                    <span class="mt-1 size-1.5 rounded-full {{ entry.dot }} shrink-0" aria-hidden="true"></span>
                    <span class="flex-1">
                        <span class="font-medium">{{ ('deadlines.empty.item.' ~ entry.key)|trans }}</span>
                        <span class="block text-xs text-slate-500 dark:text-slate-400">{{ ('deadlines.empty.item.' ~ entry.key ~ '_hint')|trans }}</span>
                    </span>
                </li>
            {% endfor %}
        </ul>
        <footer class="px-4 py-2.5 border-t border-slate-100 dark:border-slate-800 text-xs text-slate-500 dark:text-slate-400">
            {{ 'deadlines.empty.alerts_note'|trans }}
        </footer>
    </div>
</div>
