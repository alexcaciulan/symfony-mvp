{# The body of the page: the active tab, in one card.

   A region of its own because every action changes more of it than the row itself:
   counts, whether a group renders at all, the blocked cases. The page wraps it in
   `id="deadline-agenda"`, which is what the agenda Turbo Stream replaces. Only the active
   tab is built, so rows of another tab are absent from the markup, not hidden.

   @var view App\Service\Deadline\DeadlinePageView #}

{% from 'deadlines/_dates.html.twig' import day_month, long %}

{% set filter = view.filter %}
{% set counters = view.counters %}
{% set card = 'rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-soft overflow-clip' %}
{% set intro_class = 'px-5 sm:px-6 py-3 text-[13px] text-slate-600 dark:text-slate-400 border-b border-slate-100 dark:border-slate-800' %}

{# The dialogs stay outside the frame, so the selection reaches their forms from here:
   a dialog never answers with a tab other than the one on screen. #}
{% for form_id in ['deadline-add-form', 'deadline-summons-form'] %}
    {% for name, value in filter.hiddenFields() %}
        <input type="hidden" form="{{ form_id }}" name="{{ name }}" value="{{ value }}">
    {% endfor %}
{% endfor %}

{% if view.isNothingTracked() %}
    {{ include('deadlines/_empty_account.html.twig', {}, with_context = false) }}
{% elseif filter.isTab('de-completat') %}
    <div data-tab-panel="de-completat" class="{{ card }}">
        {% if view.blockages is empty %}
            {{ include('deadlines/_empty_tab.html.twig', { key: 'blocked' }, with_context = false) }}
        {% else %}
            <p class="{{ intro_class }}">{{ 'deadlines.blockages.intro'|trans }}</p>
            {{ include('deadlines/_blockages.html.twig', { blockages: view.blockages, filter: filter }, with_context = false) }}
        {% endif %}
    </div>
{% elseif filter.isTab('prescriptii') %}
    <div data-tab-panel="prescriptii" class="{{ card }}">
        {% if view.prescriptions is empty %}
            {{ include('deadlines/_empty_tab.html.twig', { key: 'prescriptions' }, with_context = false) }}
        {% else %}
            <p class="{{ intro_class }}">{{ 'deadlines.prescriptions.intro'|trans }}<span class="mt-1 block text-xs text-slate-500 dark:text-slate-400">{{ 'deadlines.prescriptions.note'|trans }}</span></p>
            <ul class="divide-y divide-slate-100 dark:divide-slate-800">
                {% for row in view.prescriptions %}
                    {{ include('deadlines/_row.html.twig', { row: row, filter: filter, show_fatal: false }, with_context = false) }}
                {% endfor %}
            </ul>
        {% endif %}
    </div>
{% elseif filter.isTab('finalizate') %}
    <div data-tab-panel="finalizate" class="{{ card }}">
        {% if view.completed is empty %}
            {{ include('deadlines/_empty_tab.html.twig', { key: 'completed' }, with_context = false) }}
        {% else %}
            <p class="{{ intro_class }}">{{ 'deadlines.completed.intro'|trans }}</p>
            <ul class="divide-y divide-slate-100 dark:divide-slate-800">
                {% for row in view.completed %}
                    {{ include('deadlines/_row.html.twig', { row: row, filter: filter, show_fatal: false }, with_context = false) }}
                {% endfor %}
            </ul>
            {% if view.hasMoreCompleted %}
                <div class="px-5 sm:px-6 py-3 border-t border-slate-100 dark:border-slate-800 text-center">
                    <a href="{{ path('app_deadlines', filter.withNextPage().queryParameters()) }}"
                       data-testid="show-more-completed"
                       data-turbo-frame="deadline-page"
                       class="inline-flex items-center h-9 px-3 rounded-lg border border-slate-200 dark:border-slate-700 text-sm font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-800 no-underline">{{ 'deadlines.completed.show_more'|trans }}</a>
                </div>
            {% endif %}
        {% endif %}
    </div>
{% else %}
    <div data-tab-panel="de-facut" class="{{ card }}">
        {% if counters.blocked > 0 or counters.todo > 0 %}
            <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 px-5 sm:px-6 py-2.5 border-b border-slate-100 dark:border-slate-800">
                <p class="text-[13px] text-slate-600 dark:text-slate-400">
                    {% if counters.blocked > 0 %}
                        {{ 'deadlines.blockages.line'|trans({ '%count%': counters.blocked }) }}
                        <a href="{{ path('app_deadlines', { tab: 'de-completat' }) }}" data-turbo-frame="deadline-page" class="font-medium text-blue-700 dark:text-blue-400 hover:underline">{{ 'deadlines.blockages.line_link'|trans }}</a>
                    {% endif %}
                </p>
                {% if counters.todo > 0 %}
                    <a href="{{ path('app_deadlines', filter.toggledFatal().queryParameters()) }}"
                       data-testid="agenda-fatal-toggle"
                       data-turbo-frame="deadline-page"
                       role="button"
                       aria-pressed="{{ filter.fatalOnly ? 'true' : 'false' }}"
                       class="shrink-0 inline-flex items-center gap-2 h-8 px-2.5 rounded-lg border border-slate-200 dark:border-slate-700 text-xs font-medium text-slate-700 dark:text-slate-300 no-underline transition hover:bg-slate-50 dark:hover:bg-slate-800 aria-pressed:bg-slate-100 dark:aria-pressed:bg-slate-800 aria-pressed:text-slate-900 dark:aria-pressed:text-white">
                        <span class="size-1.5 rounded-full bg-amber-500" aria-hidden="true"></span>{{ 'deadlines.filter.fatal_only'|trans }}
                    </a>
                {% endif %}
            </div>
        {% endif %}

        {% if view.isAgendaEmpty() and filter.fatalOnly %}
            {{ include('deadlines/_empty_filter.html.twig', {}, with_context = false) }}
        {% elseif view.isAgendaEmpty() %}
            {{ include('deadlines/_empty_agenda.html.twig', { window_end: view.windowEnd, next_prescription: view.nextPrescription }, with_context = false) }}
        {% else %}
            {% for group in view.groups %}
                {% if not group.isEmpty() %}
                    {% set heading = ('deadlines.section.' ~ group.key)|trans %}
                    {% set hint = '' %}
                    {% set info = '' %}
                    {% set dot = '' %}
                    {% if group.key == 'overdue' %}
                        {# The worst row decides the band: how far behind the oldest one is. #}
                        {% set oldest = 0 %}
                        {% for row in group.rows %}
                            {% if row.item.daysRemaining < oldest %}{% set oldest = row.item.daysRemaining %}{% endif %}
                        {% endfor %}
                        {% set hint = 'deadlines.section.oldest'|trans({ '%count%': oldest|abs }) %}
                        {% set dot = 'bg-red-500' %}
                    {% elseif group.key == 'today' %}
                        {% set info = 'deadlines.section.today_note'|trans %}
                        {% set dot = 'bg-red-500' %}
                    {% elseif group.key == 'later' %}
                        {% set hint = 'deadlines.section.later_hint'|trans({ '%date%': day_month(view.windowEnd) }) %}
                    {% endif %}
                    {{ include('deadlines/_group.html.twig', {
                        group: group,
                        heading: heading,
                        hint: hint,
                        info: info,
                        dot: dot,
                        collapsible: group.key == 'later' and group.count() > 10,
                        filter: filter,
                    }, with_context = false) }}
                {% endif %}
            {% endfor %}
        {% endif %}

    </div>
    {% if not view.isAgendaEmpty() %}
        <p class="mt-4 px-1 text-xs text-slate-500 dark:text-slate-400">{{ 'deadlines.agenda_scope_note'|trans({ '%date%': long(view.windowEnd) }) }}</p>
    {% endif %}
{% endif %}
