{# What the lawyer reads before closing a term whose miss cannot be undone.

   The wording is not "are you sure": it names the sanction the term protects
   against, states what closing the row does (stops the alerts) and what it does not
   do (prove the act, interrupt a limitation period), and prints the state of the
   case as stored, so the declaration is checked against the record.

   There is one dialog for the whole page and it is filled from the button that was
   pressed, by `agenda-dialog_controller`. Everything it shows was translated on the
   server and travels in the data attributes of that button, so opening it costs no
   request and the text stays out of JavaScript.

   The reversible terms get no dialog at all. A confirmation on every close is what
   teaches a lawyer to click through the one that mattered. #}

{% from 'deadlines/_icons.html.twig' import triangle %}

<div id="hs-modal-agenda-confirm-close"
     class="hs-overlay hidden size-full fixed top-0 start-0 z-[80] overflow-x-hidden overflow-y-auto pointer-events-none"
     role="dialog"
     tabindex="-1"
     aria-labelledby="hs-modal-agenda-confirm-close-title">
    <div class="hs-overlay-open:mt-7 hs-overlay-open:opacity-100 hs-overlay-open:duration-500 mt-0 opacity-0 ease-out transition-all sm:max-w-lg sm:w-full m-3 sm:mx-auto">
        <div class="flex flex-col bg-white border border-slate-200 shadow-lg rounded-2xl pointer-events-auto dark:bg-slate-900 dark:border-slate-800">

            <div class="flex justify-between items-center py-4 px-5 border-b border-slate-100 dark:border-slate-800">
                <div class="flex items-center gap-3">
                    <span class="inline-flex items-center justify-center size-9 rounded-lg bg-red-100 dark:bg-red-950/40 text-red-600 dark:text-red-400">
                        {{ triangle('size-5') }}
                    </span>
                    <h3 id="hs-modal-agenda-confirm-close-title"
                        class="font-bold text-slate-900 dark:text-white"
                        data-agenda-dialog-target="confirmTitle"></h3>
                </div>
                <button type="button"
                        class="size-8 inline-flex justify-center items-center rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 hover:bg-slate-200 dark:text-slate-100 dark:hover:bg-slate-700"
                        aria-label="{{ 'case_overview.modal.aria_close'|trans }}"
                        data-hs-overlay="#hs-modal-agenda-confirm-close">
                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            <div class="p-5 space-y-4">
                <p class="text-sm text-slate-600 dark:text-slate-400" data-agenda-dialog-target="confirmBody"></p>

                <dl class="hidden rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/40 px-3 py-2 text-xs divide-y divide-slate-200 dark:divide-slate-800"
                    data-agenda-dialog-target="confirmFacts"></dl>

                <p class="hidden rounded-lg border border-amber-200 dark:border-amber-900/40 bg-amber-50 dark:bg-amber-950/20 p-3 text-xs font-medium text-amber-900 dark:text-amber-200"
                   data-agenda-dialog-target="confirmWarning"></p>
            </div>

            <div class="flex justify-end items-center gap-x-2 py-3 px-5 border-t border-slate-100 dark:border-slate-800">
                <button type="button"
                        class="py-2 px-3 inline-flex items-center text-sm font-medium rounded-lg border border-slate-200 bg-white text-slate-800 hover:bg-slate-50 dark:bg-slate-900 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
                        data-hs-overlay="#hs-modal-agenda-confirm-close">
                    {{ 'deadlines.confirm.cancel'|trans }}
                </button>
                {# Label of the button that was pressed, so the answer names the same act. #}
                <button type="button"
                        class="py-2 px-4 inline-flex items-center text-sm font-semibold rounded-lg bg-red-600 text-white hover:bg-red-700 transition"
                        data-action="agenda-dialog#accept"
                        data-agenda-dialog-target="confirmSubmit"></button>
            </div>
        </div>
    </div>
</div>
