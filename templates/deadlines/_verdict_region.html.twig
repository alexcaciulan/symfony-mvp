{# The heading of the page: today's date and, in one sentence, what the agenda holds.
   A region of its own because an action fired from a row changes the sentence.

   @var view App\Service\Deadline\DeadlinePageView #}

{% from 'deadlines/_dates.html.twig' import weekday_long %}

{% set counters = view.counters %}
{% set parts = [] %}
{% if counters.overdue > 0 %}
    {% set parts = parts|merge(['deadlines.verdict.overdue'|trans({ '%count%': counters.overdue })]) %}
{% endif %}
{% if counters.today > 0 %}
    {% set parts = parts|merge([(parts is empty ? 'deadlines.verdict.today_first' : 'deadlines.verdict.today')|trans({ '%count%': counters.today })]) %}
{% endif %}
{% if counters.week > 0 %}
    {% set parts = parts|merge([(parts is empty ? 'deadlines.verdict.week_first' : 'deadlines.verdict.week')|trans({ '%count%': counters.week })]) %}
{% endif %}

<p class="text-xs uppercase tracking-wide font-semibold text-slate-500 dark:text-slate-400">
    {{ 'deadlines.heading'|trans }} <span aria-hidden="true">·</span> {{ weekday_long(view.today()) }}
</p>
<h1 data-testid="agenda-verdict" class="mt-1.5 text-2xl md:text-[32px] md:leading-9 font-bold tracking-tight text-slate-900 dark:text-white">
    {%- if view.isNothingTracked() -%}
        {{ 'deadlines.verdict.nothing_tracked'|trans }}
    {%- elseif parts is not empty -%}
        {{ parts|join(', ', ' ' ~ 'deadlines.verdict.and'|trans ~ ' ') }}.
    {%- elseif counters.todo > 0 -%}
        {{ 'deadlines.verdict.later'|trans({ '%count%': counters.todo }) }}
    {%- else -%}
        {{ 'deadlines.verdict.nothing'|trans }}
    {%- endif -%}
</h1>
