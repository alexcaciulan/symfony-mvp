{# One agenda row: the type on the left, the date, the debtor over the case, then what
   wider screens have room for, and the two controls in fixed slots. Everything else
   about the term lives in the side panel: printed here it would make forty rows
   unreadable, which defeats a triage screen.

   The whole row opens the panel; its link keeps the case as a target for a browser
   running no scripts. On a phone the row has no buttons and the panel carries them.

   @var row           App\Service\Deadline\DeadlineRowView
   @var filter        App\Service\Deadline\DeadlineAgendaFilter
   @var show_fatal    bool whether the Fatal mark applies on this tab #}

{% from 'deadlines/_dates.html.twig' import day_month %}
{% from 'deadlines/_icons.html.twig' import chevron_right %}

{% set item = row.item %}
{% set deadline = row.deadline() %}
{% set legal_case = row.legalCase() %}
{% set action = row.action %}
{% set days = item.daysRemaining %}
{% set closed = deadline.completed %}
{% set consumed = row.isConsequenceConsumed() and not closed %}
{% set is_fatal = item.isIrreversible() %}
{% set type = deadline.type.value %}
{% set unblocked = type == 'RASPUNS_SOMATIE' and days < 0 %}
{% set debtor = legal_case.primaryDebtor %}
{% set case_number = legal_case.courtCaseNumber ?: legal_case.caseNumber %}

{% set description = deadline.description|default('')|trim %}
{% set is_custom = type == 'OTHER' and description is not empty %}
{% set type_short = ('deadlines.type_short.' ~ type)|trans %}

{% if closed %}
    {% set days_text = 'deadlines.row.completed'|trans %}
{% elseif days < 0 %}
    {% set days_text = (unblocked ? 'deadlines.row.expired_by' : 'deadlines.row.overdue_by')|trans({ '%count%': days|abs }) %}
{% elseif days == 0 %}
    {% set days_text = 'deadlines.row.due_today'|trans %}
{% else %}
    {% set days_text = 'deadlines.row.due_in'|trans({ '%count%': days }) %}
{% endif %}
{% set days_class = not closed and not unblocked and days <= 0 ? 'font-medium text-red-600 dark:text-red-400' : 'text-slate-500 dark:text-slate-400' %}

{% set panel_query = { id: deadline.id } + filter.queryParameters() %}
{% set row_date = closed and deadline.completedAt ? deadline.completedAt : deadline.deadlineDate %}

<li>
<article id="deadline-row-{{ deadline.id }}"
         data-deadline-type="{{ type }}"
         data-fatal="{{ is_fatal ? '1' : '0' }}"
         data-consumed="{{ consumed ? '1' : '0' }}"
         class="relative flex items-center gap-3 lg:grid lg:gap-x-5 lg:grid-cols-[6.5rem_7.5rem_minmax(0,1fr)_5rem] xl:grid-cols-[6.5rem_7.5rem_minmax(0,1fr)_16rem_5rem] 2xl:grid-cols-[6.5rem_7.5rem_minmax(0,1fr)_16rem_6.5rem_5rem] min-[105rem]:grid-cols-[6.5rem_7.5rem_minmax(0,1fr)_16rem_13rem_6.5rem_5rem] px-5 sm:px-6 py-2.5 transition-colors {{ consumed ? 'bg-slate-50/70 dark:bg-slate-800/25 hover:bg-slate-100/70' : 'hover:bg-slate-50' }} dark:hover:bg-slate-800/40">
    <a href="{{ path('case_overview', { id: legal_case.id }) }}"
       class="absolute inset-0"
       data-action="deadline-panel#open"
       data-deadline-panel-url-param="{{ path('app_deadlines_panel', panel_query) }}"
       aria-label="{{ 'deadlines.row.details_aria'|trans({ '%type%': type_short, '%debtor%': debtor ? debtor.name : case_number, '%case%': case_number }) }}{% if is_fatal and not closed %}, {{ 'deadlines.row.fatal'|trans }}{% endif %}"></a>

    <div class="hidden lg:block pointer-events-none text-[10px] leading-[13px] font-bold uppercase tracking-[.08em] text-slate-500 dark:text-slate-400">{{ type_short }}</div>

    <div class="w-[5.25rem] sm:w-28 lg:w-auto shrink-0 pointer-events-none">
        <div class="text-base font-semibold leading-5 tnum text-slate-900 dark:text-slate-100">{{ day_month(row_date) }}{% if row_date|date('Y') != 'now'|date('Y') %} <span class="text-xs font-normal text-slate-500 dark:text-slate-400">{{ row_date|date('Y') }}</span>{% endif %}</div>
        <div class="mt-0.5 text-xs leading-4 lg:whitespace-nowrap {{ days_class }}">{{ days_text }}</div>
    </div>

    <div class="min-w-0 flex-1 pointer-events-none">
        <div class="flex flex-wrap sm:flex-nowrap items-center gap-x-2.5 gap-y-0.5 min-w-0">
            <span class="sm:truncate sm:min-w-[7rem] text-sm leading-5 font-semibold text-slate-900 dark:text-slate-100">{{ debtor ? debtor.name : case_number }}</span>
            {% if (show_fatal is not defined or show_fatal) and is_fatal and not closed %}
                {{ include('deadlines/_row_mark.html.twig', {
                    label: 'deadlines.row.fatal'|trans,
                    hint: ('deadlines.fatal_hint.' ~ type)|trans,
                    dot: consumed ? 'bg-slate-400' : 'bg-amber-500',
                    testid: 'row-fatal',
                }, with_context = false) }}
            {% endif %}
            {% if row.isEstimated() and not closed %}
                {% set note = item.estimateNote %}
                {{ include('deadlines/_row_mark.html.twig', {
                    label: note.markKey|trans(note.parameters),
                    hint: note.noteKey|trans(note.parameters),
                    dot: 'bg-slate-400',
                    testid: 'row-date-note',
                    long: true,
                }, with_context = false) }}
            {% endif %}
        </div>
        <div class="mt-0.5 sm:truncate text-[13px] leading-5 text-slate-500 dark:text-slate-400">
            <span class="lg:hidden uppercase text-[10px] font-bold tracking-wider">{{ type_short }} <span aria-hidden="true">·</span></span>
            {% if is_custom %}{{ description }} <span aria-hidden="true">·</span>{% endif %}
            {% if item.coveredTerms > 1 %}{{ 'deadlines.row.covered_terms'|trans({ '%count%': item.coveredTerms }) }} <span aria-hidden="true">·</span>{% endif %}
            <span class="font-mono text-xs whitespace-nowrap">{{ case_number }}</span>
            <span aria-hidden="true">·</span>
            {% if consumed %}
                <span class="font-medium text-slate-700 dark:text-slate-300">{{ 'deadlines.row.consequence_consumed'|trans }}</span>
            {% else %}
                {{ legal_case.status.label()|trans }}
            {% endif %}
        </div>
    </div>

    {% if row.nextStep and row.nextStep.code %}
        <div data-testid="row-next-step" data-next-step="{{ row.nextStep.code }}" class="hidden xl:block min-w-0 pointer-events-none truncate text-[13px] text-slate-500 dark:text-slate-400">
            {{ 'deadlines.next_step.label'|trans }} <span class="text-slate-600 dark:text-slate-300">{{ ('deadlines.next_step.short.' ~ row.nextStep.code)|trans }}</span>
        </div>
    {% else %}
        <div class="hidden xl:block" aria-hidden="true"></div>
    {% endif %}

    <div class="hidden min-[105rem]:block min-w-0 pointer-events-none truncate text-[13px] text-slate-500 dark:text-slate-400">{{ legal_case.court ? legal_case.court.name : 'deadlines.row.no_court'|trans }}</div>
    <div class="hidden 2xl:block pointer-events-none text-right text-[13px] tnum text-slate-700 dark:text-slate-300">
        {%- if legal_case.amount %}{{ legal_case.amount|number_format(0, ',', '.') }} {{ legal_case.currency }}{% endif -%}
    </div>

    <div class="hidden sm:flex items-center justify-end gap-2 lg:justify-self-end w-[5rem] shrink-0">
        {{ include('deadlines/_row_action.html.twig', {
            button: action.open,
            case_id: legal_case.id,
            variant: 'icon',
            tone: not closed and days == 0 ? 'filled' : 'outline',
            glyph: type == 'JUDECATA' and not closed and action.open.routeParameters.tab is defined ? 'court' : (row.nextStep and row.nextStep.code == 'filing_package' ? 'send' : 'folder'),
            slot: 'case',
        }, with_context = false) }}
        {% if action.close %}
            {{ include('deadlines/_row_action.html.twig', {
                button: action.close,
                case_id: legal_case.id,
                variant: 'icon',
                tone: 'quiet',
                glyph: 'archive',
                slot: 'close',
                filter_fields: filter.hiddenFields(),
                confirmation: row.closeConfirmation,
            }, with_context = false) }}
        {% else %}
            <span class="size-9" aria-hidden="true"></span>
        {% endif %}
    </div>

    {{ chevron_right('size-4 text-slate-400 shrink-0 sm:hidden pointer-events-none') }}
</article>
</li>
