{# Records the date the summons was received, from the agenda.

   The 15 day term of the debtor runs from communication (CPC art. 1015 para. 1), so
   until that date is known the term does not exist and the case sits in the blockage
   zone with no date on its row. Collecting the date here is the point of the button on
   that row: sending the lawyer into the case to type one field is what makes a triage
   screen stop being one.

   It posts to the route the case page posts to, with the same form name and the same
   token, and adds only the agenda context and the active filter, so the answer is
   this page rather than the case markup. The action is written by
   `agenda-dialog_controller` from the row that was pressed, because one dialog
   serves every row.

   The id is the one the case page uses for the same act, on purpose: the two never
   coexist in a document, and the answer that dismisses the dialog there dismisses it
   here with no mapping in between.

   @var filter_fields map active filter as hidden inputs #}

{% from 'deadlines/_icons.html.twig' import calendar %}

<div id="hs-modal-set-summons-communication-date"
     class="hs-overlay hidden size-full fixed top-0 start-0 z-[80] overflow-x-hidden overflow-y-auto pointer-events-none"
     role="dialog"
     tabindex="-1"
     aria-labelledby="hs-modal-agenda-summons-date-title">
    <div class="hs-overlay-open:mt-7 hs-overlay-open:opacity-100 hs-overlay-open:duration-500 mt-0 opacity-0 ease-out transition-all sm:max-w-lg sm:w-full m-3 sm:mx-auto">
        <form method="post" enctype="multipart/form-data" class="flex flex-col bg-white border border-slate-200 shadow-lg rounded-2xl pointer-events-auto dark:bg-slate-900 dark:border-slate-800">
            <input type="hidden" name="payment_notice_communication_date[_token]" value="{{ csrf_token('payment_notice_communication_date') }}">
            <input type="hidden" name="_context" value="agenda">
            {% for name, value in filter_fields %}
                <input type="hidden" name="{{ name }}" value="{{ value }}">
            {% endfor %}

            <div class="flex justify-between items-center py-4 px-5 border-b border-slate-100 dark:border-slate-800">
                <div class="flex items-center gap-3">
                    <span class="inline-flex items-center justify-center size-9 rounded-lg bg-amber-100 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400">
                        {{ calendar('size-5') }}
                    </span>
                    <h3 id="hs-modal-agenda-summons-date-title" class="font-bold text-slate-900 dark:text-white">{{ 'case_overview.summons.modal_communication_date.title'|trans }}</h3>
                </div>
                <button type="button"
                        class="size-8 inline-flex justify-center items-center rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 hover:bg-slate-200 dark:text-slate-100 dark:hover:bg-slate-700"
                        aria-label="{{ 'case_overview.modal.aria_close'|trans }}"
                        data-hs-overlay="#hs-modal-set-summons-communication-date">
                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            <div class="p-5 space-y-4">
                <p class="text-sm text-slate-600 dark:text-slate-400">{{ 'case_overview.summons.modal_communication_date.intro'|trans }}</p>

                <div class="rounded-lg border border-amber-200 dark:border-amber-900/40 bg-amber-50 dark:bg-amber-950/20 p-3">
                    <div class="text-xs text-amber-900 dark:text-amber-200">{{ 'case_overview.summons.modal_communication_date.hint'|trans }}</div>
                </div>

                <div>
                    <label for="agenda_summons_communication_date" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">{{ 'case_overview.summons.modal_communication_date.field_date_label'|trans }}</label>
                    <input type="date"
                           id="agenda_summons_communication_date"
                           name="payment_notice_communication_date[paymentNoticeCommunicationDate]"
                           required
                           max="{{ 'now'|date('Y-m-d') }}"
                           class="w-full py-2 px-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>

                <div>
                    <label for="agenda_summons_communication_method" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">{{ 'case_overview.summons.modal_communication_date.field_method_label'|trans }}</label>
                    <select id="agenda_summons_communication_method"
                            name="payment_notice_communication_date[paymentNoticeCommunicationMethod]"
                            required
                            class="w-full py-2 px-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="">{{ 'case_overview.summons.modal_communication_date.field_method_placeholder'|trans }}</option>
                        <option value="EXECUTOR">{{ 'enum.payment_notice_communication_method.EXECUTOR'|trans }}</option>
                        <option value="POSTA_RCD">{{ 'enum.payment_notice_communication_method.POSTA_RCD'|trans }}</option>
                    </select>
                </div>

                {# Același câmp opțional ca pe pagina dosarului: comunicarea prin poștă
                   aduce data și dovada odată, deci ambele se pot închide de aici. #}
                <div>
                    <label for="agenda_summons_communication_proof" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">{{ 'case_overview.summons.modal_communication_date.field_proof_label'|trans }}</label>
                    <input type="file"
                           id="agenda_summons_communication_proof"
                           name="payment_notice_communication_date[communicationProof]"
                           accept=".pdf,.jpg,.jpeg,.png"
                           class="block w-full text-sm text-slate-600 dark:text-slate-400 file:mr-3 file:py-2 file:px-3 file:rounded-lg file:border-0 file:text-sm file:font-medium file:cursor-pointer file:bg-slate-100 file:text-slate-700 hover:file:bg-slate-200 dark:file:bg-slate-800 dark:file:text-slate-200 dark:hover:file:bg-slate-700">
                    <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400">{{ 'case_overview.summons.modal_communication_date.field_proof_hint'|trans }}</p>
                </div>
            </div>

            <div class="flex justify-end items-center gap-x-2 py-3 px-5 border-t border-slate-100 dark:border-slate-800">
                <button type="button"
                        class="py-2 px-3 inline-flex items-center text-sm font-medium rounded-lg border border-slate-200 bg-white text-slate-800 hover:bg-slate-50 dark:bg-slate-900 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
                        data-hs-overlay="#hs-modal-set-summons-communication-date">
                    {{ 'case_overview.summons.modal_communication_date.cancel'|trans }}
                </button>
                <button type="submit"
                        class="py-2 px-4 inline-flex items-center text-sm font-semibold rounded-lg bg-amber-600 text-white hover:bg-amber-700 transition">
                    {{ 'case_overview.summons.modal_communication_date.submit'|trans }}
                </button>
            </div>
        </form>
    </div>
</div>
