{# One control of an agenda row, of a blocked case or of the panel.

   The route, the method and whether pressing it closes the deadline are all decided in
   PHP. This template only picks the HTML element:

   - GET            renders a link to the route;
   - POST + token   renders a form that posts straight to the existing route;
   - POST, no token renders a link to the case, because the act needs data the agenda
                    does not collect. When the agenda carries that dialog itself the same
                    link opens it in place, and the href stays the fallback for a browser
                    running no scripts.

   The forms post `_context=agenda`, which makes the target controller answer with the
   regions of this page, and they carry the active selection. A button that closes a term
   whose miss cannot be undone hands the page dialog its confirmation before posting.

   @var button        App\Service\Deadline\DeadlineActionButton
   @var case_id       int    case the row belongs to, used for the dialog fallback
   @var variant       string 'icon' (square, the row) | 'short' (compact, with a short
                             label and an icon) | 'full' (the panel)
   @var tone          string 'outline' | 'filled' | 'quiet'
   @var glyph         string name of the macro in _icons for the icon
   @var short_label   string|null already translated label of the short variant
   @var slot          string value of data-row-slot
   @var filter_fields map    active selection as hidden inputs
   @var confirmation  App\Service\Deadline\DeadlineCloseConfirmation|null #}

{% from 'deadlines/_icons.html.twig' import glyph as draw_glyph %}

{% set variant = variant|default('icon') %}
{% set tone = tone|default('outline') %}
{% set glyph = glyph|default('folder') %}
{% set label = button.label|trans %}
{% set note = button.note ? button.note|trans : '' %}
{% set layer = variant == 'full' ? '' : 'relative z-10' %}

{% set skins = {
    'outline': 'border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 hover:bg-slate-50 hover:border-slate-300 hover:text-slate-900 dark:hover:bg-slate-800 dark:hover:border-slate-600 dark:hover:text-white',
    'filled': 'border border-transparent bg-lex-navy hover:bg-lex-navy-dark text-white dark:ring-1 dark:ring-white/10',
    'quiet': 'text-slate-400 dark:text-slate-500 hover:bg-slate-100 hover:text-slate-700 dark:hover:bg-slate-800 dark:hover:text-slate-200',
} %}
{% set shapes = {
    'icon': 'inline-flex items-center justify-center size-9 rounded-lg',
    'short': 'inline-flex items-center justify-start gap-2 h-8 w-[8.75rem] px-2.5 rounded-lg text-[13px] font-semibold whitespace-nowrap',
    'full': 'inline-flex items-center justify-center h-9 px-4 rounded-lg text-[13px] font-semibold whitespace-nowrap',
} %}
{% set classes = shapes[variant] ~ ' transition no-underline ' ~ skins[tone] ~ ' ' ~ layer %}

{% set tip_attributes %}
    {%- if variant != 'full' %} data-tip="{{ label }}" aria-label="{{ label }}"{% if note %} data-tip-note="{{ note }}"{% endif %}{% elseif note %} title="{{ note }}"{% endif -%}
    {%- if slot|default('') %} data-row-slot="{{ slot }}"{% endif -%}
{% endset %}

{% set content %}
    {% if variant != 'full' %}{{ draw_glyph(glyph, 'size-4 shrink-0') }}{% endif %}
    {% if variant == 'short' %}{{ short_label }}{% elseif variant == 'full' %}{{ label }}{% endif %}
{% endset %}

{% set confirmation = confirmation|default(null) %}
{% set confirm_here = button.closesDeadline and confirmation is not null %}
{% set facts = [] %}
{% if confirm_here %}
    {% for fact in confirmation.facts %}
        {% set facts = facts|merge([{
            label: fact.labelKey|trans,
            value: fact.valueIsTranslationKey ? fact.value|trans : fact.value,
        }]) %}
    {% endfor %}
{% endif %}

{% if button.isPost() and not button.needsCaseDialog() %}
    <form method="post"
          action="{{ path(button.route, button.routeParameters) }}"
          class="contents"
          {% if confirm_here %}
              data-action="submit->agenda-dialog#confirmClose"
              data-agenda-dialog-title-param="{{ confirmation.titleKey|trans }}"
              data-agenda-dialog-body-param="{{ confirmation.bodyKey|trans }}"
              {%- if confirmation.warningKey %} data-agenda-dialog-warning-param="{{ confirmation.warningKey|trans }}"{% endif %}
              data-agenda-dialog-facts-param="{{ facts|json_encode|e('html_attr') }}"
              data-agenda-dialog-confirm-param="{{ label }}"
          {% endif %}>
        <input type="hidden" name="_token" data-controller="csrf-protection" value="{{ csrf_token(button.csrfTokenId) }}">
        <input type="hidden" name="_context" value="agenda">
        {% for name, value in filter_fields|default({}) %}
            <input type="hidden" name="{{ name }}" value="{{ value }}">
        {% endfor %}
        <button type="submit" class="{{ classes }}"{{ tip_attributes|raw }}>{{ content|raw }}</button>
    </form>
{% else %}
    {% set opens_dialog = button.needsCaseDialog() and button.agendaDialogId is not null %}
    {% set case_link = button.caseTab ? path('case_overview', { id: case_id, tab: button.caseTab }) : path('case_overview', { id: case_id }) %}
    {% set href = button.needsCaseDialog() ? case_link : path(button.route, button.routeParameters) %}
    <a href="{{ href }}"
       class="{{ classes }}"{{ tip_attributes|raw }}
       {% if opens_dialog %}
           data-action="agenda-dialog#openDialog"
           data-agenda-dialog-dialog-param="{{ button.agendaDialogId }}"
           data-agenda-dialog-action-param="{{ path(button.route, button.routeParameters) }}"
       {% endif %}>{{ content|raw }}</a>
{% endif %}
