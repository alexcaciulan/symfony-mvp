{# The single entry of the right rail. Limitation periods fall outside the 30-day
   window on every young case, yet missing one extinguishes the right itself
   (NCC art. 2517, CPC art. 706 para. 1), so they stay in view without being
   allowed to flood the agenda or the counters.

   There is deliberately no legend card here: a badge that needs a permanent legend
   is a badge written wrong, and the consequence is already spelled out on the row.

   @var rows list<App\Service\Deadline\DeadlineRowView> #}

<aside class="xl:sticky xl:top-20 space-y-4">
    <section class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-soft overflow-hidden">
        <header class="px-4 py-3 border-b border-slate-100 dark:border-slate-800">
            <h2 class="text-sm font-semibold">{{ 'deadlines.rail.heading'|trans }}</h2>
            <p class="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400">{{ 'deadlines.rail.subtitle'|trans }}</p>
            <p class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">{{ 'deadlines.rail.note'|trans }}</p>
        </header>
        <div class="divide-y divide-slate-100 dark:divide-slate-800">
            {% for row in rows %}
                {% set deadline = row.deadline() %}
                {% set legal_case = row.legalCase() %}
                {% set debtor = legal_case.debtors|length > 0 ? legal_case.debtors|first : null %}
                <div class="px-4 py-2.5 {{ row.isEstimated() ? 'border-l-2 border-l-amber-400' : '' }}">
                    <div class="flex items-baseline justify-between gap-2">
                        <span class="text-xs font-semibold">{{ deadline.type.label()|trans }}</span>
                        <span class="text-[11px] tnum text-slate-500 dark:text-slate-400 shrink-0">{{ 'deadlines.row.due_in'|trans({ '%count%': row.item.daysRemaining }) }}</span>
                    </div>
                    <div class="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400 tnum">
                        {{ deadline.deadlineDate|date('d.m.Y') }}
                        <span aria-hidden="true">·</span>
                        <a href="{{ path('case_overview', { id: legal_case.id }) }}" class="font-mono hover:underline">{{ legal_case.courtCaseNumber ?: legal_case.caseNumber }}</a>
                        {% if debtor %}<span aria-hidden="true">·</span> {{ debtor.name }}{% endif %}
                    </div>
                    {% if row.isEstimated() %}
                        <span class="mt-1 inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[9px] font-semibold uppercase tracking-wide border border-dashed border-amber-400 text-amber-700 dark:text-amber-400">
                            {{ row.item.certainty.label()|trans }}
                        </span>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </section>
</aside>
