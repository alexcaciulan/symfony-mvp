{% extends 'base.html.twig' %}

{% block title %}{{ 'registration.check_email.title'|trans }}{% endblock %}

{% block body_class %}auth-bg{% endblock %}

{% block body %}
    <div class="max-w-md mx-auto px-4 py-12 sm:py-20">
        <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-card border border-slate-200 dark:border-slate-800 p-6 sm:p-8 text-center">
            <div class="size-16 mx-auto mb-6 bg-gradient-to-br from-blue-50 to-blue-100 dark:from-blue-950/50 dark:to-blue-900/30 rounded-2xl flex items-center justify-center text-blue-600 dark:text-blue-400">
                <svg class="size-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>

            <h1 class="text-2xl font-bold tracking-tight mb-4">{{ 'registration.check_email.heading'|trans }}</h1>

            <p class="text-slate-500 dark:text-slate-400 mb-2">
                {{ 'registration.check_email.sent_to'|trans }}
            </p>
            {% if app.user %}
                <p class="font-semibold text-slate-900 dark:text-white mb-6">{{ app.user.email }}</p>
            {% endif %}

            <p class="text-sm text-slate-500 dark:text-slate-400 mb-8">
                {{ 'registration.check_email.instructions'|trans }}
            </p>

            <a href="{{ path('app_resend_verification') }}"
               class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-gradient-to-br from-lex-navy to-lex-navy-dark text-white font-semibold hover:from-lex-navy-dark hover:to-slate-900 transition shadow-sm no-underline">
                {{ 'registration.check_email.resend_button'|trans }}
            </a>
        </div>
    </div>
{% endblock %}
