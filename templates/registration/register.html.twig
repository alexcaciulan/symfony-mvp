{% extends 'base.html.twig' %}

{% block title %}{{ 'registration.title'|trans }}{% endblock %}

{% block body_class %}auth-bg{% endblock %}

{% block layout %}
    {# Floating dark-mode toggle (split layout has no topbar). #}
    <div class="absolute top-4 right-4 z-10">
        <button type="button"
                data-controller="dark-mode-toggle"
                data-action="click->dark-mode-toggle#toggle"
                aria-label="{{ 'layout.topbar.toggle_dark'|trans }}"
                class="p-2 rounded-lg bg-white/80 dark:bg-slate-800/80 backdrop-blur hover:bg-white dark:hover:bg-slate-800 shadow-sm text-slate-600 dark:text-slate-300">
            <svg class="size-5 hidden dark:inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
            <svg class="size-5 inline dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
        </button>
    </div>

    <main class="min-h-screen grid lg:grid-cols-2">

        {{ include('_auth_branding.html.twig') }}

        <div class="flex flex-col items-center justify-center px-6 py-12 lg:py-0">

            <div class="lg:hidden flex flex-col items-center gap-2 mb-8 text-center">
                <div class="inline-flex items-center justify-center size-12 rounded-xl bg-gradient-to-br from-lex-navy to-lex-navy-dark text-white shadow-lg">
                    <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16l-3-3m3 3l3-3"/></svg>
                </div>
                <h1 class="text-2xl font-bold tracking-tight">{{ 'layout.brand'|trans }}</h1>
            </div>

            <div class="w-full max-w-md">
                <div class="mb-6">
                    <h2 class="text-2xl font-bold tracking-tight">{{ 'registration.heading'|trans }}</h2>
                    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{{ 'registration.subheading'|trans }}</p>
                </div>

                {{ include('_auth_flashes.html.twig') }}

                {# data-turbo=false: the rate-limit path redirects back to /register with a flash;
                   Turbo treats the same-URL redirect as a morph refresh and drops the new flash node,
                   so a full-page submit is what makes that feedback reliably visible. #}
                {{ form_start(registrationForm, {'attr': {'novalidate': 'novalidate', 'class': 'space-y-4', 'data-turbo': 'false'}}) }}
                    {% if registrationForm.vars.errors|length > 0 %}
                        <div class="px-4 py-3 rounded-lg bg-red-50 text-red-800 border border-red-200 dark:bg-red-950/40 dark:text-red-200 dark:border-red-900 text-sm" role="alert">
                            {{ form_errors(registrationForm) }}
                        </div>
                    {% endif %}

                    {% set input_classes = 'w-full px-3 py-2.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent' %}
                    {% set label_classes = 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5' %}

                    <div>
                        {{ form_label(registrationForm.email, null, {'label_attr': {'class': label_classes}}) }}
                        {{ form_widget(registrationForm.email, {'attr': {'class': input_classes}}) }}
                        {% for e in registrationForm.email.vars.errors %}<p class="mt-1.5 text-sm text-red-600 dark:text-red-400">{{ e.message }}</p>{% endfor %}
                    </div>

                    <div>
                        {{ form_label(registrationForm.plainPassword.first, null, {'label_attr': {'class': label_classes}}) }}
                        {{ form_widget(registrationForm.plainPassword.first, {'attr': {'class': input_classes}}) }}
                        {% for e in registrationForm.plainPassword.first.vars.errors %}<p class="mt-1.5 text-sm text-red-600 dark:text-red-400">{{ e.message }}</p>{% endfor %}
                    </div>

                    <div>
                        {{ form_label(registrationForm.plainPassword.second, null, {'label_attr': {'class': label_classes}}) }}
                        {{ form_widget(registrationForm.plainPassword.second, {'attr': {'class': input_classes}}) }}
                        {% for e in registrationForm.plainPassword.vars.errors %}<p class="mt-1.5 text-sm text-red-600 dark:text-red-400">{{ e.message }}</p>{% endfor %}
                    </div>

                    <div class="pt-2">
                        <label class="flex items-start gap-2">
                            {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'mt-1 size-4 rounded border-slate-300 dark:border-slate-600 text-blue-600 focus:ring-blue-500 bg-white dark:bg-slate-800'}}) }}
                            <span class="text-sm text-slate-600 dark:text-slate-400">{{ form_label(registrationForm.agreeTerms, null, {'label_attr': {'class': 'inline'}}) }}</span>
                        </label>
                        {% for e in registrationForm.agreeTerms.vars.errors %}<p class="mt-1.5 text-sm text-red-600 dark:text-red-400">{{ e.message }}</p>{% endfor %}
                    </div>

                    <button type="submit" class="w-full mt-2 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-gradient-to-br from-lex-navy to-lex-navy-dark text-white font-semibold hover:from-lex-navy-dark hover:to-slate-900 transition shadow-sm">
                        {{ 'registration.submit'|trans }}
                        <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                    </button>
                {{ form_end(registrationForm) }}

                <div class="my-6 flex items-center gap-3">
                    <div class="flex-1 h-px bg-slate-200 dark:bg-slate-800"></div>
                    <span class="text-xs text-slate-400">{{ 'auth.or'|trans }}</span>
                    <div class="flex-1 h-px bg-slate-200 dark:bg-slate-800"></div>
                </div>

                <p class="text-center text-sm text-slate-600 dark:text-slate-400">
                    {{ 'registration.has_account'|trans }}
                    <a href="{{ path('app_login') }}" class="font-semibold text-blue-600 dark:text-blue-400 hover:underline no-underline">{{ 'registration.login_link'|trans }} →</a>
                </p>
            </div>
        </div>
    </main>
{% endblock %}
