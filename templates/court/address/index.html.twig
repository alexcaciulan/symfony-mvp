{% extends 'base.html.twig' %}

{% block title %}{{ 'court_address.validation.page_title'|trans }} · {{ case.caseNumber }}{% endblock %}

{% from 'case/overview/_icons.html.twig' import icon_chevron_right, icon_building %}

{% block breadcrumb %}
  <li class="inline-flex items-center">
    <a href="{{ path('app_cases') }}" class="text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-300">{{ 'case_overview.breadcrumb.cases'|trans }}</a>
    <span class="shrink-0 mx-1.5 text-slate-300 dark:text-slate-700">{{ icon_chevron_right('size-3') }}</span>
  </li>
  <li class="inline-flex items-center">
    <a href="{{ path('case_overview', {id: case.id, tab: 'documente'}) }}" class="font-mono text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-300">{{ case.caseNumber }}</a>
    <span class="shrink-0 mx-1.5 text-slate-300 dark:text-slate-700">{{ icon_chevron_right('size-3') }}</span>
  </li>
  <li class="inline-flex items-center font-medium text-slate-700 dark:text-slate-300 truncate" aria-current="page">{{ 'court_address.validation.page_title'|trans }}</li>
{% endblock %}

{% block body %}
<div class="max-w-4xl space-y-6">
    <section class="bg-white dark:bg-slate-900 rounded-2xl shadow-soft border border-slate-200 dark:border-slate-800 p-5">
        <div class="flex items-start gap-4">
            <span class="inline-flex items-center justify-center size-10 rounded-xl bg-indigo-50 dark:bg-indigo-950/50 text-indigo-600 dark:text-indigo-400 shrink-0">
                {{ icon_building('size-5') }}
            </span>
            <div class="min-w-0">
                <h1 class="text-lg font-semibold text-slate-900 dark:text-white">{{ 'court_address.validation.page_title'|trans }}</h1>
                {% if court %}
                    <p class="text-sm text-slate-700 dark:text-slate-200" data-testid="court-address-court">{{ court.name }} · {{ court.type.label|trans }}</p>
                {% else %}
                    <p class="text-sm text-amber-800 dark:text-amber-200">{{ 'enum.court_filing_address_missing_reason.NO_COURT'|trans }}</p>
                {% endif %}
            </div>
        </div>
        <ul class="mt-4 space-y-1 text-xs text-slate-600 dark:text-slate-300 list-disc pl-5">
            <li>{{ 'court_address.validation.intro'|trans }}</li>
            <li>{{ 'court_address.validation.scope_note'|trans }}</li>
            <li>{{ 'court_address.validation.other_channel_note'|trans }}</li>
            <li>{{ 'court_address.validation.unofficial_source'|trans }}</li>
            <li>{{ 'court_address.validation.expiry_note'|trans({'%days%': constant('App\\Entity\\CourtEmailAddress::VALIDATION_TTL_DAYS')}) }}</li>
            <li>{{ 'court_address.validation.tribunal_note'|trans }}</li>
        </ul>
        {% if not is_owner %}
            <p class="mt-3 text-xs text-slate-500" data-testid="court-address-read-only">{{ 'court_address.validation.read_only_admin'|trans }}</p>
        {% endif %}
    </section>

    {{ include('court/address/_list.html.twig') }}
</div>
{% endblock %}
