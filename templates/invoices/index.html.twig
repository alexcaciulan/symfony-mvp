{% extends 'base.html.twig' %}

{% block title %}{{ 'invoices.heading'|trans }} - {{ parent() }}{% endblock %}

{% block breadcrumb %}
    <li class="font-medium text-slate-700 dark:text-slate-300">{{ 'invoices.heading'|trans }}</li>
{% endblock %}

{% block body %}
<div class="space-y-6">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-3">
        <div>
            <h1 class="text-2xl md:text-3xl font-bold tracking-tight">{{ 'invoices.heading'|trans }}</h1>
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{{ 'invoices.subtitle'|trans }}</p>
        </div>
        <a href="{{ path('app_subscription') }}" class="inline-flex items-center gap-1.5 py-1.5 px-3 rounded-lg border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 text-sm font-semibold transition no-underline self-start">
            {{ 'invoices.manage_subscription'|trans }}
        </a>
    </div>

    <twig:DataTable key="fiscal_invoices" />
</div>
{% endblock %}
