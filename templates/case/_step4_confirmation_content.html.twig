{% extends 'case/wizard.html.twig' %}

{# Pas 3.2 wizard step 4 — Confirmare.
   Mockup: docs/LexRecovery/mockups/v2/03-wizard/step4-confirmare.html.
   Page-level h1 + subtitle + breadcrumb come from wizard.html.twig shell via
   block overrides below. Legend chips at top, grid 2-col of 4 summary cards
   (Documente / Creditor / Debitor / Creanță), then "Calcule finale" navy band
   with 4-col stats + instanță footer, GDPR notice amber, ERROR/WARNING
   admissibility display, acknowledgement checkboxes, green-gradient
   "Salvează dosar" CTA submitted via HTML5 form="..." attribute from outside
   the form (Steps 1/2/3 pattern). #}

{% block wizard_max_width %}max-w-5xl{% endblock %}
{% block wizard_subtitle %}{{ 'wizard.step4.subtitle'|trans }}{% endblock %}
{% block wizard_breadcrumb_step %} · {{ 'wizard.step.confirmation'|trans }}{% endblock %}

{% import 'case/_wizard_macros.html.twig' as f %}

{% block wizard_step_content %}
    <div class="mb-6 inline-flex items-center gap-3 text-xs">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-blue-50 dark:bg-blue-950/40 text-blue-700 dark:text-blue-300">
            <svg class="size-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            <span>{{ 'wizard.step4.legend.auto'|trans }}</span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
            <svg class="size-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
            <span>{{ 'wizard.step4.legend.manual'|trans }}</span>
        </span>
    </div>

    {# Admissibility ERROR/WARNING display — surfaced before the summary cards
       so the user notices the blocker before reviewing the data. #}
    {% if has_errors %}
        <div role="alert" class="bg-red-50 dark:bg-red-950/30 border border-red-200 dark:border-red-900/60 rounded-xl p-4 mb-6">
            <div class="flex items-start gap-3">
                <svg class="size-5 text-red-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12c0 4.97-4.03 9-9 9s-9-4.03-9-9 4.03-9 9-9 9 4.03 9 9z"/></svg>
                <div>
                    <div class="font-semibold text-red-900 dark:text-red-200">{{ 'wizard.step4.alert.errors_title'|trans }}</div>
                    <ul class="mt-2 space-y-1 text-sm text-red-800 dark:text-red-200/80">
                        {% for issue in errors %}
                            <li class="flex items-start gap-2"><span class="text-red-500">•</span><span>{{ issue.messageKey|trans }}</span></li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
    {% elseif has_warnings %}
        <div role="alert" class="bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-900/60 rounded-xl p-4 mb-6">
            <div class="flex items-start gap-3">
                <svg class="size-5 text-amber-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12c0 4.97-4.03 9-9 9s-9-4.03-9-9 4.03-9 9-9 9 4.03 9 9z"/></svg>
                <div>
                    <div class="font-semibold text-amber-900 dark:text-amber-200">{{ 'wizard.step4.alert.warnings_title'|trans }}</div>
                    <ul class="mt-2 space-y-1 text-sm text-amber-800 dark:text-amber-200/80">
                        {% for issue in warnings %}
                            <li class="flex items-start gap-2"><span class="text-amber-500">•</span><span>{{ issue.messageKey|trans }}</span></li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
    {% endif %}

    {# 4 summary cards in a 2-col grid (md+). Each card has a colored icon
       chip on the left of the header + a small "Editează" link routing back
       to the corresponding step for inline correction. #}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">

        {# Card 1: Documente sursă #}
        <section class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-soft overflow-hidden">
            <header class="px-5 py-3 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="inline-flex items-center justify-center size-7 rounded-lg bg-gradient-to-br from-blue-50 to-blue-100 dark:from-blue-950/50 dark:to-blue-900/30 text-blue-600">
                        <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    </span>
                    <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">{{ 'wizard.step4.card.documents'|trans }} ({{ documents|length }})</h3>
                </div>
                <a href="{{ path('case_wizard_documents') }}" class="text-xs font-medium text-blue-600 hover:underline no-underline">{{ 'wizard.step4.card.edit'|trans }}</a>
            </header>
            <div class="px-5 py-4 space-y-2 text-sm">
                {% if documents|length > 0 %}
                    {% for document in documents %}
                        <div class="flex items-center gap-2">
                            {% if document.extractionStatus.value == 'COMPLETED' %}
                                <svg class="size-3.5 text-green-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                            {% elseif document.extractionStatus.value == 'FAILED' %}
                                <svg class="size-3.5 text-amber-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/></svg>
                            {% else %}
                                <svg class="size-3.5 text-slate-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM10 5a.75.75 0 01.75.75v4.59l2.95-2.95a.75.75 0 111.06 1.06l-4.25 4.25a.75.75 0 01-1.06 0L5.2 8.45a.75.75 0 011.06-1.06L9.25 10.34V5.75A.75.75 0 0110 5z" clip-rule="evenodd"/></svg>
                            {% endif %}
                            <span class="font-mono text-xs truncate">{{ document.originalFilename }}</span>
                            {% if document.extractionConfidence is not null %}
                                <span class="text-xs text-slate-500 ml-auto tnum">{{ (document.extractionConfidence * 100)|number_format(0) }}%</span>
                            {% endif %}
                        </div>
                    {% endfor %}
                    <p class="text-xs text-slate-500 pt-2 border-t border-slate-100 dark:border-slate-800 mt-2">{{ 'wizard.step4.card.documents_attached_hint'|trans }}</p>
                {% else %}
                    <p class="text-xs text-slate-500">{{ 'wizard.step4.card.documents_empty'|trans }}</p>
                {% endif %}
            </div>
        </section>

        {# Card 2: Creditor #}
        <section class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-soft overflow-hidden">
            <header class="px-5 py-3 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="inline-flex items-center justify-center size-7 rounded-lg bg-gradient-to-br from-blue-50 to-blue-100 dark:from-blue-950/50 dark:to-blue-900/30 text-blue-600">
                        <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9"/></svg>
                    </span>
                    <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">{{ 'wizard.step4.card.creditor'|trans }}</h3>
                </div>
                <a href="{{ path('case_wizard_creditor') }}" class="text-xs font-medium text-blue-600 hover:underline no-underline">{{ 'wizard.step4.card.edit'|trans }}</a>
            </header>
            <div class="px-5 py-4 space-y-1.5 text-sm">
                <div class="flex justify-between gap-2">
                    <span class="text-slate-500">{{ 'wizard.step1.field.person_type'|trans }}</span>
                    <span class="font-medium">{{ creditor.personType is null ? '—' : creditor.personType.value }}</span>
                </div>
                <div class="flex justify-between gap-2">
                    <span class="text-slate-500">{{ 'wizard.step1.field.name'|trans }}</span>
                    <span class="font-medium text-right inline-flex items-center gap-1">
                        <span>{{ creditor.name|default('—') }}</span>
                        {% if 'name' in creditor.autoFilled %}<span class="text-blue-500"><svg class="size-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg></span>{% endif %}
                    </span>
                </div>
                {% if creditor.cui %}
                    <div class="flex justify-between gap-2">
                        <span class="text-slate-500">{{ 'wizard.step1.field.cui'|trans }}</span>
                        <span class="font-mono text-right inline-flex items-center gap-1">
                            <span>{{ creditor.cui }}</span>
                            {% if 'cui' in creditor.autoFilled %}<span class="text-blue-500"><svg class="size-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg></span>{% endif %}
                        </span>
                    </div>
                {% endif %}
                <div class="flex justify-between gap-2">
                    <span class="text-slate-500">{{ 'wizard.step1.field.address'|trans }}</span>
                    <span class="font-medium text-right text-xs">{{ creditor.address|default('—') }}</span>
                </div>
                {% if creditor.iban %}
                    <div class="flex justify-between gap-2">
                        <span class="text-slate-500">{{ 'wizard.step1.field.iban'|trans }}</span>
                        <span class="font-mono text-xs">{{ creditor.iban[:10] }}…</span>
                    </div>
                {% endif %}
            </div>
        </section>

        {# Card 3: Debitor(i) #}
        <section class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-soft overflow-hidden">
            <header class="px-5 py-3 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="inline-flex items-center justify-center size-7 rounded-lg bg-gradient-to-br from-orange-50 to-orange-100 dark:from-orange-950/50 dark:to-orange-900/30 text-orange-600">
                        <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                    </span>
                    <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">{{ 'wizard.step4.card.debtors'|trans({ '%count%': debtors.debtors|length }) }}</h3>
                </div>
                <a href="{{ path('case_wizard_debtor') }}" class="text-xs font-medium text-blue-600 hover:underline no-underline">{{ 'wizard.step4.card.edit'|trans }}</a>
            </header>
            <div class="px-5 py-4 space-y-3 text-sm">
                {% for entry in debtors.debtors %}
                    <div class="{% if not loop.first %}pt-3 border-t border-slate-100 dark:border-slate-800{% endif %} space-y-1.5">
                        <div class="flex justify-between gap-2">
                            <span class="text-slate-500">{{ 'wizard.step2.field.person_type'|trans }}</span>
                            <span class="font-medium">{{ entry.personType is null ? '—' : entry.personType.value }}</span>
                        </div>
                        <div class="flex justify-between gap-2">
                            <span class="text-slate-500">{{ 'wizard.step2.field.name'|trans }}</span>
                            <span class="font-medium text-right inline-flex items-center gap-1">
                                <span>{{ entry.name|default('—') }}</span>
                                {% if 'name' in entry.autoFilled %}<span class="text-blue-500"><svg class="size-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg></span>{% endif %}
                            </span>
                        </div>
                        {% if entry.cui %}
                            <div class="flex justify-between gap-2">
                                <span class="text-slate-500">{{ 'wizard.step2.field.cui'|trans }}</span>
                                <span class="font-mono">{{ entry.cui }}</span>
                            </div>
                        {% endif %}
                        <div class="flex justify-between gap-2">
                            <span class="text-slate-500">{{ 'wizard.step2.field.address'|trans }}</span>
                            <span class="font-medium text-right text-xs">{{ entry.address|default('—') }}</span>
                        </div>
                        <div class="flex justify-between gap-2 items-center">
                            <span class="text-slate-500">{{ 'wizard.step2.bpi.title'|trans|split('(')|first|trim }}</span>
                            {% if entry.inInsolvency %}
                                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-xs font-bold bg-red-100 text-red-800 dark:bg-red-950/40 dark:text-red-300">
                                    <span class="size-1.5 rounded-full bg-red-500"></span>
                                    {{ 'wizard.step2.field.in_insolvency_short'|trans }}
                                </span>
                            {% elseif entry.insolvencyCheckedAt is not null %}
                                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-xs font-bold bg-green-100 text-green-800 dark:bg-green-950/40 dark:text-green-300">
                                    <span class="size-1.5 rounded-full bg-green-500"></span>
                                    {{ 'wizard.step4.card.bpi_verified'|trans }}
                                </span>
                            {% else %}
                                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800 dark:bg-amber-950/40 dark:text-amber-300">
                                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                                    {{ 'wizard.step4.card.bpi_unverified'|trans }}
                                </span>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </section>

        {# Card 4: Creanță #}
        <section class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-soft overflow-hidden">
            <header class="px-5 py-3 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="inline-flex items-center justify-center size-7 rounded-lg bg-gradient-to-br from-green-50 to-green-100 dark:from-green-950/50 dark:to-green-900/30 text-green-600">
                        <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"/></svg>
                    </span>
                    <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">{{ 'wizard.step4.card.claim'|trans }}</h3>
                </div>
                <a href="{{ path('case_wizard_claim') }}" class="text-xs font-medium text-blue-600 hover:underline no-underline">{{ 'wizard.step4.card.edit'|trans }}</a>
            </header>
            <div class="px-5 py-4 space-y-1.5 text-sm">
                <div class="flex justify-between gap-2">
                    <span class="text-slate-500">{{ 'wizard.step3.field.amount'|trans }}</span>
                    <span class="font-bold tnum inline-flex items-center gap-1">
                        <span>{{ claim.amount is null ? '—' : claim.amount|number_format(2, '.', ',') }} {{ claim.currency }}</span>
                        {% if 'amount' in claim.autoFilled %}<span class="text-blue-500"><svg class="size-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg></span>{% endif %}
                    </span>
                </div>
                {% if conversion is defined and conversion is not null %}
                    <div class="flex justify-end">
                        <span class="text-[11px] text-slate-500">{{ 'wizard.step3.sidebar.conversion_line'|trans({ '%amount%': conversion.originalAmount|number_format(2, '.', ','), '%currency%': conversion.originalCurrency, '%rate%': conversion.rate|number_format(4, '.', ','), '%date%': conversion.rateDate ? conversion.rateDate|date('d.m.Y') : '', '%ron%': conversion.ronAmount|number_format(2, '.', ',') }) }}</span>
                    </div>
                {% endif %}
                <div class="flex justify-between gap-2">
                    <span class="text-slate-500">{{ 'wizard.step3.field.relationship_type'|trans }}</span>
                    <span class="font-medium">{{ claim.relationshipType is null ? '—' : ('enum.relationship_type.' ~ claim.relationshipType.value)|trans }}</span>
                </div>
                <div class="flex justify-between gap-2">
                    <span class="text-slate-500">{{ 'wizard.step3.field.due_date'|trans }}</span>
                    <span class="font-medium tnum inline-flex items-center gap-1">
                        <span>{{ claim.dueDate ? claim.dueDate|date('d.m.Y') : '—' }}</span>
                        {% if 'dueDate' in claim.autoFilled %}<span class="text-blue-500"><svg class="size-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg></span>{% endif %}
                    </span>
                </div>
                {% if claim.legalGround %}
                    <div class="flex justify-between gap-2">
                        <span class="text-slate-500">{{ 'wizard.step3.field.legal_ground'|trans }}</span>
                        <span class="font-medium text-right text-xs">{{ ('enum.legal_ground_category.' ~ claim.legalGround.value)|trans }}</span>
                    </div>
                {% endif %}
            </div>
        </section>
    </div>

    {# Final calculations strip — navy gradient with 4-col stats + court footer. #}
    <section class="bg-gradient-to-br from-lex-navy to-lex-navy-dark text-white rounded-2xl shadow-lg overflow-hidden mb-6">
        <div class="px-5 py-4 border-b border-white/10">
            <h3 class="text-sm font-semibold">{{ 'wizard.step4.final_calculations.title'|trans }}</h3>
        </div>
        {# For foreign-currency claims every figure here is the RON-converted one. #}
        {% set final_principal = (conversion is defined and conversion is not null) ? conversion.ronAmount : claim.amount %}
        <div class="px-5 py-4 grid grid-cols-2 md:grid-cols-4 gap-4">
            <div>
                <div class="text-[10px] text-white/60 uppercase tracking-wide font-medium">{{ 'wizard.step3.sidebar.principal_label'|trans }}</div>
                <div class="mt-1 text-lg font-bold tnum">{{ final_principal is null ? '—' : final_principal|number_format(2, '.', ',') }}</div>
            </div>
            <div>
                <div class="text-[10px] text-white/60 uppercase tracking-wide font-medium">{{ 'wizard.step3.sidebar.interest_label'|trans }}</div>
                <div class="mt-1 text-lg font-bold tnum text-amber-300">{{ accessory_total > 0 ? '+ ' ~ accessory_total|number_format(2, '.', ',') : '—' }}</div>
            </div>
            <div>
                <div class="text-[10px] text-white/60 uppercase tracking-wide font-medium">{{ 'wizard.step3.sidebar.total_label'|trans }}</div>
                <div class="mt-1 text-lg font-bold tnum text-green-300">{{ final_principal is null ? '—' : (final_principal + accessory_total)|number_format(2, '.', ',') }}</div>
            </div>
            <div>
                <div class="text-[10px] text-white/60 uppercase tracking-wide font-medium">{{ 'wizard.step3.sidebar.stamp_duty_label'|trans }}</div>
                <div class="mt-1 text-lg font-bold tnum">{{ stamp_duty is null ? '—' : stamp_duty.amount|number_format(2, '.', ',') }}</div>
            </div>
        </div>
        <div class="px-5 py-3 bg-black/20 text-xs text-white/70 flex items-center gap-2">
            <svg class="size-4 text-blue-300 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5"/></svg>
            <span>
                {{ 'wizard.step3.sidebar.court_label'|trans }}:
                <strong class="text-white">
                    {% if court is null or court.court is null %}{{ 'wizard.step3.sidebar.court_placeholder'|trans }}{% else %}{{ court.court.name }} · {{ court.court.county.name }}{% endif %}
                </strong>
                {% if court is not null %}<span class="text-white/50">· {{ court.explanationKey|trans(court.explanationParams) }}</span>{% endif %}
            </span>
        </div>
    </section>

    {# GDPR notice — Anthropic 30-day retention, AI extraction privacy. #}
    <div class="bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-900/50 rounded-xl p-4 flex gap-3 mb-6">
        <svg class="size-5 text-amber-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        <div class="text-sm text-amber-900 dark:text-amber-200">
            <div class="font-semibold">{{ 'wizard.step4.gdpr.title'|trans }}</div>
            <p class="mt-0.5 text-amber-800 dark:text-amber-300/80">{{ 'wizard.step4.gdpr.body'|trans }}</p>
        </div>
    </div>

    {# Acceptance checkboxes. Submit button lives OUTSIDE the form (Steps 1/2/3 pattern)
       and submits via the HTML5 form="step4-confirmation-form" attribute. #}
    {# data-turbo-frame="_top" — on POST success, controller redirects to
       /dashboard/cases. That route doesn't have <turbo-frame id="wizard-frame">,
       so we tell Turbo to break out of the frame and replace the whole page. #}
    {{ form_start(form, { attr: { 'id': 'step4-confirmation-form', 'class': 'space-y-4', 'novalidate': 'novalidate', 'data-turbo-frame': '_top' }}) }}
        {# Competent court picker — preselected with the auto-resolved court, editable.
           When resolution is ambiguous / county-unknown the user picks manually. #}
        <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-soft p-5">
            <label class="block text-sm font-semibold text-slate-800 dark:text-slate-200 mb-1">{{ 'wizard.step4.court.label'|trans }}</label>
            <p class="text-xs text-slate-500 dark:text-slate-400 mb-2">
                {% if court is not null and court.court is not null %}{{ 'wizard.step4.court.help_auto'|trans }}{% else %}{{ 'wizard.step4.court.help_manual'|trans }}{% endif %}
            </p>
            <div data-controller="court-autocomplete"
                 data-court-autocomplete-url-value="{{ path('api_courts_all_lookup') }}"
                 data-court-autocomplete-hint-msg-value="{{ 'wizard.step4.court.search_hint'|trans }}"
                 data-court-autocomplete-no-results-msg-value="{{ 'wizard.step4.court.no_results'|trans }}"
                 {% if preselected_court is not null %}data-court-autocomplete-selected-value="{{ { value: preselected_court.id, label: preselected_court.name ~ ' · ' ~ preselected_court.county.name }|json_encode }}"{% endif %}>
                <select data-court-autocomplete-target="select"
                        placeholder="{{ 'wizard.step4.court.pick_placeholder'|trans }}"
                        aria-label="{{ 'wizard.step4.court.label'|trans }}"></select>
                {{ form_widget(form.court, { attr: { 'data-court-autocomplete-target': 'hidden' }}) }}
            </div>
            {{ f.field_errors(form.court) }}
        </div>

        <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-soft p-5 space-y-3">
            <div>
                <label class="flex items-start gap-2 cursor-pointer">
                    {{ form_widget(form.acceptTerms, { attr: { 'class': 'mt-0.5 rounded border-slate-300 text-lex-navy focus:ring-lex-navy' ~ (form.acceptTerms.vars.valid is defined and not form.acceptTerms.vars.valid ? ' border-red-400 dark:border-red-600' : '') }}) }}
                    <span class="text-sm {{ form.acceptTerms.vars.valid is defined and not form.acceptTerms.vars.valid ? 'text-red-700 dark:text-red-400 font-medium' : 'text-slate-700 dark:text-slate-300' }}">{{ 'wizard.step4.field.accept_terms'|trans }}</span>
                </label>
                {{ f.field_errors(form.acceptTerms) }}
            </div>

            <div>
                <label class="flex items-start gap-2 cursor-pointer">
                    {{ form_widget(form.acceptDataAccuracy, { attr: { 'class': 'mt-0.5 rounded border-slate-300 text-lex-navy focus:ring-lex-navy' ~ (form.acceptDataAccuracy.vars.valid is defined and not form.acceptDataAccuracy.vars.valid ? ' border-red-400 dark:border-red-600' : '') }}) }}
                    <span class="text-sm {{ form.acceptDataAccuracy.vars.valid is defined and not form.acceptDataAccuracy.vars.valid ? 'text-red-700 dark:text-red-400 font-medium' : 'text-slate-700 dark:text-slate-300' }}">{{ 'wizard.step4.field.accept_data_accuracy'|trans }}</span>
                </label>
                {{ f.field_errors(form.acceptDataAccuracy) }}
            </div>

            {% if has_warnings %}
                <div class="pt-3 border-t border-slate-200 dark:border-slate-800">
                    <label class="flex items-start gap-2 cursor-pointer">
                        {{ form_widget(form.acknowledgedWarnings, { attr: { 'class': 'mt-0.5 rounded border-amber-400 text-amber-600 focus:ring-amber-500' ~ (form.acknowledgedWarnings.vars.valid is defined and not form.acknowledgedWarnings.vars.valid ? ' border-red-400 dark:border-red-600' : '') }}) }}
                        <span class="text-sm font-medium {{ form.acknowledgedWarnings.vars.valid is defined and not form.acknowledgedWarnings.vars.valid ? 'text-red-700 dark:text-red-400' : 'text-amber-800 dark:text-amber-200' }}">{{ 'wizard.step4.field.acknowledged_warnings'|trans }}</span>
                    </label>
                    {{ f.field_errors(form.acknowledgedWarnings) }}
                </div>
            {% else %}
                {# Hidden so the form binds the false default; no UI noise. #}
                <div class="hidden">{{ form_widget(form.acknowledgedWarnings) }}</div>
            {% endif %}
        </div>

        {{ form_errors(form) }}
    {{ form_end(form) }}

    {# Navigation bar — OUTSIDE the form, per Steps 1/2/3 pattern. Submit submits
       via form="step4-confirmation-form" and stays disabled while admissibility
       errors block the case from being filed. #}
    <div class="mt-6 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
        <a href="{{ path('case_wizard_claim') }}" class="inline-flex items-center justify-center gap-2 px-4 py-3 rounded-lg text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition no-underline">
            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
            <span>{{ 'wizard.step4.button.back'|trans }}</span>
        </a>
        <button type="submit" form="step4-confirmation-form"
                {% if has_errors %}disabled aria-disabled="true"{% endif %}
                class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg text-white text-sm font-bold transition shadow-sm
                    {% if has_errors %}bg-slate-400 cursor-not-allowed{% else %}bg-gradient-to-br from-green-500 to-emerald-600 hover:shadow-lg hover:shadow-green-500/30{% endif %}">
            <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            <span>{{ 'wizard.step4.button.submit'|trans }}</span>
        </button>
    </div>
{% endblock %}
