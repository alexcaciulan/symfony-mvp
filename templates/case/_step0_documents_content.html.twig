{% extends 'case/wizard.html.twig' %}

{% block wizard_subtitle %}{{ 'wizard.step0.subtitle'|trans }}{% endblock %}
{% block wizard_breadcrumb_step %} · {{ 'wizard.step.documents'|trans }}{% endblock %}

{% block wizard_step_content %}
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6"
     data-controller="wizard-step0"
     data-toast-completed="{{ 'wizard.step0.toast.completed'|trans }}"
     data-toast-failed="{{ 'wizard.step0.toast.failed'|trans }}"
     data-toast-skipped="{{ 'wizard.step0.toast.skipped'|trans }}">

    <div class="lg:col-span-2 space-y-6">
        {# Upload form: the POST answers with a Turbo Stream that swaps the
           documents frame, swaps the sidecard and appends the outcome toasts.
           The submission is deliberately NOT scoped to a frame: a frame-scoped
           submission makes Turbo keep only the matching frame of the response
           and drop every stream element aimed elsewhere, which silently
           swallowed the toasts (duplicate skipped, rate limit, rejected file).
           Streams replace their targets in place, so the page still stays put:
           no PRG redirect, no scroll jump, no flash lost on reload. #}
        {{ form_start(form, { attr: {
            'class': 'relative bg-white dark:bg-slate-900 rounded-2xl border-2 border-dashed border-slate-300 dark:border-slate-700 hover:border-blue-400 dark:hover:border-blue-600 transition p-12 text-center shadow-soft overflow-hidden',
            'enctype': 'multipart/form-data',
        }}) }}
            <div class="absolute top-0 right-0 size-40 bg-gradient-to-br from-blue-100/40 to-transparent dark:from-blue-950/30 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
            <div class="relative">
                <div class="inline-flex items-center justify-center size-16 rounded-2xl bg-gradient-to-br from-blue-50 to-blue-100 dark:from-blue-950/50 dark:to-blue-900/30 text-blue-600 dark:text-blue-400 mb-4 shadow-soft">
                    <svg class="size-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
                </div>
                <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">{{ 'wizard.step0.drop_zone.heading'|trans }}</h2>
                <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{{ 'wizard.step0.drop_zone.hint'|trans }}</p>
                <label class="mt-4 inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-gradient-to-br from-lex-navy to-lex-navy-dark text-white font-medium cursor-pointer hover:shadow-lg hover:shadow-lex-navy/20 transition">
                    <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                    <span>{{ 'wizard.step0.drop_zone.cta'|trans }}</span>
                    {{ form_widget(form.documents, { attr: { 'class': 'sr-only', 'data-action': 'change->wizard-step0#submitOnChange' }}) }}
                </label>
                {# Declaring the type before choosing files sends the batch to
                   the prompt written for it. Left on "detect automatically",
                   the extractor works out the type itself. #}
                <div class="mt-4 max-w-sm mx-auto text-left">
                    <label for="{{ form.documentType.vars.id }}" class="block text-xs font-medium text-slate-600 dark:text-slate-400">
                        {{ 'wizard.step0.document_type.label'|trans }}
                    </label>
                    {{ form_widget(form.documentType, { attr: {
                        'class': 'mt-1 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 px-3 py-2 text-sm text-slate-900 dark:text-slate-100',
                    }}) }}
                    <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">{{ 'wizard.step0.document_type.help'|trans }}</p>
                </div>
                <div class="mt-3">
                    {{ form_errors(form.documents) }}
                </div>
            </div>
        {{ form_end(form) }}

        {# Dynamic list of uploaded documents, GDPR notice and action bar.
           Wrapped in turbo-frame#step0-dynamic; replaced atomically by POST
           stream and Mercure-driven frame.reload(). GDPR sits inside the
           frame between the documents list and the navigation buttons so
           the visual order matches the v2 mockup (docs → notice → buttons). #}
        {{ include('case/_step0_dynamic_partial.html.twig') }}
    </div>

    {# Sidecard sits in its own grid column. Wrapped in turbo-frame#step0-sidecard
       so the controller can swap it independently. #}
    <aside class="lg:sticky lg:top-20 self-start">
        {{ include('case/_step0_sidecard_partial.html.twig') }}
    </aside>
</div>
{% endblock %}
