{# Pas 3.0 aggregated "Date detectate" sidecard — re-rendered atomically by
   Turbo Stream from both POST upload and Mercure terminal events. Wrapped in
   a turbo-frame so frame.reload() (driven by wizard-step0#onMessage) can pull
   a fresh snapshot when extraction finishes for one of the session documents. #}
<turbo-frame id="step0-sidecard"
             data-controller="poll-frame"
             data-poll-frame-pending-value="{{ documents is not empty and not all_terminal ? 'true' : 'false' }}"
             data-poll-frame-interval-ms-value="3000">
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-soft overflow-hidden">
        <header class="px-5 py-4 border-b border-slate-100 dark:border-slate-800 flex items-center gap-2">
            <span class="size-2 rounded-full {% if documents|length and not all_terminal %}bg-blue-500 animate-pulse{% else %}bg-slate-300{% endif %}"></span>
            <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">{{ 'wizard.step0.detected_data.title'|trans }}</h3>
        </header>

        {% if documents is empty %}
            <div class="px-5 py-6 text-sm text-slate-500 dark:text-slate-400">
                {{ 'wizard.step0.detected_data.empty'|trans }}
            </div>
        {% else %}
            <div class="px-5 py-4 space-y-5 text-sm">
                {% set sections = [
                    { key: 'creditor', accent: 'blue', dto: creditor_preview },
                    { key: 'debtor',   accent: 'orange', dto: debtor_preview },
                    { key: 'claim',    accent: 'green', dto: claim_preview },
                ] %}
                {% for section in sections %}
                    {% set dto = section.dto %}
                    {% set has_data = dto.autoFilled is defined and dto.autoFilled|length > 0 %}
                    <div>
                        <div class="text-[10px] font-bold uppercase tracking-wide
                            {% if section.accent == 'blue' %}text-blue-600 dark:text-blue-400
                            {% elseif section.accent == 'orange' %}text-orange-600 dark:text-orange-400
                            {% else %}text-emerald-600 dark:text-emerald-400{% endif %} mb-2">
                            {{ ('wizard.step0.detected_data.' ~ section.key)|trans }}
                        </div>
                        {% if not has_data %}
                            <p class="text-xs text-slate-400 dark:text-slate-500 italic">—</p>
                        {% else %}
                            <dl class="space-y-1.5">
                                {% for field in dto.autoFilled %}
                                    {% set field_value = attribute(dto, field) %}
                                    {% if field_value is not null %}
                                        <div class="flex justify-between gap-3">
                                            <dt class="text-slate-500 dark:text-slate-400 truncate">{{ ('wizard.step0.detected_data.field.' ~ field)|trans }}</dt>
                                            <dd class="font-medium text-slate-900 dark:text-slate-100 text-right truncate ml-2">
                                                {# GDPR art. 5(1)(c) — minimise CNP/IBAN exposure in HTML body, server access
                                                   logs, browser dev tools and Turbo response cache. The unmasked value stays
                                                   in the session-bound DTO that will pre-populate Step 1+ forms; only the
                                                   render surface is masked. #}
                                                {% if field == 'personalId' %}
                                                    {{ field_value|mask_cnp }}
                                                {% elseif field == 'iban' %}
                                                    {{ field_value|mask_iban }}
                                                {% elseif field_value is iterable %}
                                                    {{ field_value|json_encode }}
                                                {% elseif field_value.value is defined %}
                                                    {{ field_value.value }}
                                                {% elseif field_value.format is defined %}
                                                    {{ field_value|date('d.m.Y') }}
                                                {% else %}
                                                    {{ field_value }}
                                                {% endif %}
                                            </dd>
                                        </div>
                                    {% endif %}
                                {% endfor %}
                            </dl>
                        {% endif %}
                    </div>
                    {% if not loop.last %}<hr class="border-slate-100 dark:border-slate-800">{% endif %}
                {% endfor %}
            </div>
        {% endif %}
    </div>
</turbo-frame>
