{# Pas 3.0 aggregated "Date detectate" sidecard — re-rendered atomically by
   Turbo Stream from both POST upload and Mercure terminal events. Wrapped in
   a turbo-frame so frame.reload() (driven by wizard-step0#onMessage) can pull
   a fresh snapshot when extraction finishes for one of the session documents. #}
<turbo-frame id="step0-sidecard"
             data-controller="poll-frame"
             data-poll-frame-pending-value="{{ documents is not empty and not all_terminal ? 'true' : 'false' }}"
             data-poll-frame-interval-ms-value="3000">
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-soft overflow-hidden">
        <header class="px-5 py-4 border-b border-slate-100 dark:border-slate-800 flex items-center gap-2">
            <span class="size-2 rounded-full {% if documents|length and not all_terminal %}bg-blue-500 animate-pulse{% else %}bg-slate-300{% endif %}"></span>
            <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">{{ 'wizard.step0.detected_data.title'|trans }}</h3>
        </header>

        {% if documents is empty %}
            <div class="px-5 py-6 text-sm text-slate-500 dark:text-slate-400">
                {{ 'wizard.step0.detected_data.empty'|trans }}
            </div>
        {% else %}
            <div class="px-5 py-4 space-y-5 text-sm">
                {# Expected field counts per section — used to compute the coverage
                   percentage shown next to each section title. These match the
                   number of prefillable fields each wizard DTO exposes
                   (Step1CreditorData / Step2DebtorEntry / Step3ClaimData), so the
                   percentage answers "how many of the prefillable wizard inputs did
                   we manage to extract", which is what the lawyer actually cares
                   about (not the average confidence of the few fields the parser
                   happened to pick up). Keep in lockstep with those DTOs: creditor
                   adds bankName; debtor adds addressCounty/addressLocality; claim
                   adds invoice/contract/penalty metadata. #}
                {% set sections = [
                    { key: 'creditor', accent: 'blue',  dto: creditor_preview, expected: 11 },
                    { key: 'debtor',   accent: 'orange', dto: debtor_preview,  expected: 12 },
                    { key: 'claim',    accent: 'green',  dto: claim_preview,   expected: 12 },
                ] %}
                {% for section in sections %}
                    {% set dto = section.dto %}
                    {% set filled_count = dto.autoFilled is defined ? dto.autoFilled|length : 0 %}
                    {% set has_data = filled_count > 0 %}
                    {# min(100) guards against future field additions outrunning the
                       expected count before this triple is bumped. #}
                    {% set coverage_pct = min([(filled_count / section.expected * 100)|round, 100]) %}
                    <div>
                        <div class="flex items-center justify-between mb-2">
                            <div class="text-[10px] font-bold uppercase tracking-wide
                                {% if section.accent == 'blue' %}text-blue-600 dark:text-blue-400
                                {% elseif section.accent == 'orange' %}text-orange-600 dark:text-orange-400
                                {% else %}text-emerald-600 dark:text-emerald-400{% endif %}">
                                {{ ('wizard.step0.detected_data.' ~ section.key)|trans }}
                            </div>
                            <span class="text-[10px] font-semibold tabular-nums
                                {% if coverage_pct == 0 %}text-slate-400 dark:text-slate-500
                                {% elseif coverage_pct < 40 %}text-amber-600 dark:text-amber-400
                                {% elseif coverage_pct < 70 %}text-blue-600 dark:text-blue-400
                                {% else %}text-emerald-600 dark:text-emerald-400{% endif %}">
                                {{ filled_count }}/{{ section.expected }} · {{ coverage_pct }}%
                            </span>
                        </div>
                        {# With several invoices the claim is their sum, not the one
                           invoice the aggregation happened to keep. Showing that
                           figure alone reads as if the others had been missed. #}
                        {% set positions = claim_positions_preview|default(null) %}
                        {% if section.key == 'claim' and positions %}
                            <div class="mb-2 rounded-lg bg-emerald-50 dark:bg-emerald-950/30 px-2.5 py-2">
                                <div class="flex justify-between gap-3">
                                    <span class="text-slate-600 dark:text-slate-300">{{ 'wizard.step0.detected_data.positions_total'|trans({ '%count%': positions.count }) }}</span>
                                    <span class="font-semibold text-slate-900 dark:text-slate-100 tabular-nums">{{ positions.principal|number_format(2, ',', '.') }} {{ positions.currency }}</span>
                                </div>
                                {% if positions.earliestDueDate %}
                                    <div class="flex justify-between gap-3 mt-0.5">
                                        <span class="text-slate-500 dark:text-slate-400">{{ 'wizard.step0.detected_data.earliest_due_date'|trans }}</span>
                                        <span class="text-slate-700 dark:text-slate-200 tabular-nums">{{ positions.earliestDueDate|date('d.m.Y') }}</span>
                                    </div>
                                {% endif %}
                            </div>
                        {% endif %}
                        {# When the total banner is shown, the per-invoice figures
                           (sum, due date, invoice number/date) belong to one
                           invoice and contradict it; the table on step 3 carries
                           each one. Keep only the fields that describe the claim
                           as a whole (currency, basis, description). #}
                        {% set per_invoice_fields = ['amount', 'dueDate', 'invoiceNumber', 'invoiceDate'] %}
                        {% if not has_data %}
                            <p class="text-xs text-slate-400 dark:text-slate-500 italic">—</p>
                        {% else %}
                            <dl class="space-y-1.5">
                                {% for field in dto.autoFilled %}
                                    {% set field_value = attribute(dto, field) %}
                                    {% if field_value is not null and not (section.key == 'claim' and positions and field in per_invoice_fields) %}
                                        <div class="flex justify-between gap-3">
                                            <dt class="text-slate-500 dark:text-slate-400 truncate">{{ ('wizard.step0.detected_data.field.' ~ field)|trans }}</dt>
                                            <dd class="font-medium text-slate-900 dark:text-slate-100 text-right truncate ml-2">
                                                {# GDPR art. 5(1)(c) — minimise CNP/IBAN exposure in HTML body, server access
                                                   logs, browser dev tools and Turbo response cache. The unmasked value stays
                                                   in the session-bound DTO that will pre-populate Step 1+ forms; only the
                                                   render surface is masked. #}
                                                {% if field == 'personalId' %}
                                                    {{ field_value|mask_cnp }}
                                                {% elseif field == 'iban' %}
                                                    {{ field_value|mask_iban }}
                                                {% elseif field_value is iterable %}
                                                    {{ field_value|json_encode }}
                                                {% elseif field_value.value is defined %}
                                                    {{ field_value.value }}
                                                {% elseif field_value.format is defined %}
                                                    {{ field_value|date('d.m.Y') }}
                                                {% else %}
                                                    {{ field_value }}
                                                {% endif %}
                                            </dd>
                                        </div>
                                    {% endif %}
                                {% endfor %}
                            </dl>
                        {% endif %}
                        {# Confidence/coverage progress bar — gradient width proportional to coverage_pct,
                           color tier matches the badge in the section header (slate/amber/blue/emerald). #}
                        <div class="mt-2 flex items-center gap-1 text-[11px]" aria-label="{{ 'wizard.step0.detected_data.confidence_label'|trans }}: {{ coverage_pct }}%">
                            <span class="inline-block h-1 rounded-full bg-gradient-to-r
                                {% if coverage_pct < 40 %}from-amber-400 to-amber-600
                                {% elseif coverage_pct < 70 %}from-blue-400 to-blue-600
                                {% else %}from-emerald-400 to-emerald-600{% endif %}"
                                style="width: {{ (coverage_pct * 48 / 100)|round }}px;" aria-hidden="true"></span>
                            <span class="font-bold tabular-nums
                                {% if coverage_pct == 0 %}text-slate-400 dark:text-slate-500
                                {% elseif coverage_pct < 40 %}text-amber-600 dark:text-amber-400
                                {% elseif coverage_pct < 70 %}text-blue-600 dark:text-blue-400
                                {% else %}text-emerald-600 dark:text-emerald-400{% endif %}">{{ coverage_pct }}%</span>
                        </div>
                    </div>
                    {% if not loop.last %}<hr class="border-slate-100 dark:border-slate-800">{% endif %}
                {% endfor %}
            </div>
        {% endif %}
    </div>

    {# The divergences, as soon as they exist. Read only here: the remaining
       documents may still be processing, so the set is not final, and the value
       is settled on the step that owns the field. What it buys is the lawyer
       learning that two files describe the party differently before they have
       filled three steps on one of them. #}
    <div class="mt-4">
        {{ include('case/_prefill_conflicts.html.twig', { conflicts_readonly: true }) }}
    </div>
</turbo-frame>
