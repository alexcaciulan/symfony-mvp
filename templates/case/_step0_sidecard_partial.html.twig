{# Aggregated "Date detectate" sidecard: re-rendered atomically by
   Turbo Stream from both POST upload and Mercure terminal events. Wrapped in
   a turbo-frame so frame.reload() (driven by wizard-step0#onMessage) can pull
   a fresh snapshot when extraction finishes for one of the session documents. #}
<turbo-frame id="step0-sidecard"
             data-controller="poll-frame"
             data-poll-frame-pending-value="{{ documents is not empty and not all_terminal ? 'true' : 'false' }}"
             data-poll-frame-interval-ms-value="3000">
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-soft overflow-hidden">
        <header class="px-5 py-4 border-b border-slate-100 dark:border-slate-800 flex items-center gap-2">
            <span class="size-2 rounded-full {% if documents|length and not all_terminal %}bg-blue-500 animate-pulse{% else %}bg-slate-300{% endif %}"></span>
            <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">{{ 'wizard.step0.detected_data.title'|trans }}</h3>
        </header>

        {% if documents is empty %}
            <div class="px-5 py-6 text-sm text-slate-500 dark:text-slate-400">
                {{ 'wizard.step0.detected_data.empty'|trans }}
            </div>
        {% else %}
            <div class="px-5 py-4 space-y-5 text-sm">
                {# Sections, rows and counts come from DetectedDataPreviewBuilder:
                   the fraction counts only the fields this case needs from the
                   section, so it can be checked against the rows below it. Until
                   every document is done the set is not final and no count is
                   shown. #}
                {% set accents = {
                    creditor: 'text-blue-600 dark:text-blue-400',
                    debtor: 'text-orange-600 dark:text-orange-400',
                    claim: 'text-emerald-600 dark:text-emerald-400',
                } %}
                {% for section in detected_sections %}
                    {% set pct = section.percent %}
                    {% set complete = section.filled == section.required %}
                    <div data-testid="detected-section-{{ section.key }}">
                        <div class="flex items-center justify-between gap-3 mb-2">
                            <div class="text-[10px] font-bold uppercase tracking-wide {{ accents[section.key] }}">
                                {{ ('wizard.step0.detected_data.' ~ section.key)|trans }}
                            </div>
                            {% if not all_terminal %}
                                <span class="text-[10px] font-semibold text-slate-400 dark:text-slate-500">{{ 'wizard.step0.detected_data.processing'|trans }}</span>
                            {% elseif section.choiceRequired %}
                                <span class="text-[10px] font-semibold text-amber-700 dark:text-amber-400">{{ 'wizard.step0.detected_data.choose_debtor'|trans }}</span>
                            {% else %}
                                <span class="text-[10px] font-semibold tabular-nums {{ complete ? 'text-emerald-600 dark:text-emerald-400' : 'text-amber-700 dark:text-amber-400' }}"
                                      title="{{ 'wizard.step0.detected_data.completeness_hint'|trans }}"
                                      data-testid="detected-completeness">
                                    {{ 'wizard.step0.detected_data.completeness'|trans({'%filled%': section.filled, '%required%': section.required, '%percent%': pct}) }}
                                </span>
                            {% endif %}
                        </div>
                        {# With several invoices the claim is their sum, not the one
                           invoice the aggregation happened to keep. #}
                        {% set positions = claim_positions_preview|default(null) %}
                        {% if section.key == 'claim' and positions %}
                            <div class="mb-2 rounded-lg bg-emerald-50 dark:bg-emerald-950/30 px-2.5 py-2">
                                <div class="flex justify-between gap-3">
                                    <span class="text-slate-600 dark:text-slate-300">{{ 'wizard.step0.detected_data.positions_total'|trans({ '%count%': positions.count }) }}</span>
                                    <span class="font-semibold text-slate-900 dark:text-slate-100 tabular-nums">{{ positions.principal|number_format(2, ',', '.') }} {{ positions.currency }}</span>
                                </div>
                                {% if positions.earliestDueDate %}
                                    <div class="flex justify-between gap-3 mt-0.5">
                                        <span class="text-slate-500 dark:text-slate-400">{{ 'wizard.step0.detected_data.earliest_due_date'|trans }}</span>
                                        <span class="text-slate-700 dark:text-slate-200 tabular-nums">{{ positions.earliestDueDate|date('d.m.Y') }}</span>
                                    </div>
                                {% endif %}
                            </div>
                        {% endif %}
                        {% if section.hasData %}
                            {# Label above value: long names, addresses and contract
                               references wrap instead of truncating either side. #}
                            <dl class="space-y-2">
                                {% for row in section.rows %}
                                    <div data-testid="detected-row" data-field="{{ row.field }}">
                                        <dt class="text-xs text-slate-500 dark:text-slate-400">{{ ('wizard.step0.detected_data.field.' ~ row.field)|trans }}</dt>
                                        <dd class="font-medium text-slate-900 dark:text-slate-100 break-words line-clamp-3" title="{{ row.format == 'iban' ? '' : (row.format == 'trans' ? row.value|trans : row.value) }}">
                                            {# GDPR art. 5(1)(c): keep the IBAN out of the HTML body,
                                               access logs and Turbo cache; the unmasked value stays in
                                               the session DTO that prefills the next steps. #}
                                            {% if row.format == 'iban' %}
                                                {{ row.value|mask_iban }}
                                            {% elseif row.format == 'trans' %}
                                                {{ row.value|trans }}
                                            {% else %}
                                                {{ row.value }}
                                            {% endif %}
                                            {% if row.inConflict %}
                                                <span class="ml-1 inline-flex items-center rounded-full bg-amber-100 dark:bg-amber-950/50 px-1.5 py-0.5 text-[10px] font-semibold text-amber-800 dark:text-amber-300 whitespace-nowrap" data-testid="detected-row-conflict">{{ 'wizard.step0.detected_data.in_conflict'|trans({'%step%': section.step}) }}</span>
                                            {% endif %}
                                        </dd>
                                    </div>
                                {% endfor %}
                            </dl>
                        {% elseif all_terminal and not (section.key == 'claim' and positions) %}
                            <p class="text-xs text-slate-400 dark:text-slate-500 italic">{{ 'wizard.step0.detected_data.none'|trans }}</p>
                        {% endif %}
                        {# A consumer debtor stops the file (see the step 0 notice), so
                           listing what to fill in for it at step 2 would say the opposite. #}
                        {% if all_terminal and section.missing is not empty and not (section.key == 'debtor' and consumer_debtor|default(null) is not null) %}
                            <p class="mt-2 text-xs text-amber-700 dark:text-amber-400" data-testid="detected-missing">
                                {{ 'wizard.step0.detected_data.missing_hint'|trans({
                                    '%step%': section.step,
                                    '%fields%': section.missing|map(f => ('wizard.step0.detected_data.field.' ~ f)|trans)|join(', '),
                                }) }}
                            </p>
                        {% endif %}
                    </div>
                    {% if not loop.last %}<hr class="border-slate-100 dark:border-slate-800">{% endif %}
                {% endfor %}
            </div>
        {% endif %}
    </div>

    {# The divergences, as soon as they exist. Read only here: the remaining
       documents may still be processing, so the set is not final, and the value
       is settled on the step that owns the field. What it buys is the lawyer
       learning that two files describe the party differently before they have
       filled three steps on one of them. #}
    <div class="mt-4">
        {{ include('case/_prefill_conflicts.html.twig', { conflicts_readonly: true, conflicts_title_key: 'wizard.conflict.title_step0', conflicts_intro_key: null }) }}
    </div>
</turbo-frame>
