{% extends 'base.html.twig' %}

{# Pas 4.0.1 — Shell foundation. Hero / KPI / Pipeline / tab contents populate in 4.0.2 → 4.0.7. #}

{% block title %}{{ 'case_overview.title'|trans({'%reference%': case.caseNumber}) }}{% endblock %}

{% from 'case/overview/_icons.html.twig' import icon_chevron_right %}

{% block breadcrumb %}
  <li class="inline-flex items-center">
    <a href="{{ path('dashboard_cases') }}" class="text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-300">{{ 'case_overview.breadcrumb.cases'|trans }}</a>
    <span class="shrink-0 mx-1.5 text-slate-300 dark:text-slate-700">{{ icon_chevron_right('size-3') }}</span>
  </li>
  <li class="inline-flex items-center font-mono font-medium text-slate-700 dark:text-slate-300 truncate" aria-current="page">{{ case.caseNumber }}</li>
{% endblock %}

{% block body %}
  {% set show_c4_modal = app.flashes('show_c4_modal')|length > 0 %}
  {% if show_c4_modal %}
    <div data-controller="auto-modal"
         data-auto-modal-target-id-value="hs-modal-c4-summons"
         class="hidden"
         aria-hidden="true"></div>
  {% endif %}

  {{ include('case/overview/_summons_communication_alert.html.twig') }}
  {{ include('case/overview/_ruling_communication_date_alert.html.twig') }}
  {{ include('case/overview/_hero.html.twig') }}
  {{ include('case/overview/_kpi_grid.html.twig') }}
  {{ include('case/overview/_pipeline.html.twig') }}
  {{ include('case/overview/_tabs_nav.html.twig') }}

  {# Tabs panels — populate la 4.0.3 (Detalii) / 4.0.4 (Documente) / 4.0.5 (Termene) / 4.0.6 (Portal) / 4.0.7 (Audit + Modale).
     Default active panel: detalii (no `hidden`). Preline `data-hs-tab` din _tabs_nav.html.twig comută clasele. #}
  <div>
    <div id="panel-detalii" role="tabpanel" aria-labelledby="tab-detalii">
      {{ include('case/overview/_tab_detalii.html.twig') }}
    </div>
    <div id="panel-documente" class="hidden" role="tabpanel" aria-labelledby="tab-documente">
      {{ include('case/overview/_tab_documente.html.twig') }}
    </div>
    <div id="panel-termene" class="hidden" role="tabpanel" aria-labelledby="tab-termene">
      {{ include('case/overview/_tab_termene.html.twig') }}
    </div>
    <div id="panel-portal" class="hidden" role="tabpanel" aria-labelledby="tab-portal">
      {{ include('case/overview/_tab_portal.html.twig') }}
    </div>
    <div id="panel-audit" class="hidden" role="tabpanel" aria-labelledby="tab-audit">
      <div class="rounded-xl border border-dashed border-slate-200 dark:border-slate-800 p-8 text-center text-sm text-slate-400 dark:text-slate-500">
        {{ 'case_overview.placeholder.tab.audit'|trans }}
      </div>
    </div>
  </div>

  {# Pas 4.0.7 — Preline modals rendered once per request, triggered via data-hs-overlay from hero CTA,
     hero dropdown „Închide dosar", ZIP package card, Cerere OP „Generează acum", Recommended Actions. #}
  {{ include('case/overview/_modal_close_case.html.twig') }}
  {{ include('case/overview/_modal_generate_op.html.twig') }}
  {{ include('case/overview/_modal_c4_summons_communication.html.twig') }}
  {{ include('case/overview/_modal_add_deadline.html.twig') }}
  {{ include('case/overview/_modal_set_ruling_communication_date.html.twig') }}
{% endblock %}
