{% extends 'base.html.twig' %}

{# Pas 4.0.1 — Shell foundation. Hero / KPI / Pipeline / tab contents populate in 4.0.2 → 4.0.7. #}

{% block title %}{{ 'case_overview.title'|trans({'%reference%': case.caseNumber}) }}{% endblock %}

{% from 'case/overview/_icons.html.twig' import icon_chevron_right %}

{% block breadcrumb %}
  <li class="inline-flex items-center">
    <a href="{{ path('app_cases') }}" class="text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-300">{{ 'case_overview.breadcrumb.cases'|trans }}</a>
    <span class="shrink-0 mx-1.5 text-slate-300 dark:text-slate-700">{{ icon_chevron_right('size-3') }}</span>
  </li>
  <li class="inline-flex items-center font-mono font-medium text-slate-700 dark:text-slate-300 truncate" aria-current="page">{{ case.caseNumber }}</li>
{% endblock %}

{% block body %}
  {% set show_c4_modal = app.flashes('show_c4_modal')|length > 0 %}
  {% if show_c4_modal %}
    <div data-controller="auto-modal"
         data-auto-modal-target-id-value="hs-modal-c4-summons"
         class="hidden"
         aria-hidden="true"></div>
  {% endif %}

  <div id="summons-communication-alert">{{ include('case/overview/_summons_communication_alert.html.twig') }}</div>
  <div id="ruling-communication-alert">{{ include('case/overview/_ruling_communication_date_alert.html.twig') }}</div>
  <div id="annulment-ruling-communication-alert">{{ include('case/overview/_annulment_ruling_communication_date_alert.html.twig') }}</div>
  <div id="portal-ruling-proposal">{{ include('case/overview/_portal_ruling_proposal.html.twig') }}</div>
  {{ include('case/overview/_hero.html.twig') }}
  {{ include('case/overview/_kpi_grid.html.twig') }}
  {{ include('case/overview/_pipeline.html.twig') }}
  {# Server-side active tab from `?tab=`, so portal actions (which redirect back)
     keep the user on the tab they acted from instead of resetting to Detalii. #}
  {% set active_tab = app.request.query.get('tab')|default('detalii') %}
  {% if active_tab not in ['detalii', 'documente', 'termene', 'portal', 'audit'] %}
    {% set active_tab = 'detalii' %}
  {% endif %}

  {{ include('case/overview/_tabs_nav.html.twig', { active_tab: active_tab }) }}

  {# Tabs panels. Active panel rendered without `hidden`; Preline `data-hs-tab`
     toggles `hidden` on click. Initial active state is driven server-side. #}
  <div>
    <div id="panel-detalii" class="{{ active_tab == 'detalii' ? '' : 'hidden' }}" role="tabpanel" aria-labelledby="tab-detalii">
      {{ include('case/overview/_tab_detalii.html.twig') }}
    </div>
    <div id="panel-documente" class="{{ active_tab == 'documente' ? '' : 'hidden' }}" role="tabpanel" aria-labelledby="tab-documente">
      {{ include('case/overview/_tab_documente.html.twig') }}
    </div>
    <div id="panel-termene" class="{{ active_tab == 'termene' ? '' : 'hidden' }}" role="tabpanel" aria-labelledby="tab-termene">
      {{ include('case/overview/_tab_termene.html.twig') }}
    </div>
    <div id="panel-portal" class="{{ active_tab == 'portal' ? '' : 'hidden' }}" role="tabpanel" aria-labelledby="tab-portal">
      {{ include('case/overview/_tab_portal.html.twig') }}
    </div>
    <div id="panel-audit" class="{{ active_tab == 'audit' ? '' : 'hidden' }}" role="tabpanel" aria-labelledby="tab-audit">
      {{ include('case/overview/_tab_audit.html.twig') }}
    </div>
  </div>

  {# Preline modals rendered once per request, triggered via data-hs-overlay from hero CTA,
     hero dropdown, ZIP package card, Cerere OP „Generează acum", Recommended Actions, and
     the Pas 7.2 status-driven transition CTAs. #}
  {{ include('case/overview/_modal_close_case.html.twig') }}
  {{ include('case/overview/_modal_executare.html.twig') }}
  {{ include('case/overview/_modal_generate_op.html.twig') }}
  {{ include('case/overview/_modal_c4_summons_communication.html.twig') }}
  {{ include('case/overview/_modal_add_deadline.html.twig') }}
  {{ include('case/overview/_modal_edit_deadline.html.twig') }}
  {{ include('case/overview/_modal_upload_document.html.twig') }}
  {{ include('case/overview/_modal_stamp_duty_proof.html.twig') }}
  {{ include('case/overview/_modal_stamp_duty_defer.html.twig') }}
  {{ include('case/overview/_modal_stamp_duty_court_notice.html.twig') }}
  {{ include('case/overview/_modal_set_ruling_communication_date.html.twig') }}
  {{ include('case/overview/_modal_set_annulment_ruling_communication_date.html.twig') }}
  {{ include('case/overview/_modal_set_summons_communication_date.html.twig') }}
  {{ include('case/overview/_modal_register_case_number.html.twig') }}
  {{ include('case/overview/_modal_issue_ruling.html.twig') }}
  {{ include('case/overview/_modal_reject.html.twig') }}
  {% if case.status.value == 'IN_ANULARE' or case.status.value == 'EXECUTARE' %}
    {{ include('case/overview/_modal_annulment_rejected.html.twig') }}
  {% endif %}
{% endblock %}
