{# The status panel: one title, a short explanation, one main action and at most two
   secondary ones, and a critical note only when it changes the lawyer's decision
   now. The state (code, tone, keys, actions) comes from FilingPanelStateResolver.
   An accepted email is "sent", never filed, registered or received by the court;
   a detected signature is never a valid or qualified one; the filing date stays
   the lawyer's declaration. Codes and attempts live in "Detalii tehnice". #}
{% from 'case/overview/_icons.html.twig' import icon_check, icon_warning, icon_clock, icon_document, icon_refresh, icon_edit %}
{% import 'case/overview/_power_of_attorney_macros.html.twig' as poa %}
{% set panel = filing_panel %}
{% set submission = filing_submission|default(null) %}
{% set package = filing_package|default(null) %}
{% set is_owner = app.user and app.user.id == case.user.id %}
{% set failure = filing_submission_failure|default(null) %}
{% set petition_left = submission and submission.petitionAccepted %}
{% set tone_box = {
    'red': 'bg-red-50/70 border-red-200 dark:bg-red-950/20 dark:border-red-900/60',
    'amber': 'bg-amber-50/70 border-amber-200 dark:bg-amber-950/20 dark:border-amber-900/60',
}[panel.tone] ?? 'bg-white border-slate-200 dark:bg-slate-900 dark:border-slate-800' %}
{% set tone_icon = {
    'blue': 'bg-blue-50 text-blue-700 dark:bg-blue-950/50 dark:text-blue-300',
    'green': 'bg-emerald-50 text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-300',
    'amber': 'bg-amber-100 text-amber-800 dark:bg-amber-900/50 dark:text-amber-200',
    'red': 'bg-red-100 text-red-700 dark:bg-red-900/50 dark:text-red-200',
}[panel.tone] ?? 'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300' %}
{% set block_actions = ['save_filed_date', 'resume', 'late_ack', 'cc_declare', 'resolve_blocker'] %}
{% set detail = 'mt-2 text-sm text-slate-700 dark:text-slate-200' %}

<section id="depunere-status" class="scroll-mt-24 rounded-2xl border shadow-soft p-6 {{ tone_box }}" data-testid="filing-panel" data-code="{{ panel.code }}" data-tone="{{ panel.tone }}">
    <div class="flex gap-4">
        <span class="shrink-0 inline-flex items-center justify-center size-10 rounded-xl {{ tone_icon }}" aria-hidden="true">
            {% if panel.tone == 'green' %}{{ icon_check('size-5') }}
            {% elseif panel.tone in ['amber', 'red'] %}{{ icon_warning('size-5') }}
            {% elseif panel.code in ['sending', 'sent_no_receipt'] %}{{ icon_clock('size-5') }}
            {% elseif panel.code == 'to_sign' %}{{ icon_edit('size-5') }}
            {% else %}{{ icon_document('size-5') }}{% endif %}
        </span>
        <div class="min-w-0 flex-1">
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white" data-testid="filing-submission-headline">{{ panel.titleKey|trans(panel.titleParams) }}</h2>

            {# The explanation, with the lines the decision depends on in this state. #}
            {% if panel.code == 'undelivered' %}
                <div class="mt-1 space-y-2 text-sm text-slate-700 dark:text-slate-200 max-w-prose" data-testid="filing-submission-undelivered">
                    <p data-testid="filing-panel-explanation">{{ panel.explanationKey|trans(panel.explanationParams) }}</p>
                    {% if failure and failure.address_reported %}
                        <p data-testid="filing-submission-address-reported">{{ (failure.address_report_open ? 'filing.undelivered.address_reported' : 'filing.undelivered.address_report_resolved')|trans }}</p>
                    {% endif %}
                    {% if submission.part(1) and submission.part(1).status.value == 'FAILED_SIZE' %}
                        <p data-testid="filing-submission-size-help">{{ (filing_submission_resplit_done|default(false) ? 'filing.resplit.after_resplit' : (filing_submission_resplittable|default(false) ? 'filing.resplit.proposal' : 'filing.resplit.cannot_help'))|trans }}</p>
                    {% endif %}
                </div>
            {% elseif panel.code == 'late_review' %}
                <p class="mt-1 text-sm text-slate-700 dark:text-slate-200 max-w-prose" data-testid="filing-submission-late-bounce">{{ panel.explanationKey|trans(panel.explanationParams) }}</p>
            {% elseif panel.code == 'receipt_received' %}
                <p class="mt-1 text-sm text-slate-700 dark:text-slate-200 max-w-prose" data-testid="filing-receipt-received">{{ panel.explanationKey|trans(panel.explanationParams) }}</p>
            {% elseif panel.code == 'receipt_manual' %}
                <div class="mt-1 space-y-1 text-sm text-slate-700 dark:text-slate-200 max-w-prose" data-testid="filing-receipt-manual">
                    {% if submission.receiptInboundMail %}
                        <p>{{ 'filing.receipt.manual'|trans({'%date%': submission.receiptInboundMail.receivedAt|date('d.m.Y H:i', 'Europe/Bucharest')}) }}</p>
                    {% endif %}
                    {% if submission.courtReceiptAt and submission.receiptInboundMail and submission.receiptInboundMail.rawMime == 'eml' %}
                        <p data-testid="filing-receipt-manual-date">{{ 'filing.receipt.manual_eml_date'|trans({'%date%': submission.courtReceiptAt|date('d.m.Y H:i', 'Europe/Bucharest')}) }}</p>
                    {% elseif submission.receiptInboundMail and submission.receiptInboundMail.rawMime == 'eml' %}
                        <p data-testid="filing-receipt-manual-no-date">{{ 'filing.receipt.manual_eml_date_ignored'|trans }}</p>
                    {% else %}
                        <p data-testid="filing-receipt-manual-no-date">{{ 'filing.receipt.manual_no_date'|trans }}</p>
                    {% endif %}
                </div>
            {% elseif panel.code == 'receipt_overdue' %}
                <p class="mt-1 text-sm text-slate-700 dark:text-slate-200 max-w-prose" data-testid="filing-receipt-overdue">{{ panel.explanationKey|trans(panel.explanationParams) }}</p>
            {% else %}
                <p class="mt-1 text-sm text-slate-700 dark:text-slate-200 max-w-prose" data-testid="filing-panel-explanation">{{ panel.explanationKey|trans(panel.explanationParams) }}</p>
            {% endif %}

            {% if panel.code == 'sending' and submission.deliveryStatus.value == 'PARTIALLY_SENT' %}
                <p class="{{ detail }}" data-testid="filing-submission-annexes-pending">{{ 'filing.status.annexes_in_progress'|trans({'%done%': submission.countAcceptedParts, '%total%': submission.parts|length}) }}</p>
            {% endif %}
            {% if submission and submission.deliveryStatus.value == 'NEEDS_REVIEW' and submission.reviewReason and panel.code in ['review', 'review_after_petition', 'stalled'] %}
                <p class="{{ detail }}" data-testid="filing-submission-review-reason">{{ submission.reviewReason|trans }}</p>
            {% endif %}
            {% if panel.code == 'admin_failed' and filing_admin_override_reason|default(null) %}
                <p class="{{ detail }}" data-testid="filing-admin-override-reason">{{ 'filing.panel.admin_reason'|trans({'%reason%': filing_admin_override_reason}) }}</p>
            {% endif %}

            {% if failure and panel.code not in ['undelivered', 'late_review', 'cancelled', 'uncertain'] %}
                <div data-testid="filing-submission-failure" data-kind="{{ failure.kind }}">
                    {% if failure.next_retry_at %}
                        <p class="{{ detail }}" data-testid="filing-submission-next-retry">{{ 'filing.failure.next_retry'|trans({'%date%': failure.next_retry_at|date('d.m.Y H:i', 'Europe/Bucharest')}) }}</p>
                    {% endif %}
                    {% if failure.kind == 'permanent' %}
                        {# A report naming the mailbox as unknown is about the address, even though only
                           our own server's refusal takes it out of use. #}
                        {% if failure.address_invalidated %}
                            {% set permanent_key = 'filing.failure.address_rejected' %}
                        {% elseif failure.enhanced in ['5.1.1', '5.1.2', '5.1.3', '5.4.4'] %}
                            {% set permanent_key = failure.address_reported ? 'filing.failure.recipient_unknown_reported' : 'filing.failure.recipient_unknown' %}
                        {% else %}
                            {% set permanent_key = 'filing.failure.permanent_other' %}
                        {% endif %}
                        <p class="{{ detail }}" data-testid="filing-submission-address-rejected">{{ permanent_key|trans }}</p>
                    {% endif %}
                    {% if failure.kind == 'size' and not petition_left %}
                        <p class="{{ detail }}" data-testid="filing-submission-size-help">{{ (filing_submission_resplit_done|default(false) ? 'filing.resplit.after_resplit' : (filing_submission_resplittable|default(false) ? 'filing.resplit.proposal' : 'filing.resplit.cannot_help'))|trans }}</p>
                    {% elseif failure.kind == 'size' %}
                        <p class="{{ detail }}" data-testid="filing-submission-size-help">{{ 'filing.resplit.after_petition'|trans }}</p>
                    {% endif %}
                </div>
            {% endif %}

            {% if panel.code == 'stale' and package.staleReason in ['claim_totals', 'interest_date'] %}
                {# Not dismissable: rebuilding does not touch the petition, so its amounts stay as generated. #}
                <p class="{{ detail }} font-semibold" data-testid="filing-package-frozen-petition">{{ 'filing.package.frozen_petition_warning'|trans }}</p>
            {% endif %}

            {% if panel.code == 'send_blocked' and filing_send_verdict|default(null) %}
                <ul class="mt-3 space-y-1 text-sm text-slate-700 dark:text-slate-200 list-disc ps-5" data-testid="filing-send-blockers">
                    {% for blocker in filing_send_verdict.blockers %}
                        <li>{{ blocker|trans }}</li>
                    {% endfor %}
                </ul>
            {% endif %}

            {% if package and panel.code in ['to_sign', 'ready', 'send_blocked', 'stale'] %}
                {% for warning in package.warnings %}
                    <p class="mt-3 flex gap-2 text-sm text-amber-900 dark:text-amber-100" data-testid="filing-package-warning-{{ warning }}">
                        {{ icon_warning('size-4 shrink-0 mt-0.5') }}<span>{{ ('filing.package.warning.' ~ warning)|trans }}</span>
                    </p>
                {% endfor %}
            {% endif %}

            {# Actions that carry a form or a declaration of their own. #}
            {% if panel.primaryAction == 'resolve_blocker' %}
                {% set readiness_blockers = case.status.value == 'CERERE_GENERATA' ? filing_readiness(case).blockers : [] %}
                {% set poa_editable = power_of_attorney_editable(case) and is_granted('CASE_UPLOAD', case) %}
                <div class="mt-4 flex flex-wrap gap-2" data-testid="filing-package-blocker">
                    {% for issue in readiness_blockers %}
                        {% set poa_doc = issue.documentId ? case.documents|filter(d => d.id == issue.documentId)|first : null %}
                        {% if issue.code.value == 'power_of_attorney_date_missing' and poa_doc and poa_editable %}
                            <button type="button" {{ poa.edit_trigger_attrs(case, poa_doc) }}
                                    class="py-2.5 px-4 inline-flex items-center gap-2 rounded-lg bg-lex-navy text-white text-sm font-semibold hover:bg-lex-navy-dark transition shadow-sm">
                                {{ 'case_overview.modal.generate_op_power_of_attorney_cta_complete'|trans }}
                            </button>
                        {% elseif issue.code.value in ['power_of_attorney_missing', 'claim_document_missing'] and not case.fullPaymentDate %}
                            <button type="button"
                                    data-hs-overlay="#hs-modal-upload-document"
                                    data-upload-preset-type="{{ {'power_of_attorney_missing': 'imputernicire_avocatiala', 'claim_document_missing': 'factura'}[issue.code.value] }}"
                                    class="py-2.5 px-4 inline-flex items-center gap-2 rounded-lg bg-lex-navy text-white text-sm font-semibold hover:bg-lex-navy-dark transition shadow-sm">
                                {{ ('case_overview.modal.generate_op_' ~ {'power_of_attorney_missing': 'power_of_attorney', 'claim_document_missing': 'claim_document'}[issue.code.value] ~ '_cta_upload')|trans }}
                            </button>
                        {% endif %}
                    {% endfor %}
                </div>
            {% endif %}

            {% if panel.primaryAction == 'save_filed_date' %}
                {% set proposal = filing_receipt_proposal|default(null) %}
                <form method="post" action="{{ path('case_filing_submission_filed_date', {id: case.id}) }}" class="mt-4" data-turbo-frame="_top" data-testid="filing-filed-date-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('filing_filed_date_' ~ case.id) }}">
                    <label class="block text-sm font-medium text-slate-800 dark:text-slate-100" for="filing-filed-at">{{ 'filing.panel.filed_date.label'|trans }}</label>
                    {% if proposal %}
                        <p class="mt-0.5 text-xs text-amber-800 dark:text-amber-200" data-testid="filing-filed-date-proposal">{{ 'filing.receipt.proposal_label'|trans({'%date%': proposal|date('d.m.Y')}) }}</p>
                    {% endif %}
                    <div class="mt-1.5 flex flex-wrap items-center gap-2">
                        <input id="filing-filed-at" type="date" name="filed_at" required max="{{ 'now'|date('Y-m-d', 'Europe/Bucharest') }}" value="{{ case.filedAt ? case.filedAt|date('Y-m-d') : (proposal ? proposal|date('Y-m-d') : '') }}"
                               class="py-2 px-3 text-sm rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100">
                        <button type="submit" data-testid="filing-filed-date-submit" class="py-2.5 px-4 inline-flex items-center gap-2 rounded-lg bg-lex-navy text-white text-sm font-semibold hover:bg-lex-navy-dark transition shadow-sm">{{ 'filing.panel.action.save_filed_date'|trans }}</button>
                    </div>
                    <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400">{{ 'filing.status.set_date.help'|trans }}</p>
                </form>
            {% endif %}

            {% if panel.primaryAction == 'resume' %}
                <form method="post" action="{{ path('case_filing_submission_resume', {id: case.id, submissionId: submission.id}) }}" class="mt-4 space-y-2" data-turbo-frame="_top" data-controller="require-checks" data-testid="filing-submission-resume-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('filing_resume_' ~ submission.id) }}">
                    <label class="flex items-start gap-2 text-sm text-slate-700 dark:text-slate-200">
                        <input type="checkbox" name="confirm_resume_remaining" value="1" required class="mt-0.5" data-require-checks-target="check" data-action="require-checks#refresh">
                        <span>{{ 'filing.resume.confirm'|trans }}</span>
                    </label>
                    <button type="submit" data-require-checks-target="submit" data-testid="filing-submission-resume" class="py-2.5 px-4 inline-flex items-center gap-2 rounded-lg bg-lex-navy text-white text-sm font-semibold hover:bg-lex-navy-dark transition shadow-sm">{{ 'filing.resume.cta'|trans }}</button>
                </form>
            {% endif %}

            {% if panel.primaryAction == 'late_ack' %}
                {# The statement is the lawyer's, ticked by hand right above the button; its text stays as validated. #}
                <form method="post" action="{{ path('case_filing_submission_late_bounce_ack', {id: case.id, submissionId: submission.id}) }}" class="mt-4 space-y-2" data-turbo-frame="_top" data-controller="require-checks" data-testid="filing-late-bounce-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('filing_late_bounce_' ~ submission.id) }}">
                    <label class="flex items-start gap-2 text-sm text-slate-700 dark:text-slate-200">
                        <input type="checkbox" name="confirm_late_bounce" value="1" required class="mt-0.5" data-require-checks-target="check" data-action="require-checks#refresh" data-testid="filing-late-bounce-statement">
                        <span>{{ 'filing.undelivered.ack_statement'|trans }}</span>
                    </label>
                    <button type="submit" data-require-checks-target="submit" data-testid="filing-submission-late-bounce-ack" class="py-2.5 px-4 inline-flex items-center gap-2 rounded-lg bg-lex-navy text-white text-sm font-semibold hover:bg-lex-navy-dark transition shadow-sm">{{ 'filing.undelivered.ack_cta'|trans }}</button>
                </form>
            {% endif %}

            {% if panel.primaryAction == 'cc_declare' %}
                {% set uncertain_part = filing_submission_uncertain_part %}
                <div class="mt-4 grid gap-3 sm:grid-cols-2" data-testid="filing-submission-uncertain-actions">
                    <p class="sm:col-span-2 text-sm text-slate-700 dark:text-slate-200" data-testid="filing-submission-uncertain-explain">{{ 'filing.uncertain.explain'|trans }}</p>
                    <form method="post" action="{{ path('case_filing_submission_cc_received', {id: case.id, submissionId: submission.id, sequence: uncertain_part.sequence}) }}" data-turbo-frame="_top" data-controller="require-checks"
                          class="flex flex-col gap-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-4" data-testid="filing-cc-received-card">
                        <input type="hidden" name="_token" value="{{ csrf_token('filing_uncertain_' ~ submission.id ~ '_' ~ uncertain_part.sequence) }}">
                        <p class="text-sm font-semibold text-slate-900 dark:text-slate-100">{{ 'filing.uncertain.received_cta'|trans }}</p>
                        <p class="text-sm text-slate-600 dark:text-slate-300">{{ (uncertain_part.sequence == 1 ? 'filing.panel.uncertain.received_effect_petition' : 'filing.panel.uncertain.received_effect_annex')|trans }}</p>
                        <label class="flex items-start gap-2 text-sm text-slate-700 dark:text-slate-200">
                            <input type="checkbox" name="confirm_cc_received" value="1" required class="mt-0.5" data-require-checks-target="check" data-action="require-checks#refresh">
                            <span>{{ (uncertain_part.sequence == 1 ? 'filing.uncertain.confirm.cc_received_petition' : 'filing.uncertain.confirm.cc_received')|trans }}</span>
                        </label>
                        <button type="submit" data-require-checks-target="submit" data-testid="filing-submission-cc-received" class="mt-auto self-start py-2 px-3.5 rounded-lg bg-lex-navy text-white text-sm font-semibold hover:bg-lex-navy-dark transition">{{ 'filing.panel.uncertain.record'|trans }}</button>
                    </form>
                    <form method="post" action="{{ path('case_filing_submission_cc_not_received', {id: case.id, submissionId: submission.id, sequence: uncertain_part.sequence}) }}" data-turbo-frame="_top" data-controller="require-checks"
                          class="flex flex-col gap-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-4" data-testid="filing-cc-not-received-card">
                        <input type="hidden" name="_token" value="{{ csrf_token('filing_uncertain_' ~ submission.id ~ '_' ~ uncertain_part.sequence) }}">
                        <p class="text-sm font-semibold text-slate-900 dark:text-slate-100">{{ 'filing.uncertain.not_received_cta'|trans }}</p>
                        <p class="text-sm text-slate-600 dark:text-slate-300">{{ (uncertain_part.sequence == 1 ? 'filing.panel.uncertain.not_received_effect_petition' : 'filing.panel.uncertain.not_received_effect_annex')|trans }}</p>
                        <label class="flex items-start gap-2 text-sm text-slate-700 dark:text-slate-200">
                            <input type="checkbox" name="confirm_cc_not_received" value="1" required class="mt-0.5" data-require-checks-target="check" data-action="require-checks#refresh">
                            <span>{{ 'filing.uncertain.confirm.cc_not_received'|trans }}</span>
                        </label>
                        <button type="submit" data-require-checks-target="submit" data-testid="filing-submission-cc-not-received" class="mt-auto self-start py-2 px-3.5 rounded-lg bg-lex-navy text-white text-sm font-semibold hover:bg-lex-navy-dark transition">{{ 'filing.panel.uncertain.record'|trans }}</button>
                    </form>
                </div>
            {% endif %}

            {% set button_primary = panel.primaryAction and panel.primaryAction not in block_actions %}
            {% if button_primary or panel.secondaryActions is not empty %}
                <div class="mt-4 flex flex-wrap items-center gap-2" data-testid="filing-panel-actions">
                    {% if button_primary %}
                        {{ include('case/filing/_panel_action.html.twig', {action: panel.primaryAction, primary: true}) }}
                    {% endif %}
                    {% for action in panel.secondaryActions %}
                        {{ include('case/filing/_panel_action.html.twig', {action: action, primary: false}) }}
                    {% endfor %}
                </div>
            {% endif %}

            {% if panel.code == 'filed' and is_owner and filing_can_set_filed_date|default(false) %}
                <details class="mt-4 text-sm">
                    <summary class="cursor-pointer font-medium text-slate-700 dark:text-slate-200">{{ 'filing.panel.filed_date.change'|trans }}</summary>
                    <form method="post" action="{{ path('case_filing_submission_filed_date', {id: case.id}) }}" class="mt-2 flex flex-wrap items-center gap-2" data-turbo-frame="_top" data-testid="filing-filed-date-form">
                        <input type="hidden" name="_token" value="{{ csrf_token('filing_filed_date_' ~ case.id) }}">
                        <label class="sr-only" for="filing-filed-at">{{ 'filing.panel.filed_date.label'|trans }}</label>
                        <input id="filing-filed-at" type="date" name="filed_at" required max="{{ 'now'|date('Y-m-d', 'Europe/Bucharest') }}" value="{{ case.filedAt|date('Y-m-d') }}"
                               class="py-2 px-3 text-sm rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100">
                        <button type="submit" class="py-2 px-3.5 rounded-lg border border-slate-300 dark:border-slate-700 text-sm font-semibold text-slate-800 dark:text-slate-100 hover:bg-slate-50 dark:hover:bg-slate-800 transition">{{ 'filing.panel.action.save_filed_date'|trans }}</button>
                    </form>
                </details>
            {% endif %}

            {% if panel.criticalNoteKey %}
                {% set critical_red = panel.criticalNoteKey in ['filing.panel.legal.deadline_short', 'filing.close.warning'] %}
                {% set critical_testid = {
                    'filing.panel.legal.deadline_short': 'filing-submission-undelivered-deadline',
                    'filing.close.warning': 'filing-submission-incomplete-warning',
                }[panel.criticalNoteKey] ?? 'filing-submission-deadline-warning' %}
                <p class="mt-4 flex gap-2 rounded-lg border p-3 text-sm {{ critical_red ? 'border-red-300 bg-white text-red-800 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-100' : 'border-amber-300 bg-white text-amber-900 dark:border-amber-900/60 dark:bg-amber-950/30 dark:text-amber-100' }}" data-testid="{{ critical_testid }}">
                    {{ icon_clock('size-4 shrink-0 mt-0.5') }}
                    <span>
                        {{ panel.criticalNoteKey|trans }}
                        {% if panel.criticalNoteKey == 'filing.panel.legal.deadline_short' %}
                            <a href="#filing-legal-notes" class="underline hover:no-underline">{{ 'filing.panel.legal.details_link'|trans }}</a>
                        {% endif %}
                    </span>
                </p>
                {% if panel.code == 'undelivered' and filing_undelivered_deadline_open|default(false) %}
                    <p class="mt-2 text-xs text-slate-600 dark:text-slate-300" data-testid="filing-submission-undelivered-reopened">{{ 'filing.undelivered.deadline_reopened'|trans }}</p>
                {% endif %}
            {% endif %}
        </div>
    </div>
</section>
