{# Confirmation panel for transmitting the signed package to the court, loaded into the
   package card's turbo-frame. It shows what will leave, from where and to which address,
   and asks for statements that are never pre-ticked. The court is the one the platform
   calculated from the case data and the address is the one the lawyer validated: neither
   is presented as the competent court or an official address. Context from
   CaseFilingSubmissionController::confirmContext. #}
{% from 'case/overview/_icons.html.twig' import icon_warning %}

<turbo-frame id="filing-send-panel" class="block mb-3">
    <div class="rounded-lg border border-slate-300 dark:border-slate-700 p-4 text-xs text-slate-700 dark:text-slate-200 space-y-3" data-testid="filing-send-panel">
        <h4 class="text-sm font-semibold text-slate-900 dark:text-slate-100">{{ 'filing.send.title'|trans }}</h4>

        {% if error_key %}
            <div class="rounded-lg bg-red-50 dark:bg-red-950/30 border border-red-200 dark:border-red-900/60 p-3 text-red-900 dark:text-red-100" role="alert" data-testid="filing-send-error">
                {{ error_key|trans }}
            </div>
        {% endif %}

        {% if not verdict.allowed %}
            <div data-testid="filing-send-blockers">
                <p class="font-semibold">{{ 'filing.send.blocked_title'|trans }}</p>
                <ul class="mt-1 list-disc ps-4 space-y-0.5">
                    {% for blocker in verdict.blockers %}
                        <li>{{ blocker|trans }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% else %}
            {% set address = verdict.address %}
            {% if not court_live %}
                <div class="rounded-lg bg-sky-50 dark:bg-sky-950/30 border border-sky-200 dark:border-sky-900/60 p-3 text-sky-900 dark:text-sky-100" data-testid="filing-send-dev-banner">
                    {{ 'filing.send.dev_banner'|trans({'%override%': recipient_override, '%address%': address.email}) }}
                </div>
            {% endif %}

            <dl class="grid grid-cols-1 gap-2">
                <div>
                    <dt class="font-semibold">{{ 'filing.send.court'|trans }}</dt>
                    <dd>{{ case.court.name }}</dd>
                    <dd class="text-[11px] text-slate-500 dark:text-slate-400" data-testid="filing-send-competence">{{ 'filing.send.competence_line'|trans }}</dd>
                </div>
                <div>
                    <dt class="font-semibold">{{ 'filing.send.address'|trans }}</dt>
                    <dd class="font-mono break-all">{{ address.email }}</dd>
                    <dd class="text-[11px] text-slate-500 dark:text-slate-400" data-testid="filing-send-address-meta">
                        {{ 'filing.send.address_meta'|trans({'%date%': address.validatedAt|date('d.m.Y'), '%source%': address.source.label|trans}) }}
                    </dd>
                </div>
                <div>
                    <dt class="font-semibold">{{ 'filing.send.headers'|trans }}</dt>
                    <dd>{{ 'filing.send.from'|trans }}: {{ preview.from }}</dd>
                    <dd>{{ 'filing.send.cc'|trans }}: {{ preview.cc }}</dd>
                    <dd>{{ 'filing.send.reply_to'|trans }}: {{ preview.cc }}</dd>
                </div>
                <div>
                    <dt class="font-semibold">{{ 'filing.send.subject'|trans }}</dt>
                    <dd data-testid="filing-send-subject">{{ preview.subject }}</dd>
                </div>
                <div>
                    <dt class="font-semibold">{{ 'filing.send.body'|trans }}</dt>
                    <dd><pre class="mt-1 whitespace-pre-wrap font-sans text-[11px] bg-slate-50 dark:bg-slate-800/60 rounded p-2 max-h-64 overflow-y-auto" data-testid="filing-send-body">{{ preview.body }}</pre></dd>
                </div>
                <div>
                    <dt class="font-semibold">{{ 'filing.send.attachments'|trans({'%count%': preview.email_count}) }}</dt>
                    {% for attachment in preview.attachments %}
                        <dd>{{ 'filing.send.attachment_line'|trans({'%k%': attachment.email, '%name%': attachment.name, '%size%': (attachment.bytes / 1048576)|number_format(2, ',', '.')}) }}</dd>
                    {% endfor %}
                </div>
                {% if preview.interest_date %}
                    <div>
                        <dt class="font-semibold">{{ 'filing.send.interest_date'|trans }}</dt>
                        <dd>{{ preview.interest_date|date('d.m.Y') }}</dd>
                    </div>
                {% endif %}
            </dl>

            {% for warning in verdict.warnings %}
                <p class="flex gap-1.5 text-amber-800 dark:text-amber-200" data-testid="filing-send-warning">
                    {{ icon_warning('size-3.5 shrink-0 mt-0.5') }}<span>{{ warning.key|trans(warning.params) }}</span>
                </p>
            {% endfor %}

            <form method="post" action="{{ path('case_filing_submission_submit', {id: case.id}) }}" class="space-y-2" data-controller="require-checks" data-testid="filing-send-form">
                <input type="hidden" name="_token" value="{{ csrf_token('filing_submit_' ~ case.id) }}">
                {% for key, text in confirmations %}
                    <label class="flex items-start gap-2">
                        <input type="checkbox" name="confirm_{{ key }}" value="1" class="mt-0.5" data-require-checks-target="check" data-action="require-checks#refresh" data-testid="filing-send-confirm-{{ key }}">
                        <span>{{ text }}</span>
                    </label>
                {% endfor %}
                <p class="text-[11px] text-slate-500 dark:text-slate-400">{{ 'filing.send.irreversible_note'|trans }}</p>
                <div class="flex items-center gap-2">
                    <button type="submit" data-require-checks-target="submit" data-testid="filing-send-submit"
                            class="py-2 px-3 inline-flex items-center gap-2 text-sm font-semibold rounded-lg bg-lex-navy text-white hover:bg-lex-navy-dark transition">
                        {{ 'filing.send.submit'|trans }}
                    </button>
                    <a href="{{ path('case_overview', {id: case.id, tab: 'documente'}) }}" data-turbo-frame="_top" class="text-xs underline hover:no-underline">{{ 'filing.send.dismiss'|trans }}</a>
                </div>
                <p class="text-[11px] text-slate-500" data-require-checks-target="hint">{{ 'filing.send.confirm_hint'|trans }}</p>
            </form>
        {% endif %}
    </div>
</turbo-frame>
