{# The legal notes that apply to the current state, folded; opened by itself only
   for an undelivered petition. The general note that the platform reports only the
   mail server's answer appears here once, never repeated in each block. #}
{% from 'case/overview/_icons.html.twig' import icon_external_link %}
{% set panel = filing_panel %}
{% set notes = panel.legalNoteKeys %}
{% if notes is not empty %}
<details id="filing-legal-notes" class="group bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-soft" data-testid="filing-legal-notes"{% if panel.legalNotesOpen %} open{% endif %}>
    <summary class="cursor-pointer list-none px-5 py-4 flex items-center gap-2 text-sm font-semibold text-slate-700 dark:text-slate-200">
        <svg class="size-4 text-slate-400 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        {{ 'filing.panel.legal.title'|trans }}
    </summary>
    <ul class="px-5 pb-5 ps-9 space-y-2 text-sm text-slate-600 dark:text-slate-300 list-disc">
        {% for key in notes %}
            {% if key == 'filing.signature.notice.validator_consent' %}
                <li data-testid="filing-signature-notice">
                    <a href="https://ec.europa.eu/digital-building-blocks/DSS/webapp-demo/validation" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 underline hover:text-slate-800 dark:hover:text-slate-100">{{ 'filing.signature.notice.validator_link'|trans }}{{ icon_external_link('size-3') }}</a>:
                    {{ key|trans }}
                </li>
            {% elseif key == 'filing.receipt.disclaimer' %}
                <li data-testid="filing-inbound-disclaimer">{{ key|trans }}</li>
            {% else %}
                <li>{{ key|trans }}</li>
            {% endif %}
        {% endfor %}
        {% if panel.code == 'undelivered' and filing_undelivered_deadline_open|default(false) %}
            <li>{{ 'filing.undelivered.deadline_reopened'|trans }}</li>
        {% endif %}
    </ul>
</details>
{% endif %}
