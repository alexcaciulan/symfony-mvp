{# The court and the address the filing goes to, or why there is none. Only where the
   filing would go: never a sign that the case can be sent. In a test environment
   the effective recipient is named next to the court's own address. #}
{% set recipient = filing_recipient|default(null) %}
{% set is_owner = app.user and app.user.id == case.user.id %}
{% set submission = filing_submission|default(null) %}
{% set failure = filing_submission_failure|default(null) %}
{% set reported = failure and failure.address_report_open %}
<section class="bg-white dark:bg-slate-900 rounded-2xl border {{ recipient and recipient.address and not reported ? 'border-slate-200 dark:border-slate-800' : 'border-amber-300 dark:border-amber-900/60' }} shadow-soft p-5" data-testid="filing-recipient">
    <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">{{ 'filing.panel.court.title'|trans }}</h3>
    <p class="mt-2 text-sm text-slate-800 dark:text-slate-100">{{ case.court ? case.court.name : 'enum.court_filing_address_missing_reason.NO_COURT'|trans }}</p>
    {% if recipient and recipient.address %}
        <p class="mt-3 font-mono text-sm text-slate-900 dark:text-slate-100 break-all" data-testid="filing-recipient-email">{{ recipient.address.email }}</p>
        <p class="text-xs text-slate-500 dark:text-slate-400">
            {{ recipient.address.purpose.label|trans }} · {{ 'filing.recipient.source'|trans }}: {{ recipient.address.source.label|trans }}
            · {{ 'filing.recipient.confirmed_by'|trans({'%date%': recipient.address.validatedAt|date('d.m.Y')}) }}
        </p>
        {% if reported %}
            <p class="mt-2 inline-flex rounded px-2 py-0.5 text-xs font-semibold bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-200" data-testid="filing-recipient-reported">{{ 'filing.panel.court.reported'|trans }}</p>
        {% endif %}
    {% elseif recipient %}
        <p class="mt-2 text-sm text-amber-900 dark:text-amber-100" data-testid="filing-recipient-reason">{{ recipient.reason.label|trans }}</p>
        {% if recipient.reason.value != 'NO_COURT' %}
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-300" data-testid="filing-recipient-other-channel">{{ 'filing.recipient.admin_decides_other_channel'|trans }}</p>
        {% endif %}
    {% endif %}

    {% if filing_court_live is defined and not filing_court_live %}
        {% set effective = submission ? submission.toAddress : filing_recipient_override|default(null) %}
        {% if effective %}
            <p class="mt-3 rounded-lg bg-sky-50 dark:bg-sky-950/30 px-3 py-2 text-xs text-sky-900 dark:text-sky-100" data-testid="filing-recipient-test-environment">{{ 'filing.panel.court.test_environment'|trans({'%address%': effective}) }}</p>
        {% endif %}
    {% endif %}

    {% if recipient and not recipient.address and recipient.reason.action != 'none' and is_owner %}
        <a href="{{ path('case_court_address', {id: case.id}) }}" data-turbo-frame="_top" class="mt-3 inline-block text-sm font-semibold text-lex-navy dark:text-blue-300 underline underline-offset-2 hover:no-underline" data-testid="filing-recipient-action">{{ ('filing.recipient.action_' ~ recipient.reason.action)|trans }}</a>
    {% elseif case.court %}
        <a href="{{ path('case_court_address', {id: case.id}) }}" data-turbo-frame="_top" class="mt-3 inline-block text-sm font-medium text-lex-navy dark:text-blue-300 underline underline-offset-2 hover:no-underline">{{ 'filing.panel.court.addresses_link'|trans }}</a>
    {% endif %}
</section>
