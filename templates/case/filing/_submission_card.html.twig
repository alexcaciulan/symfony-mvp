{# Status of the transmission to the court. An accepted email is "transmitted, no
   receipt": never filed, registered or received, and the filing date stays the
   lawyer's declaration. Times are the mail server's acceptance, shown in Romanian
   time. While emails are on their way (and not stalled after a failure) the frame
   refreshes itself from case_filing_submission_card. After a failure the card
   names the kind of error and its SMTP code, and offers the one way out that fits:
   resume the emails that did not leave, close them, split the annexes again,
   declare the copy in CC received or not, or cancel. Context from
   OverviewContextBuilder: filing_submission and the filing_submission_* flags,
   filing_can_set_filed_date, and for the messages received afterwards
   filing_receipt_proposal, filing_inbound_mails, filing_receipt_uploadable,
   filing_late_bounce_review and filing_undelivered_deadline_open. A receipt is
   evidence that the court mailbox answered, never a registration; its date is
   only proposed for the filing date. #}
{% set submission = filing_submission|default(null) %}
{% set is_owner = app.user and app.user.id == case.user.id %}
{% set failure = filing_submission_failure|default(null) %}
{% set stalled = filing_submission_stalled|default(false) %}
{% set uncertain_part = filing_submission_uncertain_part|default(null) %}
{% set retry_pending = failure and failure.part.status.value == 'RETRY_SCHEDULED' %}
{% set polling = submission and ((submission.deliveryStatus.inFlight and not stalled) or retry_pending) %}
{% set late_review = filing_late_bounce_review|default(false) %}
<turbo-frame id="filing-submission-card"
             data-controller="poll-frame"
             data-poll-frame-pending-value="{{ polling ? 'true' : 'false' }}"
             data-poll-frame-interval-ms-value="5000"
             data-poll-frame-url-value="{{ path('case_filing_submission_card', {id: case.id}) }}"
             class="block mb-3">
    {% if submission %}
        {% set status = submission.deliveryStatus.value %}
        {% set accepted = submission.countAcceptedParts %}
        {% set total = submission.parts|length %}
        {% set petition_left = submission.petitionAccepted %}
        {% set alarming = status in ['NEEDS_REVIEW', 'FAILED_TEMPORARY_EXHAUSTED', 'FAILED_PERMANENT', 'FAILED_SIZE', 'FAILED_INTERNAL', 'CLOSED_PARTIAL', 'UNDELIVERED'] or stalled or retry_pending %}
        {% set evidence = submission.evidenceStatus.value %}
        {% set delayed_parts = submission.parts|filter(p => p.attempts|filter(a => a.source.value == 'ASYNC_BOUNCE' and a.outcome and a.outcome.value == 'TEMPORARY')|length > 0) %}
        <div class="rounded-lg border p-3 text-xs {{ alarming ? 'bg-amber-50 dark:bg-amber-950/30 border-amber-200 dark:border-amber-900/60 text-amber-900 dark:text-amber-100' : 'border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-200' }}" data-testid="filing-submission-card" data-status="{{ status }}" data-stalled="{{ stalled ? '1' : '0' }}">
            <p class="font-semibold text-sm" data-testid="filing-submission-headline">
                {% if late_review %}
                    {{ 'filing.undelivered.late_headline'|trans }}
                {% elseif stalled and petition_left %}
                    {{ 'filing.status.headline.stalled'|trans }}
                {% elseif status == 'NEEDS_REVIEW' and petition_left %}
                    {{ 'filing.status.headline.NEEDS_REVIEW_after_petition'|trans }}
                {% elseif status == 'CLOSED_PARTIAL' %}
                    {{ 'filing.status.headline.CLOSED_PARTIAL'|trans }}
                {% elseif retry_pending %}
                    {{ 'filing.status.headline.retrying'|trans }}
                {% elseif status in ['SENT', 'PARTIALLY_SENT'] and evidence in ['RECEIPT_RECEIVED', 'RECEIPT_MANUAL'] %}
                    {{ 'filing.status.transmitted_with_receipt'|trans }}
                {% elseif status in ['SENT', 'PARTIALLY_SENT'] %}
                    {{ 'filing.status.transmitted_no_receipt'|trans }}
                {% else %}
                    {{ ('filing.status.headline.' ~ status)|trans }}
                {% endif %}
            </p>
            {% if status == 'PARTIALLY_SENT' and not stalled %}
                <p class="mt-0.5" data-testid="filing-submission-annexes-pending">{{ 'filing.status.annexes_in_progress'|trans({'%done%': accepted, '%total%': total}) }}</p>
            {% endif %}
            {% if status == 'NEEDS_REVIEW' and submission.reviewReason %}
                <p class="mt-1" data-testid="filing-submission-review-reason">{{ submission.reviewReason|trans }}</p>
            {% endif %}

            {% if status == 'UNDELIVERED' or late_review %}
                {% set bounced = submission.part(1) %}
                <div class="mt-2 space-y-1" data-testid="filing-submission-undelivered">
                    <p>{{ 'filing.undelivered.explain'|trans }}</p>
                    {% if bounced and (bounced.lastEnhancedStatus or bounced.lastError) %}
                        <p class="text-[11px] text-slate-600 dark:text-slate-300 break-words" data-testid="filing-submission-undelivered-diagnostic">{{ 'filing.undelivered.diagnostic'|trans({'%code%': bounced.lastEnhancedStatus ?? '-', '%text%': bounced.lastError ?? ''}) }}</p>
                    {% endif %}
                    {% if status == 'UNDELIVERED' %}
                        {% if failure and failure.address_invalidated %}
                            <p data-testid="filing-submission-address-rejected">{{ 'filing.undelivered.address_invalidated'|trans }}</p>
                            {% if is_owner %}
                                <a href="{{ path('case_court_address', {id: case.id}) }}" data-turbo-frame="_top" class="text-[11px] underline hover:no-underline">{{ 'filing.failure.address_link'|trans }}</a>
                            {% endif %}
                        {% endif %}
                        {% if bounced and bounced.status.value == 'FAILED_SIZE' %}
                            <p data-testid="filing-submission-size-help">{{ (filing_submission_resplittable|default(false) ? 'filing.resplit.proposal' : 'filing.resplit.cannot_help')|trans }}</p>
                        {% endif %}
                        <p class="rounded border border-red-300 dark:border-red-900/60 bg-red-50 dark:bg-red-950/30 p-2 text-red-900 dark:text-red-100" data-testid="filing-submission-undelivered-deadline">{{ 'filing.undelivered.deadline_warning'|trans }}</p>
                        {% if filing_undelivered_deadline_open|default(false) %}
                            <p class="text-[11px]" data-testid="filing-submission-undelivered-reopened">{{ 'filing.undelivered.deadline_reopened'|trans }}</p>
                        {% endif %}
                        <p class="text-[11px]">{{ 'filing.undelivered.next_step'|trans }}</p>
                    {% endif %}
                    {% if late_review %}
                        <p data-testid="filing-submission-late-bounce">{{ 'filing.undelivered.late_explain'|trans }}</p>
                        {% if is_owner %}
                            <form method="post" action="{{ path('case_filing_submission_late_bounce_ack', {id: case.id, submissionId: submission.id}) }}" data-turbo-frame="_top">
                                <input type="hidden" name="_token" value="{{ csrf_token('filing_late_bounce_' ~ submission.id) }}">
                                <button type="submit" data-testid="filing-submission-late-bounce-ack" class="py-1.5 px-2.5 text-xs font-semibold rounded-lg border border-slate-300 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 transition">{{ 'filing.undelivered.ack_cta'|trans }}</button>
                            </form>
                        {% endif %}
                    {% endif %}
                </div>
            {% endif %}

            {% if failure and status not in ['CANCELLED', 'UNDELIVERED'] and not late_review %}
                <div class="mt-2 space-y-1" data-testid="filing-submission-failure" data-kind="{{ failure.kind }}">
                    <p>{{ ('filing.failure.reason.' ~ failure.kind)|trans({'%k%': failure.part.sequence, '%n%': failure.part.total}) }}</p>
                    {% if failure.code or failure.enhanced %}
                        <p class="text-[11px] text-slate-600 dark:text-slate-300" data-testid="filing-submission-failure-code">{{ 'filing.failure.code'|trans({'%code%': (failure.code ?? '-') ~ (failure.enhanced ? ' ' ~ failure.enhanced : '')}) }}</p>
                    {% endif %}
                    {% if failure.next_retry_at %}
                        <p data-testid="filing-submission-next-retry">{{ 'filing.failure.next_retry'|trans({'%date%': failure.next_retry_at|date('d.m.Y H:i', 'Europe/Bucharest')}) }}</p>
                    {% endif %}
                    {% if failure.kind == 'temporary' %}
                        <p class="text-[11px]" data-testid="filing-submission-deadline-warning">{{ 'filing.failure.deadline_warning'|trans }}</p>
                    {% endif %}
                    {% if failure.kind == 'permanent' %}
                        <p data-testid="filing-submission-address-rejected">{{ (failure.address_invalidated ? 'filing.failure.address_rejected' : 'filing.failure.permanent_other')|trans }}</p>
                        {% if failure.address_invalidated and is_owner %}
                            <a href="{{ path('case_court_address', {id: case.id}) }}" data-turbo-frame="_top" class="text-[11px] underline hover:no-underline" data-testid="filing-submission-address-link">{{ 'filing.failure.address_link'|trans }}</a>
                        {% endif %}
                    {% endif %}
                    {% if failure.kind == 'size' and not petition_left %}
                        <p data-testid="filing-submission-size-help">{{ (filing_submission_resplittable|default(false) ? 'filing.resplit.proposal' : 'filing.resplit.cannot_help')|trans }}</p>
                    {% elseif failure.kind == 'size' %}
                        <p data-testid="filing-submission-size-help">{{ 'filing.resplit.after_petition'|trans }}</p>
                    {% endif %}
                    {% if failure.kind == 'uncertain' and not (is_owner and uncertain_part) %}
                        <p>{{ 'filing.uncertain.explain'|trans }}</p>
                    {% endif %}
                </div>
            {% endif %}

            {% if petition_left and (stalled or status in ['NEEDS_REVIEW', 'CLOSED_PARTIAL']) and accepted < total %}
                <p class="mt-2 rounded border border-red-300 dark:border-red-900/60 bg-red-50 dark:bg-red-950/30 p-2 text-red-900 dark:text-red-100" data-testid="filing-submission-incomplete-warning">{{ 'filing.close.warning'|trans }}</p>
            {% endif %}

            <p class="mt-2">{{ 'filing.status.recipient'|trans({'%address%': submission.toAddress}) }}</p>
            {% if submission.recipientOverridden %}
                <p class="text-[11px] text-slate-500 dark:text-slate-400" data-testid="filing-submission-override">{{ 'filing.status.override_note'|trans({'%address%': submission.intendedToAddress}) }}</p>
            {% endif %}

            <ol class="mt-2 space-y-1" data-testid="filing-submission-parts">
                {% for part in submission.parts %}
                    <li>
                        <div class="flex flex-wrap items-center gap-x-2">
                            <span class="font-medium">{{ 'filing.status.part'|trans({'%k%': part.sequence, '%n%': part.total}) }}</span>
                            <span data-testid="filing-submission-part-status-{{ part.sequence }}">{{ part.status.label|trans }}</span>
                            {% if part.sentAt %}
                                <span class="text-[11px] text-slate-500 dark:text-slate-400">{{ 'filing.status.accepted_at'|trans({'%date%': part.sentAt|date('d.m.Y H:i', 'Europe/Bucharest')}) }}</span>
                            {% endif %}
                            {% if is_owner and part.emlPath %}
                                <a href="{{ path('case_filing_submission_eml', {id: case.id, submissionId: submission.id, sequence: part.sequence}) }}" data-turbo="false" class="text-[11px] underline hover:no-underline">{{ 'filing.status.download_eml'|trans }}</a>
                            {% endif %}
                        </div>
                        {% if part.attempts|length > 1 or (part.attempts|length == 1 and part.status.value != 'ACCEPTED') %}
                            <ul class="ms-3 text-[11px] text-slate-500 dark:text-slate-400" data-testid="filing-submission-attempts-{{ part.sequence }}">
                                {% for attempt in part.attempts %}
                                    <li>{{ 'filing.status.attempt_line'|trans({
                                        '%no%': attempt.attemptNo,
                                        '%date%': attempt.startedAt|date('d.m.Y H:i', 'Europe/Bucharest'),
                                        '%source%': attempt.source.label|trans,
                                        '%outcome%': attempt.outcome ? attempt.outcome.label|trans : 'filing.status.attempt_running'|trans,
                                        '%code%': attempt.smtpCode ? ' (SMTP ' ~ attempt.smtpCode ~ (attempt.enhancedStatus ? ' ' ~ attempt.enhancedStatus : '') ~ ')' : (attempt.enhancedStatus ? ' (' ~ attempt.enhancedStatus ~ ')' : ''),
                                    }) }}</li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </li>
                {% endfor %}
            </ol>

            {% if submission.sentAt %}
                <p class="mt-2 text-[11px] text-slate-500 dark:text-slate-400">{{ 'filing.status.sent_at_note'|trans }}</p>
            {% endif %}

            {% if evidence == 'RECEIPT_RECEIVED' and submission.courtReceiptAt %}
                <div class="mt-2 space-y-0.5" data-testid="filing-receipt-received">
                    <p>{{ 'filing.receipt.received'|trans({'%date%': submission.courtReceiptAt|date('d.m.Y H:i', 'Europe/Bucharest')}) }}</p>
                    {% if submission.receiptInboundMail and submission.receiptInboundMail.authVerdict and submission.receiptInboundMail.authVerdict.value == 'TRUSTED_PASS' %}
                        <p class="text-[11px] text-slate-500 dark:text-slate-400">{{ 'filing.receipt.auth_note'|trans }}</p>
                    {% endif %}
                </div>
            {% elseif evidence == 'RECEIPT_MANUAL' %}
                <div class="mt-2 space-y-0.5" data-testid="filing-receipt-manual">
                    {% if submission.receiptInboundMail %}
                        <p>{{ 'filing.receipt.manual'|trans({'%date%': submission.receiptInboundMail.receivedAt|date('d.m.Y H:i', 'Europe/Bucharest')}) }}</p>
                    {% endif %}
                    {% if submission.courtReceiptAt and submission.receiptInboundMail and submission.receiptInboundMail.rawMime == 'eml' %}
                        <p data-testid="filing-receipt-manual-date">{{ 'filing.receipt.manual_eml_date'|trans({'%date%': submission.courtReceiptAt|date('d.m.Y H:i', 'Europe/Bucharest')}) }}</p>
                    {% else %}
                        <p data-testid="filing-receipt-manual-no-date">{{ 'filing.receipt.manual_no_date'|trans }}</p>
                    {% endif %}
                    <p class="text-[11px] text-slate-500 dark:text-slate-400">{{ 'filing.receipt.technical_check_note'|trans }}</p>
                </div>
            {% elseif evidence == 'RECEIPT_OVERDUE' and status != 'UNDELIVERED' %}
                <p class="mt-2" data-testid="filing-receipt-overdue">{{ 'filing.receipt.overdue'|trans }}</p>
            {% endif %}
            {% if submission.readReceiptAt %}
                <p class="mt-1 text-[11px]" data-testid="filing-read-receipt">{{ 'filing.receipt.read'|trans({'%date%': submission.readReceiptAt|date('d.m.Y H:i', 'Europe/Bucharest')}) }}</p>
            {% endif %}
            {% if delayed_parts is not empty and status != 'UNDELIVERED' %}
                <p class="mt-1 text-[11px]" data-testid="filing-delivery-delayed">{{ 'filing.receipt.delayed'|trans }}</p>
            {% endif %}

            {% include 'case/filing/_inbound_mail_list.html.twig' with {rows: filing_inbound_mails|default([]), case: case, is_owner: is_owner} only %}

            {% if case.filedAt %}
                <p class="mt-2" data-testid="filing-submission-filed-at">{{ 'filing.status.filed_at'|trans({'%date%': case.filedAt|date('d.m.Y')}) }}</p>
            {% elseif submission.sentAt %}
                <p class="mt-2">{{ 'filing.status.filed_at_pending'|trans }}</p>
            {% endif %}

            {% if is_owner and uncertain_part %}
                <div class="mt-3 space-y-2 rounded border border-amber-300 dark:border-amber-900/60 p-2" data-testid="filing-submission-uncertain-actions">
                    <p class="font-semibold">{{ 'filing.uncertain.title'|trans({'%k%': uncertain_part.sequence, '%n%': uncertain_part.total}) }}</p>
                    <p data-testid="filing-submission-uncertain-explain">{{ 'filing.uncertain.explain'|trans }}</p>
                    <form method="post" action="{{ path('case_filing_submission_cc_received', {id: case.id, submissionId: submission.id, sequence: uncertain_part.sequence}) }}" data-turbo-frame="_top" class="space-y-1">
                        <input type="hidden" name="_token" value="{{ csrf_token('filing_uncertain_' ~ submission.id ~ '_' ~ uncertain_part.sequence) }}">
                        <label class="flex items-start gap-2"><input type="checkbox" name="confirm_cc_received" value="1" required class="mt-0.5"><span>{{ (uncertain_part.sequence == 1 ? 'filing.uncertain.confirm.cc_received_petition' : 'filing.uncertain.confirm.cc_received')|trans }}</span></label>
                        <button type="submit" data-testid="filing-submission-cc-received" class="py-1.5 px-2.5 text-xs font-semibold rounded-lg border border-slate-300 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 transition">{{ 'filing.uncertain.received_cta'|trans }}</button>
                    </form>
                    <form method="post" action="{{ path('case_filing_submission_cc_not_received', {id: case.id, submissionId: submission.id, sequence: uncertain_part.sequence}) }}" data-turbo-frame="_top" class="space-y-1">
                        <input type="hidden" name="_token" value="{{ csrf_token('filing_uncertain_' ~ submission.id ~ '_' ~ uncertain_part.sequence) }}">
                        <label class="flex items-start gap-2"><input type="checkbox" name="confirm_cc_not_received" value="1" required class="mt-0.5"><span>{{ 'filing.uncertain.confirm.cc_not_received'|trans }}</span></label>
                        <button type="submit" data-testid="filing-submission-cc-not-received" class="py-1.5 px-2.5 text-xs font-semibold rounded-lg border border-slate-300 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 transition">{{ 'filing.uncertain.not_received_cta'|trans }}</button>
                    </form>
                </div>
            {% endif %}

            {% if is_owner and filing_submission_resumable|default(false) %}
                <form method="post" action="{{ path('case_filing_submission_resume', {id: case.id, submissionId: submission.id}) }}" class="mt-3 space-y-1" data-turbo-frame="_top" data-testid="filing-submission-resume-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('filing_resume_' ~ submission.id) }}">
                    <label class="flex items-start gap-2"><input type="checkbox" name="confirm_resume_remaining" value="1" required class="mt-0.5"><span>{{ 'filing.resume.confirm'|trans }}</span></label>
                    <button type="submit" data-testid="filing-submission-resume" class="py-1.5 px-2.5 text-xs font-semibold rounded-lg bg-lex-navy text-white hover:bg-lex-navy-dark transition">{{ 'filing.resume.cta'|trans }}</button>
                </form>
            {% endif %}

            {% if is_owner and filing_submission_resplittable|default(false) %}
                <form method="post" action="{{ path('case_filing_submission_resplit', {id: case.id, submissionId: submission.id}) }}" class="mt-3" data-turbo-frame="_top">
                    <input type="hidden" name="_token" value="{{ csrf_token('filing_resplit_' ~ submission.id) }}">
                    <button type="submit" data-testid="filing-submission-resplit" class="py-1.5 px-2.5 text-xs font-semibold rounded-lg border border-slate-300 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 transition">{{ 'filing.resplit.cta'|trans }}</button>
                </form>
            {% endif %}

            {% if is_owner and filing_submission_closable|default(false) %}
                <form method="post" action="{{ path('case_filing_submission_close', {id: case.id, submissionId: submission.id}) }}" class="mt-3 space-y-1" data-turbo-frame="_top" data-testid="filing-submission-close-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('filing_close_' ~ submission.id) }}">
                    <label class="flex items-start gap-2"><input type="checkbox" name="confirm_incomplete" value="1" required class="mt-0.5"><span>{{ 'filing.close.confirm.incomplete'|trans }}</span></label>
                    <button type="submit" data-testid="filing-submission-close" class="py-1.5 px-2.5 text-xs font-semibold rounded-lg border border-red-300 text-red-800 dark:border-red-900/60 dark:text-red-200 hover:bg-red-50 dark:hover:bg-red-950/30 transition">{{ 'filing.close.cta'|trans }}</button>
                </form>
            {% endif %}

            {% if is_owner and filing_submission_cancellable|default(false) %}
                <form method="post" action="{{ path('case_filing_submission_cancel', {id: case.id, submissionId: submission.id}) }}" class="mt-2" data-turbo-frame="_top">
                    <input type="hidden" name="_token" value="{{ csrf_token('filing_cancel_' ~ submission.id) }}">
                    <button type="submit" data-testid="filing-submission-cancel" class="py-1.5 px-2.5 text-xs font-semibold rounded-lg border border-slate-300 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 transition">{{ 'filing.status.cancel'|trans }}</button>
                </form>
            {% endif %}

            {% if alarming or stalled %}
                <p class="mt-2 text-[11px] text-slate-500 dark:text-slate-400">{{ 'filing.failure.responsibility'|trans }}</p>
            {% endif %}

            {% if is_owner and filing_can_set_filed_date|default(false) %}
                <form method="post" action="{{ path('case_filing_submission_filed_date', {id: case.id}) }}" class="mt-3 space-y-1" data-turbo-frame="_top" data-testid="filing-filed-date-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('filing_filed_date_' ~ case.id) }}">
                    <label class="block font-semibold" for="filing-filed-at">{{ 'filing.status.set_date.title'|trans }}</label>
                    <p class="text-[11px] text-slate-500 dark:text-slate-400">{{ 'filing.status.set_date.help'|trans }}</p>
                    {% set proposal = filing_receipt_proposal|default(null) %}
                    {% if proposal %}
                        <p class="text-[11px] text-amber-800 dark:text-amber-200" data-testid="filing-filed-date-proposal">{{ 'filing.receipt.proposal_label'|trans({'%date%': proposal|date('d.m.Y')}) }}</p>
                    {% endif %}
                    <div class="flex items-center gap-2">
                        <input id="filing-filed-at" type="date" name="filed_at" required max="{{ 'now'|date('Y-m-d', 'Europe/Bucharest') }}" value="{{ case.filedAt ? case.filedAt|date('Y-m-d') : (proposal ? proposal|date('Y-m-d') : '') }}"
                               class="py-1 px-2 text-xs rounded border border-slate-300 dark:border-slate-700 dark:bg-slate-900">
                        <button type="submit" class="py-1.5 px-2.5 text-xs font-semibold rounded-lg bg-lex-navy text-white hover:bg-lex-navy-dark transition">{{ 'filing.status.set_date.submit'|trans }}</button>
                    </div>
                </form>
            {% endif %}

            {% if is_owner and filing_receipt_uploadable|default(false) and evidence != 'RECEIPT_RECEIVED' %}
                <form method="post" enctype="multipart/form-data" action="{{ path('case_filing_submission_receipt_upload', {id: case.id, submissionId: submission.id}) }}" class="mt-3 space-y-1" data-turbo="false" data-testid="filing-receipt-upload-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('filing_receipt_upload_' ~ submission.id) }}">
                    <label class="block font-semibold" for="filing-receipt-file">{{ 'filing.receipt.upload.title'|trans }}</label>
                    <p class="text-[11px] text-slate-500 dark:text-slate-400">{{ 'filing.receipt.upload.help'|trans }}</p>
                    <div class="flex flex-wrap items-center gap-2">
                        <input id="filing-receipt-file" type="file" name="receipt" required accept=".eml,.pdf,.png,.jpg,.jpeg" class="text-xs max-w-full">
                        <button type="submit" data-testid="filing-receipt-upload" class="py-1.5 px-2.5 text-xs font-semibold rounded-lg border border-slate-300 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 transition">{{ 'filing.receipt.upload.cta'|trans }}</button>
                    </div>
                </form>
            {% endif %}

            {% if submission.sentAt %}
                <p class="mt-3 text-[11px] text-slate-500 dark:text-slate-400" data-testid="filing-inbound-disclaimer">{{ 'filing.receipt.disclaimer'|trans }}</p>
            {% endif %}
        </div>
    {% endif %}
</turbo-frame>
