{# Status of the transmission to the court. An accepted email is "transmitted, no
   receipt": never filed, registered or received, and the filing date stays the
   lawyer's declaration. Times are the mail server's acceptance, shown in Romanian
   time. While emails are on their way the frame refreshes itself from
   case_filing_submission_card. Context: filing_submission, filing_submission_cancellable,
   filing_can_set_filed_date (OverviewContextBuilder). #}
{% set submission = filing_submission|default(null) %}
{% set is_owner = app.user and app.user.id == case.user.id %}
<turbo-frame id="filing-submission-card"
             data-controller="poll-frame"
             data-poll-frame-pending-value="{{ submission and submission.deliveryStatus.inFlight ? 'true' : 'false' }}"
             data-poll-frame-interval-ms-value="5000"
             data-poll-frame-url-value="{{ path('case_filing_submission_card', {id: case.id}) }}"
             class="block mb-3">
    {% if submission %}
        {% set status = submission.deliveryStatus.value %}
        {% set accepted = submission.countAcceptedParts %}
        {% set total = submission.parts|length %}
        <div class="rounded-lg border p-3 text-xs {{ status == 'NEEDS_REVIEW' ? 'bg-amber-50 dark:bg-amber-950/30 border-amber-200 dark:border-amber-900/60 text-amber-900 dark:text-amber-100' : 'border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-200' }}" data-testid="filing-submission-card" data-status="{{ status }}">
            <p class="font-semibold text-sm" data-testid="filing-submission-headline">
                {% if status in ['SENT', 'PARTIALLY_SENT'] or (status == 'NEEDS_REVIEW' and submission.petitionAccepted) %}
                    {{ 'filing.status.transmitted_no_receipt'|trans }}
                {% else %}
                    {{ ('filing.status.headline.' ~ status)|trans }}
                {% endif %}
            </p>
            {% if status == 'PARTIALLY_SENT' %}
                <p class="mt-0.5" data-testid="filing-submission-annexes-pending">{{ 'filing.status.annexes_in_progress'|trans({'%done%': accepted, '%total%': total}) }}</p>
            {% endif %}
            {% if status == 'NEEDS_REVIEW' and submission.reviewReason %}
                <p class="mt-1" data-testid="filing-submission-review-reason">{{ submission.reviewReason|trans }}</p>
            {% endif %}

            <p class="mt-2">{{ 'filing.status.recipient'|trans({'%address%': submission.toAddress}) }}</p>
            {% if submission.recipientOverridden %}
                <p class="text-[11px] text-slate-500 dark:text-slate-400" data-testid="filing-submission-override">{{ 'filing.status.override_note'|trans({'%address%': submission.intendedToAddress}) }}</p>
            {% endif %}

            <ol class="mt-2 space-y-1" data-testid="filing-submission-parts">
                {% for part in submission.parts %}
                    <li class="flex flex-wrap items-center gap-x-2">
                        <span class="font-medium">{{ 'filing.status.part'|trans({'%k%': part.sequence, '%n%': part.total}) }}</span>
                        <span>{{ part.status.label|trans }}</span>
                        {% if part.sentAt %}
                            <span class="text-[11px] text-slate-500 dark:text-slate-400">{{ 'filing.status.accepted_at'|trans({'%date%': part.sentAt|date('d.m.Y H:i', 'Europe/Bucharest')}) }}</span>
                        {% endif %}
                        {% if is_owner and part.emlPath %}
                            <a href="{{ path('case_filing_submission_eml', {id: case.id, submissionId: submission.id, sequence: part.sequence}) }}" data-turbo="false" class="text-[11px] underline hover:no-underline">{{ 'filing.status.download_eml'|trans }}</a>
                        {% endif %}
                    </li>
                {% endfor %}
            </ol>

            {% if submission.sentAt %}
                <p class="mt-2 text-[11px] text-slate-500 dark:text-slate-400">{{ 'filing.status.sent_at_note'|trans }}</p>
            {% endif %}

            {% if case.filedAt %}
                <p class="mt-2" data-testid="filing-submission-filed-at">{{ 'filing.status.filed_at'|trans({'%date%': case.filedAt|date('d.m.Y')}) }}</p>
            {% elseif submission.sentAt %}
                <p class="mt-2">{{ 'filing.status.filed_at_pending'|trans }}</p>
            {% endif %}

            {% if is_owner and filing_submission_cancellable|default(false) %}
                <form method="post" action="{{ path('case_filing_submission_cancel', {id: case.id, submissionId: submission.id}) }}" class="mt-2" data-turbo-frame="_top">
                    <input type="hidden" name="_token" value="{{ csrf_token('filing_cancel_' ~ submission.id) }}">
                    <button type="submit" data-testid="filing-submission-cancel" class="py-1.5 px-2.5 text-xs font-semibold rounded-lg border border-slate-300 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 transition">{{ 'filing.status.cancel'|trans }}</button>
                </form>
            {% endif %}

            {% if is_owner and filing_can_set_filed_date|default(false) %}
                <form method="post" action="{{ path('case_filing_submission_filed_date', {id: case.id}) }}" class="mt-3 space-y-1" data-turbo-frame="_top" data-testid="filing-filed-date-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('filing_filed_date_' ~ case.id) }}">
                    <label class="block font-semibold" for="filing-filed-at">{{ 'filing.status.set_date.title'|trans }}</label>
                    <p class="text-[11px] text-slate-500 dark:text-slate-400">{{ 'filing.status.set_date.help'|trans }}</p>
                    <div class="flex items-center gap-2">
                        <input id="filing-filed-at" type="date" name="filed_at" required max="{{ 'now'|date('Y-m-d', 'Europe/Bucharest') }}" value="{{ case.filedAt ? case.filedAt|date('Y-m-d') : '' }}"
                               class="py-1 px-2 text-xs rounded border border-slate-300 dark:border-slate-700 dark:bg-slate-900">
                        <button type="submit" class="py-1.5 px-2.5 text-xs font-semibold rounded-lg bg-lex-navy text-white hover:bg-lex-navy-dark transition">{{ 'filing.status.set_date.submit'|trans }}</button>
                    </div>
                </form>
            {% endif %}
        </div>
    {% endif %}
</turbo-frame>
