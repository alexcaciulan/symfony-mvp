{# Filing package: the unsigned files built for signing and filing, one download per file,
   and the upload of each signed file. Context from OverviewContextBuilder: filing_package
   (already re-checked for staleness) and filing_gate_blocker; filing_over_budget comes from
   a refused signed upload. A detected signature is never presented as a valid or qualified
   one, and SIGNED never as ready to file: the signature, the content and the rest of the
   filing requirements stay the lawyer's. #}
{% from 'case/overview/_icons.html.twig' import icon_document, icon_download, icon_warning, icon_refresh, icon_lock, icon_external_link, icon_check %}
{% import 'case/overview/_power_of_attorney_macros.html.twig' as poa %}

{% set package = filing_package|default(null) %}
{% set gate_blocker = filing_gate_blocker|default(null) %}
{% set is_owner = app.user and app.user.id == case.user.id %}
{% set can_build = gate_blocker is null and is_granted('CASE_TRANSITION', case) %}
{% set readiness_blockers = gate_blocker and case.status.value == 'CERERE_GENERATA' ? filing_readiness(case).blockers : [] %}
{% set poa_editable = power_of_attorney_editable(case) and is_granted('CASE_UPLOAD', case) %}
{% set over_budget = filing_over_budget|default(null) %}
{% set uploads_open = package and is_owner and case.status.value == 'CERERE_GENERATA' and package.status.value in ['BUILT', 'AWAITING_SIGNATURES', 'SIGNED'] %}
{% set validator_url = 'https://ec.europa.eu/digital-building-blocks/DSS/webapp-demo/validation' %}

<section id="filing-package-card" class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-soft overflow-hidden">
    <div class="p-5">
        <div class="flex items-start justify-between gap-3 mb-3">
            <div class="flex items-center gap-2">
                {{ icon_document('size-5 text-slate-400') }}
                <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">{{ 'filing.package.title'|trans }}</h3>
            </div>
            {% if package %}
                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-semibold {{ package.status.value == 'STALE' ? 'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-200' : 'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-200' }}" data-testid="filing-package-status">
                    {{ package.status.label|trans }} · v{{ package.version }}
                </span>
            {% endif %}
        </div>

        <p class="text-xs text-slate-600 dark:text-slate-300 mb-3">{{ 'filing.package.intro'|trans }}</p>

        {% if package and package.status.value == 'SIGNED' %}
            <p class="text-xs font-semibold text-slate-700 dark:text-slate-200 mb-3" data-testid="filing-package-signed">{{ 'filing.signature.package_signed'|trans }}</p>
        {% endif %}

        {% if gate_blocker %}
            <div class="rounded-lg bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-900/60 p-3 mb-3 text-xs text-amber-900 dark:text-amber-100" data-testid="filing-package-blocker">
                <p class="font-semibold">{{ 'filing.package.blocked_title'|trans }}</p>
                <p class="mt-0.5">{{ gate_blocker|trans }}</p>
                {% for issue in readiness_blockers %}
                    {% set poa_doc = issue.documentId ? case.documents|filter(d => d.id == issue.documentId)|first : null %}
                    {% if issue.code.value == 'power_of_attorney_date_missing' and poa_doc and poa_editable %}
                        <button type="button" {{ poa.edit_trigger_attrs(case, poa_doc) }}
                                class="mt-2 py-1.5 px-3 inline-flex items-center gap-1.5 text-xs font-semibold rounded-lg bg-white border border-amber-300 text-amber-900 hover:bg-amber-100 transition">
                            {{ 'case_overview.modal.generate_op_power_of_attorney_cta_complete'|trans }}
                        </button>
                    {% elseif issue.code.value in ['power_of_attorney_missing', 'claim_document_missing', 'contract_missing'] and not case.fullPaymentDate %}
                        <button type="button"
                                data-hs-overlay="#hs-modal-upload-document"
                                data-upload-preset-type="{{ {'power_of_attorney_missing': 'imputernicire_avocatiala', 'claim_document_missing': 'factura', 'contract_missing': 'contract'}[issue.code.value] }}"
                                class="mt-2 py-1.5 px-3 inline-flex items-center gap-1.5 text-xs font-semibold rounded-lg bg-white border border-amber-300 text-amber-900 hover:bg-amber-100 transition">
                            {{ ('case_overview.modal.generate_op_' ~ {'power_of_attorney_missing': 'power_of_attorney', 'claim_document_missing': 'claim_document', 'contract_missing': 'contract'}[issue.code.value] ~ '_cta_upload')|trans }}
                        </button>
                    {% endif %}
                {% endfor %}
            </div>
        {% endif %}

        {% set recipient = filing_recipient|default(null) %}
        {% if recipient %}
            {# Only where the filing would go, or why that is unknown: never a sign that the case can be sent. #}
            <div class="rounded-lg border p-3 mb-3 text-xs {{ recipient.address ? 'border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-200' : 'bg-amber-50 dark:bg-amber-950/30 border-amber-200 dark:border-amber-900/60 text-amber-900 dark:text-amber-100' }}" data-testid="filing-recipient">
                <p class="font-semibold">{{ 'filing.recipient.title'|trans }}</p>
                {% if recipient.address %}
                    <p class="mt-0.5 font-mono break-all" data-testid="filing-recipient-email">{{ recipient.address.email }}</p>
                    <p class="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400">
                        {{ recipient.address.purpose.label|trans }} · {{ 'filing.recipient.source'|trans }}: {{ recipient.address.source.label|trans }}
                        · {{ 'filing.recipient.confirmed_by'|trans({'%date%': recipient.address.validatedAt|date('d.m.Y')}) }}
                    </p>
                    <a href="{{ path('case_court_address', {id: case.id}) }}" class="mt-1 inline-block underline hover:no-underline">{{ 'filing.recipient.open_page'|trans }}</a>
                {% else %}
                    <p class="mt-0.5" data-testid="filing-recipient-reason">{{ recipient.reason.label|trans }}</p>
                    {% set action = recipient.reason.action %}
                    {% if action != 'none' %}
                        {% if is_owner %}
                            <a href="{{ path('case_court_address', {id: case.id}) }}" class="mt-1 inline-block font-semibold underline hover:no-underline" data-testid="filing-recipient-action">{{ ('filing.recipient.action_' ~ action)|trans }}</a>
                        {% else %}
                            <a href="{{ path('case_court_address', {id: case.id}) }}" class="mt-1 inline-block underline hover:no-underline">{{ 'filing.recipient.open_page'|trans }}</a>
                        {% endif %}
                    {% endif %}
                {% endif %}
            </div>
        {% endif %}

        {% if package and package.status.value == 'STALE' %}
            <div class="rounded-lg bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-900/60 p-3 mb-3 text-xs text-amber-900 dark:text-amber-100" data-testid="filing-package-stale">
                <p class="font-semibold">{{ 'filing.package.stale_title'|trans }}</p>
                <p class="mt-0.5">{{ ('filing.package.stale_reason.' ~ (package.staleReason ?? 'other'))|trans }}</p>
                {% if package.staleReason in ['claim_totals', 'interest_date'] %}
                    {# Not dismissable: rebuilding does not touch the petition, so its amounts stay as generated. #}
                    <p class="mt-2 font-semibold" data-testid="filing-package-frozen-petition">{{ 'filing.package.frozen_petition_warning'|trans }}</p>
                {% endif %}
            </div>
        {% endif %}

        {% if package %}
            {% for warning in package.warnings %}
                <div class="rounded-lg bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-900/60 p-3 mb-3 text-xs text-amber-900 dark:text-amber-100 flex gap-2" data-testid="filing-package-warning-{{ warning }}">
                    {{ icon_warning('size-4 shrink-0 mt-0.5') }}
                    <span>{{ ('filing.package.warning.' ~ warning)|trans }}</span>
                </div>
            {% endfor %}

            <ul class="divide-y divide-slate-100 dark:divide-slate-800 border border-slate-200 dark:border-slate-800 rounded-lg mb-3" data-testid="filing-package-parts">
                {% for part in package.parts %}
                    {% set chip_key = part.signatureStatus.value == 'PRESENT_PROBABLE'
                        ? (part.signatureAccepted ? 'PRESENT_PROBABLE_confirmed' : 'PRESENT_PROBABLE_unconfirmed')
                        : (part.signatureStatus.value == 'PRESENT_MATCHED' ? 'PRESENT_MATCHED' : 'MISSING') %}
                    <li class="p-3" data-testid="filing-part-{{ part.id }}">
                        <div class="flex items-start justify-between gap-3">
                            <div class="min-w-0">
                                <p class="text-sm font-medium text-slate-900 dark:text-slate-100">{{ part.title }}</p>
                                <p class="text-[11px] text-slate-500">
                                    {{ 'filing.package.part_meta'|trans({'%pages%': part.pageCount, '%size%': (part.unsignedBytes / 1048576)|number_format(2, ',', '.')}) }}
                                    {% if part.annexPageFrom %} · {{ part.annexPageFrom == part.annexPageTo ? 'filing.package.part_annex_page'|trans({'%page%': part.annexPageFrom}) : 'filing.package.part_annex_range'|trans({'%from%': part.annexPageFrom, '%to%': part.annexPageTo}) }}{% endif %}
                                </p>
                                <div class="mt-1 flex flex-wrap gap-1">
                                    <span class="inline-flex rounded px-1.5 py-0.5 text-[10px] font-semibold {{ chip_key == 'MISSING' ? 'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-200' : (chip_key == 'PRESENT_PROBABLE_unconfirmed' ? 'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-200' : 'bg-emerald-50 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-200') }}" data-testid="filing-part-signature-chip">
                                        {{ ('filing.signature.chip.' ~ chip_key)|trans }}
                                    </span>
                                    {% if part.compressionApplied %}
                                        <span class="inline-flex rounded px-1.5 py-0.5 text-[10px] font-semibold bg-sky-50 text-sky-800 dark:bg-sky-900/40 dark:text-sky-200" data-testid="filing-part-compressed">{{ 'filing.package.compressed_badge'|trans }}</span>
                                    {% endif %}
                                </div>
                                {% if chip_key != 'MISSING' %}
                                    {# Shown with every detected signature and never dismissable. #}
                                    <p class="mt-1 text-[11px] text-slate-500 dark:text-slate-400" data-testid="filing-part-validity-notice">{{ 'filing.signature.notice.validity'|trans }}</p>
                                    {% if part.signatureReport.signerCn|default(null) %}
                                        <p class="text-[11px] text-slate-500">{{ 'filing.signature.signer'|trans({'%name%': part.signatureReport.signerCn}) }}</p>
                                    {% endif %}
                                    {% for warning in part.signatureWarnings %}
                                        <p class="mt-1 flex gap-1 text-[11px] text-amber-800 dark:text-amber-200" data-testid="filing-part-warning">
                                            {{ icon_warning('size-3.5 shrink-0 mt-0.5') }}<span>{{ warning|trans }}</span>
                                        </p>
                                    {% endfor %}
                                {% endif %}
                            </div>
                            {% if is_owner %}
                                <div class="shrink-0 flex flex-col items-end gap-1">
                                    <a href="{{ path('case_filing_part_download', {id: case.id, packageId: package.id, partId: part.id}) }}"
                                       data-turbo="false"
                                       class="py-1.5 px-2.5 inline-flex items-center gap-1 text-xs font-semibold rounded-lg border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-800 transition">
                                        {{ icon_download('size-3.5') }}
                                        {{ 'filing.package.download_unsigned'|trans }}
                                    </a>
                                    {% if part.hasSignedFile %}
                                        <a href="{{ path('case_filing_part_download_signed', {id: case.id, packageId: package.id, partId: part.id}) }}"
                                           data-turbo="false" data-testid="filing-part-download-signed"
                                           class="py-1.5 px-2.5 inline-flex items-center gap-1 text-xs font-semibold rounded-lg border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-800 transition">
                                            {{ icon_download('size-3.5') }}
                                            {{ 'filing.upload.download_signed'|trans }}
                                        </a>
                                    {% endif %}
                                </div>
                            {% endif %}
                        </div>

                        {% if uploads_open %}
                            {% if part.awaitingProbableConfirmation %}
                                <form method="post" action="{{ path('case_filing_part_confirm_signed', {id: case.id, packageId: package.id, partId: part.id}) }}" class="mt-2" data-testid="filing-part-confirm-form">
                                    <input type="hidden" name="_token" value="{{ csrf_token('filing_signed_confirm_' ~ part.id) }}">
                                    <input type="hidden" name="sha256" value="{{ part.signedSha256 }}">
                                    <button type="submit" class="py-1.5 px-2.5 inline-flex items-center gap-1 text-xs font-semibold rounded-lg bg-amber-100 text-amber-900 hover:bg-amber-200 dark:bg-amber-900/40 dark:text-amber-100 transition">
                                        {{ icon_check('size-3.5') }}
                                        {{ 'filing.upload.confirm_button'|trans }}
                                    </button>
                                </form>
                            {% endif %}
                            <form method="post" enctype="multipart/form-data"
                                  action="{{ path('case_filing_part_upload_signed', {id: case.id, packageId: package.id, partId: part.id}) }}"
                                  class="mt-2 space-y-1.5" data-testid="filing-part-upload-form">
                                <input type="hidden" name="_token" value="{{ csrf_token('filing_signed_upload_' ~ part.id) }}">
                                {% if part.signatureAccepted %}<input type="hidden" name="replace" value="1">{% endif %}
                                <label class="block text-[11px] text-slate-600 dark:text-slate-300">
                                    {{ 'filing.upload.label'|trans }}
                                    <input type="file" name="signed_file" accept="application/pdf" required
                                           class="mt-1 block w-full text-xs text-slate-700 dark:text-slate-200 file:mr-2 file:py-1 file:px-2 file:rounded file:border-0 file:text-xs file:font-semibold file:bg-slate-100 file:text-slate-700 dark:file:bg-slate-800 dark:file:text-slate-200">
                                </label>
                                <button type="submit" class="py-1.5 px-2.5 inline-flex items-center gap-1 text-xs font-semibold rounded-lg bg-lex-navy text-white hover:bg-lex-navy-dark transition">
                                    {{ (part.signatureAccepted ? 'filing.upload.replace' : 'filing.upload.button')|trans }}
                                </button>
                            </form>
                        {% endif %}

                        {% if over_budget and over_budget.partId == part.id %}
                            <div class="mt-2 rounded-lg bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-900/60 p-3 text-xs text-amber-900 dark:text-amber-100" data-testid="filing-part-over-budget">
                                <p>{{ 'filing.upload.over_budget.text'|trans({'%excess%': (over_budget.excess / 1048576)|number_format(2, ',', '.')}) }}</p>
                                <form method="post" action="{{ path('case_filing_package_rebuild_annexes', {id: case.id, packageId: package.id}) }}" class="mt-2">
                                    <input type="hidden" name="_token" value="{{ csrf_token('filing_annex_rebuild_' ~ package.id) }}">
                                    <input type="hidden" name="excess" value="{{ over_budget.excess }}">
                                    <button type="submit" data-testid="filing-rebuild-annexes" class="py-1.5 px-2.5 inline-flex items-center gap-1 text-xs font-semibold rounded-lg bg-white border border-amber-300 text-amber-900 hover:bg-amber-100 transition">
                                        {{ icon_refresh('size-3.5') }}
                                        {{ 'filing.upload.over_budget.rebuild_button'|trans }}
                                    </button>
                                </form>
                            </div>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>

            <p class="text-xs text-slate-600 dark:text-slate-300 mb-1" data-testid="filing-package-emails">{{ 'filing.package.emails_info'|trans({'%count%': package.emailCount}) }}</p>
            {% if package.annexVolumeCount > 1 %}
                <p class="text-xs text-slate-600 dark:text-slate-300 mb-1" data-testid="filing-package-volumes">{{ 'filing.package.volumes_banner'|trans({'%count%': package.annexVolumeCount}) }}</p>
            {% endif %}
            {% if package.skippedDocuments is not empty %}
                <p class="text-xs text-amber-800 dark:text-amber-200 mb-1">{{ 'filing.package.skipped_documents'|trans({'%documents%': package.skippedDocuments|join(', ')}) }}</p>
            {% endif %}
            {% if not is_owner %}
                <p class="text-xs text-slate-500 mb-1">{{ 'filing.package.owner_only'|trans }}</p>
            {% endif %}
        {% endif %}

        {% if can_build and (package is null or package.status.value == 'STALE') %}
            <form method="post" action="{{ path('case_filing_package_build', {id: case.id}) }}" class="mt-3">
                <input type="hidden" name="_token" value="{{ csrf_token('filing_package_build_' ~ case.id) }}">
                <button type="submit" data-testid="filing-package-build"
                        class="w-full py-2.5 px-3 inline-flex items-center justify-center gap-2 text-sm font-semibold rounded-lg bg-lex-navy text-white hover:bg-lex-navy-dark transition">
                    {{ icon_refresh('size-4') }}
                    {{ (package ? 'filing.package.rebuild' : 'filing.package.build')|trans }}
                </button>
            </form>
        {% endif %}

        <div class="mt-4 space-y-2 text-[11px] text-slate-500 dark:text-slate-400">
            <p class="flex gap-1.5">{{ icon_lock('size-3.5 shrink-0 mt-0.5') }}<span>{{ 'filing.package.unsigned_instructions'|trans }}</span></p>
            {% if package %}
                <div data-testid="filing-signature-notice">
                    <p>{{ 'filing.signature.notice.validity'|trans }}</p>
                    <p class="mt-0.5">
                        <a href="{{ validator_url }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 underline hover:text-slate-700 dark:hover:text-slate-200">
                            {{ 'filing.signature.notice.validator_link'|trans }}{{ icon_external_link('size-3') }}
                        </a>
                    </p>
                    <p class="mt-0.5">{{ 'filing.signature.notice.validator_consent'|trans }}</p>
                    <p class="mt-0.5">{{ 'filing.signature.notice.responsibility'|trans }}</p>
                </div>
            {% endif %}
            <p>{{ 'filing.package.cover_text_provisional'|trans }}</p>
            <p>{{ 'filing.package.compression_note'|trans }}</p>
        </div>
    </div>
</section>
