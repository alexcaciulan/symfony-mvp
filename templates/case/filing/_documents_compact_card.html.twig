{# Documents tab: where the email filing stands, in one line, and the way to the
   filing tab. The flow itself lives in that tab. #}
<section id="filing-documents-card" class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-soft p-5" data-testid="filing-documents-card">
    {% if filing_tab_visible|default(false) and filing_panel|default(null) %}
        {% set panel = filing_panel %}
        <div class="flex items-start justify-between gap-3">
            <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">{{ 'filing.panel.compact.title'|trans }}</h3>
            {% if panel.tabDot %}
                <span class="mt-1 size-2 shrink-0 rounded-full {{ {'red': 'bg-red-500', 'amber': 'bg-amber-500'}[panel.tabDot] ?? 'bg-blue-500' }}" aria-hidden="true"></span>
            {% endif %}
        </div>
        <p class="mt-2 text-sm font-medium {{ {'red': 'text-red-700 dark:text-red-300', 'amber': 'text-amber-800 dark:text-amber-200', 'green': 'text-emerald-700 dark:text-emerald-300'}[panel.tone] ?? 'text-slate-800 dark:text-slate-100' }}" data-testid="filing-documents-card-title">{{ panel.titleKey|trans(panel.titleParams) }}</p>
        <p class="mt-0.5 text-sm text-slate-600 dark:text-slate-300">{{ ('filing.panel.compact.' ~ (panel.tabDot ?? 'none'))|trans }}</p>
        <a href="{{ path('case_overview', {id: case.id, tab: 'depunere'}) }}" data-turbo-frame="_top" data-testid="filing-documents-card-open"
           class="mt-3 py-2 px-3.5 inline-flex items-center gap-2 rounded-lg bg-lex-navy text-white text-sm font-semibold hover:bg-lex-navy-dark transition">{{ 'filing.panel.action.open_tab'|trans }}</a>
    {% endif %}
</section>
