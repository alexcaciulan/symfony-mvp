{# Sidebar ZIP package. CTA: dacă cerere OP încă negenerată → deschide modal generate; dacă există → link direct la GET download. #}
{% from 'case/overview/_icons.html.twig' import icon_check, icon_download, icon_document %}

{% set intro_key = case.court ? 'case_overview.zip_package.intro' : 'case_overview.zip_package.intro_no_court' %}
{% set intro_params = case.court ? {'%court%': case.court.name} : {} %}
{% set payment_order_doc = case.documents|filter(d => d.documentType.value == 'cerere_op')|first %}

<section class="bg-gradient-to-br from-lex-navy to-lex-navy-dark text-white rounded-2xl shadow-card overflow-hidden">
    <div class="p-5">
        <div class="flex items-center gap-2 mb-3">
            {{ icon_document('size-5') }}
            <h3 class="text-sm font-semibold">{{ 'case_overview.zip_package.title'|trans }}</h3>
        </div>
        <p class="text-xs text-blue-100/80 mb-4">{{ intro_key|trans(intro_params) }}</p>
        <ul class="space-y-1.5 text-xs">
            <li class="flex items-center gap-2">
                {{ icon_check('size-3.5 text-green-300') }}
                {{ 'case_overview.zip_package.item_cerere'|trans }}
            </li>
            <li class="flex items-center gap-2">
                {{ icon_check('size-3.5 text-green-300') }}
                {{ 'case_overview.zip_package.item_opis'|trans }}
            </li>
            <li class="flex items-center gap-2">
                {{ icon_check('size-3.5 text-green-300') }}
                {{ 'case_overview.zip_package.item_somatie'|trans }}
            </li>
            <li class="flex items-center gap-2">
                {% if case.stampDutyStatus.value == 'ACHITATA' %}
                    {{ icon_check('size-3.5 text-green-300') }}
                {% else %}
                    <span class="size-3.5 inline-flex items-center justify-center text-amber-300" aria-hidden="true">!</span>
                {% endif %}
                {{ 'case_overview.zip_package.item_stamp_duty'|trans }}
            </li>
            <li class="flex items-center gap-2">
                {{ icon_check('size-3.5 text-green-300') }}
                {{ 'case_overview.zip_package.item_evidence'|trans }}
            </li>
        </ul>
        {% if payment_order_doc and not (has_communication_proof|default(false)) %}
            {# The download refuses without the proof of service. Saying so here, with the
               upload at hand, keeps the refusal off a reloaded page. #}
            <div class="mt-4 rounded-lg bg-white/10 ring-1 ring-white/25 p-3 text-xs">
                <p class="font-semibold">{{ 'case_overview.zip_package.blocked_proof_title'|trans }}</p>
                <p class="mt-0.5 text-white/80">{{ 'case_overview.zip_package.blocked_proof_body'|trans }}</p>
                <button type="button"
                        data-hs-overlay="#hs-modal-upload-document"
                        data-upload-preset-type="dovada_comunicare"
                        class="mt-2 py-1.5 px-3 inline-flex items-center gap-1.5 text-xs font-semibold rounded-lg bg-white text-lex-navy hover:bg-blue-50 transition">
                    {{ 'case_overview.zip_package.blocked_proof_cta'|trans }}
                </button>
            </div>
        {% elseif payment_order_doc %}
            <a href="{{ path('case_zip_package_download', {id: case.id}) }}"
               class="mt-4 w-full py-2.5 px-3 inline-flex items-center justify-center gap-2 text-sm font-bold rounded-lg bg-white text-lex-navy hover:bg-blue-50 transition shadow-lg">
                {{ icon_download('size-4') }}
                {{ 'case_overview.zip_package.cta_download'|trans }}
            </a>
        {% else %}
            <button type="button"
                    data-hs-overlay="#hs-modal-cerere-op"
                    class="mt-4 w-full py-2.5 px-3 inline-flex items-center justify-center gap-2 text-sm font-bold rounded-lg bg-white text-lex-navy hover:bg-blue-50 transition shadow-lg">
                {{ icon_download('size-4') }}
                {{ 'case_overview.zip_package.cta'|trans }}
            </button>
        {% endif %}
    </div>
</section>
