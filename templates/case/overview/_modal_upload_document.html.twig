{# Modal Preline „Adaugă document" (atașament dosar). Trigger via
   `data-hs-overlay="#hs-modal-upload-document"` din `_documents_source_list` și
   din `_communication_warning` (acesta din urmă preselectează tipul prin
   `data-upload-preset-type`, vezi controllerul Stimulus `document-upload-preset`).
   Submit multipart către `case_document_upload` cu CSRF nativ form. Documentele
   de aici sunt pure atașamente: NU declanșează extracție AI. #}
{# `document_upload_types` vine din OverviewContextBuilder (DocumentType::uploadableTypes()),
   aceeași sursă ca alegerile din DocumentUploadType, ca să nu diverge. #}
{% from 'case/overview/_icons.html.twig' import icon_document %}

<div id="hs-modal-upload-document"
     data-controller="document-upload-preset"
     class="hs-overlay hidden size-full fixed top-0 start-0 z-[80] overflow-x-hidden overflow-y-auto pointer-events-none"
     role="dialog"
     tabindex="-1"
     aria-labelledby="hs-modal-upload-document-title">
    <div class="hs-overlay-open:mt-7 hs-overlay-open:opacity-100 hs-overlay-open:duration-500 mt-0 opacity-0 ease-out transition-all sm:max-w-lg sm:w-full m-3 sm:mx-auto">
        <form method="post"
              action="{{ path('case_document_upload', {caseId: case.id}) }}"
              enctype="multipart/form-data"
              data-turbo-frame="_top"
              class="flex flex-col bg-white border border-slate-200 shadow-lg rounded-2xl pointer-events-auto dark:bg-slate-900 dark:border-slate-800">
            <input type="hidden" name="document_upload[_token]" value="{{ csrf_token('document_upload') }}">

            <div class="flex justify-between items-center py-4 px-5 border-b border-slate-100 dark:border-slate-800">
                <div class="flex items-center gap-3">
                    <span class="inline-flex items-center justify-center size-9 rounded-lg bg-blue-100 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400">
                        {{ icon_document('size-5') }}
                    </span>
                    <h3 id="hs-modal-upload-document-title" class="font-bold text-slate-900 dark:text-white">{{ 'case_overview.documents.modal_upload.title'|trans }}</h3>
                </div>
                <button type="button"
                        class="size-8 inline-flex justify-center items-center rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 hover:bg-slate-200 dark:text-slate-100 dark:hover:bg-slate-700"
                        aria-label="{{ 'case_overview.modal.aria_close'|trans }}"
                        data-hs-overlay="#hs-modal-upload-document">
                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            <div class="p-5 space-y-4">
                <p class="text-sm text-slate-600 dark:text-slate-400">{{ 'case_overview.documents.modal_upload.intro'|trans }}</p>

                <div>
                    <label for="document_upload_file" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">{{ 'case_overview.documents.modal_upload.field_file_label'|trans }}</label>
                    <input type="file"
                           id="document_upload_file"
                           name="document_upload[file]"
                           required
                           accept=".pdf,.jpg,.jpeg,.png"
                           class="block w-full text-sm text-slate-600 dark:text-slate-400 file:mr-3 file:py-2 file:px-3 file:rounded-lg file:border-0 file:text-sm file:font-medium file:cursor-pointer file:bg-slate-100 file:text-slate-700 hover:file:bg-slate-200 dark:file:bg-slate-800 dark:file:text-slate-200 dark:hover:file:bg-slate-700">
                    <p class="mt-1.5 text-xs text-slate-400 dark:text-slate-500">{{ 'case_overview.documents.modal_upload.field_file_hint'|trans }}</p>
                </div>

                <div>
                    <label for="document_upload_documentType" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">{{ 'case_overview.documents.modal_upload.field_type_label'|trans }}</label>
                    <select id="document_upload_documentType"
                            name="document_upload[documentType]"
                            data-document-upload-preset-target="type"
                            class="wizard-select w-full py-2 px-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm text-slate-900 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                        {% for t in document_upload_types %}
                            <option value="{{ t.value }}">{{ ('document.type.' ~ t.value)|trans }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            <div class="flex justify-end items-center gap-x-2 py-3 px-5 border-t border-slate-100 dark:border-slate-800">
                <button type="button"
                        class="py-2 px-3 inline-flex items-center text-sm font-medium rounded-lg border border-slate-200 bg-white text-slate-800 hover:bg-slate-50 dark:bg-slate-900 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
                        data-hs-overlay="#hs-modal-upload-document">
                    {{ 'case_overview.documents.modal_upload.cancel'|trans }}
                </button>
                <button type="submit"
                        class="py-2 px-4 inline-flex items-center text-sm font-semibold rounded-lg bg-lex-navy text-white hover:bg-lex-navy/90 transition">
                    {{ 'case_overview.documents.modal_upload.submit'|trans }}
                </button>
            </div>
        </form>
    </div>
</div>
