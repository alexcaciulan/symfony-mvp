{# The fields of one invoice, posted to `form_action`: the manual pane of the add
   dialog and the reading of an uploaded invoice share it. `values` prefill the
   inputs, `detected` names the fields the reading supplied (tagged as such),
   `scope` keeps the ids unique between the two panes. #}
{% set values = values|default({}) %}
{% set detected = detected|default([]) %}
{% set scope = scope|default('manual') %}
{% set fld = 'w-full py-2 px-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm text-slate-900 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500' %}
{% set lbl = 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5' %}
{% macro tag_detected(field, detected) %}{% if field in detected %}<span class="ml-1 inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold bg-blue-100 text-blue-800 dark:bg-blue-950/40 dark:text-blue-300">{{ 'case.claim.edit.detected'|trans }}</span>{% endif %}{% endmacro %}
{% import _self as m %}

<form method="post" action="{{ form_action }}" data-turbo-frame="_top" data-testid="claim-position-form-{{ scope }}" class="space-y-4">
    <input type="hidden" name="claim_position[_token]" value="{{ csrf_token('claim_position') }}">
    {% if source_document_id|default(null) %}
        <input type="hidden" name="claim_position[sourceDocumentId]" value="{{ source_document_id }}">
    {% endif %}

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
            <label for="claim_position_{{ scope }}_documentNumber" class="{{ lbl }}">{{ 'case.claim.edit.field_document_number'|trans }}{{ m.tag_detected('documentNumber', detected) }}</label>
            <input type="text" id="claim_position_{{ scope }}_documentNumber" name="claim_position[documentNumber]" maxlength="100" value="{{ values.documentNumber|default('') }}" placeholder="{{ 'case.claim.edit.field_document_number_placeholder'|trans }}" class="{{ fld }}">
        </div>
        <div>
            <label for="claim_position_{{ scope }}_documentDate" class="{{ lbl }}">{{ 'case.claim.edit.field_document_date'|trans }}{{ m.tag_detected('documentDate', detected) }}</label>
            <input type="date" id="claim_position_{{ scope }}_documentDate" name="claim_position[documentDate]" max="{{ 'now'|date('Y-m-d') }}" value="{{ values.documentDate|default('') }}" class="{{ fld }} tnum">
        </div>
        <div>
            <label for="claim_position_{{ scope }}_dueDate" class="{{ lbl }}">{{ 'case.claim.edit.field_due_date'|trans }}{{ m.tag_detected('dueDate', detected) }}</label>
            <input type="date" id="claim_position_{{ scope }}_dueDate" name="claim_position[dueDate]" required value="{{ values.dueDate|default('') }}" class="{{ fld }} tnum">
            <p class="mt-1 text-[11px] text-slate-500">{{ 'case.claim.edit.field_due_date_hint'|trans }}</p>
        </div>
        <div class="grid grid-cols-3 gap-2">
            <div class="col-span-2">
                <label for="claim_position_{{ scope }}_amount" class="{{ lbl }}">{{ 'case.claim.edit.field_amount'|trans }}{{ m.tag_detected('amount', detected) }}</label>
                <input type="number" step="0.01" min="0.01" id="claim_position_{{ scope }}_amount" name="claim_position[amount]" required value="{{ values.amount|default('') }}" placeholder="0.00" class="{{ fld }} tnum">
            </div>
            <div>
                <label for="claim_position_{{ scope }}_currency" class="{{ lbl }}">{{ 'case.claim.edit.field_currency'|trans }}</label>
                <select id="claim_position_{{ scope }}_currency" name="claim_position[currency]" class="{{ fld }}">
                    {% for currency in ['RON', 'EUR'] %}
                        <option value="{{ currency }}" {{ (values.currency|default('RON')) == currency ? 'selected' : '' }}>{{ currency }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>
        {% if case.debtors|length > 1 %}
            <div class="sm:col-span-2">
                <label for="claim_position_{{ scope }}_debtorId" class="{{ lbl }}">{{ 'case.claim.edit.field_debtor'|trans }}</label>
                <select id="claim_position_{{ scope }}_debtorId" name="claim_position[debtorId]" required class="{{ fld }}">
                    <option value="">{{ 'case.claim.edit.field_debtor_placeholder'|trans }}</option>
                    {% for link in case.debtors %}
                        <option value="{{ link.id }}">{{ link.name }}{% if link.cui %} ({{ link.cui }}){% endif %}</option>
                    {% endfor %}
                </select>
            </div>
        {% endif %}
        <div class="sm:col-span-2">
            <label for="claim_position_{{ scope }}_causeReference" class="{{ lbl }}">{{ 'case.claim.edit.field_cause_reference'|trans }}{{ m.tag_detected('causeReference', detected) }} <span class="font-normal text-slate-400">({{ 'case.claim.edit.optional'|trans }})</span></label>
            <input type="text" id="claim_position_{{ scope }}_causeReference" name="claim_position[causeReference]" maxlength="255" value="{{ values.causeReference|default('') }}" placeholder="{{ case.contractReference|default('case.claim.edit.field_cause_reference_placeholder'|trans) }}" class="{{ fld }}">
            <p class="mt-1 text-[11px] text-slate-500">{{ 'case.claim.edit.field_cause_reference_hint'|trans }}</p>
        </div>
        <div class="sm:col-span-2">
            <label for="claim_position_{{ scope }}_description" class="{{ lbl }}">{{ 'case.claim.edit.field_description'|trans }}{{ m.tag_detected('description', detected) }} <span class="font-normal text-slate-400">({{ 'case.claim.edit.optional'|trans }})</span></label>
            <input type="text" id="claim_position_{{ scope }}_description" name="claim_position[description]" maxlength="2000" value="{{ values.description|default('') }}" placeholder="{{ 'case.claim.edit.field_description_placeholder'|trans }}" class="{{ fld }}">
        </div>
    </div>

    {% if scope == 'manual' %}
        <p class="flex items-start gap-2 rounded-lg bg-slate-50 dark:bg-slate-950/40 border border-slate-200 dark:border-slate-800 px-3 py-2.5 text-xs text-slate-600 dark:text-slate-400">
            <svg class="size-4 shrink-0 text-slate-400 mt-px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>{{ 'case.claim.edit.manual_no_partial_payment'|trans }}</span>
        </p>
    {% endif %}

    {% if party_check|default(null) %}
        <div class="space-y-1.5 text-sm" aria-label="{{ 'case.claim.edit.party_check'|trans }}" data-testid="claim-party-check">
            {% for party in ['creditor', 'debtor'] %}
                {% set status = attribute(party_check, party).value %}
                {% set name = attribute(party_check, 'extracted' ~ (party|capitalize) ~ 'Name') %}
                {% set cui = attribute(party_check, 'extracted' ~ (party|capitalize) ~ 'Cui') %}
                {% set name_ok = attribute(party_check, party ~ 'NameMatches') %}
                {% set ok = status == 'match' or (status == 'unknown' and name_ok) %}
                <p class="flex items-start gap-2 {{ ok ? 'text-green-700 dark:text-green-400' : 'text-amber-700 dark:text-amber-400' }}">
                    <span aria-hidden="true">{{ ok ? '✓' : '?' }}</span>
                    <span>{{ ('case.claim.edit.party_' ~ party)|trans }}: {{ name|default('—') }}{% if cui %} (CUI {{ cui }}){% endif %} · {{ (ok ? 'case.claim.edit.party_matches' : 'case.claim.edit.party_unverified')|trans }}</span>
                </p>
            {% endfor %}
        </div>
    {% endif %}

    {% if warning_keys|default([])|length > 0 %}
        <ul class="space-y-1 text-xs text-amber-800 dark:text-amber-200" data-testid="claim-position-warnings-extracted">
            {% for key in warning_keys %}<li>{{ key|trans }}</li>{% endfor %}
        </ul>
    {% endif %}

    {# Filled by the server when the position needs an explicit confirmation (another contract). #}
    <div id="claim-position-warnings-{{ scope }}"></div>

    {% if case.paymentNoticeDate %}
        <p class="text-xs text-amber-800 dark:text-amber-200" data-testid="claim-summons-regenerate-note">{{ 'case.claim.edit.details_payment_notice_regenerate'|trans({'%date%': case.paymentNoticeDate|date('d.m.Y')}) }}</p>
    {% endif %}

    <div class="flex justify-end items-center gap-x-2 pt-2">
        <button type="button" class="py-2 px-3 inline-flex items-center text-sm font-medium rounded-lg border border-slate-200 bg-white text-slate-800 hover:bg-slate-50 dark:bg-slate-900 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800" data-hs-overlay="#hs-modal-claim-add">{{ 'case.claim.edit.cancel'|trans }}</button>
        <button type="submit" data-testid="claim-position-submit-{{ scope }}" class="py-2 px-4 inline-flex items-center text-sm font-semibold rounded-lg bg-lex-navy text-white hover:bg-lex-navy/90 transition">{{ 'case.claim.edit.submit_position'|trans }}</button>
    </div>
</form>
