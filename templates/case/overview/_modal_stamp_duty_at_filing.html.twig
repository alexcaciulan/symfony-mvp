{# Plata taxei în chiar formularul registraturii electronice, odată cu depunerea.
   Nu e o amânare: taxa se achită anticipat în sensul OUG 80/2013 art. 33 alin. 1,
   doar că momentul cade după generarea pachetului, fiindcă pachetul e ce se depune. #}
{% from 'case/overview/_icons.html.twig' import icon_money %}

<div id="hs-modal-stamp-duty-at-filing"
     class="hs-overlay hidden size-full fixed top-0 start-0 z-[80] overflow-x-hidden overflow-y-auto pointer-events-none"
     role="dialog"
     tabindex="-1"
     aria-labelledby="hs-modal-stamp-duty-at-filing-title">
    <div class="hs-overlay-open:mt-7 hs-overlay-open:opacity-100 hs-overlay-open:duration-500 mt-0 opacity-0 ease-out transition-all sm:max-w-lg sm:w-full m-3 sm:mx-auto">
        <form method="post" action="{{ path('case_stamp_duty_at_filing', {id: case.id}) }}" data-turbo-frame="_top" class="flex flex-col bg-white border border-slate-200 shadow-lg rounded-2xl pointer-events-auto dark:bg-slate-900 dark:border-slate-800">
            <input type="hidden" name="_token" value="{{ csrf_token('stamp_duty_at_filing_' ~ case.id) }}">

            <div class="flex justify-between items-center py-4 px-5 border-b border-slate-100 dark:border-slate-800">
                <div class="flex items-center gap-3">
                    <span class="inline-flex items-center justify-center size-9 rounded-lg bg-blue-100 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400">
                        {{ icon_money('size-5') }}
                    </span>
                    <h3 id="hs-modal-stamp-duty-at-filing-title" class="font-bold text-slate-900 dark:text-white">{{ 'case_overview.stamp_duty.modal_at_filing.title'|trans }}</h3>
                </div>
                <button type="button"
                        class="size-8 inline-flex justify-center items-center rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 hover:bg-slate-200 dark:text-slate-100 dark:hover:bg-slate-700"
                        aria-label="{{ 'case_overview.modal.aria_close'|trans }}"
                        data-hs-overlay="#hs-modal-stamp-duty-at-filing">
                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            <div class="p-5 space-y-4">
                <p class="text-sm text-slate-600 dark:text-slate-400">{{ 'case_overview.stamp_duty.modal_at_filing.intro'|trans }}</p>

                <div class="rounded-lg border border-blue-200 dark:border-blue-900/40 bg-blue-50 dark:bg-blue-950/20 p-3">
                    <div class="text-xs text-blue-900 dark:text-blue-200 space-y-1">
                        <p class="font-semibold">{{ 'case_overview.stamp_duty.modal_at_filing.note_title'|trans }}</p>
                        <p>{{ 'case_overview.stamp_duty.modal_at_filing.note_body'|trans }}</p>
                    </div>
                </div>
            </div>

            <div class="flex justify-end items-center gap-x-2 py-3 px-5 border-t border-slate-100 dark:border-slate-800">
                <button type="button"
                        class="py-2 px-3 inline-flex items-center text-sm font-medium rounded-lg border border-slate-200 bg-white text-slate-800 hover:bg-slate-50 dark:bg-slate-900 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
                        data-hs-overlay="#hs-modal-stamp-duty-at-filing">
                    {{ 'case_overview.stamp_duty.modal_at_filing.cancel'|trans }}
                </button>
                <button type="submit"
                        class="py-2 px-4 inline-flex items-center text-sm font-semibold rounded-lg bg-blue-600 text-white hover:bg-blue-700 transition">
                    {{ 'case_overview.stamp_duty.modal_at_filing.submit'|trans }}
                </button>
            </div>
        </form>
    </div>
</div>
