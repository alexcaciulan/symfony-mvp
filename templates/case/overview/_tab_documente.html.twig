{# Tab Documente orchestrator: main col-span-2 (summons communication + Generated +
   Source) + sidebar (Taxă timbru + ZIP). Cardul taxei stă deasupra ZIP-ului
   fiindcă plata condiționează pachetul: dovada trebuie atașată cererii (CPC art. 197). #}

{# The communication card leads the column while date or proof is missing and drops
   below the generated documents once complete. #}
{% set has_summons = case.documents|filter(d => d.documentType.value == 'somatie')|length > 0 %}
{% set show_communication_card = has_summons and not case.fullPaymentDate %}
{% set communication_pending = case.paymentNoticeCommunicationDate is null or communication_proof|default(null) is null %}

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <div class="lg:col-span-2 space-y-6">
        {% if show_communication_card and communication_pending %}
            {{ include('case/overview/_summons_communication_card.html.twig') }}
        {% endif %}
        {{ include('case/overview/_documents_generated_list.html.twig') }}
        {% if show_communication_card and not communication_pending %}
            {{ include('case/overview/_summons_communication_card.html.twig') }}
        {% endif %}
        {{ include('case/overview/_documents_source_list.html.twig') }}
    </div>

    <aside class="space-y-6">
        {% if case.status.value not in ['AMIABIL', 'RESPINSA', 'INCHIS_SUCCES', 'INCHIS_FARA_RECUPERARE'] %}
            {{ include('case/overview/_stamp_duty_card.html.twig') }}
        {% endif %}
        {% if not case.fullPaymentDate %}
            {{ include('case/overview/_zip_package_card.html.twig') }}
        {% endif %}
    </aside>

</div>
