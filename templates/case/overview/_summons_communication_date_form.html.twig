{# Inline date + method form of the summons communication card. Posts to the same
   endpoint as the case and agenda dialogs, so the 15-day and six-month terms are
   created or recomputed in one place. `return_tab` keeps the lawyer on Documente.
   Params: case, id_suffix, submit_key, current_date (Y-m-d or null), current_method. #}
<form method="post"
      action="{{ path('case_deadline_summons_communication_date', {caseId: case.id}) }}"
      class="space-y-3">
    <input type="hidden" name="payment_notice_communication_date[_token]" value="{{ csrf_token('payment_notice_communication_date') }}">
    <input type="hidden" name="return_tab" value="documente">

    <div class="space-y-3">
        <div>
            <label for="summons_card_date_{{ id_suffix }}" class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">{{ 'case_overview.summons_card.field_date'|trans }}</label>
            <input type="date"
                   id="summons_card_date_{{ id_suffix }}"
                   name="payment_notice_communication_date[paymentNoticeCommunicationDate]"
                   value="{{ current_date }}"
                   required
                   max="{{ 'now'|date('Y-m-d') }}"
                   class="w-full py-2 px-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>
        <div>
            <label for="summons_card_method_{{ id_suffix }}" class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">{{ 'case_overview.summons_card.field_method'|trans }}</label>
            <select id="summons_card_method_{{ id_suffix }}"
                    name="payment_notice_communication_date[paymentNoticeCommunicationMethod]"
                    required
                    class="w-full py-2 px-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                <option value="">{{ 'case_overview.summons.modal_communication_date.field_method_placeholder'|trans }}</option>
                {% for method in ['EXECUTOR', 'POSTA_RCD'] %}
                    <option value="{{ method }}" {{ current_method == method ? 'selected' : '' }}>{{ ('enum.payment_notice_communication_method.' ~ method)|trans }}</option>
                {% endfor %}
            </select>
        </div>
    </div>

    <button type="submit"
            class="w-full py-2 px-4 inline-flex items-center justify-center text-sm font-semibold rounded-lg bg-blue-600 text-white hover:bg-blue-700 transition">
        {{ submit_key|trans }}
    </button>
</form>
