{# Pas 4.0.4 — Sidebar amber warning condițional: afișat doar când lipsă document DOVADA_COMUNICARE.
   Reflectă mockup linii 753-762. CTA aria-disabled (post-MVP). #}
{% from 'case/overview/_icons.html.twig' import icon_warning %}

<section class="bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-900/50 rounded-xl p-4">
    <div class="flex items-start gap-2">
        {{ icon_warning('size-4 text-amber-600 dark:text-amber-400 shrink-0 mt-0.5') }}
        <div class="text-xs text-amber-900 dark:text-amber-200">
            <div class="font-bold">{{ 'case_overview.communication_warning.title'|trans }}</div>
            <p class="mt-0.5 text-amber-800 dark:text-amber-300/80">{{ 'case_overview.communication_warning.body'|trans }}</p>
            <button type="button"
                    aria-disabled="true"
                    tabindex="-1"
                    title="{{ 'case_overview.tooltip.coming_soon_doc_upload'|trans }}"
                    class="mt-2 text-xs font-semibold text-amber-700 opacity-60 cursor-not-allowed">
                {{ 'case_overview.communication_warning.cta'|trans }}
            </button>
        </div>
    </div>
</section>
