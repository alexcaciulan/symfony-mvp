{# Turbo Stream response for CasePortalController activate / check-now, so portal
   actions update the page in place (no full reload, no redirect, tab preserved).
   `update_regions` is false for pure error/warning toasts (nothing changed).
   Preline re-inits via preline-init_controller MutationObserver after the swap. #}
{% if update_regions %}
    <turbo-stream action="replace" target="case-hero">
        <template>{{ include('case/overview/_hero.html.twig') }}</template>
    </turbo-stream>
    <turbo-stream action="replace" target="case-pipeline">
        <template>{{ include('case/overview/_pipeline.html.twig') }}</template>
    </turbo-stream>
    <turbo-stream action="replace" target="case-tabs-nav">
        <template>{{ include('case/overview/_tabs_nav.html.twig', { active_tab: 'portal' }) }}</template>
    </turbo-stream>
    {# The nav replace above only marks the tab active; a stream cannot toggle the
       `hidden` class on the panels, so a tiny controller finishes the switch. #}
    <turbo-stream action="append" target="toasts">
        <template><div data-controller="activate-tab" data-activate-tab-tab-value="portal"></div></template>
    </turbo-stream>
    <turbo-stream action="update" target="panel-portal">
        <template>{{ include('case/overview/_tab_portal.html.twig') }}</template>
    </turbo-stream>
    {# A portal event can advance the status and add a deadline, so refresh the
       top KPI card and the Detalii sidebar (recommended actions + deadline ring). #}
    <turbo-stream action="replace" target="case-kpi-grid">
        <template>{{ include('case/overview/_kpi_grid.html.twig') }}</template>
    </turbo-stream>
    <turbo-stream action="update" target="case-detalii-sidebar">
        <template>{{ include('case/overview/_detalii_sidebar.html.twig') }}</template>
    </turbo-stream>
{% endif %}

<turbo-stream action="append" target="toasts">
    <template>
        {% include 'components/Toast.html.twig' with { message: toast_key|trans, variant: toast_variant, details: [] } only %}
    </template>
</turbo-stream>
