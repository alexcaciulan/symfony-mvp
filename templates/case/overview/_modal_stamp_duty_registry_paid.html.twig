{# Confirmarea plății făcute prin registratura electronică. Fără fișier: portalul
   transmite confirmarea direct instanței, deci dovada e deja unde trebuie, iar a
   o cere a doua oară ar însemna să cerem ceva ce nu există la avocat. #}
{% from 'case/overview/_icons.html.twig' import icon_check %}

<div id="hs-modal-stamp-duty-registry-paid"
     class="hs-overlay hidden size-full fixed top-0 start-0 z-[80] overflow-x-hidden overflow-y-auto pointer-events-none"
     role="dialog"
     tabindex="-1"
     aria-labelledby="hs-modal-stamp-duty-registry-paid-title">
    <div class="hs-overlay-open:mt-7 hs-overlay-open:opacity-100 hs-overlay-open:duration-500 mt-0 opacity-0 ease-out transition-all sm:max-w-lg sm:w-full m-3 sm:mx-auto">
        <form method="post" action="{{ path('case_stamp_duty_registry_paid', {id: case.id}) }}" data-turbo-frame="_top" class="flex flex-col bg-white border border-slate-200 shadow-lg rounded-2xl pointer-events-auto dark:bg-slate-900 dark:border-slate-800">
            <input type="hidden" name="_token" value="{{ csrf_token('stamp_duty_registry_paid_' ~ case.id) }}">

            <div class="flex justify-between items-center py-4 px-5 border-b border-slate-100 dark:border-slate-800">
                <div class="flex items-center gap-3">
                    <span class="inline-flex items-center justify-center size-9 rounded-lg bg-green-100 dark:bg-green-950/40 text-green-600 dark:text-green-400">
                        {{ icon_check('size-5') }}
                    </span>
                    <h3 id="hs-modal-stamp-duty-registry-paid-title" class="font-bold text-slate-900 dark:text-white">{{ 'case_overview.stamp_duty.modal_registry_paid.title'|trans }}</h3>
                </div>
                <button type="button"
                        class="size-8 inline-flex justify-center items-center rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 hover:bg-slate-200 dark:text-slate-100 dark:hover:bg-slate-700"
                        aria-label="{{ 'case_overview.modal.aria_close'|trans }}"
                        data-hs-overlay="#hs-modal-stamp-duty-registry-paid">
                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            <div class="p-5 space-y-4">
                <p class="text-sm text-slate-600 dark:text-slate-400">{{ 'case_overview.stamp_duty.modal_registry_paid.intro'|trans }}</p>

                <div>
                    <label for="stamp_duty_registry_paid_at" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">{{ 'case_overview.stamp_duty.modal_registry_paid.field_paid_at'|trans }}</label>
                    <input type="date"
                           id="stamp_duty_registry_paid_at"
                           name="paidAt"
                           required
                           max="{{ 'now'|date('Y-m-d') }}"
                           class="w-full py-2 px-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-green-500">
                </div>

                <div>
                    <label for="stamp_duty_registry_reference" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">{{ 'case_overview.stamp_duty.modal_registry_paid.field_reference'|trans }}</label>
                    <input type="text"
                           id="stamp_duty_registry_reference"
                           name="paymentReference"
                           maxlength="100"
                           class="w-full py-2 px-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-green-500">
                    <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400">{{ 'case_overview.stamp_duty.modal_registry_paid.field_reference_hint'|trans }}</p>
                </div>
            </div>

            <div class="flex justify-end items-center gap-x-2 py-3 px-5 border-t border-slate-100 dark:border-slate-800">
                <button type="button"
                        class="py-2 px-3 inline-flex items-center text-sm font-medium rounded-lg border border-slate-200 bg-white text-slate-800 hover:bg-slate-50 dark:bg-slate-900 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
                        data-hs-overlay="#hs-modal-stamp-duty-registry-paid">
                    {{ 'case_overview.stamp_duty.modal_registry_paid.cancel'|trans }}
                </button>
                <button type="submit"
                        class="py-2 px-4 inline-flex items-center text-sm font-semibold rounded-lg bg-green-600 text-white hover:bg-green-700 transition">
                    {{ 'case_overview.stamp_duty.modal_registry_paid.submit'|trans }}
                </button>
            </div>
        </form>
    </div>
</div>
