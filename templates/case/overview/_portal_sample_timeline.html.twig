{# Pas 4.0.6 — Sample timeline preview (HTML-only, 3 evenimente exemplu cu opacity-60). Texts via i18n.
   Educational preview pentru utilizator (cum va arăta tab-ul după activarea monitorizării). Mockup linii 928-965. #}
{% from 'case/overview/_icons.html.twig' import icon_check, icon_calendar, icon_building %}

<section class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-soft overflow-hidden">
    <header class="px-6 py-4 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
        <h3 class="text-sm font-semibold">{{ 'case_overview.portal.preview_title'|trans }}</h3>
        <span class="text-[10px] text-slate-400 italic">{{ 'case_overview.portal.preview_label'|trans }}</span>
    </header>
    <div class="px-6 py-5 opacity-60" aria-hidden="true">
        <ol class="relative space-y-5">
            <div class="absolute left-[11px] top-2 bottom-2 w-px bg-slate-200 dark:bg-slate-700"></div>

            <li class="relative pl-9">
                <span class="absolute left-0 top-1 inline-flex items-center justify-center size-6 rounded-full bg-gradient-to-br from-purple-400 to-purple-500 text-white shadow-md ring-2 ring-white dark:ring-slate-900">
                    {{ icon_check('size-3') }}
                </span>
                <div class="flex items-baseline justify-between gap-2 mb-0.5">
                    <span class="text-sm font-semibold">{{ 'case_overview.portal.preview_event_1_title'|trans }}</span>
                    <time class="text-[11px] text-slate-500 tnum">{{ 'case_overview.portal.preview_event_1_time'|trans }}</time>
                </div>
                <p class="text-xs text-slate-600 dark:text-slate-400">{{ 'case_overview.portal.preview_event_1_body'|trans }}</p>
            </li>

            <li class="relative pl-9">
                <span class="absolute left-0 top-1 inline-flex items-center justify-center size-6 rounded-full bg-gradient-to-br from-indigo-400 to-indigo-500 text-white shadow-md ring-2 ring-white dark:ring-slate-900">
                    {{ icon_calendar('size-3') }}
                </span>
                <div class="flex items-baseline justify-between gap-2 mb-0.5">
                    <span class="text-sm font-semibold">{{ 'case_overview.portal.preview_event_2_title'|trans }}</span>
                    <time class="text-[11px] text-slate-500 tnum">{{ 'case_overview.portal.preview_event_2_time'|trans }}</time>
                </div>
                <p class="text-xs text-slate-600 dark:text-slate-400">{{ 'case_overview.portal.preview_event_2_body'|trans }}</p>
            </li>

            <li class="relative pl-9">
                <span class="absolute left-0 top-1 inline-flex items-center justify-center size-6 rounded-full bg-gradient-to-br from-blue-400 to-blue-500 text-white shadow-md ring-2 ring-white dark:ring-slate-900">
                    {{ icon_building('size-3') }}
                </span>
                <div class="flex items-baseline justify-between gap-2 mb-0.5">
                    <span class="text-sm font-semibold">{{ 'case_overview.portal.preview_event_3_title'|trans }}</span>
                    <time class="text-[11px] text-slate-500 tnum">{{ 'case_overview.portal.preview_event_3_time'|trans }}</time>
                </div>
                <p class="text-xs text-slate-600 dark:text-slate-400">{{ 'case_overview.portal.preview_event_3_body'|trans }}</p>
            </li>
        </ol>
    </div>
</section>
