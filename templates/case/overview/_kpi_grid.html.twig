{# KPI grid 4 celule. Reflectă mockup linii 329-359. Layout grid-px (separator thin gri prin background-color). #}

{% set principal = case.amount|default(0)|number_format(2, ',', '.') %}
{% set interest = case.calculatedInterest|default(0)|number_format(2, ',', '.') %}
{% set total_value = (case.amount|default(0)) + (case.calculatedInterest|default(0)) %}
{% set total = total_value|number_format(2, ',', '.') %}
{% set stamp_duty = case.stampDuty|default(0)|number_format(2, ',', '.') %}
{% set due_date_label = case.dueDate ? case.dueDate|date('d.m.Y') : ('case_overview.kpi.no_due_date'|trans) %}

{# Interest days span: from dueDate to the reference date of the stored `calculatedInterest` (OG 13/2011). #}
{% set interest_days = 0 %}
{% if case.dueDate %}
    {% set diff_seconds = (accessory_reference_date|default(case.createdAt)|date('U') - case.dueDate|date('U')) %}
    {% set interest_days = (diff_seconds / 86400)|round(0, 'floor') %}
    {% if interest_days < 0 %}{% set interest_days = 0 %}{% endif %}
{% endif %}

{% set interest_hint_key = case.relationshipType and case.relationshipType.value == 'CIVIL'
    ? 'case_overview.kpi.interest_hint_civil'
    : 'case_overview.kpi.interest_hint_commercial' %}

{# The "%days% zile" narrative only holds for a single-period breakdown from one due
   date. On a multi-position claim interest is aggregated per position, so there is
   no single first-period rate and the hint is left out; the lei figure stays correct. #}
{% set first_period_rate = (interest_breakdown is defined and interest_breakdown is not null and interest_breakdown|length > 0)
    ? (interest_breakdown|first).applicableRate
    : null %}
{# The margin follows the contract (+4 pp before Law 72/2013, +8 pp after), so it is read off the computation. #}
{% set first_period_margin = first_period_rate is not null ? (interest_breakdown|first).margin : null %}

{# Active deadline countdown in whole days. #}
{% set deadline_days_remaining = null %}
{% set deadline_expires_label = null %}
{% if active_deadline %}
    {% set diff_seconds = (active_deadline.deadlineDate|date('U') - "now"|date('U')) %}
    {% set deadline_days_remaining = (diff_seconds / 86400)|round(0, 'ceil') %}
    {% if deadline_days_remaining < 0 %}{% set deadline_days_remaining = 0 %}{% endif %}
    {% set deadline_expires_label = active_deadline.deadlineDate|date('d.m.Y') %}
{% endif %}

<section id="case-kpi-grid" class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-slate-100 dark:bg-slate-800 rounded-2xl overflow-hidden shadow-soft border border-slate-200 dark:border-slate-800 mb-6">
    <div class="bg-white dark:bg-slate-900 px-6 py-4 lg:px-8">
        <div class="text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">{{ 'case_overview.kpi.principal'|trans }}</div>
        <div class="mt-1.5 text-2xl font-bold tnum text-slate-900 dark:text-white">{{ principal }}<span class="text-base font-medium text-slate-400 ml-1">{{ case.currency }}</span></div>
        <div class="mt-1 text-xs text-slate-500">{{ 'case_overview.kpi.principal_due'|trans({'%date%': due_date_label}) }}</div>
    </div>

    {# A contractual penalty is not interest and owes nothing to the BNR rate:
       it carries the contract's own name and daily rate here, as in the wizard. #}
    {% set is_contractual = case.penaltyType and case.penaltyType.value == 'CONTRACTUAL' and case.contractualPenaltyRate %}
    <div class="bg-white dark:bg-slate-900 px-6 py-4 lg:px-8">
        <div class="text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">
            {{ is_contractual ? (case.contractualAccessoryLabel ? case.contractualAccessoryLabel.label : 'enum.contractual_accessory_label.PENALITATI_INTARZIERE')|trans : 'case_overview.kpi.interest'|trans }}
        </div>
        <div class="mt-1.5 text-2xl font-bold tnum text-amber-600 dark:text-amber-400">+ {{ interest }}</div>
        {% if is_contractual %}
            <div class="mt-1 text-xs text-slate-500">{{ (case.contractualPenaltyCapPercent ? 'case_overview.kpi.penalty_hint_capped' : 'case_overview.kpi.penalty_hint')|trans({'%rate%': case.contractualPenaltyRate|number_format(2, ',', '.'), '%cap%': case.contractualPenaltyCapPercent|default(0)|percent_number}) }}</div>
        {% elseif first_period_rate is not null %}
            <div class="mt-1 text-xs text-slate-500">{{ interest_hint_key|trans({'%days%': interest_days, '%margin%': first_period_margin ? first_period_margin.value : ''}) }}</div>
        {% endif %}
    </div>

    <div class="bg-white dark:bg-slate-900 px-6 py-4 lg:px-8 relative">
        <div class="absolute top-0 left-0 right-0 h-0.5 bg-gradient-to-r from-blue-500 to-blue-600" aria-hidden="true"></div>
        <div class="text-xs font-medium uppercase tracking-wide text-blue-600 dark:text-blue-400">{{ 'case_overview.kpi.total'|trans }}</div>
        <div class="mt-1.5 text-2xl font-bold tnum text-blue-700 dark:text-blue-300">{{ total }}</div>
        <div class="mt-1 text-xs text-slate-500">{{ 'case_overview.kpi.total_hint'|trans({'%stampDuty%': stamp_duty, '%currency%': case.currency}) }}</div>
    </div>

    <div class="bg-white dark:bg-slate-900 px-6 py-4 lg:px-8 relative">
        <div class="absolute top-0 left-0 right-0 h-0.5 bg-gradient-to-r from-amber-500 to-red-500" aria-hidden="true"></div>
        <div class="flex items-center gap-2">
            <div class="text-xs font-medium uppercase tracking-wide text-amber-700 dark:text-amber-400">{{ 'case_overview.kpi.active_deadline'|trans }}</div>
            {% if active_deadline %}
                <span class="relative flex size-2" aria-hidden="true">
                    <span class="absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75 soft-pulse"></span>
                    <span class="relative inline-flex rounded-full size-2 bg-red-500"></span>
                </span>
            {% endif %}
        </div>
        {% if active_deadline %}
            <div class="mt-1.5 text-2xl font-bold tnum text-amber-700 dark:text-amber-300">{{ deadline_days_remaining }} <span class="text-base font-medium">{{ 'case_overview.kpi.active_deadline_unit'|trans }}</span></div>
            <div class="mt-1 text-xs text-slate-500" data-testid="kpi-active-deadline-line">{{ 'case_overview.kpi.active_deadline_type_line'|trans({'%type%': active_deadline.type.label()|trans, '%date%': deadline_expires_label}) }}</div>
            {# Next reminder: the loosest threshold not yet sent, or the day of expiry once they all
               have been. The ladder differs per type, so it is read from the service that owns it
               (DeadlineAlertService) rather than written out here. #}
            {% set next_alert_offset = deadline_next_alert_days_before(active_deadline) %}
            {% set next_alert_date = next_alert_offset is null ? null : active_deadline.deadlineDate|date_modify('-' ~ next_alert_offset ~ ' days') %}
            <div class="text-xs text-slate-500" data-testid="kpi-next-alert">
                {% if next_alert_date is null %}
                    {{ 'case_overview.kpi.next_alert_all_sent'|trans }}
                {% elseif (next_alert_date|date('U') - "now"|date('U')) < 0 %}
                    {{ 'case_overview.kpi.next_alert_imminent'|trans }}
                {% else %}
                    {{ 'case_overview.kpi.next_alert'|trans }}
                    <span class="tnum font-medium text-slate-700 dark:text-slate-300">{{ next_alert_date|date('d.m.Y') }}</span>
                    <span class="text-slate-400">{{ (next_alert_offset == 0 ? 'case_overview.kpi.next_alert_at_expiry' : 'case_overview.kpi.next_alert_days_before')|trans({'%days%': next_alert_offset}) }}</span>
                {% endif %}
            </div>
        {% else %}
            <div class="mt-1.5 text-lg font-semibold text-slate-400 dark:text-slate-500">{{ 'case_overview.kpi.no_active_deadline'|trans }}</div>
        {% endif %}
    </div>
</section>
