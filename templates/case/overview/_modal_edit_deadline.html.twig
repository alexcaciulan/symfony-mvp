{# Shared edit-deadline modal (one per page, body level). Populated from the
   clicked card's edit button by deadline-edit_controller, so a Turbo Stream
   panel re-render never destroys the open modal. Posts to case_deadline_edit. #}
{% from 'case/overview/_icons.html.twig' import icon_edit, icon_warning %}

<div id="hs-modal-edit-deadline"
     data-controller="deadline-edit"
     class="hs-overlay hidden size-full fixed top-0 start-0 z-[80] overflow-x-hidden overflow-y-auto pointer-events-none"
     role="dialog"
     tabindex="-1"
     aria-labelledby="hs-modal-edit-deadline-title">
    <div class="hs-overlay-open:mt-7 hs-overlay-open:opacity-100 hs-overlay-open:duration-500 mt-0 opacity-0 ease-out transition-all sm:max-w-lg sm:w-full m-3 sm:mx-auto">
        <form method="post" action="" data-turbo-frame="_top" data-deadline-edit-target="form" class="flex flex-col bg-white border border-slate-200 shadow-lg rounded-2xl pointer-events-auto dark:bg-slate-900 dark:border-slate-800">
            <input type="hidden" name="edit_deadline[_token]" value="{{ csrf_token('edit_deadline') }}">

            <div class="flex justify-between items-center py-4 px-5 border-b border-slate-100 dark:border-slate-800">
                <div class="flex items-center gap-3">
                    <span class="inline-flex items-center justify-center size-9 rounded-lg bg-blue-100 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400">
                        {{ icon_edit('size-5') }}
                    </span>
                    <h3 id="hs-modal-edit-deadline-title" class="font-bold text-slate-900 dark:text-white">{{ 'case_overview.deadlines.modal_edit.title'|trans }}</h3>
                </div>
                <button type="button"
                        class="size-8 inline-flex justify-center items-center rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 hover:bg-slate-200 dark:text-slate-100 dark:hover:bg-slate-700"
                        aria-label="{{ 'case_overview.modal.aria_close'|trans }}"
                        data-hs-overlay="#hs-modal-edit-deadline">
                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            <div class="p-5 space-y-4">
                <div data-deadline-edit-target="criticalWarning" class="hidden rounded-lg border border-amber-200 dark:border-amber-900/40 bg-amber-50 dark:bg-amber-950/20 px-3 py-2 flex items-start gap-2 text-xs text-amber-800 dark:text-amber-300">
                    {{ icon_warning('size-4 shrink-0') }}
                    <span>{{ 'case_overview.deadlines.modal_edit.critical_warning'|trans }}</span>
                </div>

                <div>
                    <label for="edit_deadline_deadlineDate" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">{{ 'case_overview.deadlines.modal_edit.field_date_label'|trans }}</label>
                    <input type="date"
                           id="edit_deadline_deadlineDate"
                           name="edit_deadline[deadlineDate]"
                           required
                           data-deadline-edit-target="date"
                           class="w-full py-2 px-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>

                <div>
                    <label for="edit_deadline_description" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">{{ 'case_overview.deadlines.modal_edit.field_description_label'|trans }}</label>
                    <input type="text"
                           id="edit_deadline_description"
                           name="edit_deadline[description]"
                           maxlength="255"
                           data-deadline-edit-target="description"
                           class="w-full py-2 px-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
            </div>

            <div class="flex justify-end items-center gap-x-2 py-3 px-5 border-t border-slate-100 dark:border-slate-800">
                <button type="button"
                        class="py-2 px-3 inline-flex items-center text-sm font-medium rounded-lg border border-slate-200 bg-white text-slate-800 hover:bg-slate-50 dark:bg-slate-900 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
                        data-hs-overlay="#hs-modal-edit-deadline">
                    {{ 'case_overview.deadlines.modal_edit.cancel'|trans }}
                </button>
                <button type="submit"
                        class="py-2 px-4 inline-flex items-center text-sm font-semibold rounded-lg bg-lex-navy text-white hover:bg-lex-navy/90 transition">
                    {{ 'case_overview.deadlines.modal_edit.submit'|trans }}
                </button>
            </div>
        </form>
    </div>
</div>
