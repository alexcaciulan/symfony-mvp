{# Card Instanță competentă. Reflectă mockup linii 550-565. #}
{% from 'case/overview/_icons.html.twig' import icon_building, icon_warning %}

{% if case.court is null %}
    <section class="bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-900/50 rounded-2xl shadow-soft p-5">
        <div class="flex items-start gap-3">
            <span class="inline-flex items-center justify-center size-9 rounded-lg bg-amber-100 dark:bg-amber-900/40 text-amber-700 dark:text-amber-300 shrink-0">
                {{ icon_warning('size-5') }}
            </span>
            <div>
                <div class="text-[10px] font-bold uppercase tracking-wider text-amber-700 dark:text-amber-400 mb-0.5">{{ 'case_overview.court.title'|trans }}</div>
                <div class="font-semibold text-amber-900 dark:text-amber-100">{{ 'case_overview.court.no_court'|trans }}</div>
            </div>
        </div>
    </section>
{% else %}
    <section class="bg-white dark:bg-slate-900 rounded-2xl shadow-soft border border-slate-200 dark:border-slate-800 p-5">
        <div class="flex items-center gap-4">
            <span class="inline-flex items-center justify-center size-12 rounded-xl bg-gradient-to-br from-indigo-50 to-indigo-100 dark:from-indigo-950/50 dark:to-indigo-900/30 text-indigo-600 dark:text-indigo-400 shrink-0">
                {{ icon_building('size-6') }}
            </span>
            <div class="flex-1 min-w-0">
                <div class="text-[10px] font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400 mb-0.5">{{ 'case_overview.court.title'|trans }}</div>
                <div class="font-semibold text-slate-900 dark:text-white">{{ case.court.name }}</div>
                <div class="text-xs text-slate-500 mt-0.5">{{ 'case_overview.court.rule_hint'|trans({'%county%': case.court.county.name}) }}</div>
            </div>
            <div class="text-right">
                <div class="text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-0.5">{{ 'case_overview.court.case_number'|trans }}</div>
                {% if case.courtCaseNumber %}
                    <div class="text-sm font-mono font-medium text-slate-700 dark:text-slate-300">{{ case.courtCaseNumber }}</div>
                {% else %}
                    <div class="text-sm font-medium text-slate-400 italic">{{ 'case_overview.court.case_number_pending'|trans }}</div>
                {% endif %}
            </div>
        </div>
    </section>
{% endif %}
