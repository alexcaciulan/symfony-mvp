{# What to do with a court case the search found: check it, then confirm it or set
   it aside. Opened with the case already loaded when reached from the page banner. #}
{% from 'case/overview/_icons.html.twig' import icon_chevron_right %}
<div id="portal-proposal" class="mt-4 rounded-xl border border-blue-200 dark:border-blue-900/40 bg-blue-50/60 dark:bg-blue-950/20 p-4" data-testid="portal-proposal-steps">
    <div class="text-sm font-semibold text-blue-900 dark:text-blue-200">{{ 'case_overview.portal.proposal_title'|trans({'%number%': case.portalProposedNumber}) }}</div>

    <div class="mt-3">
        <div class="text-xs font-semibold text-slate-800 dark:text-slate-200">{{ 'case_overview.portal.proposal_step_check'|trans }}</div>
        {% if autoload|default(false) %}
            <turbo-frame id="portal-proposed-card" src="{{ path('case_portal_proposal_details', { id: case.id }) }}">
                <p class="mt-2 text-xs text-slate-500">{{ 'case_overview.portal.proposal_loading'|trans }}</p>
            </turbo-frame>
        {% else %}
            {{ include('case/overview/_portal_proposed_card.html.twig', { state: 'initial', dosar: null, parties: [] }) }}
        {% endif %}
    </div>

    <div class="mt-4">
        <div class="text-xs font-semibold text-slate-800 dark:text-slate-200">{{ 'case_overview.portal.proposal_step_decide'|trans }}</div>
        <div class="mt-2 flex items-center gap-3 flex-wrap">
            <form method="post" action="{{ path('case_portal_activate', { id: case.id }) }}" data-turbo-frame="_top">
                <input type="hidden" name="portal_activate[_token]" value="{{ csrf_token('portal_activate') }}">
                <input type="hidden" name="portal_activate[courtCaseNumber]" value="{{ case.portalProposedNumber }}">
                <button type="submit" data-testid="portal-proposal-activate"
                        class="py-2 px-3 inline-flex items-center gap-1.5 text-xs font-semibold rounded-lg bg-gradient-to-br from-lex-navy to-lex-navy-dark text-white shadow-sm hover:opacity-90 transition-opacity">
                    {{ icon_chevron_right('size-3.5') }}
                    {{ 'case_overview.portal.proposal_activate'|trans }}
                </button>
            </form>
            <form method="post" action="{{ path('case_portal_proposal_dismiss', { id: case.id }) }}" data-turbo="false">
                <input type="hidden" name="_token" value="{{ csrf_token('portal_proposal_dismiss_' ~ case.id) }}">
                <button type="submit" class="text-xs font-medium text-slate-600 dark:text-slate-300 underline-offset-2 hover:underline">
                    {{ 'case_overview.portal.alert_proposed_dismiss'|trans }}
                </button>
            </form>
        </div>
    </div>
</div>
