{# Sidebar Acțiuni recomandate cu 4 buttons enum-mapped pe CaseStatus. Reflectă mockup linii 600-624. #}
{% from 'case/overview/_icons.html.twig' import icon_check, icon_document, icon_money, icon_chevron_right %}

{# A case has its summons sent (or beyond) when its status is past AMIABIL in the pipeline. #}
{% set summons_done = case.status.value != 'AMIABIL' %}

{# Find the date when SOMATIE_TRIMISA was first reached, if any, to display under "deja generată".
   Filter the Doctrine collection then take the first match — Twig 3.x dropped `for...if` syntax. #}
{% set summons_match = case.statusHistory|filter(e => e.newStatus == 'SOMATIE_TRIMISA')|first %}
{% set summons_date = summons_match ? summons_match.createdAt : null %}

<section id="case-recommended-actions" class="bg-white dark:bg-slate-900 rounded-2xl shadow-card border border-slate-200 dark:border-slate-800 overflow-hidden">
    <header class="px-5 py-4 bg-gradient-to-br from-lex-navy via-lex-navy to-lex-navy-dark text-white">
        <h3 class="text-sm font-semibold">{{ 'case_overview.recommended_actions.title'|trans }}</h3>
        <p class="mt-0.5 text-[11px] text-blue-100/80">{{ 'case_overview.recommended_actions.subtitle'|trans }}</p>
    </header>

    <div class="p-3 space-y-1">
        {# 1. Generate notice — wired POST when status==AMIABIL. After transition,
           show as "done" with line-through + date. #}
        {% if summons_done %}
            <div class="w-full px-3 py-2.5 flex items-center gap-3 text-left rounded-lg opacity-80">
                <div class="size-9 rounded-lg bg-green-100 dark:bg-green-950/40 text-green-600 dark:text-green-400 flex items-center justify-center shrink-0">
                    {{ icon_check('size-4') }}
                </div>
                <div class="flex-1 min-w-0">
                    <div class="text-sm font-medium text-slate-700 dark:text-slate-300 line-through decoration-1">{{ 'case_overview.recommended_actions.generate_summons'|trans }}</div>
                    {% if summons_date %}
                        <div class="text-[10px] text-green-600 dark:text-green-400 font-semibold uppercase tracking-wide">{{ 'case_overview.recommended_actions.generate_summons_done'|trans({'%date%': summons_date|date('d.m.Y')}) }}</div>
                    {% endif %}
                </div>
            </div>
        {% else %}
            <form method="post"
                  action="{{ path('case_summons_generate', {id: case.id}) }}"
                  data-turbo-frame="_top"
                  class="w-full">
                <input type="hidden" name="_token" value="{{ csrf_token('generate_summons_' ~ case.id) }}">
                <button type="submit"
                        class="w-full px-3 py-2.5 flex items-center gap-3 text-left rounded-lg bg-gradient-to-r from-amber-50 to-amber-50/50 dark:from-amber-950/30 dark:to-amber-950/10 border border-amber-200/60 dark:border-amber-900/40 hover:from-amber-100 dark:hover:from-amber-950/50 transition group">
                    <div class="size-9 rounded-lg bg-amber-100 dark:bg-amber-900/40 text-amber-700 dark:text-amber-300 flex items-center justify-center shrink-0">
                        {{ icon_check('size-4') }}
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="text-sm font-semibold text-amber-900 dark:text-amber-100">{{ 'case_overview.recommended_actions.generate_summons'|trans }}</div>
                        <div class="text-[11px] text-amber-700/80 dark:text-amber-300/80 mt-0.5">{{ 'case_overview.recommended_actions.generate_summons_hint'|trans }}</div>
                    </div>
                    {{ icon_chevron_right('size-4 text-amber-600 dark:text-amber-400 shrink-0') }}
                </button>
            </form>
        {% endif %}

        {# 2. Generate payment order — RECOMMENDED, opens modal cerere-op.
           Only available once the summons has been sent (status SOMATIE_TRIMISA), matching the hero CTA. #}
        {% if case.status.value == 'SOMATIE_TRIMISA' %}
            <button type="button"
                    data-hs-overlay="#hs-modal-cerere-op"
                    class="w-full px-3 py-2.5 flex items-center gap-3 text-left rounded-lg bg-gradient-to-r from-blue-50 to-blue-50/50 dark:from-blue-950/40 dark:to-blue-950/20 border border-blue-200/60 dark:border-blue-900/40 ring-1 ring-blue-100 dark:ring-blue-950/50 hover:from-blue-100 dark:hover:from-blue-950/60 transition group">
                <div class="size-9 rounded-lg bg-gradient-to-br from-blue-500 to-blue-600 text-white flex items-center justify-center shrink-0 shadow-md shadow-blue-500/30">
                    {{ icon_document('size-4') }}
                </div>
                <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-1.5">
                        <span class="text-sm font-bold text-blue-900 dark:text-blue-100">{{ 'case_overview.recommended_actions.generate_op'|trans }}</span>
                        <span class="text-[9px] font-bold uppercase tracking-wide text-blue-600 dark:text-blue-400 bg-blue-100 dark:bg-blue-950/60 px-1.5 py-0.5 rounded">{{ 'case_overview.recommended_actions.recommended_badge'|trans }}</span>
                    </div>
                    <div class="text-[11px] text-blue-700/80 dark:text-blue-300/80 mt-0.5">{{ 'case_overview.recommended_actions.generate_op_hint'|trans }}</div>
                </div>
                {{ icon_chevron_right('size-4 text-blue-600 dark:text-blue-400 shrink-0') }}
            </button>
        {% endif %}

        {# 3. Mark amicable payment — disabled (coming soon). #}
        <button type="button"
                aria-disabled="true"
                title="{{ 'case_overview.tooltip.coming_soon_mark_paid'|trans }}"
                class="w-full px-3 py-2.5 flex items-center gap-3 text-left rounded-lg opacity-60 cursor-not-allowed hover:bg-slate-50 dark:hover:bg-slate-800/50 transition">
            <div class="size-9 rounded-lg bg-green-100 dark:bg-green-950/40 text-green-600 dark:text-green-400 flex items-center justify-center shrink-0">
                {{ icon_money('size-4') }}
            </div>
            <div class="flex-1 min-w-0">
                <div class="text-sm font-medium text-slate-900 dark:text-white">{{ 'case_overview.recommended_actions.mark_paid'|trans }}</div>
                <div class="text-[11px] text-slate-500 mt-0.5">{{ 'case_overview.recommended_actions.mark_paid_hint'|trans }}</div>
            </div>
        </button>

        {# Status-driven transitions exposed inline as secondary CTAs. Each opens the matching
           Preline modal; the controller validates and applies the workflow transition. #}
        {% if case.status.value == 'CERERE_GENERATA' %}
            <button type="button"
                    data-hs-overlay="#hs-modal-confirm-filing"
                    class="w-full px-3 py-2.5 flex items-center gap-3 text-left rounded-lg bg-gradient-to-r from-purple-50 to-purple-50/50 dark:from-purple-950/40 dark:to-purple-950/20 border border-purple-200/60 dark:border-purple-900/40 hover:from-purple-100 dark:hover:from-purple-950/60 transition group">
                <div class="size-9 rounded-lg bg-purple-100 dark:bg-purple-900/40 text-purple-700 dark:text-purple-300 flex items-center justify-center shrink-0">
                    {{ icon_document('size-4') }}
                </div>
                <div class="flex-1 min-w-0">
                    <div class="text-sm font-semibold text-purple-900 dark:text-purple-100">{{ 'case_overview.recommended_actions.confirm_filing'|trans }}</div>
                    <div class="text-[11px] text-purple-700/80 dark:text-purple-300/80 mt-0.5">{{ 'case_overview.recommended_actions.confirm_filing_hint'|trans }}</div>
                </div>
                {{ icon_chevron_right('size-4 text-purple-600 dark:text-purple-400 shrink-0') }}
            </button>
        {% elseif case.status.value == 'CERERE_DEPUSA' %}
            <button type="button"
                    data-controller="goto-portal-discover"
                    data-action="goto-portal-discover#navigate"
                    class="w-full px-3 py-2.5 flex items-center gap-3 text-left rounded-lg bg-gradient-to-r from-indigo-50 to-indigo-50/50 dark:from-indigo-950/40 dark:to-indigo-950/20 border border-indigo-200/60 dark:border-indigo-900/40 hover:from-indigo-100 dark:hover:from-indigo-950/60 transition group">
                <div class="size-9 rounded-lg bg-indigo-100 dark:bg-indigo-900/40 text-indigo-700 dark:text-indigo-300 flex items-center justify-center shrink-0">
                    {{ icon_document('size-4') }}
                </div>
                <div class="flex-1 min-w-0">
                    <div class="text-sm font-semibold text-indigo-900 dark:text-indigo-100">{{ 'case_overview.recommended_actions.register_case'|trans }}</div>
                    <div class="text-[11px] text-indigo-700/80 dark:text-indigo-300/80 mt-0.5">{{ 'case_overview.recommended_actions.register_case_hint'|trans }}</div>
                </div>
                {{ icon_chevron_right('size-4 text-indigo-600 dark:text-indigo-400 shrink-0') }}
            </button>
        {% elseif case.status.value == 'TERMEN_FIXAT' %}
            <button type="button"
                    data-hs-overlay="#hs-modal-issue-ruling"
                    class="w-full px-3 py-2.5 flex items-center gap-3 text-left rounded-lg bg-gradient-to-r from-violet-50 to-violet-50/50 dark:from-violet-950/40 dark:to-violet-950/20 border border-violet-200/60 dark:border-violet-900/40 hover:from-violet-100 dark:hover:from-violet-950/60 transition group">
                <div class="size-9 rounded-lg bg-violet-100 dark:bg-violet-900/40 text-violet-700 dark:text-violet-300 flex items-center justify-center shrink-0">
                    {{ icon_check('size-4') }}
                </div>
                <div class="flex-1 min-w-0">
                    <div class="text-sm font-semibold text-violet-900 dark:text-violet-100">{{ 'case_overview.recommended_actions.issue_ruling'|trans }}</div>
                    <div class="text-[11px] text-violet-700/80 dark:text-violet-300/80 mt-0.5">{{ 'case_overview.recommended_actions.issue_ruling_hint'|trans }}</div>
                </div>
                {{ icon_chevron_right('size-4 text-violet-600 dark:text-violet-400 shrink-0') }}
            </button>
            <button type="button"
                    data-hs-overlay="#hs-modal-reject"
                    class="w-full px-3 py-2.5 flex items-center gap-3 text-left rounded-lg hover:bg-red-50 dark:hover:bg-red-950/30 transition">
                <div class="size-9 rounded-lg bg-red-100 dark:bg-red-950/40 text-red-600 dark:text-red-400 flex items-center justify-center shrink-0">
                    {{ icon_document('size-4') }}
                </div>
                <div class="flex-1 min-w-0">
                    <div class="text-sm font-medium text-red-700 dark:text-red-300">{{ 'case_overview.recommended_actions.reject_case'|trans }}</div>
                    <div class="text-[11px] text-red-600/80 dark:text-red-400/80 mt-0.5">{{ 'case_overview.recommended_actions.reject_case_hint'|trans }}</div>
                </div>
            </button>
        {% elseif case.status.value == 'ORDONANTA_EMISA' and case.rulingCommunicationDate %}
            <button type="button"
                    data-hs-overlay="#hs-modal-executare"
                    class="w-full px-3 py-2.5 flex items-center gap-3 text-left rounded-lg bg-gradient-to-r from-teal-50 to-teal-50/50 dark:from-teal-950/40 dark:to-teal-950/20 border border-teal-200/60 dark:border-teal-900/40 hover:from-teal-100 dark:hover:from-teal-950/60 transition group">
                <div class="size-9 rounded-lg bg-teal-100 dark:bg-teal-900/40 text-teal-700 dark:text-teal-300 flex items-center justify-center shrink-0">
                    {{ icon_money('size-4') }}
                </div>
                <div class="flex-1 min-w-0">
                    <div class="text-sm font-semibold text-teal-900 dark:text-teal-100">{{ 'case_overview.recommended_actions.start_execution'|trans }}</div>
                    <div class="text-[11px] text-teal-700/80 dark:text-teal-300/80 mt-0.5">{{ 'case_overview.recommended_actions.start_execution_parallel_hint'|trans }}</div>
                </div>
                {{ icon_chevron_right('size-4 text-teal-600 dark:text-teal-400 shrink-0') }}
            </button>
        {% elseif case.status.value == 'IN_ANULARE' %}
            <button type="button"
                    data-hs-overlay="#hs-modal-executare"
                    class="w-full px-3 py-2.5 flex items-center gap-3 text-left rounded-lg bg-gradient-to-r from-teal-50 to-teal-50/50 dark:from-teal-950/40 dark:to-teal-950/20 border border-teal-200/60 dark:border-teal-900/40 hover:from-teal-100 dark:hover:from-teal-950/60 transition group">
                <div class="size-9 rounded-lg bg-teal-100 dark:bg-teal-900/40 text-teal-700 dark:text-teal-300 flex items-center justify-center shrink-0">
                    {{ icon_money('size-4') }}
                </div>
                <div class="flex-1 min-w-0">
                    <div class="text-sm font-semibold text-teal-900 dark:text-teal-100">{{ 'case_overview.recommended_actions.start_execution'|trans }}</div>
                    <div class="text-[11px] text-teal-700/80 dark:text-teal-300/80 mt-0.5">{{ 'case_overview.recommended_actions.start_execution_parallel_hint'|trans }}</div>
                </div>
                {{ icon_chevron_right('size-4 text-teal-600 dark:text-teal-400 shrink-0') }}
            </button>
            <button type="button"
                    data-hs-overlay="#hs-modal-reject"
                    class="w-full px-3 py-2.5 flex items-center gap-3 text-left rounded-lg hover:bg-red-50 dark:hover:bg-red-950/30 transition">
                <div class="size-9 rounded-lg bg-red-100 dark:bg-red-950/40 text-red-600 dark:text-red-400 flex items-center justify-center shrink-0">
                    {{ icon_document('size-4') }}
                </div>
                <div class="flex-1 min-w-0">
                    <div class="text-sm font-medium text-red-700 dark:text-red-300">{{ 'case_overview.recommended_actions.reject_case'|trans }}</div>
                    <div class="text-[11px] text-red-600/80 dark:text-red-400/80 mt-0.5">{{ 'case_overview.recommended_actions.reject_case_hint_in_anulare'|trans }}</div>
                </div>
            </button>
            <button type="button"
                    data-hs-overlay="#hs-modal-annulment-rejected"
                    class="w-full px-3 py-2.5 flex items-center gap-3 text-left rounded-lg hover:bg-emerald-50 dark:hover:bg-emerald-950/30 transition">
                <div class="size-9 rounded-lg bg-emerald-100 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
                    {{ icon_check('size-4') }}
                </div>
                <div class="flex-1 min-w-0">
                    <div class="text-sm font-medium text-emerald-700 dark:text-emerald-300">{{ 'case_overview.recommended_actions.annulment_rejected'|trans }}</div>
                    <div class="text-[11px] text-emerald-600/80 dark:text-emerald-400/80 mt-0.5">{{ 'case_overview.recommended_actions.annulment_rejected_hint_in_anulare'|trans }}</div>
                </div>
            </button>
        {% elseif case.status.value == 'DEFINITIVA' %}
            <button type="button"
                    data-hs-overlay="#hs-modal-executare"
                    class="w-full px-3 py-2.5 flex items-center gap-3 text-left rounded-lg bg-gradient-to-r from-teal-50 to-teal-50/50 dark:from-teal-950/40 dark:to-teal-950/20 border border-teal-200/60 dark:border-teal-900/40 hover:from-teal-100 dark:hover:from-teal-950/60 transition group">
                <div class="size-9 rounded-lg bg-teal-100 dark:bg-teal-900/40 text-teal-700 dark:text-teal-300 flex items-center justify-center shrink-0">
                    {{ icon_money('size-4') }}
                </div>
                <div class="flex-1 min-w-0">
                    <div class="text-sm font-semibold text-teal-900 dark:text-teal-100">{{ 'case_overview.recommended_actions.start_execution'|trans }}</div>
                    <div class="text-[11px] text-teal-700/80 dark:text-teal-300/80 mt-0.5">{{ 'case_overview.recommended_actions.start_execution_hint'|trans }}</div>
                </div>
                {{ icon_chevron_right('size-4 text-teal-600 dark:text-teal-400 shrink-0') }}
            </button>
            <button type="button"
                    data-hs-overlay="#hs-modal-close-case"
                    class="w-full px-3 py-2.5 flex items-center gap-3 text-left rounded-lg bg-gradient-to-r from-emerald-50 to-emerald-50/50 dark:from-emerald-950/40 dark:to-emerald-950/20 border border-emerald-200/60 dark:border-emerald-900/40 hover:from-emerald-100 dark:hover:from-emerald-950/60 transition group">
                <div class="size-9 rounded-lg bg-emerald-100 dark:bg-emerald-900/40 text-emerald-700 dark:text-emerald-300 flex items-center justify-center shrink-0">
                    {{ icon_money('size-4') }}
                </div>
                <div class="flex-1 min-w-0">
                    <div class="text-sm font-semibold text-emerald-900 dark:text-emerald-100">{{ 'case_overview.recommended_actions.close_case_definitiva'|trans }}</div>
                    <div class="text-[11px] text-emerald-700/80 dark:text-emerald-300/80 mt-0.5">{{ 'case_overview.recommended_actions.close_case_definitiva_hint'|trans }}</div>
                </div>
                {{ icon_chevron_right('size-4 text-emerald-600 dark:text-emerald-400 shrink-0') }}
            </button>
        {% elseif case.status.value == 'EXECUTARE' %}
            <button type="button"
                    data-hs-overlay="#hs-modal-close-case"
                    class="w-full px-3 py-2.5 flex items-center gap-3 text-left rounded-lg bg-gradient-to-r from-emerald-50 to-emerald-50/50 dark:from-emerald-950/40 dark:to-emerald-950/20 border border-emerald-200/60 dark:border-emerald-900/40 hover:from-emerald-100 dark:hover:from-emerald-950/60 transition group">
                <div class="size-9 rounded-lg bg-emerald-100 dark:bg-emerald-900/40 text-emerald-700 dark:text-emerald-300 flex items-center justify-center shrink-0">
                    {{ icon_money('size-4') }}
                </div>
                <div class="flex-1 min-w-0">
                    <div class="text-sm font-semibold text-emerald-900 dark:text-emerald-100">{{ 'case_overview.recommended_actions.close_case_executare'|trans }}</div>
                    <div class="text-[11px] text-emerald-700/80 dark:text-emerald-300/80 mt-0.5">{{ 'case_overview.recommended_actions.close_case_executare_hint'|trans }}</div>
                </div>
                {{ icon_chevron_right('size-4 text-emerald-600 dark:text-emerald-400 shrink-0') }}
            </button>
            <button type="button"
                    data-hs-overlay="#hs-modal-reject"
                    class="w-full px-3 py-2.5 flex items-center gap-3 text-left rounded-lg hover:bg-red-50 dark:hover:bg-red-950/30 transition">
                <div class="size-9 rounded-lg bg-red-100 dark:bg-red-950/40 text-red-600 dark:text-red-400 flex items-center justify-center shrink-0">
                    {{ icon_document('size-4') }}
                </div>
                <div class="flex-1 min-w-0">
                    <div class="text-sm font-medium text-red-700 dark:text-red-300">{{ 'case_overview.recommended_actions.grant_annulment_executare'|trans }}</div>
                    <div class="text-[11px] text-red-600/80 dark:text-red-400/80 mt-0.5">{{ 'case_overview.recommended_actions.grant_annulment_executare_hint'|trans }}</div>
                </div>
            </button>
            <button type="button"
                    data-hs-overlay="#hs-modal-annulment-rejected"
                    class="w-full px-3 py-2.5 flex items-center gap-3 text-left rounded-lg hover:bg-emerald-50 dark:hover:bg-emerald-950/30 transition">
                <div class="size-9 rounded-lg bg-emerald-100 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
                    {{ icon_check('size-4') }}
                </div>
                <div class="flex-1 min-w-0">
                    <div class="text-sm font-medium text-emerald-700 dark:text-emerald-300">{{ 'case_overview.recommended_actions.annulment_rejected'|trans }}</div>
                    <div class="text-[11px] text-emerald-600/80 dark:text-emerald-400/80 mt-0.5">{{ 'case_overview.recommended_actions.annulment_rejected_hint_executare'|trans }}</div>
                </div>
            </button>
        {% endif %}
    </div>
</section>
