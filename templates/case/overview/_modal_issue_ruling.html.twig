{# Modal Preline „Emite ordonanța". Submit la `case_transition_issue_ruling`
   (workflow emite_ordonanta: TERMEN_FIXAT → ORDONANTA_EMISA). Form auto-CSRF
   prin IssueRulingType (csrf_token_id: issue_ruling). #}
{% from 'case/overview/_icons.html.twig' import icon_calendar %}

<div id="hs-modal-issue-ruling"
     class="hs-overlay hidden size-full fixed top-0 start-0 z-[80] overflow-x-hidden overflow-y-auto pointer-events-none"
     role="dialog"
     tabindex="-1"
     aria-labelledby="hs-modal-issue-ruling-title">
    <div class="hs-overlay-open:mt-7 hs-overlay-open:opacity-100 hs-overlay-open:duration-500 mt-0 opacity-0 ease-out transition-all sm:max-w-lg sm:w-full m-3 sm:mx-auto">
        <form method="post" enctype="multipart/form-data" action="{{ path('case_transition_issue_ruling', {id: case.id}) }}" class="flex flex-col bg-white border border-slate-200 shadow-lg rounded-2xl pointer-events-auto dark:bg-slate-900 dark:border-slate-800">
            <input type="hidden" name="issue_ruling[_token]" value="{{ csrf_token('issue_ruling') }}">

            <div class="flex justify-between items-center py-4 px-5 border-b border-slate-100 dark:border-slate-800">
                <div class="flex items-center gap-3">
                    <span class="inline-flex items-center justify-center size-9 rounded-lg bg-violet-100 dark:bg-violet-950/40 text-violet-600 dark:text-violet-400">
                        {{ icon_calendar('size-5') }}
                    </span>
                    <h3 id="hs-modal-issue-ruling-title" class="font-bold text-slate-900 dark:text-white">{{ 'case_overview.modal.ruling_title'|trans }}</h3>
                </div>
                <button type="button"
                        class="size-8 inline-flex justify-center items-center rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 hover:bg-slate-200 dark:text-slate-100 dark:hover:bg-slate-700"
                        aria-label="{{ 'case_overview.modal.aria_close'|trans }}"
                        data-hs-overlay="#hs-modal-issue-ruling">
                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            <div class="p-5 space-y-4">
                <p class="text-sm text-slate-600 dark:text-slate-400">{{ 'case_overview.modal.ruling_intro'|trans }}</p>

                <div>
                    <label for="issue_ruling_field" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">{{ 'case_overview.modal.ruling_field_label'|trans }}</label>
                    {% set ruling_prefill = (portal_ruling_proposal is defined and portal_ruling_proposal and portal_ruling_proposal.transition == 'emite_ordonanta' and portal_ruling_proposal.prefillDate) ? portal_ruling_proposal.prefillDate|date('Y-m-d') : '' %}
                    <input type="date"
                           id="issue_ruling_field"
                           name="issue_ruling[rulingDate]"
                           required
                           value="{{ ruling_prefill }}"
                           max="{{ 'now'|date('Y-m-d') }}"
                           class="w-full py-2 px-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-violet-500">
                    <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400">{{ 'case_overview.modal.ruling_hint'|trans }}</p>
                </div>

                <div>
                    <label for="issue_ruling_document_field" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">{{ 'case_overview.modal.ruling_document_label'|trans }}</label>
                    <input type="file"
                           id="issue_ruling_document_field"
                           name="issue_ruling[rulingDocument]"
                           accept=".pdf,image/jpeg,image/png,image/gif,image/webp"
                           class="w-full text-sm text-slate-600 dark:text-slate-300 file:mr-3 file:py-2 file:px-3 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-violet-50 file:text-violet-700 hover:file:bg-violet-100 dark:file:bg-violet-950/40 dark:file:text-violet-300">
                    <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400">{{ 'case_overview.modal.ruling_document_hint'|trans }}</p>
                </div>
            </div>

            <div class="flex justify-end items-center gap-x-2 py-3 px-5 border-t border-slate-100 dark:border-slate-800">
                <button type="button"
                        class="py-2 px-3 inline-flex items-center text-sm font-medium rounded-lg border border-slate-200 bg-white text-slate-800 hover:bg-slate-50 dark:bg-slate-900 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
                        data-hs-overlay="#hs-modal-issue-ruling">
                    {{ 'case_overview.modal.ruling_cancel'|trans }}
                </button>
                <button type="submit"
                        class="py-2 px-4 inline-flex items-center text-sm font-semibold rounded-lg bg-violet-600 text-white hover:bg-violet-700 transition">
                    {{ 'case_overview.modal.ruling_confirm'|trans }}
                </button>
            </div>
        </form>
    </div>
</div>
