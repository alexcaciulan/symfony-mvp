{# Modal Preline „Comunicarea somației — modalități legale" (CPC art. 1015 alin. 1).
   Afișat post-generare PDF la primul click pe „Generează somația". Conține
   cele 2 modalități legale + warning roșu curier privat (Cargus/FAN/DPD nu sunt
   admisibile — nu oferă „conținut declarat"). #}
{% from 'case/overview/_icons.html.twig' import icon_warning, icon_check %}

<div id="hs-modal-c4-summons"
     class="hs-overlay hidden size-full fixed top-0 start-0 z-[80] overflow-x-hidden overflow-y-auto pointer-events-none"
     role="dialog"
     tabindex="-1"
     aria-labelledby="hs-modal-c4-summons-title">
    <div class="hs-overlay-open:mt-7 hs-overlay-open:opacity-100 hs-overlay-open:duration-500 mt-0 opacity-0 ease-out transition-all sm:max-w-2xl sm:w-full m-3 sm:mx-auto">
        <div class="flex flex-col bg-white border border-slate-200 shadow-lg rounded-2xl pointer-events-auto dark:bg-slate-900 dark:border-slate-800">
            <div class="flex justify-between items-center py-4 px-5 border-b border-slate-100 dark:border-slate-800">
                <div class="flex items-center gap-3">
                    <span class="inline-flex items-center justify-center size-9 rounded-lg bg-amber-100 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400">
                        {{ icon_warning('size-5') }}
                    </span>
                    <h3 id="hs-modal-c4-summons-title" class="font-bold text-slate-900 dark:text-white">{{ 'case_overview.summons.modal_c4.title'|trans }}</h3>
                </div>
                <button type="button"
                        class="size-8 inline-flex justify-center items-center rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 hover:bg-slate-200 dark:text-slate-300 dark:hover:bg-slate-700"
                        aria-label="{{ 'case_overview.modal.aria_close'|trans }}"
                        data-hs-overlay="#hs-modal-c4-summons">
                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            <div class="p-5 space-y-4">
                <p class="text-sm text-slate-600 dark:text-slate-400">{{ 'case_overview.summons.modal_c4.intro'|trans }}</p>

                <div class="space-y-3">
                    <div class="flex items-start gap-3 rounded-lg border border-slate-200 dark:border-slate-700 p-3">
                        <span class="inline-flex items-center justify-center size-7 rounded-full bg-green-100 dark:bg-green-950/40 text-green-600 dark:text-green-400 shrink-0">
                            {{ icon_check('size-4') }}
                        </span>
                        <div>
                            <div class="text-sm font-semibold text-slate-900 dark:text-white">{{ 'case_overview.summons.modal_c4.option_executor_title'|trans }}</div>
                            <div class="text-xs text-slate-600 dark:text-slate-400 mt-1">{{ 'case_overview.summons.modal_c4.option_executor_body'|trans }}</div>
                        </div>
                    </div>

                    <div class="flex items-start gap-3 rounded-lg border border-slate-200 dark:border-slate-700 p-3">
                        <span class="inline-flex items-center justify-center size-7 rounded-full bg-green-100 dark:bg-green-950/40 text-green-600 dark:text-green-400 shrink-0">
                            {{ icon_check('size-4') }}
                        </span>
                        <div>
                            <div class="text-sm font-semibold text-slate-900 dark:text-white">{{ 'case_overview.summons.modal_c4.option_posta_title'|trans }}</div>
                            <div class="text-xs text-slate-600 dark:text-slate-400 mt-1">{{ 'case_overview.summons.modal_c4.option_posta_body'|trans }}</div>
                        </div>
                    </div>
                </div>

                <div class="rounded-lg border border-red-200 dark:border-red-900/40 bg-red-50 dark:bg-red-950/20 p-3">
                    <div class="flex items-start gap-2">
                        <span class="text-red-600 dark:text-red-400 mt-0.5">{{ icon_warning('size-4') }}</span>
                        <div>
                            <div class="text-sm font-bold text-red-700 dark:text-red-300">{{ 'case_overview.summons.modal_c4.warning_courier_title'|trans }}</div>
                            <div class="text-xs text-red-600 dark:text-red-400 mt-1">{{ 'case_overview.summons.modal_c4.warning_courier_body'|trans }}</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex justify-end items-center gap-x-2 py-3 px-5 border-t border-slate-100 dark:border-slate-800">
                <button type="button"
                        class="py-2 px-4 inline-flex items-center text-sm font-semibold rounded-lg bg-lex-navy text-white hover:bg-lex-navy/90 transition"
                        data-hs-overlay="#hs-modal-c4-summons">
                    {{ 'case_overview.summons.modal_c4.dismiss'|trans }}
                </button>
            </div>
        </div>
    </div>
</div>
