{# Card Creanță: composition bar, 4-stat dl, the positions table (every position,
   excluded ones included) and the BNR breakdown. While the case is amiable the
   owner adds, excludes and reinstates positions from here; after the summons the
   header says why the claim no longer changes. Reflects mockup 04-dosar/creanta-editare. #}
{% from 'case/overview/_icons.html.twig' import icon_money, icon_chevron_right, icon_warning, icon_lock, icon_plus, icon_check %}

{% set can_edit_claim = is_granted('CASE_CLAIM_EDIT', case) %}
{% set all_items = claim_items_all|default(case.claimItems) %}
{% set counting_ids = [] %}
{% for ci in claim_items|default([]) %}{% set counting_ids = counting_ids|merge([ci.id]) %}{% endfor %}
{% set excluded_count = 0 %}
{% for ci in all_items %}{% if ci.excludedByLawyer %}{% set excluded_count = excluded_count + 1 %}{% endif %}{% endfor %}
{% set summary = claim_change_summary|default(null) %}

{% set principal = case.amount|default(0) + 0 %}
{% set interest = case.calculatedInterest|default(0) + 0 %}
{% set stamp_duty = case.stampDuty|default(0) + 0 %}
{% set total_value = principal + interest %}
{% set grand_total = total_value + stamp_duty %}
{% set principal_pct = total_value > 0 ? (principal / total_value * 100) : 0 %}
{% set interest_pct = total_value > 0 ? (interest / total_value * 100) : 0 %}

{# Interest span ends at the reference date of the stored `calculatedInterest`, so the day count matches the breakdown. #}
{% set interest_days = 0 %}
{% if case.dueDate %}
    {% set diff_seconds = (accessory_reference_date|default(case.createdAt)|date('U') - case.dueDate|date('U')) %}
    {% set interest_days = (diff_seconds / 86400)|round(0, 'floor') %}
    {% if interest_days < 0 %}{% set interest_days = 0 %}{% endif %}
{% endif %}

{% set first_period_rate = (interest_breakdown is not null and interest_breakdown|length > 0) ? (interest_breakdown|first).applicableRate : null %}

{# A contractual penalty carries the contract's own name, never "interest". #}
{% set is_contractual = case.penaltyType and case.penaltyType.value == 'CONTRACTUAL' and case.contractualPenaltyRate %}
{% set accessory_label = is_contractual
    ? (case.contractualAccessoryLabel ? case.contractualAccessoryLabel.label : 'enum.contractual_accessory_label.PENALITATI_INTARZIERE')|trans
    : null %}

<section id="case-claim-card" class="bg-white dark:bg-slate-900 rounded-2xl shadow-soft border border-slate-200 dark:border-slate-800 overflow-hidden" data-testid="case-claim-card">
    <header class="px-6 py-4 border-b border-slate-100 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div class="flex items-center gap-2.5">
            <span class="inline-flex items-center justify-center size-7 rounded-lg bg-gradient-to-br from-green-50 to-green-100 dark:from-green-950/50 dark:to-green-900/30 text-green-600 dark:text-green-400">
                {{ icon_money('size-4') }}
            </span>
            <h3 class="text-sm font-semibold text-slate-900 dark:text-white">{{ 'case_overview.claim.title'|trans }}</h3>
            {% if case.relationshipType %}
                <span class="text-xs text-slate-500 hidden md:inline">
                    {{ 'case_overview.claim.report_type'|trans }}:
                    <span class="font-semibold text-slate-700 dark:text-slate-300">{{ case.relationshipType.label()|trans }}</span>
                </span>
            {% endif %}
        </div>
        {% if can_edit_claim %}
            <div class="flex items-center gap-2" data-testid="claim-edit-actions">
                <button type="button"
                        data-hs-overlay="#hs-modal-claim-details"
                        data-testid="claim-edit-details"
                        class="py-2 px-3 inline-flex items-center gap-1.5 text-xs font-semibold rounded-lg border border-slate-200 bg-white text-slate-800 hover:bg-slate-50 dark:bg-slate-900 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800 transition">
                    {{ 'case.claim.edit.details_title'|trans }}
                </button>
                <button type="button"
                        data-hs-overlay="#hs-modal-claim-add"
                        data-testid="claim-add-invoice"
                        class="py-2 px-3 inline-flex items-center gap-1.5 text-xs font-semibold rounded-lg bg-lex-navy text-white hover:bg-lex-navy/90 transition">
                    {{ icon_plus('size-3.5') }}
                    {{ 'case.claim.edit.add_invoice'|trans }}
                </button>
            </div>
        {% elseif case.status.value != 'AMIABIL' and all_items|length > 0 %}
            <p class="flex items-start gap-2 text-xs text-slate-500 dark:text-slate-400 sm:max-w-sm" data-testid="claim-locked-note">
                {{ icon_lock('size-4 shrink-0 text-slate-400 mt-px') }}
                <span>{{ 'case.claim.edit.locked_after_summons'|trans }}</span>
            </p>
        {% endif %}
    </header>

    <div class="px-6 py-5">
        {% if summary and (summary.lines|length > 0 or summary.warnings|length > 0) %}
            <div id="claim-change-summary" class="mb-5 rounded-xl border border-green-200 dark:border-green-900/50 bg-green-50 dark:bg-green-950/30 p-4" role="status" data-testid="claim-change-summary">
                <div class="flex items-start justify-between gap-3">
                    <div class="flex items-center gap-2 text-sm font-semibold text-green-800 dark:text-green-300">
                        {{ icon_check('size-4') }}
                        {{ 'case.claim.edit.changed.title'|trans }}
                    </div>
                    <button type="button" data-hs-remove-element="#claim-change-summary" aria-label="{{ 'common.close'|trans }}" class="p-1 -m-1 rounded-md text-green-700 dark:text-green-400 hover:bg-green-100 dark:hover:bg-green-900/40">
                        <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                    </button>
                </div>
                {% if summary.lines|length > 0 %}
                    <ul class="mt-2 space-y-1 text-sm text-green-900 dark:text-green-200 tnum">
                        {% for line in summary.lines %}<li>{{ line }}</li>{% endfor %}
                    </ul>
                {% endif %}
                {% if summary.warnings|length > 0 %}
                    <ul class="mt-2 space-y-1 text-sm text-amber-900 dark:text-amber-200" data-testid="claim-change-warnings">
                        {% for line in summary.warnings %}<li class="flex items-start gap-1.5">{{ icon_warning('size-4 shrink-0 mt-0.5 text-amber-600') }}<span>{{ line }}</span></li>{% endfor %}
                    </ul>
                {% endif %}
            </div>
        {% endif %}

        {% if can_edit_claim and court_proposal|default(null) %}
            {{ include('case/overview/_claim_court_proposal.html.twig', { proposal: court_proposal }) }}
        {% endif %}

        {# Object of the claim (free text from the wizard). Hidden when empty. #}
        {% if claim_description is defined and claim_description %}
            <div class="mb-5">
                <div class="text-[10px] font-medium uppercase tracking-wide text-slate-500">{{ 'case_overview.claim.description_label'|trans }}</div>
                <p class="mt-0.5 text-sm text-slate-700 dark:text-slate-300">{{ claim_description }}</p>
            </div>
        {% endif %}

        {# Composition bar — only when total > 0 to avoid divide-by-zero artifacts. #}
        {% if total_value > 0 %}
            <div class="mb-5">
                <div class="flex items-baseline justify-between mb-2">
                    <span class="text-xs font-medium text-slate-500">{{ 'case_overview.claim.composition'|trans }}</span>
                    <div class="text-2xl font-bold tnum text-blue-700 dark:text-blue-300">{{ grand_total|number_format(2, ',', '.') }} <span class="text-sm font-medium text-slate-400">{{ case.currency }}</span></div>
                </div>
                {% if case.originalCurrency %}
                    <p class="mb-2 text-[11px] text-slate-500">{{ 'wizard.step3.sidebar.conversion_line'|trans({ '%amount%': (case.originalAmount + 0)|number_format(2, '.', ','), '%currency%': case.originalCurrency, '%rate%': (case.exchangeRate + 0)|number_format(4, '.', ','), '%date%': case.exchangeRateDate ? case.exchangeRateDate|date('d.m.Y') : '', '%ron%': principal|number_format(2, '.', ',') }) }}</p>
                {% endif %}
                <div class="flex h-2.5 rounded-full overflow-hidden bg-slate-100 dark:bg-slate-800">
                    <div class="bg-gradient-to-r from-blue-500 to-blue-600" style="width: {{ principal_pct|number_format(1, '.', '') }}%"></div>
                    <div class="bg-gradient-to-r from-amber-400 to-amber-500" style="width: {{ interest_pct|number_format(1, '.', '') }}%"></div>
                </div>
                <div class="flex items-center gap-4 mt-2 text-[11px]">
                    <div class="flex items-center gap-1.5"><span class="size-2 rounded-sm bg-blue-500" aria-hidden="true"></span><span class="text-slate-600 dark:text-slate-400">{{ 'case_overview.claim.principal'|trans }} <span class="font-semibold text-slate-900 dark:text-white">{{ principal_pct|number_format(1, ',', '.') }}%</span></span></div>
                    <div class="flex items-center gap-1.5"><span class="size-2 rounded-sm bg-amber-500" aria-hidden="true"></span><span class="text-slate-600 dark:text-slate-400">{{ accessory_label ?? 'case_overview.claim.interest_label'|trans }} <span class="font-semibold text-slate-900 dark:text-white">{{ interest_pct|number_format(1, ',', '.') }}%</span></span></div>
                </div>
            </div>
        {% endif %}

        {# 4-stat dl grid #}
        <dl class="grid grid-cols-2 md:grid-cols-4 gap-px bg-slate-100 dark:bg-slate-800 rounded-lg overflow-hidden mb-4">
            <div class="bg-slate-50 dark:bg-slate-950/50 p-3">
                <dt class="text-[10px] font-medium uppercase tracking-wide text-slate-500">{{ 'case_overview.claim.stat_principal'|trans }}</dt>
                <dd class="mt-1 text-base font-bold tnum text-slate-900 dark:text-white">{{ principal|number_format(2, ',', '.') }}</dd>
                {% if case.dueDate %}
                    <dd class="text-[10px] text-slate-500">{{ 'case_overview.claim.stat_principal_hint'|trans({'%date%': case.dueDate|date('d.m.Y')}) }}</dd>
                {% endif %}
            </div>
            <div class="bg-slate-50 dark:bg-slate-950/50 p-3">
                <dt class="text-[10px] font-medium uppercase tracking-wide text-slate-500">{{ accessory_label ?? 'case_overview.claim.stat_interest'|trans }}</dt>
                <dd class="mt-1 text-base font-bold tnum text-amber-600 dark:text-amber-400">+ {{ interest|number_format(2, ',', '.') }}</dd>
                {% if is_contractual %}
                    <dd class="text-[10px] text-slate-500">{{ (case.contractualPenaltyCapPercent ? 'case_overview.kpi.penalty_hint_capped' : 'case_overview.kpi.penalty_hint')|trans({'%rate%': case.contractualPenaltyRate|number_format(2, ',', '.'), '%cap%': case.contractualPenaltyCapPercent|default(0)|percent_number}) }}</dd>
                {% elseif first_period_rate is not null %}
                    <dd class="text-[10px] text-slate-500">{{ 'case_overview.claim.stat_interest_hint'|trans({'%days%': interest_days, '%rate%': first_period_rate|number_format(2, ',', '.')}) }}</dd>
                {% endif %}
            </div>
            <div class="bg-slate-50 dark:bg-slate-950/50 p-3">
                <dt class="text-[10px] font-medium uppercase tracking-wide text-slate-500">{{ 'case_overview.claim.stat_stamp'|trans }}</dt>
                <dd class="mt-1 text-base font-bold tnum text-slate-900 dark:text-white">{{ stamp_duty|number_format(2, ',', '.') }}</dd>
                <dd class="text-[10px] text-slate-500">{{ 'case_overview.claim.stat_stamp_hint'|trans }}</dd>
            </div>
            <div class="bg-slate-50 dark:bg-slate-950/50 p-3">
                <dt class="text-[10px] font-medium uppercase tracking-wide text-slate-500">{{ 'case_overview.claim.stat_total'|trans }}</dt>
                <dd class="mt-1 text-base font-bold tnum text-blue-700 dark:text-blue-300">{{ grand_total|number_format(2, ',', '.') }}</dd>
                <dd class="text-[10px] text-slate-500">{{ 'case_overview.claim.stat_total_hint'|trans }}</dd>
            </div>
        </dl>

        {% if all_items|length > 0 %}
            <h4 class="text-sm font-semibold text-slate-900 dark:text-white mb-2">{{ 'case.claim.edit.positions_title'|trans }}</h4>
            <div class="border border-slate-200 dark:border-slate-800 rounded-lg overflow-x-auto">
                <table class="w-full min-w-[880px] text-xs" data-testid="claim-positions-table">
                    <thead class="text-[10px] uppercase tracking-wide text-slate-500 border-b border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-950/30">
                        <tr>
                            <th scope="col" class="text-left py-2 px-3 font-medium">{{ 'case_overview.claim.positions_number'|trans }}</th>
                            <th scope="col" class="text-left py-2 px-3 font-medium">{{ 'case.claim.edit.positions_date'|trans }}</th>
                            <th scope="col" class="text-left py-2 px-3 font-medium">{{ 'case_overview.claim.positions_due_date'|trans }}</th>
                            <th scope="col" class="text-right py-2 px-3 font-medium">{{ 'case_overview.claim.positions_amount'|trans }}</th>
                            <th scope="col" class="text-right py-2 px-3 font-medium">{{ 'case.claim.edit.positions_paid'|trans }}</th>
                            <th scope="col" class="text-right py-2 px-3 font-medium">{{ 'case.claim.edit.positions_outstanding'|trans }}</th>
                            <th scope="col" class="text-right py-2 px-3 font-medium">{{ accessory_label ?? 'case_overview.claim.positions_interest'|trans }}</th>
                            <th scope="col" class="text-left py-2 px-3 font-medium">{{ 'case.claim.edit.positions_state'|trans }}</th>
                            <th scope="col" class="text-left py-2 px-3 font-medium">{{ 'case.claim.edit.positions_source'|trans }}</th>
                            {% if can_edit_claim %}<th scope="col" class="text-right py-2 px-3 font-medium">{{ 'case.claim.edit.positions_actions'|trans }}</th>{% endif %}
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                        {% for item in all_items %}
                            {% set counts = item.id in counting_ids %}
                            {% set itemAccessory = counts and claim_item_accessories is defined and claim_item_accessories ? claim_item_accessories.forItem(item.id) : null %}
                            {% set label = item.documentNumber|default(item.amount|number_format(2, ',', '.') ~ ' ' ~ item.currency) %}
                            <tr id="claim-position-{{ item.id }}" data-testid="claim-position-row" data-claim-position-state="{{ item.excludedByLawyer ? 'excluded' : (counts ? 'counting' : 'pending') }}" class="{{ item.excludedByLawyer ? 'opacity-60' : '' }}">
                                <td class="py-2.5 px-3 font-medium text-slate-900 dark:text-white whitespace-nowrap">{{ item.documentNumber|default('—') }}</td>
                                <td class="py-2.5 px-3 text-slate-700 dark:text-slate-300 tnum">{{ item.documentDate ? item.documentDate|date('d.m.Y') : '—' }}</td>
                                <td class="py-2.5 px-3 text-slate-700 dark:text-slate-300 tnum">{{ item.dueDate ? item.dueDate|date('d.m.Y') : '—' }}</td>
                                <td class="py-2.5 px-3 text-right tnum text-slate-900 dark:text-white {{ item.excludedByLawyer ? 'line-through' : '' }}">
                                    {{ (item.amount + 0)|number_format(2, ',', '.') }} {{ item.currency }}
                                    {% if item.currency != 'RON' and item.amountRon is not null %}
                                        <div class="text-[10px] text-slate-500 whitespace-nowrap">≈ {{ (item.amountRon + 0)|number_format(2, ',', '.') }} RON{% if item.exchangeRate %} · {{ (item.exchangeRate + 0)|number_format(4, ',', '.') }}{% if item.exchangeRateDate %} / {{ item.exchangeRateDate|date('d.m.Y') }}{% endif %}{% endif %}</div>
                                    {% elseif item.needsManualFx %}
                                        <div class="text-[10px] text-amber-600 whitespace-nowrap">{{ 'case.claim.edit.positions_fx_missing'|trans }}</div>
                                    {% endif %}
                                </td>
                                <td class="py-2.5 px-3 text-right tnum text-slate-700 dark:text-slate-300">{{ (item.paidAmount + 0)|number_format(2, ',', '.') }}</td>
                                <td class="py-2.5 px-3 text-right tnum font-semibold text-slate-900 dark:text-white">{{ item.excludedByLawyer ? '0,00' : item.outstandingAmount|number_format(2, ',', '.') }}</td>
                                <td class="py-2.5 px-3 text-right tnum text-amber-600 dark:text-amber-400">{{ itemAccessory ? itemAccessory.total|number_format(2, ',', '.') : '—' }}</td>
                                <td class="py-2.5 px-3">
                                    {% if item.excludedByLawyer %}
                                        <span class="inline-flex items-center gap-1.5 py-0.5 px-2 rounded-full text-[11px] font-semibold bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300"><span class="size-1.5 rounded-full bg-slate-400" aria-hidden="true"></span>{{ 'case.claim.edit.state_excluded'|trans }}</span>
                                        {% if item.exclusionReason or item.exclusionNote %}
                                            <div class="mt-0.5 text-[10px] text-slate-500 whitespace-nowrap" data-testid="claim-exclusion-reason">{{ item.exclusionReason ? item.exclusionReason.label()|trans : '' }}{% if item.exclusionNote %}{{ item.exclusionReason ? ': ' : '' }}{{ item.exclusionNote }}{% endif %}</div>
                                        {% endif %}
                                    {% elseif counts %}
                                        <span class="inline-flex items-center gap-1.5 py-0.5 px-2 rounded-full text-[11px] font-semibold bg-green-100 text-green-800 dark:bg-green-950/40 dark:text-green-300"><span class="size-1.5 rounded-full bg-green-500" aria-hidden="true"></span>{{ 'case.claim.edit.state_confirmed'|trans }}</span>
                                    {% else %}
                                        <span class="inline-flex items-center gap-1.5 py-0.5 px-2 rounded-full text-[11px] font-semibold bg-amber-100 text-amber-800 dark:bg-amber-950/40 dark:text-amber-300"><span class="size-1.5 rounded-full bg-amber-500" aria-hidden="true"></span>{{ 'case.claim.edit.state_not_counting'|trans }}</span>
                                    {% endif %}
                                </td>
                                <td class="py-2.5 px-3 text-slate-700 dark:text-slate-300">
                                    {% if item.sourceDocument %}
                                        <a href="{{ path('case_document_download', {caseId: case.id, documentId: item.sourceDocument.id}) }}" class="text-blue-700 dark:text-blue-400 hover:underline">{{ item.sourceDocument.originalFilename }}</a>
                                    {% else %}
                                        {{ 'case.claim.edit.source_manual'|trans }}
                                    {% endif %}
                                </td>
                                {% if can_edit_claim %}
                                    <td class="py-2.5 px-3 text-right whitespace-nowrap">
                                        {% if item.excludedByLawyer %}
                                            <form method="post" action="{{ path('case_claim_reinclude', {id: case.id, itemId: item.id}) }}" data-turbo-frame="_top" class="inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('claim_reinclude_' ~ item.id) }}">
                                                <button type="submit" data-testid="claim-reinclude-{{ item.id }}" aria-label="{{ 'case.claim.edit.reinclude_aria'|trans({'%position%': label}) }}" class="text-xs font-semibold text-blue-700 dark:text-blue-400 hover:underline">{{ 'case.claim.edit.reinclude'|trans }}</button>
                                            </form>
                                        {% else %}
                                            <button type="button"
                                                    data-hs-overlay="#hs-modal-claim-exclude"
                                                    data-action="click->claim-exclude#open"
                                                    data-claim-exclude-url-param="{{ path('case_claim_exclude', {id: case.id, itemId: item.id}) }}"
                                                    data-claim-exclude-label-param="{{ label }}"
                                                    data-testid="claim-exclude-{{ item.id }}"
                                                    aria-label="{{ 'case.claim.edit.exclude_aria'|trans({'%position%': label}) }}"
                                                    class="text-xs font-semibold text-slate-600 dark:text-slate-300 hover:underline">{{ 'case.claim.edit.exclude'|trans }}</button>
                                        {% endif %}
                                    </td>
                                {% endif %}
                            </tr>
                        {% endfor %}
                    </tbody>
                    <tfoot>
                        <tr class="border-t border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-950/30">
                            <td colspan="{{ can_edit_claim ? 10 : 9 }}" class="py-2.5 px-3 text-sm font-semibold text-slate-900 dark:text-white tnum">
                                {{ 'case.claim.edit.positions_total'|trans({'%amount%': principal|number_format(2, ',', '.'), '%count%': all_items|length, '%excluded%': excluded_count}) }}
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <p class="mt-2 text-[11px] text-slate-500">{{ 'case.claim.edit.positions_note'|trans }} {{ (is_contractual ? 'case_overview.claim.positions_hint_contractual' : 'case_overview.claim.positions_hint')|trans }}</p>
        {% endif %}

        {# BNR breakdown: per invoice on a multi-position claim, aggregate otherwise, or the error/empty banner. #}
        {% if breakdown_error %}
            <div class="flex items-start gap-2 p-3 rounded-lg bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-900/50 text-xs text-amber-900 dark:text-amber-200">
                {{ icon_warning('size-4 text-amber-600 shrink-0 mt-0.5') }}
                <span>{{ 'case_overview.claim.breakdown_error'|trans }}</span>
            </div>
        {% elseif claim_items is defined and claim_items|length > 1 %}
            {% include 'case/overview/_penalty_breakdown.html.twig' %}

            {# Per-invoice BNR period breakdown, restored for multi-invoice claims. Each
               interest-bearing invoice accrues from its own due date, so the periods are
               grouped per invoice rather than as a single aggregate table. Count only the
               invoices that actually have accrued periods, so the header matches the rows
               below (a not-yet-due invoice carries an empty breakdown). #}
            {% set bnr_invoice_count = 0 %}
            {% if claim_item_accessories is defined and claim_item_accessories %}
                {% for item in claim_items %}
                    {% set _ii = claim_item_accessories.interestByItemId[item.id]|default(null) %}
                    {% if _ii and _ii.breakdown|length > 0 %}{% set bnr_invoice_count = bnr_invoice_count + 1 %}{% endif %}
                {% endfor %}
            {% endif %}
            {% if bnr_invoice_count > 0 %}
                <div class="hs-accordion-group mt-3 border border-slate-200 dark:border-slate-800 rounded-lg overflow-hidden">
                    <div class="hs-accordion" id="acc-bnr-breakdown-multi">
                        <button type="button"
                                class="hs-accordion-toggle hs-accordion-active:bg-slate-50 dark:hs-accordion-active:bg-slate-950/50 inline-flex items-center justify-between gap-x-3 w-full text-sm font-medium text-slate-700 dark:text-slate-300 py-3 px-4 hover:bg-slate-50 dark:hover:bg-slate-950/30 transition"
                                aria-expanded="false"
                                aria-controls="acc-bnr-breakdown-multi-content">
                            <span class="inline-flex items-center gap-2">
                                <span class="hs-accordion-active:rotate-90 transition-transform">{{ icon_chevron_right('size-4 text-slate-400') }}</span>
                                {{ 'case_overview.claim.breakdown_toggle'|trans }}
                            </span>
                            <span class="text-xs text-slate-500 font-normal">{{ 'case_overview.claim.breakdown_summary_multi'|trans({'%count%': bnr_invoice_count}) }}</span>
                        </button>
                        <div id="acc-bnr-breakdown-multi-content"
                             class="hs-accordion-content hidden w-full overflow-hidden transition-[height] duration-300"
                             role="region"
                             aria-labelledby="acc-bnr-breakdown-multi">
                            <div class="px-4 pb-4 space-y-4">
                                {% for item in claim_items %}
                                    {% set itemInterest = claim_item_accessories.interestByItemId[item.id]|default(null) %}
                                    {% if itemInterest and itemInterest.breakdown|length > 0 %}
                                        {% set item_days = 0 %}
                                        {% for period in itemInterest.breakdown %}{% set item_days = item_days + period.days %}{% endfor %}
                                        <div>
                                            <div class="text-[11px] font-medium text-slate-600 dark:text-slate-300 mb-1">{{ 'case_overview.claim.breakdown_item_heading'|trans({'%doc%': item.documentNumber|default('—'), '%date%': item.dueDate ? item.dueDate|date('d.m.Y') : '—'}) }}</div>
                                            <div class="overflow-x-auto">
                                                <table class="w-full text-xs">
                                                    <thead class="text-[10px] uppercase tracking-wide text-slate-500 border-b border-slate-200 dark:border-slate-800">
                                                        <tr>
                                                            <th class="text-left py-2 font-medium">{{ 'case_overview.claim.breakdown_period'|trans }}</th>
                                                            <th class="text-right py-2 font-medium">{{ 'case_overview.claim.breakdown_bnr'|trans }}</th>
                                                            <th class="text-right py-2 font-medium">{{ 'case_overview.claim.breakdown_applicable'|trans }}</th>
                                                            <th class="text-right py-2 font-medium">{{ 'case_overview.claim.breakdown_days'|trans }}</th>
                                                            <th class="text-right py-2 font-medium">{{ 'case_overview.claim.breakdown_interest'|trans }}</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                                                        {% for period in itemInterest.breakdown %}
                                                            <tr>
                                                                <td class="py-2 text-slate-700 dark:text-slate-300">{{ period.startDate|date('d.m.Y') }} → {{ period.endDate|date('d.m.Y') }}</td>
                                                                <td class="py-2 text-right tnum">{{ period.nbrRate|number_format(2, ',', '.') }}%</td>
                                                                <td class="py-2 text-right tnum font-medium">{{ period.applicableRate|number_format(2, ',', '.') }}%</td>
                                                                <td class="py-2 text-right tnum text-slate-500">{{ period.days }}</td>
                                                                <td class="py-2 text-right tnum font-semibold">{{ period.periodInterest|number_format(2, ',', '.') }}</td>
                                                            </tr>
                                                        {% endfor %}
                                                    </tbody>
                                                    <tfoot class="border-t-2 border-slate-200 dark:border-slate-700 font-bold">
                                                        <tr>
                                                            <td colspan="3" class="py-2 text-slate-900 dark:text-white">{{ 'case_overview.claim.breakdown_total'|trans }}</td>
                                                            <td class="py-2 text-right tnum text-slate-500">{{ item_days }}</td>
                                                            <td class="py-2 text-right tnum text-amber-600 dark:text-amber-400">{{ itemInterest.total|number_format(2, ',', '.') }}</td>
                                                        </tr>
                                                    </tfoot>
                                                </table>
                                            </div>
                                        </div>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}
        {% elseif is_contractual %}
            <div class="p-3 rounded-lg bg-slate-50 dark:bg-slate-950/30 border border-slate-200 dark:border-slate-800 text-xs text-slate-600 dark:text-slate-400">
                {{ 'case_overview.claim.contractual_formula'|trans({'%rate%': case.contractualPenaltyRate|number_format(2, ',', '.')}) }}
            </div>
            {% include 'case/overview/_penalty_breakdown.html.twig' %}
        {% elseif interest_breakdown is null or interest_breakdown|length == 0 %}
            <div class="p-3 rounded-lg bg-slate-50 dark:bg-slate-950/30 border border-slate-200 dark:border-slate-800 text-xs text-slate-600 dark:text-slate-400">
                {{ 'case_overview.claim.breakdown_zero'|trans }}
            </div>
        {% else %}
            <div class="hs-accordion-group border border-slate-200 dark:border-slate-800 rounded-lg overflow-hidden">
                <div class="hs-accordion" id="acc-bnr-breakdown">
                    <button type="button"
                            class="hs-accordion-toggle hs-accordion-active:bg-slate-50 dark:hs-accordion-active:bg-slate-950/50 inline-flex items-center justify-between gap-x-3 w-full text-sm font-medium text-slate-700 dark:text-slate-300 py-3 px-4 hover:bg-slate-50 dark:hover:bg-slate-950/30 transition"
                            aria-expanded="false"
                            aria-controls="acc-bnr-breakdown-content">
                        <span class="inline-flex items-center gap-2">
                            <span class="hs-accordion-active:rotate-90 transition-transform">{{ icon_chevron_right('size-4 text-slate-400') }}</span>
                            {{ 'case_overview.claim.breakdown_toggle'|trans }}
                        </span>
                        <span class="text-xs text-slate-500 font-normal">{{ 'case_overview.claim.breakdown_summary'|trans({'%periods%': interest_breakdown|length}) }}</span>
                    </button>
                    <div id="acc-bnr-breakdown-content"
                         class="hs-accordion-content hidden w-full overflow-hidden transition-[height] duration-300"
                         role="region"
                         aria-labelledby="acc-bnr-breakdown">
                        <div class="px-4 pb-4 overflow-x-auto">
                            <table class="w-full text-xs">
                                <thead class="text-[10px] uppercase tracking-wide text-slate-500 border-b border-slate-200 dark:border-slate-800">
                                    <tr>
                                        <th class="text-left py-2 font-medium">{{ 'case_overview.claim.breakdown_period'|trans }}</th>
                                        <th class="text-right py-2 font-medium">{{ 'case_overview.claim.breakdown_bnr'|trans }}</th>
                                        <th class="text-right py-2 font-medium">{{ 'case_overview.claim.breakdown_applicable'|trans }}</th>
                                        <th class="text-right py-2 font-medium">{{ 'case_overview.claim.breakdown_days'|trans }}</th>
                                        <th class="text-right py-2 font-medium">{{ 'case_overview.claim.breakdown_interest'|trans }}</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                                    {% for period in interest_breakdown %}
                                        <tr>
                                            <td class="py-2 text-slate-700 dark:text-slate-300">{{ period.startDate|date('d.m.Y') }} → {{ period.endDate|date('d.m.Y') }}</td>
                                            <td class="py-2 text-right tnum">{{ period.nbrRate|number_format(2, ',', '.') }}%</td>
                                            <td class="py-2 text-right tnum font-medium">{{ period.applicableRate|number_format(2, ',', '.') }}%</td>
                                            <td class="py-2 text-right tnum text-slate-500">{{ period.days }}</td>
                                            <td class="py-2 text-right tnum font-semibold">{{ period.periodInterest|number_format(2, ',', '.') }}</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                                <tfoot class="border-t-2 border-slate-200 dark:border-slate-700 font-bold">
                                    <tr>
                                        <td colspan="3" class="py-2 text-slate-900 dark:text-white">{{ 'case_overview.claim.breakdown_total'|trans }}</td>
                                        <td class="py-2 text-right tnum text-slate-500">{{ interest_days }}</td>
                                        <td class="py-2 text-right tnum text-amber-600 dark:text-amber-400">{{ interest|number_format(2, ',', '.') }}</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</section>
