{# Preline tabs nav. Preline JS comută clasele `hidden` pe panels.
   Tab-ul activ inițial e dat server-side prin `active_tab` (vezi overview.html.twig),
   ca acțiunile care redirectează să păstreze tab-ul curent. #}
{% set active_tab = active_tab|default('detalii') %}

{% set tabs = [
    { key: 'detalii',   label: 'case_overview.tab.details',   count: null },
    { key: 'documente', label: 'case_overview.tab.documents', count: case.documents|length, badge: 'slate' },
    { key: 'termene',   label: 'case_overview.tab.deadlines', count: deadlines|length,       badge: 'amber' },
    { key: 'portal',    label: 'case_overview.tab.portal',    count: null },
    { key: 'audit',     label: 'case_overview.tab.audit',     count: auditLogs|length,       badge: 'slate' },
] %}

{% set tab_class = "hs-tab-active:font-semibold hs-tab-active:text-slate-900 hs-tab-active:after:bg-gradient-to-r hs-tab-active:after:from-lex-navy hs-tab-active:after:to-blue-500 dark:hs-tab-active:text-white relative py-3.5 px-4 inline-flex items-center gap-x-1.5 text-sm font-medium text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 whitespace-nowrap after:content-[''] after:absolute after:bottom-0 after:left-2 after:right-2 after:h-0.5 after:rounded-t-full after:bg-transparent" %}

<div id="case-tabs-nav" data-controller="tab-url-sync" class="bg-white dark:bg-slate-900 rounded-2xl shadow-soft border border-slate-200 dark:border-slate-800 mb-6 overflow-hidden">
    <nav class="flex gap-1 px-2 border-b border-slate-200 dark:border-slate-800 overflow-x-auto" aria-label="{{ 'case_overview.title'|trans({'%reference%': case.caseNumber}) }}" role="tablist">
        {% for t in tabs %}
            <button type="button"
                    id="tab-{{ t.key }}"
                    role="tab"
                    aria-controls="panel-{{ t.key }}"
                    aria-selected="{{ active_tab == t.key ? 'true' : 'false' }}"
                    data-hs-tab="#panel-{{ t.key }}"
                    class="{{ tab_class }}{{ active_tab == t.key ? ' active' : '' }}">
                {{ t.label|trans }}
                {% if t.count is not null and t.count > 0 %}
                    <span class="inline-flex items-center justify-center min-w-[20px] h-5 px-1.5 rounded-md text-[10px] font-semibold tnum {{ t.badge == 'amber' ? 'bg-amber-100 dark:bg-amber-950/50 text-amber-700 dark:text-amber-300' : 'bg-slate-100 dark:bg-slate-800' }}">{{ t.count }}</span>
                {% endif %}
            </button>
        {% endfor %}
    </nav>
</div>
