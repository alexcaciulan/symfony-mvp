{# Config monitorizare card (wired). Badge stare din
   `case.portalMonitoringActive`. Form POST către `case_portal_activate`. #}
{% from 'case/overview/_icons.html.twig' import icon_chevron_right, icon_lock %}

{% set monitoring_active = case.portalMonitoringActive %}
{# Threshold: once real portal activity exists, the court case number is
   load-bearing. Discovery + the editable number are hidden; correcting the
   number (with cleanup) is a deferred feature. #}
{% set has_portal_activity = case.portalEvents|length > 0 %}

<section class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-soft overflow-hidden">
    <div class="px-6 py-5 border-b border-slate-100 dark:border-slate-800">
        <div class="flex items-center justify-between gap-4 flex-wrap">
            <div>
                <div class="text-[10px] font-bold uppercase tracking-wider text-purple-600 dark:text-purple-400 mb-1">{{ 'case_overview.portal.config_label'|trans }}</div>
                <h3 class="text-base font-semibold">{{ 'case_overview.portal.config_title'|trans }}</h3>
                <p class="text-xs text-slate-500 mt-0.5">{{ 'case_overview.portal.config_hint'|trans }}</p>
            </div>
            {% if monitoring_active %}
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-green-100 text-green-800 dark:bg-green-950/40 dark:text-green-300">
                    <span class="size-1.5 rounded-full bg-green-500" aria-hidden="true"></span>{{ 'case_overview.portal.config_active'|trans }}
                </span>
            {% else %}
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400">
                    <span class="size-1.5 rounded-full bg-slate-400" aria-hidden="true"></span>{{ 'case_overview.portal.config_inactive'|trans }}
                </span>
            {% endif %}
        </div>

        {% if has_portal_activity %}
            {# Number is locked: monitoring already produced activity. Show it
               read-only with a discreet note. Casual change is disabled. #}
            <div class="mt-4 flex items-center justify-between gap-4 px-3 py-2.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/40">
                <div>
                    <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">{{ 'case_overview.portal.config_number_label'|trans }}</div>
                    <div class="font-mono text-sm font-semibold">{{ case.courtCaseNumber }}</div>
                </div>
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                    {{ icon_lock('size-3') }}{{ 'case_overview.portal.config_locked_badge'|trans }}
                </span>
            </div>
            <p class="mt-2 text-[11px] text-slate-500">{{ 'case_overview.portal.config_locked_note'|trans }}</p>
        {% else %}
            {# Auto-descoperire pe portal: caută dosarul după părți + instanță, fără ca
               avocatul să iasă din platformă. Inputul manual de mai jos rămâne fallback. #}
            <div class="mt-4 pb-4 border-b border-slate-100 dark:border-slate-800">
                {{ include('case/overview/_portal_discover_results.html.twig', { suggestions: [], state: 'initial' }) }}
            </div>

            <form method="post" action="{{ path('case_portal_activate', { id: case.id }) }}" data-turbo-frame="_top" class="mt-4 flex items-center gap-2">
                <input type="hidden" name="portal_activate[_token]" value="{{ csrf_token('portal_activate') }}">
                <div class="flex-1 relative">
                    <input type="text"
                           name="portal_activate[courtCaseNumber]"
                           value="{{ case.courtCaseNumber|default('') }}"
                           placeholder="{{ 'case_overview.portal.config_placeholder'|trans }}"
                           class="w-full px-3 py-2.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800/60 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-lex-navy/40">
                    <span class="absolute right-3 top-1/2 -translate-y-1/2 text-[11px] text-slate-400">{{ 'case_overview.portal.config_format'|trans }}</span>
                </div>
                <button type="submit"
                        class="py-2.5 px-4 inline-flex items-center gap-1.5 text-sm font-semibold rounded-lg bg-gradient-to-br from-lex-navy to-lex-navy-dark text-white shadow-sm hover:opacity-90 transition-opacity">
                    {{ icon_chevron_right('size-4') }}
                    {{ monitoring_active ? 'case_overview.portal.config_update'|trans : 'case_overview.portal.config_activate'|trans }}
                </button>
            </form>
            <p class="mt-2 text-[11px] text-slate-500">{{ 'case_overview.portal.config_disclaimer'|trans }}</p>
        {% endif %}
    </div>
</section>
