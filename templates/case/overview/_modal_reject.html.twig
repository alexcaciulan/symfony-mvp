{# Modal Preline pentru tranzițiile către RESPINSA. Două contexte juridice distincte
   partajează același formular: din TERMEN_FIXAT — instanța respinge cererea de OP
   (workflow `respinge`); din IN_ANULARE — instanța admite cererea în anulare a
   debitorului și anulează ordonanța (workflow `admite_cerere_anulare`). Titlul și
   intro-ul se schimbă condiționat ca să reflecte semantica reală.
   Form auto-CSRF prin RejectCaseType (csrf_token_id: reject_case). #}
{% from 'case/overview/_icons.html.twig' import icon_warning %}

{% set is_admit_anulare = case.status.value == 'IN_ANULARE' %}
{% set modal_title = is_admit_anulare
    ? 'case_overview.modal.reject_title_admit_anulare'|trans
    : 'case_overview.modal.reject_title'|trans %}
{% set modal_intro = is_admit_anulare
    ? 'case_overview.modal.reject_intro_admit_anulare'|trans
    : 'case_overview.modal.reject_intro'|trans %}

<div id="hs-modal-reject"
     class="hs-overlay hidden size-full fixed top-0 start-0 z-[80] overflow-x-hidden overflow-y-auto pointer-events-none"
     role="dialog"
     tabindex="-1"
     aria-labelledby="hs-modal-reject-title">
    <div class="hs-overlay-open:mt-7 hs-overlay-open:opacity-100 hs-overlay-open:duration-500 mt-0 opacity-0 ease-out transition-all sm:max-w-lg sm:w-full m-3 sm:mx-auto">
        <form method="post" action="{{ path('case_transition_reject', {id: case.id}) }}" class="flex flex-col bg-white border border-slate-200 shadow-lg rounded-2xl pointer-events-auto dark:bg-slate-900 dark:border-slate-800">
            <input type="hidden" name="reject_case[_token]" value="{{ csrf_token('reject_case') }}">

            <div class="flex justify-between items-center py-4 px-5 border-b border-slate-100 dark:border-slate-800">
                <div class="flex items-center gap-3">
                    <span class="inline-flex items-center justify-center size-9 rounded-lg bg-red-100 dark:bg-red-950/40 text-red-600 dark:text-red-400">
                        {{ icon_warning('size-5') }}
                    </span>
                    <h3 id="hs-modal-reject-title" class="font-bold text-slate-900 dark:text-white">{{ modal_title }}</h3>
                </div>
                <button type="button"
                        class="size-8 inline-flex justify-center items-center rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 hover:bg-slate-200 dark:text-slate-100 dark:hover:bg-slate-700"
                        aria-label="{{ 'case_overview.modal.aria_close'|trans }}"
                        data-hs-overlay="#hs-modal-reject">
                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            <div class="p-5 space-y-4">
                <p class="text-sm text-slate-600 dark:text-slate-400">{{ modal_intro }}</p>

                <div>
                    <label for="reject_case_reason_field" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">{{ 'case_overview.modal.reject_reason_label'|trans }}</label>
                    <select id="reject_case_reason_field"
                            name="reject_case[reason]"
                            required
                            class="w-full py-2 px-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-red-500">
                        <option value="">{{ 'case_overview.modal.reject_reason_placeholder'|trans }}</option>
                        <option value="NO_PROOF">{{ 'enum.reject_reason.NO_PROOF'|trans }}</option>
                        <option value="INADMISSIBLE">{{ 'enum.reject_reason.INADMISSIBLE'|trans }}</option>
                    </select>
                </div>

                <div>
                    <label for="reject_case_details_field" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">{{ 'case_overview.modal.reject_details_label'|trans }}</label>
                    <textarea id="reject_case_details_field"
                              name="reject_case[details]"
                              rows="3"
                              maxlength="500"
                              placeholder="{{ 'case_overview.modal.reject_details_placeholder'|trans }}"
                              class="w-full py-2 px-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-red-500"></textarea>
                </div>
            </div>

            <div class="flex justify-end items-center gap-x-2 py-3 px-5 border-t border-slate-100 dark:border-slate-800">
                <button type="button"
                        class="py-2 px-3 inline-flex items-center text-sm font-medium rounded-lg border border-slate-200 bg-white text-slate-800 hover:bg-slate-50 dark:bg-slate-900 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
                        data-hs-overlay="#hs-modal-reject">
                    {{ 'case_overview.modal.reject_cancel'|trans }}
                </button>
                <button type="submit"
                        class="py-2 px-4 inline-flex items-center text-sm font-semibold rounded-lg bg-red-600 text-white hover:bg-red-700 transition">
                    {{ 'case_overview.modal.reject_confirm'|trans }}
                </button>
            </div>
        </form>
    </div>
</div>
