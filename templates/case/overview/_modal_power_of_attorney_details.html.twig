{# Shared modal completing the series, number and date of a power of attorney
   already on the case. Populated from the clicked trigger by
   power-of-attorney-edit_controller, so it lives at body level and survives the
   Turbo Stream re-render of the documents panel. Posts to case_document_power_of_attorney. #}
{% from 'case/overview/_icons.html.twig' import icon_edit %}

<div id="hs-modal-power-of-attorney"
     data-controller="power-of-attorney-edit"
     class="hs-overlay hidden size-full fixed top-0 start-0 z-[80] overflow-x-hidden overflow-y-auto pointer-events-none"
     role="dialog"
     tabindex="-1"
     aria-labelledby="hs-modal-power-of-attorney-title">
    <div class="hs-overlay-open:mt-7 hs-overlay-open:opacity-100 hs-overlay-open:duration-500 mt-0 opacity-0 ease-out transition-all sm:max-w-lg sm:w-full m-3 sm:mx-auto">
        <form method="post" action="" data-turbo-frame="_top" data-power-of-attorney-edit-target="form" class="flex flex-col bg-white border border-slate-200 shadow-lg rounded-2xl pointer-events-auto dark:bg-slate-900 dark:border-slate-800">
            <input type="hidden" name="power_of_attorney_details[_token]" value="{{ csrf_token('power_of_attorney_details') }}">

            <div class="flex justify-between items-center py-4 px-5 border-b border-slate-100 dark:border-slate-800">
                <div class="flex items-center gap-3">
                    <span class="inline-flex items-center justify-center size-9 rounded-lg bg-blue-100 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400">
                        {{ icon_edit('size-5') }}
                    </span>
                    <h3 id="hs-modal-power-of-attorney-title" class="font-bold text-slate-900 dark:text-white">{{ 'document.power_of_attorney.modal_title'|trans }}</h3>
                </div>
                <button type="button"
                        class="size-8 inline-flex justify-center items-center rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 hover:bg-slate-200 dark:text-slate-100 dark:hover:bg-slate-700"
                        aria-label="{{ 'case_overview.modal.aria_close'|trans }}"
                        data-hs-overlay="#hs-modal-power-of-attorney">
                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            <div class="p-5 space-y-4">
                <p class="text-sm text-slate-600 dark:text-slate-400 truncate" data-power-of-attorney-edit-target="filename"></p>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label for="power_of_attorney_details_powerOfAttorneySeries" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">{{ 'document.power_of_attorney.series_label'|trans }}</label>
                        <input type="text" id="power_of_attorney_details_powerOfAttorneySeries" name="power_of_attorney_details[powerOfAttorneySeries]" maxlength="20"
                               data-power-of-attorney-edit-target="series"
                               class="w-full py-2 px-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                    </div>
                    <div>
                        <label for="power_of_attorney_details_powerOfAttorneyNumber" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">{{ 'document.power_of_attorney.number_label'|trans }}</label>
                        <input type="text" id="power_of_attorney_details_powerOfAttorneyNumber" name="power_of_attorney_details[powerOfAttorneyNumber]" maxlength="30"
                               data-power-of-attorney-edit-target="number"
                               class="w-full py-2 px-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                    </div>
                </div>

                <div>
                    <label for="power_of_attorney_details_powerOfAttorneyDate" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">{{ 'document.power_of_attorney.date_label'|trans }}</label>
                    <input type="date" id="power_of_attorney_details_powerOfAttorneyDate" name="power_of_attorney_details[powerOfAttorneyDate]" required max="{{ 'now'|date('Y-m-d') }}"
                           data-power-of-attorney-edit-target="date"
                           class="w-full py-2 px-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <p class="mt-1.5 text-xs text-slate-400 dark:text-slate-500">{{ 'document.power_of_attorney.date_hint'|trans }}</p>
                </div>
            </div>

            <div class="flex justify-end items-center gap-x-2 py-3 px-5 border-t border-slate-100 dark:border-slate-800">
                <button type="button"
                        class="py-2 px-3 inline-flex items-center text-sm font-medium rounded-lg border border-slate-200 bg-white text-slate-800 hover:bg-slate-50 dark:bg-slate-900 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
                        data-hs-overlay="#hs-modal-power-of-attorney">
                    {{ 'document.power_of_attorney.cancel'|trans }}
                </button>
                <button type="submit"
                        class="py-2 px-4 inline-flex items-center text-sm font-semibold rounded-lg bg-lex-navy text-white hover:bg-lex-navy/90 transition">
                    {{ 'document.power_of_attorney.submit'|trans }}
                </button>
            </div>
        </form>
    </div>
</div>
