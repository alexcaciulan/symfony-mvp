{# Card pentru o singură LegalDeadline. Variant computed din state (completed) sau priority.
   Reflectă mockup linii 781-845. Variantele: completed / critical / high (with blur + large icon + pulse)
   / medium / low. Caller passes `deadline: LegalDeadline` via include. #}
{% from 'case/overview/_icons.html.twig' import icon_check, icon_clock, icon_warning, icon_document, icon_edit, icon_trash %}

{% set variant_key = deadline.completed ? 'completed' : deadline.priority.value|lower %}
{% set is_critical = deadline.priority.value == 'CRITICAL' %}

{# Single source of truth for the visual styling of each variant. Keep all variant-dependent
   classes here so a future redesign / palette tweak stays in one place. #}
{% set variant_map = {
    'completed': {
        card: 'bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-800 opacity-60',
        icon_size: 'size-12',
        icon_classes: 'bg-green-100 dark:bg-green-950/40 text-green-600 dark:text-green-400',
        badge: 'bg-green-100 text-green-800 dark:bg-green-950/40 dark:text-green-300',
        large_icon: false,
        decoration: false,
        pulse: false,
        badge_label_key: 'case_overview.deadlines.status_completed_badge',
    },
    'critical': {
        card: 'bg-gradient-to-br from-red-50 to-rose-50 dark:from-red-950/30 dark:to-rose-950/20 border-red-200 dark:border-red-900/50',
        icon_size: 'size-14',
        icon_classes: 'bg-gradient-to-br from-red-400 to-red-600 text-white shadow-lg shadow-red-500/30',
        badge: 'bg-red-100 text-red-800 dark:bg-red-950/40 dark:text-red-300',
        large_icon: true,
        decoration: true,
        pulse: true,
        decoration_classes: 'bg-gradient-to-br from-red-200/30 to-transparent dark:from-red-700/20',
    },
    'high': {
        card: 'bg-gradient-to-br from-amber-50 to-orange-50 dark:from-amber-950/30 dark:to-orange-950/20 border-amber-200 dark:border-amber-900/50',
        icon_size: 'size-14',
        icon_classes: 'bg-gradient-to-br from-amber-400 to-amber-600 text-white shadow-lg shadow-amber-500/30',
        badge: 'bg-amber-100 text-amber-800 dark:bg-amber-950/40 dark:text-amber-300',
        large_icon: true,
        decoration: true,
        pulse: true,
        decoration_classes: 'bg-gradient-to-br from-amber-200/30 to-transparent dark:from-amber-700/20',
    },
    'medium': {
        card: 'bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-800',
        icon_size: 'size-12',
        icon_classes: 'bg-yellow-100 dark:bg-yellow-950/40 text-yellow-600 dark:text-yellow-400',
        badge: 'bg-yellow-100 text-yellow-800 dark:bg-yellow-950/40 dark:text-yellow-300',
        large_icon: false,
        decoration: false,
        pulse: false,
    },
    'low': {
        card: 'bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-800',
        icon_size: 'size-12',
        icon_classes: 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400',
        badge: 'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300',
        large_icon: false,
        decoration: false,
        pulse: false,
    },
} %}
{# Fallback to LOW variant for any new DeadlinePriority case that might be added later. #}
{% set v = variant_map[variant_key]|default(variant_map['low']) %}
{% set badge_label = v.badge_label_key is defined and v.badge_label_key ? v.badge_label_key|trans : deadline.priority.value %}

{% set days_remaining = deadline.daysRemaining %}
{% set type_label = deadline.type.label()|trans %}
{% set date_label = deadline.deadlineDate|date('d.m.Y') %}

<section id="deadline-card-{{ deadline.id }}" class="{{ v.card }} border rounded-2xl p-5 shadow-soft relative overflow-hidden">
    {% if v.decoration %}
        <div class="absolute top-0 right-0 size-32 {{ v.decoration_classes }} rounded-full blur-2xl pointer-events-none" aria-hidden="true"></div>
    {% endif %}
    <div class="relative flex items-start gap-4">
        <div class="shrink-0">
            <div class="{{ v.icon_size }} rounded-xl {{ v.icon_classes }} flex items-center justify-center">
                {% if deadline.completed %}
                    {{ icon_check('size-6') }}
                {% elseif v.large_icon %}
                    {{ icon_document('size-7') }}
                {% else %}
                    {{ icon_clock('size-6') }}
                {% endif %}
            </div>
        </div>
        <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 flex-wrap mb-1">
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold {{ v.badge }}">
                    {% if v.pulse %}<span class="size-1.5 rounded-full bg-amber-500 animate-pulse" aria-hidden="true"></span>{% endif %}
                    {{ badge_label }}
                </span>
                <span class="text-[10px] uppercase tracking-wider font-bold {% if deadline.completed %}text-slate-500 line-through{% else %}text-amber-700 dark:text-amber-400{% endif %}">{{ type_label }}</span>
            </div>
            <div class="text-base font-bold {% if deadline.completed %}text-slate-700 dark:text-slate-300 line-through{% else %}text-slate-900 dark:text-white{% endif %}">
                {% if deadline.completed %}
                    {{ 'case_overview.deadlines.completed_on'|trans({'%date%': date_label}) }}
                {% else %}
                    {{ 'case_overview.deadlines.date_in_days'|trans({'%date%': date_label, '%days%': days_remaining}) }}
                {% endif %}
            </div>
            {% if deadline.description %}
                <p class="text-xs {% if deadline.completed %}text-slate-500{% else %}text-slate-600 dark:text-slate-400{% endif %} mt-1">{{ deadline.description }}</p>
            {% endif %}

            {# The lawyer has decided he is not challenging the order. It is the only act
               the platform can offer on this window: it cannot draft the request, which
               needs the reasoning of a ruling nobody has analysed here. Pressing nothing
               is equally valid, and then the term runs its course and closes on expiry. #}
            {% if not deadline.completed and deadline.type.value == 'CERERE_IN_ANULARE' %}
                <form method="post"
                      action="{{ path('case_deadline_no_annulment_request', {caseId: deadline.legalCase.id, deadlineId: deadline.id}) }}"
                      data-turbo-frame="_top"
                      data-turbo-confirm="{{ 'case_overview.deadlines.no_annulment_request_confirm'|trans }}"
                      class="mt-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('no_annulment_request_' ~ deadline.id) }}">
                    <button type="submit" class="text-[11px] font-semibold text-slate-500 hover:text-amber-700 dark:hover:text-amber-400 underline underline-offset-2 transition">
                        {{ 'case_overview.deadlines.no_annulment_request_cta'|trans }}
                    </button>
                </form>
            {% endif %}

            {# The filing with the bailiff is declared, its registration number is not.
               The interruption of CPC art. 708 alin. 1 pct. 2 already happened, on the day
               the request was filed; the number is the confirmation the platform asks for
               before it closes a term by itself, not something the law waits for. So the
               card asks for it and states that the alerts are silent meanwhile. #}
            {% if not deadline.completed and deadline.type.value == 'PRESCRIPTIE_EXECUTARE' and deadline.legalCase.enforcementRequestDate is not null and deadline.legalCase.enforcementRegistrationNumber is null %}
                <div class="mt-3 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60 p-3">
                    <p class="text-[11px] leading-relaxed text-slate-600 dark:text-slate-400">
                        {{ 'case_overview.deadlines.awaiting_enforcement_registration_number'|trans({'%date%': deadline.legalCase.enforcementRequestDate|date('d.m.Y')}) }}
                    </p>
                    <button type="button"
                            data-hs-overlay="#hs-modal-set-enforcement-registration-number"
                            class="mt-2 text-[11px] font-semibold text-lex-navy dark:text-blue-400 underline underline-offset-2 transition">
                        {{ 'case_overview.deadlines.enforcement_registration_number_cta'|trans }}
                    </button>
                </div>
            {% endif %}

            {# The enforcement interrupted the limitation on the date the request was filed
               (CPC art. 708 alin. 1 pct. 2). That interruption falls away if the
               enforcement is dismissed, annulled, perimed or abandoned (alin. 3), and then
               the three years never stopped running.

               Offered from the moment the filing is declared, not only once the term is
               closed: between the declaration and the registration number the term is
               already silent, and gating this on `completed` would leave the lawyer with
               no way to say the enforcement failed before the bailiff ever registered it.
               Whether the term is still open or already closed, the action means the same
               thing and undoes the same two facts. #}
            {% if deadline.type.value == 'PRESCRIPTIE_EXECUTARE' and deadline.legalCase.enforcementRequestDate is not null %}
                <form method="post"
                      action="{{ path('case_deadline_enforcement_not_interrupting', {caseId: deadline.legalCase.id}) }}"
                      data-turbo-frame="_top"
                      data-turbo-confirm="{{ 'case_overview.deadlines.reopen_execution_prescription_confirm'|trans }}"
                      class="mt-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('enforcement_not_interrupting_' ~ deadline.legalCase.id) }}">
                    <button type="submit" class="text-[11px] font-semibold text-slate-500 hover:text-amber-700 dark:hover:text-amber-400 underline underline-offset-2 transition">
                        {{ 'case_overview.deadlines.reopen_execution_prescription_cta'|trans }}
                    </button>
                </form>
            {% endif %}

            {% if not deadline.completed and (variant_key == 'high' or variant_key == 'critical') %}
                {# The tiers come from the alerting service, not from this template: a
                   limitation term is warned about at 30 and 14 days on top of the
                   procedural 7 / 3 / 1, and a fixed list here would hide them. The same
                   service decides when a term deliberately sends nothing, so the card
                   says so rather than printing an empty list under the word "Alerte". #}
                <div class="mt-3 flex items-center gap-3 text-[11px] text-slate-500">
                    <span class="inline-flex items-center gap-1 flex-wrap">
                        {{ icon_clock('size-3') }}
                        {% if deadline_alerts_muted(deadline) %}
                            {{ 'case_overview.deadlines.alerts_muted'|trans }}
                        {% else %}
                            {{ 'case_overview.deadlines.alerts_label'|trans }}
                            {% for tier in deadline_alert_ladder(deadline) %}
                                {{ (tier.sent ? 'case_overview.deadlines.alert_tier_sent' : 'case_overview.deadlines.alert_tier_pending')|trans({ '%days%': tier.days }) }}{% if not loop.last %} ·{% endif %}
                            {% endfor %}
                        {% endif %}
                    </span>
                </div>
            {% endif %}
        </div>

        {# Completion toggle (optimistic UI + Turbo Stream) + edit + delete.

           The toggle is deliberately absent on three types, each of which ends through an
           act of its own rather than through a tick.

           A limitation period is not an act the lawyer performs, and closing one is
           irreversible: what ends it is the act that stops it (the request filed in court,
           the enforcement registered with the bailiff), recorded by the application itself.

           The annulment window is a ten-day forfeiture term, and the only act the platform
           can offer on it is the decision not to use it. That decision has its own button
           above, with its own confirmation and its own audit reason, so the tick here would
           be a second, silent way to close the same term and would record it as a generic
           completion instead.

           The agenda offers none of the three either. Delete stays available, so a term
           created by mistake is still removable. #}
        {% set closable = deadline.type.value not in ['PRESCRIPTIE', 'PRESCRIPTIE_EXECUTARE', 'CERERE_IN_ANULARE'] %}
        <div class="shrink-0 flex flex-col items-center gap-2">
            {% if deadline.completed %}
                <span class="inline-flex items-center justify-center size-6 rounded-full border-2 bg-green-500 border-green-500 text-white" aria-label="{{ 'case_overview.deadlines.status_completed_badge'|trans }}">
                    {{ icon_check('size-3.5') }}
                </span>
            {% elseif closable %}
                <button type="button"
                        data-controller="optimistic-action"
                        data-action="click->optimistic-action#trigger"
                        data-optimistic-action-url-value="{{ path('case_deadline_complete', {caseId: deadline.legalCase.id, deadlineId: deadline.id}) }}"
                        data-optimistic-action-method-value="POST"
                        data-optimistic-action-toggle-class-value="is-completing"
                        data-optimistic-action-csrf-token-value="{{ csrf_token('complete_deadline_' ~ deadline.id) }}"
                        data-optimistic-action-error-message-value="{{ 'stimulus.deadline.error'|trans }}"
                        aria-label="{{ 'case_overview.deadlines.mark_complete_aria'|trans }}"
                        class="inline-flex items-center justify-center size-6 rounded-full border-2 border-slate-300 dark:border-slate-600 hover:border-green-500 hover:bg-green-50 dark:hover:bg-green-950/40 cursor-pointer transition group">
                    <span class="opacity-0 group-hover:opacity-100 transition text-green-600 dark:text-green-400">
                        {{ icon_check('size-3.5') }}
                    </span>
                </button>
            {% endif %}

            {# Edit is meaningless once a deadline is completed; delete stays as the
               escape hatch for a mistaken completion (no un-complete action). #}
            {% if not deadline.completed %}
                <button type="button"
                        data-hs-overlay="#hs-modal-edit-deadline"
                        data-deadline-edit-url="{{ path('case_deadline_edit', {caseId: deadline.legalCase.id, deadlineId: deadline.id}) }}"
                        data-deadline-edit-date="{{ deadline.deadlineDate|date('Y-m-d') }}"
                        data-deadline-edit-description="{{ deadline.description }}"
                        data-deadline-edit-critical="{{ is_critical ? '1' : '0' }}"
                        aria-label="{{ 'case_overview.deadlines.edit_aria'|trans }}"
                        class="inline-flex items-center justify-center size-6 rounded-full text-slate-400 dark:text-slate-500 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition">
                    {{ icon_edit('size-3.5') }}
                </button>
            {% endif %}

            <form method="post"
                  action="{{ path('case_deadline_delete', {caseId: deadline.legalCase.id, deadlineId: deadline.id}) }}"
                  data-turbo-frame="_top"
                  data-turbo-confirm="{{ (is_critical ? 'case_overview.deadlines.delete_confirm_critical' : 'case_overview.deadlines.delete_confirm')|trans }}">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_deadline_' ~ deadline.id) }}">
                <button type="submit"
                        aria-label="{{ 'case_overview.deadlines.delete_aria'|trans }}"
                        class="inline-flex items-center justify-center size-6 rounded-full text-slate-400 dark:text-slate-500 hover:text-red-600 dark:hover:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/40 transition">
                    {{ icon_trash('size-3.5') }}
                </button>
            </form>
        </div>
    </div>
</section>
