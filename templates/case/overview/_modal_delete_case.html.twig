{# Confirming the deletion of a case still in the amiable stage. Rendered only when
   CASE_DELETE is granted, so the dialog never offers what the route would refuse.
   Lists what leaves the lists with the case and asks for an explicit acknowledgement
   when a summons was already produced. Submitted by Turbo Drive: a refusal answers
   with a toast only, so the dialog stays open; a success leaves for the case list. #}
{% from 'case/overview/_icons.html.twig' import icon_trash %}
{% set summons_generated = case.paymentNoticeDate is not null %}
{% set stamp_duty_proof = case.hasStampDutyProof %}

<div id="hs-modal-delete-case"
     class="hs-overlay hidden size-full fixed top-0 start-0 z-[80] overflow-x-hidden overflow-y-auto pointer-events-none"
     role="dialog"
     tabindex="-1"
     aria-labelledby="hs-modal-delete-case-title"
     data-testid="modal-delete-case">
    <div class="hs-overlay-open:mt-7 hs-overlay-open:opacity-100 hs-overlay-open:duration-500 mt-0 opacity-0 ease-out transition-all sm:max-w-lg sm:w-full m-3 sm:mx-auto">
        <form method="post" action="{{ path('case_delete', {id: case.id}) }}" class="flex flex-col bg-white border border-slate-200 shadow-lg rounded-2xl pointer-events-auto dark:bg-slate-900 dark:border-slate-800">
            <input type="hidden" name="_token" value="{{ csrf_token('delete_case_' ~ case.id) }}">

            <div class="flex justify-between items-center py-4 px-5 border-b border-slate-100 dark:border-slate-800">
                <div class="flex items-center gap-3">
                    <span class="inline-flex items-center justify-center size-9 rounded-lg bg-red-100 dark:bg-red-950/40 text-red-600 dark:text-red-400">
                        {{ icon_trash('size-5') }}
                    </span>
                    <h3 id="hs-modal-delete-case-title" class="font-bold text-slate-900 dark:text-white">{{ 'case.delete.title'|trans }}</h3>
                </div>
                <button type="button"
                        class="size-8 inline-flex justify-center items-center rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 hover:bg-slate-200 dark:text-slate-100 dark:hover:bg-slate-700"
                        aria-label="{{ 'case_overview.modal.aria_close'|trans }}"
                        data-hs-overlay="#hs-modal-delete-case">
                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            <div class="p-5 space-y-4">
                <p class="text-sm text-slate-600 dark:text-slate-400">
                    {{ 'case.delete.body_prefix'|trans }}
                    <strong class="font-mono text-slate-900 dark:text-white">{{ case.caseNumber }}</strong>
                    {{ 'case.delete.body_suffix'|trans }}
                </p>

                <ul class="text-sm text-slate-600 dark:text-slate-400 list-disc ps-5 space-y-1" data-testid="delete-case-losses">
                    <li>{{ 'case.delete.loses_documents'|trans({'%count%': case.documents|length}) }}</li>
                    <li>{{ 'case.delete.loses_claim'|trans({'%count%': case.claimItems|length}) }}</li>
                    <li>{{ 'case.delete.loses_deadlines'|trans }}</li>
                </ul>

                {% if summons_generated %}
                    <div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800 dark:border-amber-900 dark:bg-amber-950/40 dark:text-amber-200" role="alert" data-testid="delete-warn-summons-generated">
                        <p>{{ 'case.delete.warn_summons_generated'|trans({'%date%': case.paymentNoticeDate|date('d.m.Y')}) }}</p>
                        <label class="mt-2 flex items-start gap-2 font-medium">
                            <input type="checkbox" name="acknowledge" value="1" required class="mt-0.5 size-4 rounded border-amber-400 text-red-600 focus:ring-red-500">
                            <span>{{ 'case.delete.acknowledge'|trans }}</span>
                        </label>
                    </div>
                {% endif %}

                {% if stamp_duty_proof %}
                    <div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800 dark:border-amber-900 dark:bg-amber-950/40 dark:text-amber-200" role="alert" data-testid="delete-warn-stamp-duty-proof">
                        {{ 'case.delete.warn_stamp_duty_proof'|trans }}
                    </div>
                {% endif %}

                <div>
                    <label for="delete_case_reason_field" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">{{ 'case.delete.reason'|trans }}</label>
                    <textarea id="delete_case_reason_field"
                              name="reason"
                              rows="3"
                              maxlength="500"
                              placeholder="{{ 'case.delete.reason_placeholder'|trans }}"
                              class="w-full py-2 px-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-red-500"></textarea>
                    <p class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">{{ 'case.delete.reason_hint'|trans }}</p>
                </div>
            </div>

            <div class="flex justify-end items-center gap-x-2 py-3 px-5 border-t border-slate-100 dark:border-slate-800">
                <button type="button"
                        class="py-2 px-3 inline-flex items-center text-sm font-medium rounded-lg border border-slate-200 bg-white text-slate-800 hover:bg-slate-50 dark:bg-slate-900 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
                        data-hs-overlay="#hs-modal-delete-case">
                    {{ 'case.delete.cancel'|trans }}
                </button>
                <button type="submit"
                        data-testid="delete-case-confirm"
                        class="py-2 px-4 inline-flex items-center gap-x-2 text-sm font-semibold rounded-lg bg-red-600 text-white hover:bg-red-700 transition">
                    {{ icon_trash('size-4') }}
                    {{ 'case.delete.confirm'|trans }}
                </button>
            </div>
        </form>
    </div>
</div>
