{# Summons communication on the Documente tab: the receipt date (starts the 15-day
   term) and the proof shown to the court, side by side. #}
{% from 'case/overview/_icons.html.twig' import icon_check, icon_calendar, icon_download, icon_document %}

{% set communication_date = case.paymentNoticeCommunicationDate %}
{% set communication_method = case.paymentNoticeCommunicationMethod %}
{% set proof = communication_proof|default(null) %}
{% set can_edit_date = case.canCorrectPaymentNoticeCommunicationDate %}
{% set term_end = payment_term_end|default(null) %}

{% if communication_date is null %}
    {% set state = 'needs_date' %}
{% elseif proof is null %}
    {% set state = 'needs_proof' %}
{% else %}
    {% set state = 'complete' %}
{% endif %}

<section id="summons-communication-card"
         class="bg-white dark:bg-slate-900 rounded-2xl shadow-soft border overflow-hidden {{ state == 'complete' ? 'border-slate-200 dark:border-slate-800' : 'border-amber-300 dark:border-amber-800/60 ring-1 ring-amber-100 dark:ring-amber-900/30' }}">
    <header class="px-6 py-4 border-b border-slate-100 dark:border-slate-800 flex flex-col-reverse sm:flex-row items-start justify-between gap-3 sm:gap-4">
        <div class="flex items-start gap-3">
            <span class="inline-flex items-center justify-center size-9 rounded-lg shrink-0 {{ state == 'complete' ? 'bg-green-100 text-green-700 dark:bg-green-950/40 dark:text-green-300' : 'bg-amber-100 text-amber-700 dark:bg-amber-950/40 dark:text-amber-300' }}">
                {{ icon_calendar('size-5') }}
            </span>
            <div>
                <h3 class="text-base font-semibold text-slate-900 dark:text-white">{{ 'case_overview.summons_card.title'|trans }}</h3>
                <p class="mt-0.5 text-sm text-slate-600 dark:text-slate-400">{{ 'case_overview.summons_card.intro'|trans }}</p>
            </div>
        </div>
        <span class="shrink-0 inline-flex items-center px-2 py-1 rounded-md text-xs font-semibold {{ state == 'complete' ? 'bg-green-100 text-green-800 dark:bg-green-950/40 dark:text-green-300' : 'bg-amber-100 text-amber-800 dark:bg-amber-950/40 dark:text-amber-300' }}">
            {{ ('case_overview.summons_card.state_' ~ state)|trans }}
        </span>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-slate-100 dark:divide-slate-800">

        {# Step 1: the date the debtor received the summons. #}
        <div class="p-6">
            <div class="flex items-center gap-2 mb-3">
                {% if communication_date %}
                    <span class="inline-flex items-center justify-center size-6 rounded-full bg-green-600 text-white">{{ icon_check('size-3.5') }}</span>
                {% else %}
                    <span class="inline-flex items-center justify-center size-6 rounded-full bg-amber-500 text-white text-xs font-bold">1</span>
                {% endif %}
                <h4 class="text-sm font-semibold text-slate-900 dark:text-white">{{ 'case_overview.summons_card.step_date_title'|trans }}</h4>
            </div>

            {% if communication_date is null %}
                <p class="text-xs text-slate-600 dark:text-slate-400 mb-3">{{ 'case_overview.summons_card.step_date_hint'|trans }}</p>
                {{ include('case/overview/_summons_communication_date_form.html.twig', {
                    id_suffix: 'new',
                    submit_key: 'case_overview.summons_card.submit_date',
                    current_date: null,
                    current_method: null,
                }) }}
            {% else %}
                <div class="text-2xl font-bold text-slate-900 dark:text-white tabular-nums">{{ communication_date|date('d.m.Y') }}</div>
                {% if communication_method %}
                    <div class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">{{ communication_method.label|trans }}</div>
                {% endif %}

                {% if term_end %}
                    {% if payment_term_expired|default(false) %}
                        <div class="mt-3 rounded-lg bg-green-50 dark:bg-green-950/20 border border-green-200 dark:border-green-900/40 px-3 py-2 text-xs text-green-900 dark:text-green-200">
                            {{ 'case_overview.summons_card.term_expired'|trans({'%date%': term_end|date('d.m.Y')}) }}
                        </div>
                    {% else %}
                        <div class="mt-3 rounded-lg bg-blue-50 dark:bg-blue-950/20 border border-blue-200 dark:border-blue-900/40 px-3 py-2 text-xs text-blue-900 dark:text-blue-200">
                            {{ 'case_overview.summons_card.term_running'|trans({'%date%': term_end|date('d.m.Y')}) }}
                        </div>
                    {% endif %}
                {% endif %}

                {% if can_edit_date %}
                    <details class="mt-3 group">
                        <summary class="cursor-pointer list-none text-xs font-medium text-blue-600 dark:text-blue-400 hover:underline">{{ 'case_overview.summons_card.correct_toggle'|trans }}</summary>
                        <div class="mt-3">
                            <p class="text-xs text-slate-500 dark:text-slate-400 mb-3">{{ 'case_overview.summons_card.correct_hint'|trans }}</p>
                            {{ include('case/overview/_summons_communication_date_form.html.twig', {
                                id_suffix: 'edit',
                                submit_key: 'case_overview.summons_card.submit_correction',
                                current_date: communication_date|date('Y-m-d'),
                                current_method: communication_method ? communication_method.value : null,
                            }) }}
                        </div>
                    </details>
                {% endif %}
            {% endif %}
        </div>

        {# Step 2: the proof of service, required to generate the petition. #}
        <div class="p-6">
            <div class="flex items-center gap-2 mb-3">
                {% if proof %}
                    <span class="inline-flex items-center justify-center size-6 rounded-full bg-green-600 text-white">{{ icon_check('size-3.5') }}</span>
                {% else %}
                    <span class="inline-flex items-center justify-center size-6 rounded-full bg-amber-500 text-white text-xs font-bold">2</span>
                {% endif %}
                <h4 class="text-sm font-semibold text-slate-900 dark:text-white">{{ 'case_overview.summons_card.step_proof_title'|trans }}</h4>
            </div>

            {% if proof %}
                <div class="flex items-center gap-3 rounded-lg border border-slate-200 dark:border-slate-700 px-3 py-2">
                    <span class="text-slate-400">{{ icon_document('size-4') }}</span>
                    <div class="flex-1 min-w-0">
                        <div class="text-sm font-medium text-slate-900 dark:text-white truncate" title="{{ proof.originalFilename }}">{{ proof.originalFilename }}</div>
                        <div class="text-xs text-slate-500">{{ 'case_overview.summons_card.proof_uploaded_on'|trans({'%date%': proof.createdAt|date('d.m.Y')}) }}</div>
                    </div>
                    <a href="{{ path('case_document_download', {caseId: case.id, documentId: proof.id}) }}"
                       class="shrink-0 inline-flex items-center gap-1 text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline"
                       aria-label="{{ 'case_overview.summons_card.proof_download'|trans }}">
                        {{ icon_download('size-4') }}
                        {{ 'case_overview.summons_card.proof_download'|trans }}
                    </a>
                </div>
                <p class="mt-3 text-xs text-slate-500 dark:text-slate-400">{{ 'case_overview.summons_card.proof_in_package'|trans }}</p>
            {% else %}
                <p class="text-xs text-slate-600 dark:text-slate-400 mb-3">{{ 'case_overview.summons_card.step_proof_hint'|trans }}</p>
                <button type="button"
                        data-hs-overlay="#hs-modal-upload-document"
                        data-upload-preset-type="dovada_comunicare"
                        class="py-2 px-4 inline-flex items-center text-sm font-semibold rounded-lg {{ communication_date ? 'bg-blue-600 text-white hover:bg-blue-700' : 'border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-800' }} transition">
                    {{ 'case_overview.summons_card.proof_cta'|trans }}
                </button>
            {% endif %}
        </div>
    </div>

    <footer class="px-6 py-3 border-t border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-900/60">
        <button type="button"
                data-hs-overlay="#hs-modal-c4-summons"
                class="text-xs font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:underline">
            {{ 'case_overview.summons_card.legal_methods'|trans }}
        </button>
    </footer>
</section>
