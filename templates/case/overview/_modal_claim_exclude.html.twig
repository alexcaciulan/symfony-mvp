{# One dialog for every „Exclude" button: the button hands over the route and the
   position's label (claim-exclude controller), the reason is required, the note
   optional. The position stays on file as excluded and can be reinstated. #}
<div id="hs-modal-claim-exclude"
     class="hs-overlay hidden size-full fixed top-0 start-0 z-[80] overflow-x-hidden overflow-y-auto pointer-events-none"
     role="dialog"
     tabindex="-1"
     aria-labelledby="hs-modal-claim-exclude-title"
     data-claim-exclude-target="modal"
     data-testid="modal-claim-exclude">
    <div class="hs-overlay-open:mt-7 hs-overlay-open:opacity-100 hs-overlay-open:duration-500 mt-0 opacity-0 ease-out transition-all sm:max-w-md sm:w-full m-3 sm:mx-auto">
        <form method="post" action="" data-claim-exclude-target="form" data-turbo-frame="_top" data-testid="claim-exclude-form" class="flex flex-col bg-white border border-slate-200 shadow-lg rounded-2xl pointer-events-auto dark:bg-slate-900 dark:border-slate-800">
            <input type="hidden" name="claim_exclude[_token]" value="{{ csrf_token('claim_exclude') }}">
            <div class="px-5 py-5">
                <h3 id="hs-modal-claim-exclude-title" class="text-base font-semibold text-slate-900 dark:text-white">{{ 'case.claim.edit.exclude_title_prefix'|trans }} <span data-claim-exclude-target="label"></span> {{ 'case.claim.edit.exclude_title_suffix'|trans }}</h3>
                <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{{ 'case.claim.edit.exclude_body'|trans }}</p>
                <p class="mt-2 flex items-start gap-2 text-xs text-amber-800 dark:text-amber-200" data-testid="claim-exclude-accessories-warning">
                    <svg class="size-4 shrink-0 mt-px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                    <span>{{ 'case.claim.edit.exclude_warning_accessories'|trans }}</span>
                </p>
                <div class="mt-4">
                    <label for="claim_exclude_reason" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">{{ 'case.claim.edit.exclude_reason'|trans }}</label>
                    <select id="claim_exclude_reason" name="claim_exclude[reason]" required class="w-full py-2 px-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                        {% for reason in enum('App\\Enum\\ClaimExclusionReason').cases %}
                            <option value="{{ reason.value }}">{{ reason.label()|trans }}</option>
                        {% endfor %}
                    </select>
                    <label for="claim_exclude_note" class="sr-only">{{ 'case.claim.edit.exclude_note'|trans }}</label>
                    <input type="text" id="claim_exclude_note" name="claim_exclude[note]" maxlength="255" placeholder="{{ 'case.claim.edit.exclude_note_placeholder'|trans }}" class="mt-2 w-full py-2 px-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                {% if case.paymentNoticeDate %}
                    <p class="mt-3 text-xs text-amber-800 dark:text-amber-200">{{ 'case.claim.edit.details_payment_notice_regenerate'|trans({'%date%': case.paymentNoticeDate|date('d.m.Y')}) }}</p>
                {% endif %}
            </div>
            <div class="flex justify-end items-center gap-x-2 py-3 px-5 border-t border-slate-100 dark:border-slate-800">
                <button type="button" class="py-2 px-3 inline-flex items-center text-sm font-medium rounded-lg border border-slate-200 bg-white text-slate-800 hover:bg-slate-50 dark:bg-slate-900 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800" data-hs-overlay="#hs-modal-claim-exclude">{{ 'case.claim.edit.cancel'|trans }}</button>
                <button type="submit" data-testid="claim-exclude-confirm" class="py-2 px-4 inline-flex items-center text-sm font-semibold rounded-lg bg-red-600 text-white hover:bg-red-700 transition">{{ 'case.claim.edit.exclude'|trans }}</button>
            </div>
        </form>
    </div>
</div>
