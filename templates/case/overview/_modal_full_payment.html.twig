{# Closing on full payment before the payment order request (AMIABIL or
   SOMATIE_TRIMISA). Submitted by Turbo Drive: a rejected submission answers with a
   toast only, so the modal stays open with what was typed; a valid one swaps the
   regions the closing changed and closes the modal. #}
{% from 'case/overview/_icons.html.twig' import icon_money, icon_warning %}
{% set debtors_total = debtor_count|default(1) %}

<div id="hs-modal-full-payment"
     class="hs-overlay hidden size-full fixed top-0 start-0 z-[80] overflow-x-hidden overflow-y-auto pointer-events-none"
     role="dialog"
     tabindex="-1"
     aria-labelledby="hs-modal-full-payment-title">
    <div class="hs-overlay-open:mt-7 hs-overlay-open:opacity-100 hs-overlay-open:duration-500 mt-0 opacity-0 ease-out transition-all sm:max-w-lg sm:w-full m-3 sm:mx-auto">
        <form method="post" action="{{ path('case_transition_full_payment', {id: case.id}) }}" class="flex flex-col bg-white border border-slate-200 shadow-lg rounded-2xl pointer-events-auto dark:bg-slate-900 dark:border-slate-800">
            <input type="hidden" name="full_payment_closure[_token]" value="{{ csrf_token('full_payment_closure') }}">

            <div class="flex justify-between items-center py-4 px-5 border-b border-slate-100 dark:border-slate-800">
                <div class="flex items-center gap-3">
                    <span class="inline-flex items-center justify-center size-9 rounded-lg bg-green-100 dark:bg-green-950/40 text-green-600 dark:text-green-400">
                        {{ icon_money('size-5') }}
                    </span>
                    <h3 id="hs-modal-full-payment-title" class="font-bold text-slate-900 dark:text-white">{{ 'case_overview.modal.full_payment_title'|trans }}</h3>
                </div>
                <button type="button"
                        class="size-8 inline-flex justify-center items-center rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 hover:bg-slate-200 dark:text-slate-100 dark:hover:bg-slate-700"
                        aria-label="{{ 'case_overview.modal.aria_close'|trans }}"
                        data-hs-overlay="#hs-modal-full-payment">
                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            <div class="p-5 space-y-4">
                <p class="text-sm text-slate-600 dark:text-slate-400">{{ 'case_overview.modal.full_payment_intro'|trans }}</p>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label for="full_payment_date_field" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">{{ 'case_overview.modal.full_payment_field_date_label'|trans }}</label>
                        <input type="date"
                               id="full_payment_date_field"
                               name="full_payment_closure[paymentDate]"
                               required
                               max="{{ 'now'|date('Y-m-d') }}"
                               class="w-full py-2 px-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-green-500">
                        {% if case.paymentNoticeDate %}
                            <p class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">{{ 'case_overview.modal.full_payment_field_date_reference'|trans({'%date%': case.paymentNoticeDate|date('d.m.Y')}) }}</p>
                        {% endif %}
                    </div>
                    <div>
                        <label for="full_payment_amount_field" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">{{ 'case_overview.modal.full_payment_field_amount_label'|trans }}</label>
                        <input type="text"
                               inputmode="decimal"
                               id="full_payment_amount_field"
                               name="full_payment_closure[amountReceived]"
                               placeholder="0.00"
                               class="w-full py-2 px-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm text-right focus:outline-none focus:ring-2 focus:ring-green-500">
                    </div>
                </div>

                <div>
                    <label for="full_payment_details_field" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">{{ 'case_overview.modal.full_payment_field_details_label'|trans }}</label>
                    <textarea id="full_payment_details_field"
                              name="full_payment_closure[details]"
                              rows="2"
                              maxlength="500"
                              class="w-full py-2 px-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-green-500"></textarea>
                    <p class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">{{ 'case_overview.modal.full_payment_field_details_help'|trans }}</p>
                </div>

                <ul class="space-y-1.5 text-xs text-slate-600 dark:text-slate-400">
                    {% if debtors_total > 1 %}
                        <li class="font-medium text-amber-700 dark:text-amber-400" data-testid="full-payment-multi-debtor">{{ 'case_overview.modal.full_payment_warning_multi_debtor'|trans({'%count%': debtors_total}) }}</li>
                    {% endif %}
                    {% if case.status.value == 'SOMATIE_TRIMISA' %}
                        <li>{{ 'case_overview.modal.full_payment_warning_accessories'|trans }}</li>
                    {% endif %}
                    <li>{{ 'case_overview.modal.full_payment_warning_proof'|trans }}</li>
                </ul>

                <div class="rounded-lg border border-amber-200 dark:border-amber-900/40 bg-amber-50 dark:bg-amber-950/20 p-3 flex items-start gap-2">
                    <span class="text-amber-600 dark:text-amber-400 mt-0.5">{{ icon_warning('size-4') }}</span>
                    <p class="text-xs text-amber-800 dark:text-amber-300">{{ 'case_overview.modal.full_payment_warning_irreversible'|trans }}</p>
                </div>

                <label class="flex items-start gap-2.5 cursor-pointer">
                    <input type="checkbox"
                           name="full_payment_closure[confirmFullPayment]"
                           value="1"
                           required
                           class="mt-0.5 size-4 rounded border-slate-300 text-green-600 focus:ring-green-500">
                    <span class="text-sm text-slate-700 dark:text-slate-300">{{ 'case_overview.modal.full_payment_field_confirm_label'|trans }}</span>
                </label>
            </div>

            <div class="flex justify-end items-center gap-x-2 py-3 px-5 border-t border-slate-100 dark:border-slate-800">
                <button type="button"
                        class="py-2 px-3 inline-flex items-center text-sm font-medium rounded-lg border border-slate-200 bg-white text-slate-800 hover:bg-slate-50 dark:bg-slate-900 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
                        data-hs-overlay="#hs-modal-full-payment">
                    {{ 'case_overview.modal.full_payment_cancel'|trans }}
                </button>
                <button type="submit"
                        class="py-2 px-3 inline-flex items-center text-sm font-semibold rounded-lg bg-green-600 text-white hover:bg-green-700 transition">
                    {{ 'case_overview.modal.full_payment_submit'|trans }}
                </button>
            </div>
        </form>
    </div>
</div>
