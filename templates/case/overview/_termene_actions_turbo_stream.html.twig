{# Turbo Stream response for CaseDeadlineController add / set-ruling-date, so the
   deadline actions update the page in place (no full reload, tab preserved).
   `update_regions` is false for pure error toasts (nothing changed). When a modal
   triggered the action, `close_modal_id` dismisses it after the swap. #}
{% if update_regions %}
    <turbo-stream action="update" target="panel-termene">
        <template>{{ include('case/overview/_tab_termene.html.twig') }}</template>
    </turbo-stream>
    {# The summons alert is driven by the communication date, and that date is set from
       this very response, so it has to be swapped here too: otherwise the case keeps
       reading "in service" while the 15-day term it denies is already on the page. #}
    <turbo-stream action="update" target="summons-communication-alert">
        <template>{{ include('case/overview/_summons_communication_alert.html.twig') }}</template>
    </turbo-stream>
    <turbo-stream action="update" target="ruling-communication-alert">
        <template>{{ include('case/overview/_ruling_communication_date_alert.html.twig') }}</template>
    </turbo-stream>
    <turbo-stream action="update" target="annulment-ruling-communication-alert">
        <template>{{ include('case/overview/_annulment_ruling_communication_date_alert.html.twig') }}</template>
    </turbo-stream>
    {# Refresh the tab nav so the deadline count badge reflects add / delete. #}
    <turbo-stream action="replace" target="case-tabs-nav">
        <template>{{ include('case/overview/_tabs_nav.html.twig', { active_tab: 'termene' }) }}</template>
    </turbo-stream>
    {# The nav replace above only marks the tab active; a stream cannot toggle the
       `hidden` class on the panels, so a tiny controller finishes the switch. #}
    <turbo-stream action="append" target="toasts">
        <template><div data-controller="activate-tab" data-activate-tab-tab-value="termene"></div></template>
    </turbo-stream>
    {# The active deadline drives the top KPI card and the Detalii sidebar ring. #}
    <turbo-stream action="replace" target="case-kpi-grid">
        <template>{{ include('case/overview/_kpi_grid.html.twig') }}</template>
    </turbo-stream>
    <turbo-stream action="update" target="case-detalii-sidebar">
        <template>{{ include('case/overview/_detalii_sidebar.html.twig') }}</template>
    </turbo-stream>
    {# The communication-date dialog can carry the proof with it, so a response from here
       may have added a document and lifted the gate on the petition. Both live outside
       every region above: the documents panel would keep showing the case without its
       proof, and the filing dialog would keep its button disabled until a reload. #}
    <turbo-stream action="update" target="panel-documente">
        <template>{{ include('case/overview/_tab_documente.html.twig') }}</template>
    </turbo-stream>
    <turbo-stream action="replace" target="hs-modal-cerere-op">
        <template>{{ include('case/overview/_modal_generate_op.html.twig') }}</template>
    </turbo-stream>
{% endif %}

{% if close_modal_id is defined and close_modal_id %}
    <turbo-stream action="append" target="toasts">
        <template><div data-controller="close-modal" data-close-modal-target-id-value="{{ close_modal_id }}"></div></template>
    </turbo-stream>
{% endif %}

<turbo-stream action="append" target="toasts">
    <template>
        {% include 'components/Toast.html.twig' with { message: toast_key|trans, variant: toast_variant, details: [] } only %}
    </template>
</turbo-stream>
