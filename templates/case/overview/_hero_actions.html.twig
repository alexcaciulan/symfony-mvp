{# Bottom action bar of the case header: next-step sentence, then amicable payment, primary CTA
   and the ⋯ menu. A size container, so the buttons wrap by the card width, not the viewport. #}
{% from 'case/overview/_icons.html.twig' import icon_dots, icon_edit, icon_share, icon_copy, icon_trash, icon_check, icon_building, icon_warning, icon_arrow_right %}

{# Render the primary-CTA icon by name so the keyed map below can carry a distinct glyph per status. #}
{% macro cta_icon(name) %}
    {% from 'case/overview/_icons.html.twig' import icon_document, icon_warning, icon_building, icon_check, icon_money %}
    {%- if name == 'warning' -%}{{ icon_warning('size-4') }}
    {%- elseif name == 'building' -%}{{ icon_building('size-4') }}
    {%- elseif name == 'check' -%}{{ icon_check('size-4') }}
    {%- elseif name == 'money' -%}{{ icon_money('size-4') }}
    {%- else -%}{{ icon_document('size-4') }}{%- endif -%}
{% endmacro %}

{# Base button shape; per-status color + icon are applied below. `whitespace-nowrap` keeps the label on one line. #}
{% set base_cta_class = 'w-full sm:w-auto py-2 px-3.5 inline-flex items-center justify-center gap-x-2 text-sm font-semibold rounded-lg border transition whitespace-nowrap' %}
{% set outline_class = 'border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-800' %}

{# Modal-triggered primary CTAs keyed by status, each with a distinct color + icon.
   AMIABIL (send summons) and CERERE_DEPUSA (register via portal) are handled
   separately below. #}
{% set primary_modal = {
    'SOMATIE_TRIMISA': {target: '#hs-modal-cerere-op', label: 'case_overview.cta.generate_op', color: 'bg-slate-900 dark:bg-white text-white dark:text-slate-900 hover:bg-slate-800 dark:hover:bg-slate-100', icon: 'document'},
    'CERERE_GENERATA': {target: '#hs-modal-confirm-filing', label: 'case_overview.cta.confirm_filing', color: 'bg-purple-600 text-white hover:bg-purple-700', icon: 'building'},
    'TERMEN_FIXAT': {target: '#hs-modal-issue-ruling', label: 'case_overview.cta.issue_ruling', color: 'bg-violet-600 text-white hover:bg-violet-700', icon: 'check'},
    'IN_ANULARE': {target: '#hs-modal-executare', label: 'case_overview.cta.start_execution', color: 'bg-teal-600 text-white hover:bg-teal-700', icon: 'money'},
    'DEFINITIVA': {target: '#hs-modal-executare', label: 'case_overview.cta.start_execution', color: 'bg-teal-600 text-white hover:bg-teal-700', icon: 'money'},
    'EXECUTARE': {target: '#hs-modal-close-case', label: 'case_overview.cta.close_case_executare', color: 'bg-emerald-600 text-white hover:bg-emerald-700', icon: 'money'},
} %}
{% set primary = primary_modal[case.status.value] ?? null %}
{# An issued order is enforceable once communicated, so enforcement is offered from that date on. #}
{% if case.status.value == 'ORDONANTA_EMISA' and case.rulingCommunicationDate %}
    {% set primary = primary_modal['DEFINITIVA'] %}
{% endif %}
{# Once the case has an email filing (a package or a transmission), the hero only leads
   to the filing tab and never runs an action itself; a manual filing there would also
   file the petition twice. Without one, the manual confirmation stays. After the
   transmission, the tab stays the next step until the lawyer declares the filing date
   or while a late bounce waits for review. #}
{% set filing_panel_state = filing_panel|default(null) %}
{% set next_step = case_next_step(
    case,
    filing_panel_state is not null and filing_tab_visible|default(false),
    filing_package|default(null) is not null or filing_submission|default(null) is not null,
    filing_late_bounce_review|default(false),
    portal_ruling_proposal|default(null) is not null
) %}
{% set filing_link = next_step.filingLink %}
{% set has_primary = filing_link or case.status.value == 'AMIABIL' or case.status.value == 'CERERE_DEPUSA' or primary %}

{# A band above with a filled button comes first: the hero CTA steps back to an outline.
   Each test mirrors the visibility test of its band template. #}
{% set blocked_by = next_step.blockedBy %}
{% set cta_tone = blocked_by ? outline_class : null %}

{% set next_step_key = next_step.sentenceKey %}

<div class="@container relative border-t border-slate-100 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-950/30 rounded-b-2xl">
<div class="px-5 py-3 lg:px-8 flex {{ has_primary ? 'flex-col @3xl:flex-row @3xl:items-center' : 'flex-row items-center' }} gap-3 @3xl:gap-6">
    <div class="flex items-start gap-2 min-w-0 flex-1" data-testid="hero-next-step" data-blocked="{{ blocked_by ? 'true' : 'false' }}">
        <span class="mt-0.5 shrink-0 inline-flex items-center justify-center size-5 rounded-full {{ blocked_by ? 'bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300' : 'bg-blue-100 text-blue-700 dark:bg-blue-950/50 dark:text-blue-300' }}" aria-hidden="true">
            {{ blocked_by ? icon_warning('size-3') : (case.status.isTerminal() ? icon_check('size-3') : icon_arrow_right('size-3')) }}
        </span>
        <p class="text-xs leading-snug text-slate-600 dark:text-slate-300">
            <span class="font-semibold text-slate-800 dark:text-slate-100">{{ (case.status.isTerminal() ? 'case_overview.hero.closed_label' : 'case_overview.hero.next_step_label')|trans }}</span>
            {{ ('case_overview.hero.next_step.' ~ next_step_key)|trans({'%date%': case.fullPaymentDate ? case.fullPaymentDate|date('d.m.Y') : ''}) }}
        </p>
    </div>

<div id="case-hero-actions" class="flex items-center justify-end gap-2 shrink-0">
    {# On a phone the amicable payment lives in the menu, so it comes first here and the primary stays last before the menu. #}
    {% if can_close_full_payment|default(false) %}
        <button type="button"
                data-hs-overlay="#hs-modal-full-payment"
                data-testid="hero-full-payment-action"
                class="hidden sm:inline-flex py-2 px-3.5 items-center gap-x-2 text-sm font-semibold rounded-lg border {{ outline_class }} transition whitespace-nowrap">
            {{ icon_check('size-4') }}
            {{ 'case_overview.cta.mark_paid'|trans }}
        </button>
    {% endif %}
    {% if filing_link %}
        <a href="{{ path('case_overview', {id: case.id, tab: 'depunere'}) }}#depunere-status"
           data-turbo-frame="_top"
           data-testid="hero-filing-link" data-controller="open-tab" data-open-tab-tab-value="depunere" data-action="open-tab#open"
           data-tone="{{ cta_tone ? 'outline' : 'filled' }}"
           class="flex-1 sm:flex-none {{ base_cta_class }} {{ cta_tone ?: 'border-transparent shadow-sm bg-lex-navy text-white hover:bg-lex-navy-dark' }}">
            {{ _self.cta_icon('building') }}
            {{ ('filing.panel.hero.' ~ (filing_panel_state.primaryAction ?? 'open'))|trans }}
        </a>
    {% elseif has_primary %}
        <div class="flex-1 sm:flex-none">
            {% if case.status.value == 'AMIABIL' %}
                <form method="post" action="{{ path('case_summons_generate', {id: case.id}) }}" data-turbo-frame="_top">
                    <input type="hidden" name="_token" value="{{ csrf_token('generate_summons_' ~ case.id) }}">
                    <button type="submit"
                            data-testid="hero-primary-cta"
                            data-tone="{{ cta_tone ? 'outline' : 'filled' }}"
                            class="{{ base_cta_class }} {{ cta_tone ?: 'border-transparent shadow-sm bg-amber-500 text-white hover:bg-amber-600' }}
                                   {% if just_created|default(false) %}ring-2 ring-offset-2 ring-emerald-400 dark:ring-offset-slate-900 soft-pulse-once{% endif %}">
                        {{ _self.cta_icon('warning') }}
                        {{ 'case_overview.cta.send_summons'|trans }}
                    </button>
                </form>
            {% elseif case.status.value == 'CERERE_DEPUSA' %}
                {# Register = find the case on the portal (auto-discover), which also activates
                   monitoring. The CTA jumps to the portal tab and highlights the search. #}
                <button type="button"
                        data-controller="goto-portal-discover"
                        data-action="goto-portal-discover#navigate"
                        data-testid="hero-primary-cta"
                        data-tone="{{ cta_tone ? 'outline' : 'filled' }}"
                        class="{{ base_cta_class }} {{ cta_tone ?: 'border-transparent shadow-sm bg-indigo-600 text-white hover:bg-indigo-700' }}
                               {% if just_created|default(false) %}ring-2 ring-offset-2 ring-emerald-400 dark:ring-offset-slate-900 soft-pulse-once{% endif %}">
                    {{ _self.cta_icon('building') }}
                    {{ 'case_overview.cta.register_case'|trans }}
                </button>
            {% else %}
                <button type="button"
                        data-hs-overlay="{{ primary.target }}"
                        data-testid="hero-primary-cta"
                        data-tone="{{ cta_tone ? 'outline' : 'filled' }}"
                        class="{{ base_cta_class }} {{ cta_tone ?: 'border-transparent shadow-sm ' ~ primary.color }}
                               {% if just_created|default(false) %}ring-2 ring-offset-2 ring-emerald-400 dark:ring-offset-slate-900 soft-pulse-once{% endif %}">
                    {{ _self.cta_icon(primary.icon) }}
                    {{ primary.label|trans }}
                </button>
            {% endif %}
        </div>
    {% endif %}

    <div class="hs-dropdown relative inline-flex [--strategy:absolute] [--placement:bottom-right]">
        <button id="hs-case-actions-dropdown"
                type="button"
                class="hs-dropdown-toggle size-[38px] shrink-0 inline-flex items-center justify-center rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 transition"
                aria-haspopup="menu"
                aria-expanded="false"
                aria-label="{{ 'case_overview.cta.actions_menu'|trans }}">
            {{ icon_dots('size-4') }}
        </button>
        <div class="hs-dropdown-menu transition-[opacity,margin] duration hs-dropdown-open:opacity-100 opacity-0 hidden min-w-56 whitespace-nowrap bg-white shadow-card rounded-xl border border-slate-200 dark:bg-slate-900 dark:border-slate-800 mt-2 p-1.5 z-40"
             role="menu"
             aria-labelledby="hs-case-actions-dropdown">
            <span role="menuitem"
                  aria-disabled="true"
                  title="{{ 'case_overview.tooltip.coming_soon_edit'|trans }}"
                  class="flex items-center gap-x-3 py-2 px-3 rounded-lg text-sm text-slate-800 dark:text-slate-300 opacity-60 cursor-not-allowed">
                {{ icon_edit('size-4 text-slate-400') }}
                {{ 'case_overview.cta.edit_details'|trans }}
            </span>
            <span role="menuitem"
                  aria-disabled="true"
                  title="{{ 'case_overview.tooltip.coming_soon_share'|trans }}"
                  class="flex items-center gap-x-3 py-2 px-3 rounded-lg text-sm text-slate-800 dark:text-slate-300 opacity-60 cursor-not-allowed">
                {{ icon_share('size-4 text-slate-400') }}
                {{ 'case_overview.cta.share'|trans }}
            </span>
            <span role="menuitem"
                  aria-disabled="true"
                  title="{{ 'case_overview.tooltip.coming_soon_duplicate'|trans }}"
                  class="flex items-center gap-x-3 py-2 px-3 rounded-lg text-sm text-slate-800 dark:text-slate-300 opacity-60 cursor-not-allowed">
                {{ icon_copy('size-4 text-slate-400') }}
                {{ 'case_overview.cta.duplicate'|trans }}
            </span>
            {# Status actions that are not the next step: rejection and the annulment outcomes. #}
            {% set menu_item_class = 'flex w-full items-center gap-x-3 py-2 px-3 rounded-lg text-sm text-left text-slate-800 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-800' %}
            {% set status_menu = can_close_full_payment|default(false)
                or (case.status.value == 'CERERE_DEPUSA' and filing_link)
                or case.status.value in ['TERMEN_FIXAT', 'IN_ANULARE', 'EXECUTARE'] %}
            {% if status_menu %}
                <hr class="my-1 border-slate-100 dark:border-slate-800{% if can_close_full_payment|default(false) and case.status.value not in ['CERERE_DEPUSA', 'TERMEN_FIXAT', 'IN_ANULARE', 'EXECUTARE'] %} sm:hidden{% endif %}">
            {% endif %}
            {% if can_close_full_payment|default(false) %}
                <button type="button" data-hs-overlay="#hs-modal-full-payment" data-testid="hero-menu-full-payment" class="sm:hidden {{ menu_item_class }}">
                    {{ icon_check('size-4 text-slate-400') }}
                    {{ 'case_overview.cta.mark_paid'|trans }}
                </button>
            {% endif %}
            {% if case.status.value == 'CERERE_DEPUSA' and filing_link %}
                <button type="button" data-controller="goto-portal-discover" data-action="goto-portal-discover#navigate" data-testid="hero-menu-register-case" class="{{ menu_item_class }}">
                    {{ icon_building('size-4 text-slate-400') }}
                    {{ 'case_overview.cta.register_case'|trans }}
                </button>
            {% endif %}
            {% if case.status.value == 'TERMEN_FIXAT' %}
                <button type="button" data-hs-overlay="#hs-modal-reject" data-testid="hero-menu-reject" class="{{ menu_item_class }}">
                    {{ icon_warning('size-4 text-slate-400') }}
                    {{ 'case_overview.cta.reject_case'|trans }}
                </button>
            {% endif %}
            {% if case.status.value == 'IN_ANULARE' or case.status.value == 'EXECUTARE' %}
                <button type="button" data-hs-overlay="#hs-modal-reject" data-testid="hero-menu-grant-annulment" class="{{ menu_item_class }}">
                    {{ icon_warning('size-4 text-slate-400') }}
                    {{ 'case_overview.cta.grant_annulment'|trans }}
                </button>
                <button type="button" data-hs-overlay="#hs-modal-annulment-rejected" data-testid="hero-menu-annulment-rejected" class="{{ menu_item_class }}">
                    {{ icon_check('size-4 text-slate-400') }}
                    {{ 'case_overview.cta.annulment_rejected'|trans }}
                </button>
            {% endif %}
            {# Close case applies from DEFINITIVA and EXECUTARE (the statuses the
               close transitions accept), so the action is hidden otherwise. #}
            {% if case.status.value == 'DEFINITIVA' or case.status.value == 'EXECUTARE' %}
                <hr class="my-1 border-slate-100 dark:border-slate-800">
                <button type="button"
                        data-hs-overlay="#hs-modal-close-case"
                        class="flex w-full items-center gap-x-3 py-2 px-3 rounded-lg text-sm text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/30">
                    {{ icon_trash('size-4') }}
                    {{ 'case_overview.cta.close_case'|trans }}
                </button>
            {% endif %}
            {# Deleting is offered by the same rule the route enforces (owner, AMIABIL,
               not deleted), so the entry never appears where the action would be refused. #}
            {% if is_granted('CASE_DELETE', case) %}
                <hr class="my-1 border-slate-100 dark:border-slate-800">
                <button type="button"
                        data-hs-overlay="#hs-modal-delete-case"
                        data-testid="action-delete-case"
                        class="flex w-full items-center gap-x-3 py-2 px-3 rounded-lg text-sm text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/30">
                    {{ icon_trash('size-4') }}
                    {{ 'case.delete.button'|trans }}
                </button>
            {% endif %}
        </div>
    </div>
</div>
</div>
</div>
