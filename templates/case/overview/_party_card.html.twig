{# Card Părți (Creditor + Debtor side-by-side cu accent bars + badge ANAF). Reflectă mockup linii 447-482. #}
{% from 'case/overview/_icons.html.twig' import icon_eye, icon_edit %}

{% set creditor = case.creditor %}
{% set primary_debtor = case.debtors|length > 0 ? case.debtors|first : null %}
{% set anaf_status = primary_debtor and primary_debtor.anafStatus ? primary_debtor.anafStatus.value : null %}

{# ANAF badge styling map — single source of truth (Tailwind classes + dot color + i18n key). #}
{% set anaf_badge_map = {
    'ACTIV':   { 'badge': 'bg-green-100 text-green-800 dark:bg-green-950/40 dark:text-green-300', 'dot': 'bg-green-500',  'label': 'case_overview.parties.anaf_active' },
    'INACTIV': { 'badge': 'bg-amber-100 text-amber-800 dark:bg-amber-950/40 dark:text-amber-300', 'dot': 'bg-amber-500',  'label': 'case_overview.parties.anaf_inactive' },
    'RADIAT':  { 'badge': 'bg-red-100   text-red-800   dark:bg-red-950/40   dark:text-red-300',   'dot': 'bg-red-500',    'label': 'case_overview.parties.anaf_radiat' },
} %}
{% set anaf_badge = anaf_status ? anaf_badge_map[anaf_status]|default(null) : null %}

<section class="bg-white dark:bg-slate-900 rounded-2xl shadow-soft border border-slate-200 dark:border-slate-800 overflow-hidden">
    <header class="px-6 py-4 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
        <div class="flex items-center gap-2.5">
            <span class="inline-flex items-center justify-center size-7 rounded-lg bg-gradient-to-br from-blue-50 to-blue-100 dark:from-blue-950/50 dark:to-blue-900/30 text-blue-600 dark:text-blue-400">
                {{ icon_eye('size-4') }}
            </span>
            <h3 class="text-sm font-semibold text-slate-900 dark:text-white">{{ 'case_overview.parties.title'|trans }}</h3>
        </div>
        <button type="button"
                aria-disabled="true"
                title="{{ 'case_overview.tooltip.coming_soon_edit'|trans }}"
                class="text-xs font-medium text-blue-600 dark:text-blue-400 opacity-60 cursor-not-allowed">
            {{ 'case_overview.parties.edit'|trans }}
        </button>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-slate-100 dark:divide-slate-800">

        {# Creditor sub-card #}
        <div class="px-6 py-5 relative">
            <div class="absolute left-0 top-5 bottom-5 w-0.5 bg-gradient-to-b from-blue-400 to-blue-600 rounded-r" aria-hidden="true"></div>
            <div class="text-[10px] font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400 mb-2">{{ 'case_overview.parties.creditor'|trans }}</div>
            <div class="font-semibold text-slate-900 dark:text-white">
                {{ creditor ? creditor.name : ('case_overview.header.no_creditor'|trans) }}
            </div>
            {% if creditor %}
                <dl class="mt-3 space-y-1.5 text-xs">
                    <div class="flex gap-2">
                        <dt class="w-14 text-slate-500 shrink-0">{{ 'case_overview.parties.field_cui'|trans }}</dt>
                        <dd class="font-mono text-slate-700 dark:text-slate-300">{{ creditor.cui|default('case_overview.parties.no_data'|trans) }}</dd>
                    </div>
                    <div class="flex gap-2">
                        <dt class="w-14 text-slate-500 shrink-0">{{ 'case_overview.parties.field_seat'|trans }}</dt>
                        <dd class="text-slate-700 dark:text-slate-300">{{ creditor.address|default('case_overview.parties.no_data'|trans) }}</dd>
                    </div>
                    <div class="flex gap-2">
                        <dt class="w-14 text-slate-500 shrink-0">{{ 'case_overview.parties.field_iban'|trans }}</dt>
                        <dd class="font-mono text-[11px] text-slate-700 dark:text-slate-300">{{ creditor.iban|default('case_overview.parties.no_data'|trans) }}</dd>
                    </div>
                </dl>
            {% endif %}
        </div>

        {# Debtor sub-card #}
        <div class="px-6 py-5 relative">
            <div class="absolute left-0 top-5 bottom-5 w-0.5 bg-gradient-to-b from-orange-400 to-orange-600 rounded-r" aria-hidden="true"></div>
            <div class="flex items-center gap-2 mb-2">
                <div class="text-[10px] font-bold uppercase tracking-wider text-orange-600 dark:text-orange-400">{{ 'case_overview.parties.debtor'|trans }}</div>
                {% if anaf_badge %}
                    <span class="inline-flex items-center gap-x-1 py-0.5 px-1.5 rounded text-[9px] font-bold {{ anaf_badge.badge }}">
                        <span class="size-1 rounded-full {{ anaf_badge.dot }}" aria-hidden="true"></span>{{ anaf_badge.label|trans }}
                    </span>
                {% endif %}
            </div>
            <div class="font-semibold text-slate-900 dark:text-white">
                {{ primary_debtor ? primary_debtor.name : ('case_overview.header.no_debtor'|trans) }}
            </div>
            {% if primary_debtor %}
                <dl class="mt-3 space-y-1.5 text-xs">
                    <div class="flex gap-2">
                        <dt class="w-14 text-slate-500 shrink-0">{{ 'case_overview.parties.field_cui'|trans }}</dt>
                        <dd class="font-mono text-slate-700 dark:text-slate-300">{{ primary_debtor.cui|default('case_overview.parties.no_data'|trans) }}</dd>
                    </div>
                    <div class="flex gap-2">
                        <dt class="w-14 text-slate-500 shrink-0">{{ 'case_overview.parties.field_seat'|trans }}</dt>
                        <dd class="text-slate-700 dark:text-slate-300">{{ primary_debtor.address|default('case_overview.parties.no_data'|trans) }}</dd>
                    </div>
                    {% if primary_debtor.administrator %}
                        <div class="flex gap-2">
                            <dt class="w-14 text-slate-500 shrink-0">{{ 'case_overview.parties.field_admin'|trans }}</dt>
                            <dd class="text-slate-700 dark:text-slate-300">{{ primary_debtor.administrator }}</dd>
                        </div>
                    {% endif %}
                </dl>
            {% endif %}
        </div>
    </div>
</section>
