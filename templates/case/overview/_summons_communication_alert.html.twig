{# What the case still owes after the summons went out, in one alert at a time.

   While the communication date is missing, the case is in service: the 15-day term of
   CPC art. 1015 para. 1 runs from receipt by the debtor, not from the day the summons
   was generated, so it does not exist yet and the case shows no date for it. Saying so
   here is what keeps the case page and the blockage zone of the agenda telling the
   same story, and the button is the same act on both screens.

   The proof alert follows once the date is in: it asks for the document, which is a
   separate thing from the date, and asking for both at once buries the one that
   actually starts a term. #}
{% from 'case/overview/_icons.html.twig' import icon_warning %}

{% set is_summons_sent = case.status.value == 'SOMATIE_TRIMISA' %}
{% set date_missing = case.paymentNoticeCommunicationDate is null %}
{# Counted, not `|first is not null`: Twig's `first` yields an empty string on an empty
   result, which is not null, so that test answers "attached" for a case with no proof
   at all and silences the alert exactly when it is needed. #}
{% set proof_attached = case.documents|filter(d => d.documentType.value == 'dovada_comunicare')|length > 0 %}

{% if is_summons_sent and date_missing %}
    <div class="rounded-xl border border-amber-200 dark:border-amber-900/40 bg-amber-50 dark:bg-amber-950/20 px-4 py-3 mb-4 flex items-start gap-3">
        <span class="inline-flex items-center justify-center size-8 rounded-lg bg-amber-100 dark:bg-amber-900/40 text-amber-700 dark:text-amber-300 shrink-0">
            {{ icon_warning('size-4') }}
        </span>
        <div class="flex-1 min-w-0">
            <div class="text-sm font-semibold text-amber-900 dark:text-amber-200">{{ 'case_overview.summons.alert_in_service'|trans }}</div>
            <div class="text-xs text-amber-800 dark:text-amber-300/80 mt-0.5">{{ 'case_overview.summons.alert_in_service_hint'|trans }}</div>
        </div>
        <div class="flex flex-col items-end gap-1 shrink-0">
            <button type="button"
                    data-hs-overlay="#hs-modal-set-summons-communication-date"
                    class="py-1.5 px-3 inline-flex items-center text-xs font-semibold rounded-lg bg-amber-600 text-white hover:bg-amber-700 transition">
                {{ 'case_overview.summons.alert_in_service_cta'|trans }}
            </button>
            <button type="button"
                    data-hs-overlay="#hs-modal-c4-summons"
                    class="text-xs font-medium text-amber-800/80 dark:text-amber-300/70 underline-offset-2 hover:underline">
                {{ 'case_overview.summons.alert_attach_proof_remind'|trans }}
            </button>
        </div>
    </div>
{% elseif is_summons_sent and not proof_attached %}
    <div class="rounded-xl border border-amber-200 dark:border-amber-900/40 bg-amber-50 dark:bg-amber-950/20 px-4 py-3 mb-4 flex items-start gap-3">
        <span class="inline-flex items-center justify-center size-8 rounded-lg bg-amber-100 dark:bg-amber-900/40 text-amber-700 dark:text-amber-300 shrink-0">
            {{ icon_warning('size-4') }}
        </span>
        <div class="flex-1 min-w-0">
            <div class="text-sm font-semibold text-amber-900 dark:text-amber-200">{{ 'case_overview.summons.alert_attach_proof'|trans }}</div>
            <div class="text-xs text-amber-800 dark:text-amber-300/80 mt-0.5">{{ 'case_overview.summons.alert_attach_proof_hint'|trans }}</div>
        </div>
        <button type="button"
                data-hs-overlay="#hs-modal-c4-summons"
                class="shrink-0 text-xs font-medium text-amber-800/80 dark:text-amber-300/70 underline-offset-2 hover:underline">
            {{ 'case_overview.summons.alert_attach_proof_remind'|trans }}
        </button>
    </div>
{% endif %}
