{# Dialog „Modifică detaliile creanței": the descriptive fields the summons quotes
   and the accessory configuration.
   The fields live in `claim-details-fields` so a save refreshes them in place. #}
<div id="hs-modal-claim-details"
     class="hs-overlay hidden size-full fixed top-0 start-0 z-[80] overflow-x-hidden overflow-y-auto pointer-events-none"
     role="dialog"
     tabindex="-1"
     aria-labelledby="hs-modal-claim-details-title"
     data-testid="modal-claim-details">
    <div class="hs-overlay-open:mt-7 hs-overlay-open:opacity-100 hs-overlay-open:duration-500 mt-0 opacity-0 ease-out transition-all sm:max-w-2xl sm:w-full m-3 sm:mx-auto">
        <form method="post" action="{{ path('case_claim_details', {id: case.id}) }}" data-turbo-frame="_top" data-testid="claim-details-form" class="flex flex-col bg-white border border-slate-200 shadow-lg rounded-2xl pointer-events-auto dark:bg-slate-900 dark:border-slate-800">
            <input type="hidden" name="claim_details[_token]" value="{{ csrf_token('claim_details') }}">
            <div class="flex justify-between items-center py-4 px-5 border-b border-slate-100 dark:border-slate-800">
                <h3 id="hs-modal-claim-details-title" class="font-bold text-slate-900 dark:text-white">{{ 'case.claim.edit.details_title'|trans }}</h3>
                <button type="button"
                        class="size-8 inline-flex justify-center items-center rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 hover:bg-slate-200 dark:text-slate-100 dark:hover:bg-slate-700"
                        aria-label="{{ 'case_overview.modal.aria_close'|trans }}"
                        data-hs-overlay="#hs-modal-claim-details">
                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
            <div id="claim-details-fields" class="p-5 max-h-[70vh] overflow-y-auto">
                {{ include('case/overview/_claim_details_fields.html.twig') }}
            </div>
            <div class="flex justify-end items-center gap-x-2 py-3 px-5 border-t border-slate-100 dark:border-slate-800">
                <button type="button" class="py-2 px-3 inline-flex items-center text-sm font-medium rounded-lg border border-slate-200 bg-white text-slate-800 hover:bg-slate-50 dark:bg-slate-900 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800" data-hs-overlay="#hs-modal-claim-details">{{ 'case.claim.edit.cancel'|trans }}</button>
                <button type="submit" data-testid="claim-details-submit" class="py-2 px-4 inline-flex items-center text-sm font-semibold rounded-lg bg-lex-navy text-white hover:bg-lex-navy/90 transition">{{ 'case.claim.edit.save'|trans }}</button>
            </div>
        </form>
    </div>
</div>
