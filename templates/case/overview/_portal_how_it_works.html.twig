{# Pas 4.0.6 — Sidebar Cum funcționează (purple-indigo gradient, 4 steps + source). Mockup linii 970-981. #}
{% from 'case/overview/_icons.html.twig' import icon_lightning %}

<section class="bg-gradient-to-br from-purple-50 to-indigo-50 dark:from-purple-950/30 dark:to-indigo-950/30 border border-purple-200 dark:border-purple-900/50 rounded-2xl p-5">
    <div class="flex items-center gap-2 mb-3">
        <span class="inline-flex items-center justify-center size-8 rounded-lg bg-gradient-to-br from-purple-500 to-indigo-600 text-white">
            {{ icon_lightning('size-4') }}
        </span>
        <h3 class="text-sm font-bold text-purple-900 dark:text-purple-100">{{ 'case_overview.portal.how_title'|trans }}</h3>
    </div>
    <ul class="space-y-2.5 text-xs text-purple-900 dark:text-purple-200">
        <li class="flex items-start gap-2"><span class="text-purple-500 font-bold shrink-0">1.</span><span>{{ 'case_overview.portal.how_step_1'|trans }}</span></li>
        <li class="flex items-start gap-2"><span class="text-purple-500 font-bold shrink-0">2.</span><span>{{ 'case_overview.portal.how_step_2'|trans }}</span></li>
        <li class="flex items-start gap-2"><span class="text-purple-500 font-bold shrink-0">3.</span><span>{{ 'case_overview.portal.how_step_3'|trans }}</span></li>
        <li class="flex items-start gap-2"><span class="text-purple-500 font-bold shrink-0">4.</span><span>{{ 'case_overview.portal.how_step_4'|trans }}</span></li>
    </ul>
    <p class="mt-3 pt-3 border-t border-purple-200 dark:border-purple-900/50 text-[11px] text-purple-700/80 dark:text-purple-300/80">{{ 'case_overview.portal.how_source'|trans }}</p>
</section>
