{# Pas 4.0.5 — Tab Termene orchestrator: main col-span-2 (header + deadline cards / empty state) + sidebar (calendar + alerts info). #}

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <div class="lg:col-span-2 space-y-4">
        {{ include('case/overview/_deadlines_header.html.twig') }}

        {% if deadlines|length == 0 %}
            <div class="bg-white dark:bg-slate-900 rounded-2xl border border-dashed border-slate-200 dark:border-slate-800 p-8 text-center">
                <div class="text-sm font-semibold text-slate-700 dark:text-slate-300">{{ 'case_overview.deadlines.empty_title'|trans }}</div>
                <p class="mt-1 text-xs text-slate-500">{{ 'case_overview.deadlines.empty_body'|trans }}</p>
            </div>
        {% else %}
            {% for deadline in deadlines %}
                {{ include('case/overview/_deadline_card.html.twig', { deadline: deadline }) }}
            {% endfor %}
        {% endif %}
    </div>

    <aside class="space-y-6">
        {{ include('case/overview/_deadline_calendar.html.twig') }}
        {{ include('case/overview/_alerts_info.html.twig') }}
    </aside>

</div>
