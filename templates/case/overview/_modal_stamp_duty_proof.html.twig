{# Încărcarea dovezii de plată a taxei de timbru. Plătitorul se cere separat de
   fișier fiindcă art. 40 alin. 3 OUG 80/2013 prezumă plata din ordinul semnat de
   DEBITORUL TAXEI (reclamantul), deci o dovadă pe alt nume merită semnalată. #}
{% from 'case/overview/_icons.html.twig' import icon_money %}

<div id="hs-modal-stamp-duty-proof"
     class="hs-overlay hidden size-full fixed top-0 start-0 z-[80] overflow-x-hidden overflow-y-auto pointer-events-none"
     role="dialog"
     tabindex="-1"
     aria-labelledby="hs-modal-stamp-duty-proof-title">
    <div class="hs-overlay-open:mt-7 hs-overlay-open:opacity-100 hs-overlay-open:duration-500 mt-0 opacity-0 ease-out transition-all sm:max-w-lg sm:w-full m-3 sm:mx-auto">
        <form method="post" action="{{ path('case_stamp_duty_proof', {id: case.id}) }}" enctype="multipart/form-data" data-turbo-frame="_top" class="flex flex-col bg-white border border-slate-200 shadow-lg rounded-2xl pointer-events-auto dark:bg-slate-900 dark:border-slate-800">
            <input type="hidden" name="stamp_duty_proof[_token]" value="{{ csrf_token('stamp_duty_proof') }}">

            <div class="flex justify-between items-center py-4 px-5 border-b border-slate-100 dark:border-slate-800">
                <div class="flex items-center gap-3">
                    <span class="inline-flex items-center justify-center size-9 rounded-lg bg-green-100 dark:bg-green-950/40 text-green-600 dark:text-green-400">
                        {{ icon_money('size-5') }}
                    </span>
                    <h3 id="hs-modal-stamp-duty-proof-title" class="font-bold text-slate-900 dark:text-white">{{ 'case_overview.stamp_duty.modal_proof.title'|trans }}</h3>
                </div>
                <button type="button"
                        class="size-8 inline-flex justify-center items-center rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 hover:bg-slate-200 dark:text-slate-100 dark:hover:bg-slate-700"
                        aria-label="{{ 'case_overview.modal.aria_close'|trans }}"
                        data-hs-overlay="#hs-modal-stamp-duty-proof">
                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            <div class="p-5 space-y-4">
                <p class="text-sm text-slate-600 dark:text-slate-400">{{ 'case_overview.stamp_duty.modal_proof.intro'|trans }}</p>

                <div>
                    <label for="stamp_duty_file" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">{{ 'case_overview.stamp_duty.field.file'|trans }} <span class="text-red-500">*</span></label>
                    <input type="file"
                           id="stamp_duty_file"
                           name="stamp_duty_proof[file]"
                           required
                           accept=".pdf,.jpg,.jpeg,.png"
                           class="w-full text-sm text-slate-600 dark:text-slate-300 file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-slate-100 file:text-slate-700 hover:file:bg-slate-200 dark:file:bg-slate-800 dark:file:text-slate-200">
                    <p class="mt-1 text-[11px] text-slate-500">{{ 'case_overview.stamp_duty.modal_proof.file_hint'|trans }}</p>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label for="stamp_duty_paid_at" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">{{ 'case_overview.stamp_duty.field.paid_at'|trans }} <span class="text-red-500">*</span></label>
                        <input type="date"
                               id="stamp_duty_paid_at"
                               name="stamp_duty_proof[paidAt]"
                               required
                               max="{{ 'now'|date('Y-m-d') }}"
                               class="w-full py-2 px-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                    </div>
                    <div>
                        <label for="stamp_duty_paid_amount" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">{{ 'case_overview.stamp_duty.field.paid_amount'|trans }}</label>
                        <input type="text"
                               id="stamp_duty_paid_amount"
                               name="stamp_duty_proof[paidAmount]"
                               inputmode="decimal"
                               value="{{ (stamp_duty_amount|default(case.stampDuty))|number_format(2, ',', '') }}"
                               class="w-full py-2 px-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm tnum focus:outline-none focus:ring-2 focus:ring-blue-500">
                    </div>
                </div>

                <div>
                    <label for="stamp_duty_payer" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">{{ 'case_overview.stamp_duty.field.payer_name'|trans }}</label>
                    <input type="text"
                           id="stamp_duty_payer"
                           name="stamp_duty_proof[payerName]"
                           value="{{ case.creditor ? case.creditor.name : '' }}"
                           class="w-full py-2 px-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <p class="mt-1 text-[11px] text-slate-500">{{ 'case_overview.stamp_duty.modal_proof.payer_hint'|trans }}</p>

                    <label class="mt-2 flex items-start gap-2.5 cursor-pointer">
                        <input type="checkbox" name="stamp_duty_proof[payerOnBehalf]" value="1"
                               class="mt-0.5 shrink-0 size-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-800">
                        <span class="text-xs text-slate-600 dark:text-slate-400">{{ 'case_overview.stamp_duty.field.payer_on_behalf'|trans }}</span>
                    </label>
                </div>

                <div>
                    <label for="stamp_duty_reference" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">{{ 'case_overview.stamp_duty.field.payment_reference'|trans }}</label>
                    <input type="text"
                           id="stamp_duty_reference"
                           name="stamp_duty_proof[paymentReference]"
                           class="w-full py-2 px-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
            </div>

            <div class="flex justify-end items-center gap-x-2 py-3 px-5 border-t border-slate-100 dark:border-slate-800">
                <button type="button"
                        class="py-2 px-3 inline-flex items-center text-sm font-medium rounded-lg border border-slate-200 bg-white text-slate-800 hover:bg-slate-50 dark:bg-slate-900 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
                        data-hs-overlay="#hs-modal-stamp-duty-proof">
                    {{ 'case_overview.stamp_duty.modal_proof.cancel'|trans }}
                </button>
                <button type="submit"
                        class="py-2 px-4 inline-flex items-center text-sm font-semibold rounded-lg bg-green-600 text-white hover:bg-green-700 transition">
                    {{ 'case_overview.stamp_duty.modal_proof.submit'|trans }}
                </button>
            </div>
        </form>
    </div>
</div>
