{# Pas 4.0.7 — Modal Preline „Confirmă închiderea dosarului". Reflectă mockup linii 1116-1133.
   Trigger din hero dropdown („Închide dosar"). Confirm-button aria-disabled — workflow ARHIVAT vine la Faza 4.x. #}
{% from 'case/overview/_icons.html.twig' import icon_warning %}

<div id="hs-modal-close-case"
     class="hs-overlay hidden size-full fixed top-0 start-0 z-[80] overflow-x-hidden overflow-y-auto pointer-events-none"
     role="dialog"
     tabindex="-1"
     aria-labelledby="hs-modal-close-case-title">
    <div class="hs-overlay-open:mt-7 hs-overlay-open:opacity-100 hs-overlay-open:duration-500 mt-0 opacity-0 ease-out transition-all sm:max-w-lg sm:w-full m-3 sm:mx-auto">
        <div class="flex flex-col bg-white border border-slate-200 shadow-lg rounded-2xl pointer-events-auto dark:bg-slate-900 dark:border-slate-800">
            <div class="flex justify-between items-center py-4 px-5 border-b border-slate-100 dark:border-slate-800">
                <div class="flex items-center gap-3">
                    <span class="inline-flex items-center justify-center size-9 rounded-lg bg-red-100 dark:bg-red-950/40 text-red-600 dark:text-red-400">
                        {{ icon_warning('size-5') }}
                    </span>
                    <h3 id="hs-modal-close-case-title" class="font-bold text-slate-900 dark:text-white">{{ 'case_overview.modal.close_case_title'|trans }}</h3>
                </div>
                <button type="button"
                        class="size-8 inline-flex justify-center items-center rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 hover:bg-slate-200 dark:text-slate-300 dark:hover:bg-slate-700"
                        aria-label="{{ 'case_overview.modal.aria_close'|trans }}"
                        data-hs-overlay="#hs-modal-close-case">
                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            <div class="p-5 space-y-4">
                <p class="text-sm text-slate-600 dark:text-slate-400">
                    {{ 'case_overview.modal.close_case_body_prefix'|trans }}
                    <strong class="font-mono text-slate-900 dark:text-white">{{ case.caseNumber }}</strong>
                    {{ 'case_overview.modal.close_case_body_suffix'|trans }}
                </p>
                <div>
                    <label for="hs-modal-close-case-reason" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">{{ 'case_overview.modal.close_case_reason'|trans }}</label>
                    <select id="hs-modal-close-case-reason"
                            class="w-full py-2 px-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="">{{ 'case_overview.modal.close_case_reason_placeholder'|trans }}</option>
                        <option value="paid">{{ 'case_overview.modal.close_case_reason_paid'|trans }}</option>
                        <option value="partial">{{ 'case_overview.modal.close_case_reason_partial'|trans }}</option>
                        <option value="insolvent">{{ 'case_overview.modal.close_case_reason_insolvent'|trans }}</option>
                        <option value="abandoned">{{ 'case_overview.modal.close_case_reason_abandoned'|trans }}</option>
                    </select>
                </div>
            </div>

            <div class="flex justify-end items-center gap-x-2 py-3 px-5 border-t border-slate-100 dark:border-slate-800">
                <button type="button"
                        class="py-2 px-3 inline-flex items-center text-sm font-medium rounded-lg border border-slate-200 bg-white text-slate-800 hover:bg-slate-50 dark:bg-slate-900 dark:border-slate-700 dark:text-slate-200"
                        data-hs-overlay="#hs-modal-close-case">
                    {{ 'case_overview.modal.close_case_cancel'|trans }}
                </button>
                <button type="button"
                        aria-disabled="true"
                        tabindex="-1"
                        title="{{ 'case_overview.tooltip.coming_soon_close'|trans }}"
                        class="py-2 px-3 inline-flex items-center text-sm font-semibold rounded-lg bg-red-600 text-white opacity-70 cursor-not-allowed">
                    {{ 'case_overview.modal.close_case_confirm'|trans }}
                </button>
            </div>
        </div>
    </div>
</div>
