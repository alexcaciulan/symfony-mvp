{# Records the registration number the bailiff assigned to the enforcement request.

   That number is what closes the three-year enforcement-limitation term (CPC art. 705
   alin. 1): the interruption of art. 708 alin. 1 pct. 2 has to rest on a filing confirmed
   from outside the platform, not on a declaration. The term is still closed AGAINST the
   date the request was filed, which is already on the case, because the interruption runs
   from the filing and not from the day the bailiff registered it.

   Opened from the deadline card of the case and reached from the blockage zone of the
   agenda, which links here. Rendered only while the case is waiting on the number, so the
   dialog never offers to record a fact that has no anchor. #}
{% from 'case/overview/_icons.html.twig' import icon_document %}

{% if case.enforcementRequestDate is not null and case.enforcementRegistrationNumber is null %}
<div id="hs-modal-set-enforcement-registration-number"
     class="hs-overlay hidden size-full fixed top-0 start-0 z-[80] overflow-x-hidden overflow-y-auto pointer-events-none"
     role="dialog"
     tabindex="-1"
     aria-labelledby="hs-modal-set-enforcement-registration-number-title">
    <div class="hs-overlay-open:mt-7 hs-overlay-open:opacity-100 hs-overlay-open:duration-500 mt-0 opacity-0 ease-out transition-all sm:max-w-lg sm:w-full m-3 sm:mx-auto">
        <form method="post" action="{{ path('case_deadline_enforcement_registration_number', {caseId: case.id}) }}" data-turbo-frame="_top" class="flex flex-col bg-white border border-slate-200 shadow-lg rounded-2xl pointer-events-auto dark:bg-slate-900 dark:border-slate-800">
            <input type="hidden" name="enforcement_registration_number[_token]" value="{{ csrf_token('enforcement_registration_number') }}">

            <div class="flex justify-between items-center py-4 px-5 border-b border-slate-100 dark:border-slate-800">
                <div class="flex items-center gap-3">
                    <span class="inline-flex items-center justify-center size-9 rounded-lg bg-teal-100 dark:bg-teal-950/40 text-teal-600 dark:text-teal-400">
                        {{ icon_document('size-5') }}
                    </span>
                    <h3 id="hs-modal-set-enforcement-registration-number-title" class="font-bold text-slate-900 dark:text-white">{{ 'case_overview.deadlines.modal_enforcement_registration_number.title'|trans }}</h3>
                </div>
                <button type="button"
                        class="size-8 inline-flex justify-center items-center rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 hover:bg-slate-200 dark:text-slate-100 dark:hover:bg-slate-700"
                        aria-label="{{ 'case_overview.modal.aria_close'|trans }}"
                        data-hs-overlay="#hs-modal-set-enforcement-registration-number">
                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            <div class="p-5 space-y-4">
                <p class="text-sm text-slate-600 dark:text-slate-400">{{ 'case_overview.deadlines.modal_enforcement_registration_number.intro'|trans }}</p>

                <div class="rounded-lg border border-teal-200 dark:border-teal-900/40 bg-teal-50 dark:bg-teal-950/20 p-3">
                    <div class="text-xs text-teal-900 dark:text-teal-200">{{ 'case_overview.deadlines.modal_enforcement_registration_number.hint'|trans({'%date%': case.enforcementRequestDate|date('d.m.Y')}) }}</div>
                </div>

                <div>
                    <label for="enforcement_registration_number_field" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">{{ 'case_overview.deadlines.modal_enforcement_registration_number.field_label'|trans }}</label>
                    <input type="text"
                           id="enforcement_registration_number_field"
                           name="enforcement_registration_number[enforcementRegistrationNumber]"
                           required
                           maxlength="100"
                           placeholder="{{ 'case_overview.deadlines.modal_enforcement_registration_number.field_placeholder'|trans }}"
                           class="w-full py-2 px-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500">
                </div>
            </div>

            <div class="flex justify-end items-center gap-x-2 py-3 px-5 border-t border-slate-100 dark:border-slate-800">
                <button type="button"
                        class="py-2 px-3 inline-flex items-center text-sm font-medium rounded-lg border border-slate-200 bg-white text-slate-800 hover:bg-slate-50 dark:bg-slate-900 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
                        data-hs-overlay="#hs-modal-set-enforcement-registration-number">
                    {{ 'case_overview.deadlines.modal_enforcement_registration_number.cancel'|trans }}
                </button>
                <button type="submit"
                        class="py-2 px-4 inline-flex items-center text-sm font-semibold rounded-lg bg-teal-600 text-white hover:bg-teal-700 transition">
                    {{ 'case_overview.deadlines.modal_enforcement_registration_number.submit'|trans }}
                </button>
            </div>
        </form>
    </div>
</div>
{% endif %}
