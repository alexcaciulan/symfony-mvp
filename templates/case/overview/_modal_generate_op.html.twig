{# Modal Preline „Generează pachet cerere OP" — wire form POST `case_payment_order_generate`
   Trigger din hero CTA + ZIP package card + Cerere OP card + Recommended Actions. #}
{% from 'case/overview/_icons.html.twig' import icon_check, icon_document, icon_download, icon_warning %}

{% set source_docs_count = case.documents|filter(d => d.documentType is not null)|length %}

<div id="hs-modal-cerere-op"
     class="hs-overlay hidden size-full fixed top-0 start-0 z-[80] overflow-x-hidden overflow-y-auto pointer-events-none"
     role="dialog"
     tabindex="-1"
     aria-labelledby="hs-modal-cerere-op-title">
    <div class="hs-overlay-open:mt-7 hs-overlay-open:opacity-100 hs-overlay-open:duration-500 mt-0 opacity-0 ease-out transition-all sm:max-w-lg sm:w-full m-3 sm:mx-auto">
        <form method="post" action="{{ path('case_payment_order_generate', {id: case.id}) }}" data-turbo-frame="_top" class="flex flex-col bg-white border border-slate-200 shadow-lg rounded-2xl pointer-events-auto dark:bg-slate-900 dark:border-slate-800">
            <input type="hidden" name="_token" value="{{ csrf_token('generate_payment_order_' ~ case.id) }}">
            <div class="flex justify-between items-center py-4 px-5 border-b border-slate-100 dark:border-slate-800">
                <div class="flex items-center gap-3">
                    <span class="inline-flex items-center justify-center size-9 rounded-lg bg-gradient-to-br from-blue-500 to-blue-600 text-white">
                        {{ icon_document('size-5') }}
                    </span>
                    <h3 id="hs-modal-cerere-op-title" class="font-bold text-slate-900 dark:text-white">{{ 'case_overview.modal.generate_op_title'|trans }}</h3>
                </div>
                <button type="button"
                        class="size-8 inline-flex justify-center items-center rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 hover:bg-slate-200 dark:text-slate-100 dark:hover:bg-slate-700"
                        aria-label="{{ 'case_overview.modal.aria_close'|trans }}"
                        data-hs-overlay="#hs-modal-cerere-op">
                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            <div class="p-5 space-y-4">
                <p class="text-sm text-slate-600 dark:text-slate-400">{{ 'case_overview.modal.generate_op_intro'|trans }}</p>
                <ul class="space-y-2">
                    <li class="flex items-center gap-3 p-3 rounded-lg bg-slate-50 dark:bg-slate-950/50">
                        {{ icon_check('size-5 text-green-500') }}
                        <span class="text-sm text-slate-700 dark:text-slate-300 flex-1">{{ 'case_overview.modal.generate_op_item_cerere'|trans }}</span>
                        <span class="text-xs text-slate-400">{{ 'case_overview.modal.generate_op_item_cerere_hint'|trans }}</span>
                    </li>
                    <li class="flex items-center gap-3 p-3 rounded-lg bg-slate-50 dark:bg-slate-950/50">
                        {{ icon_check('size-5 text-green-500') }}
                        <span class="text-sm text-slate-700 dark:text-slate-300 flex-1">{{ 'case_overview.modal.generate_op_item_opis'|trans }}</span>
                        <span class="text-xs text-slate-400">{{ 'case_overview.modal.generate_op_item_opis_hint'|trans }}</span>
                    </li>
                    <li class="flex items-center gap-3 p-3 rounded-lg bg-slate-50 dark:bg-slate-950/50">
                        {{ icon_document('size-5 text-blue-500') }}
                        <span class="text-sm text-slate-700 dark:text-slate-300 flex-1">{{ 'case_overview.modal.generate_op_item_evidence'|trans }}</span>
                        <span class="text-xs text-slate-400">{{ 'case_overview.modal.generate_op_item_evidence_hint'|trans({'%count%': source_docs_count}) }}</span>
                    </li>
                </ul>
                <div class="flex items-start gap-2 p-3 rounded-lg bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-900/50 text-xs text-amber-900 dark:text-amber-200">
                    {{ icon_warning('size-4 text-amber-600 shrink-0 mt-0.5') }}
                    <div>
                        <strong>{{ 'case_overview.modal.generate_op_disclaimer_warning'|trans }}</strong>
                        {% if case.court %}
                            {{ 'case_overview.modal.generate_op_disclaimer_body'|trans({'%court%': case.court.name}) }}
                        {% else %}
                            {{ 'case_overview.modal.generate_op_disclaimer_no_court'|trans }}
                        {% endif %}
                    </div>
                </div>

                {# Payment-term status: confirmed expired when the real communication date is set,
                   otherwise the lawyer asserts it via the consent checkbox below (D-R4). #}
                {% if payment_term_expired|default(false) %}
                    <div class="flex items-start gap-2 p-3 rounded-lg bg-green-50 dark:bg-green-950/30 border border-green-200 dark:border-green-900/50 text-xs text-green-800 dark:text-green-200">
                        {{ icon_check('size-4 text-green-600 shrink-0 mt-0.5') }}
                        <div>{{ 'case_overview.modal.generate_op_term_expired'|trans }}</div>
                    </div>
                {% else %}
                    <div class="flex items-start gap-2 p-3 rounded-lg bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-900/50 text-xs text-amber-900 dark:text-amber-200">
                        {{ icon_warning('size-4 text-amber-600 shrink-0 mt-0.5') }}
                        <div>{{ 'case_overview.modal.generate_op_term_unknown'|trans }}</div>
                    </div>
                {% endif %}

                {# Taxa de timbru. CPC art. 197 cere ca dovada achitării să fie atașată
                   cererii, iar netimbrarea atrage anularea. Blocăm depunerea până când
                   fie există dovada, fie avocatul alege explicit regularizarea. #}
                {% set stamp_duty_ok = case.stampDutyStatus.allowsFiling %}
                {% if stamp_duty_ok %}
                    <div class="flex items-start gap-2 p-3 rounded-lg bg-green-50 dark:bg-green-950/30 border border-green-200 dark:border-green-900/50 text-xs text-green-800 dark:text-green-200">
                        {{ icon_check('size-4 text-green-600 shrink-0 mt-0.5') }}
                        <div>
                            {% if case.stampDutyStatus.value == 'ACHITATA' %}
                                {{ 'case_overview.modal.generate_op_stamp_duty_paid'|trans }}
                            {% else %}
                                {{ 'case_overview.modal.generate_op_stamp_duty_deferred'|trans }}
                            {% endif %}
                        </div>
                    </div>
                {% else %}
                    <div class="p-3 rounded-lg bg-red-50 dark:bg-red-950/30 border border-red-200 dark:border-red-900/50">
                        <div class="flex items-start gap-2 text-xs text-red-800 dark:text-red-200">
                            {{ icon_warning('size-4 text-red-600 shrink-0 mt-0.5') }}
                            <div>
                                <p class="font-semibold">{{ 'case_overview.modal.generate_op_stamp_duty_blocked_title'|trans }}</p>
                                <p class="mt-0.5">{{ 'case_overview.modal.generate_op_stamp_duty_blocked_body'|trans }}</p>
                            </div>
                        </div>
                        <div class="mt-3 flex flex-wrap gap-2">
                            <button type="button" data-hs-overlay="#hs-modal-stamp-duty-proof"
                                    class="py-1.5 px-3 inline-flex items-center text-xs font-semibold rounded-lg bg-green-600 text-white hover:bg-green-700 transition">
                                {{ 'case_overview.stamp_duty.cta_upload_proof'|trans }}
                            </button>
                            <button type="button" data-hs-overlay="#hs-modal-stamp-duty-defer"
                                    class="py-1.5 px-3 inline-flex items-center text-xs font-semibold rounded-lg border border-orange-300 dark:border-orange-800 text-orange-800 dark:text-orange-300 hover:bg-orange-50 dark:hover:bg-orange-950/40 transition">
                                {{ 'case_overview.stamp_duty.cta_defer'|trans }}
                            </button>
                        </div>
                    </div>
                {% endif %}

                {# Dovada comunicării somației. Data se salvează liber, ca termenul de 15
                   zile să pornească, dar dovada comunicării se atașează cererii sub
                   sancțiunea respingerii ca inadmisibilă (CPC art. 1016 alin. 2), deci
                   pachetul nu se generează fără recipisa executorului sau confirmarea
                   de primire. #}
                {% set communication_proof_ok = has_communication_proof|default(false) %}
                {% if communication_proof_ok %}
                    <div class="flex items-start gap-2 p-3 rounded-lg bg-green-50 dark:bg-green-950/30 border border-green-200 dark:border-green-900/50 text-xs text-green-800 dark:text-green-200">
                        {{ icon_check('size-4 text-green-600 shrink-0 mt-0.5') }}
                        <div>{{ 'case_overview.modal.generate_op_communication_proof_attached'|trans }}</div>
                    </div>
                {% else %}
                    <div class="p-3 rounded-lg bg-red-50 dark:bg-red-950/30 border border-red-200 dark:border-red-900/50">
                        <div class="flex items-start gap-2 text-xs text-red-800 dark:text-red-200">
                            {{ icon_warning('size-4 text-red-600 shrink-0 mt-0.5') }}
                            <div>
                                <p class="font-semibold">{{ 'case_overview.modal.generate_op_communication_proof_blocked_title'|trans }}</p>
                                <p class="mt-0.5">{{ 'case_overview.modal.generate_op_communication_proof_blocked_body'|trans }}</p>
                            </div>
                        </div>
                        <div class="mt-3 flex flex-wrap gap-2">
                            <button type="button" data-hs-overlay="#hs-modal-upload-document"
                                    data-upload-preset-type="dovada_comunicare"
                                    class="py-1.5 px-3 inline-flex items-center text-xs font-semibold rounded-lg bg-green-600 text-white hover:bg-green-700 transition">
                                {{ 'case_overview.modal.generate_op_communication_proof_cta_upload'|trans }}
                            </button>
                            <button type="button" data-hs-overlay="#hs-modal-c4-summons"
                                    class="py-1.5 px-3 inline-flex items-center text-xs font-semibold rounded-lg border border-red-300 dark:border-red-800 text-red-800 dark:text-red-300 hover:bg-red-50 dark:hover:bg-red-950/40 transition">
                                {{ 'case_overview.modal.generate_op_communication_proof_cta_methods'|trans }}
                            </button>
                        </div>
                    </div>
                {% endif %}

                <fieldset>
                    <legend class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">{{ 'case_overview.modal.generate_op_debit_status_label'|trans }}</legend>
                    <div class="space-y-1.5">
                        <label class="flex items-center gap-2 text-sm text-slate-700 dark:text-slate-300">
                            <input type="radio" name="debitAcknowledgedStatus" value="UNPAID" required class="text-blue-600 focus:ring-blue-500">
                            {{ 'enum.debit_acknowledged_status.UNPAID'|trans }}
                        </label>
                        <label class="flex items-center gap-2 text-sm text-slate-700 dark:text-slate-300">
                            <input type="radio" name="debitAcknowledgedStatus" value="PARTIAL" class="text-blue-600 focus:ring-blue-500">
                            {{ 'enum.debit_acknowledged_status.PARTIAL'|trans }}
                        </label>
                    </div>
                </fieldset>

                <label class="flex items-start gap-2 text-sm text-slate-700 dark:text-slate-300">
                    <input type="checkbox" name="opGenerationConsent" value="1" required class="mt-0.5 rounded text-blue-600 focus:ring-blue-500">
                    <span>{{ 'case_overview.modal.generate_op_consent_label'|trans }}</span>
                </label>
            </div>

            <div class="flex justify-end items-center gap-x-2 py-3 px-5 border-t border-slate-100 dark:border-slate-800">
                <button type="button"
                        class="py-2 px-3 inline-flex items-center text-sm font-medium rounded-lg border border-slate-200 bg-white text-slate-800 hover:bg-slate-50 dark:bg-slate-900 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
                        data-hs-overlay="#hs-modal-cerere-op">
                    {{ 'case_overview.modal.generate_op_cancel'|trans }}
                </button>
                <button type="submit"
                        {% if not stamp_duty_ok or not communication_proof_ok %}disabled{% endif %}
                        class="py-2 px-3 inline-flex items-center gap-x-2 text-sm font-semibold rounded-lg bg-blue-600 text-white hover:bg-blue-700 transition disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-blue-600">
                    {{ icon_download('size-4') }}
                    {{ 'case_overview.modal.generate_op_confirm'|trans }}
                </button>
            </div>
        </form>
    </div>
</div>
