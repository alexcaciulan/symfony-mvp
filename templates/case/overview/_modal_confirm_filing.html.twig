{# Confirmarea depunerii (workflow depune_cerere: CERERE_GENERATA la CERERE_DEPUSA).
   Platforma nu depune nimic, deci acesta e singurul semnal că cererea a plecat.
   CSRF automat prin ConfirmFilingType (csrf_token_id: confirm_filing). #}
{% from 'case/overview/_icons.html.twig' import icon_building %}

<div id="hs-modal-confirm-filing"
     class="hs-overlay hidden size-full fixed top-0 start-0 z-[80] overflow-x-hidden overflow-y-auto pointer-events-none"
     role="dialog"
     tabindex="-1"
     aria-labelledby="hs-modal-confirm-filing-title">
    <div class="hs-overlay-open:mt-7 hs-overlay-open:opacity-100 hs-overlay-open:duration-500 mt-0 opacity-0 ease-out transition-all sm:max-w-lg sm:w-full m-3 sm:mx-auto">
        <form method="post" action="{{ path('case_transition_file', {id: case.id}) }}" class="flex flex-col bg-white border border-slate-200 shadow-lg rounded-2xl pointer-events-auto dark:bg-slate-900 dark:border-slate-800">
            <input type="hidden" name="confirm_filing[_token]" value="{{ csrf_token('confirm_filing') }}">

            <div class="flex justify-between items-center py-4 px-5 border-b border-slate-100 dark:border-slate-800">
                <div class="flex items-center gap-3">
                    <span class="inline-flex items-center justify-center size-9 rounded-lg bg-purple-100 dark:bg-purple-950/40 text-purple-600 dark:text-purple-400">
                        {{ icon_building('size-5') }}
                    </span>
                    <h3 id="hs-modal-confirm-filing-title" class="font-bold text-slate-900 dark:text-white">{{ 'case_overview.filing.modal_title'|trans }}</h3>
                </div>
                <button type="button"
                        class="size-8 inline-flex justify-center items-center rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 hover:bg-slate-200 dark:text-slate-100 dark:hover:bg-slate-700"
                        aria-label="{{ 'case_overview.modal.aria_close'|trans }}"
                        data-hs-overlay="#hs-modal-confirm-filing">
                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            <div class="p-5 space-y-4">
                <p class="text-sm text-slate-600 dark:text-slate-400">{{ 'case_overview.filing.modal_intro'|trans }}</p>

                <div>
                    <label for="confirm_filing_filed_at" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">{{ 'case_overview.filing.field_filed_at'|trans }}</label>
                    <input type="date"
                           id="confirm_filing_filed_at"
                           name="confirm_filing[filedAt]"
                           required
                           max="{{ 'now'|date('Y-m-d') }}"
                           class="w-full py-2 px-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500">
                </div>

                <div>
                    <label for="confirm_filing_channel" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">{{ 'case_overview.filing.field_channel'|trans }}</label>
                    <select id="confirm_filing_channel"
                            name="confirm_filing[filingChannel]"
                            required
                            class="w-full py-2 px-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500">
                        <option value="">{{ 'case_overview.filing.channel_placeholder'|trans }}</option>
                        {% for channel in filing_channels %}
                            <option value="{{ channel.value }}">{{ channel.label()|trans }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div>
                    <label for="confirm_filing_reference" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">{{ 'case_overview.filing.field_reference'|trans }}</label>
                    <input type="text"
                           id="confirm_filing_reference"
                           name="confirm_filing[filingReference]"
                           maxlength="100"
                           class="w-full py-2 px-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500">
                    <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400">{{ 'case_overview.filing.field_reference_hint'|trans }}</p>
                </div>

                <p class="text-xs text-slate-500 dark:text-slate-400">{{ 'case_overview.filing.modal_note'|trans }}</p>
            </div>

            <div class="flex justify-end items-center gap-x-2 py-3 px-5 border-t border-slate-100 dark:border-slate-800">
                <button type="button"
                        class="py-2 px-3 inline-flex items-center text-sm font-medium rounded-lg border border-slate-200 bg-white text-slate-800 hover:bg-slate-50 dark:bg-slate-900 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
                        data-hs-overlay="#hs-modal-confirm-filing">
                    {{ 'case_overview.filing.cancel'|trans }}
                </button>
                <button type="submit"
                        class="py-2 px-4 inline-flex items-center text-sm font-semibold rounded-lg bg-purple-600 text-white hover:bg-purple-700 transition">
                    {{ 'case_overview.filing.submit'|trans }}
                </button>
            </div>
        </form>
    </div>
</div>
