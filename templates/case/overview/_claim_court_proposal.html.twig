{# What the competence rules say after the claim changed, next to the court on the
   case. The court is never changed by the application: the lawyer accepts the
   proposal (the resolver runs again on the server) or keeps the current one. An
   unresolved comparison only says why. #}
{% from 'case/overview/_icons.html.twig' import icon_warning %}
<div id="claim-court-proposal" class="mb-5 rounded-xl border border-amber-200 dark:border-amber-900/50 bg-amber-50 dark:bg-amber-950/30 p-4" role="alert" data-testid="claim-court-proposal">
    <div class="flex items-start gap-2.5">
        {{ icon_warning('size-4 text-amber-600 dark:text-amber-400 shrink-0 mt-0.5') }}
        <div class="text-sm text-amber-900 dark:text-amber-200 flex-1">
            {% if proposal.isChange %}
                <p class="font-semibold">{{ 'case.claim.edit.court_proposal_title'|trans }}</p>
                <p class="mt-0.5">{{ 'case.claim.edit.court_proposal_body'|trans({
                    '%proposed%': proposal.proposed.name,
                    '%current%': proposal.current ? proposal.current.name : ('case_overview.court.no_court'|trans),
                }) }}{% if proposal.explanationKey %} {{ proposal.explanationKey|trans(proposal.explanationParams) }}{% endif %}</p>
                <div class="mt-3 flex flex-wrap gap-2">
                    <button type="button" data-hs-remove-element="#claim-court-proposal" data-testid="claim-court-keep" class="py-1.5 px-3 inline-flex items-center text-xs font-semibold rounded-lg border border-amber-300 bg-white text-slate-800 hover:bg-amber-100 dark:bg-slate-900 dark:border-amber-800 dark:text-slate-200">
                        {{ 'case.claim.edit.court_keep'|trans }}
                    </button>
                    <form method="post" action="{{ path('case_claim_court_accept', {id: case.id}) }}" data-turbo-frame="_top" class="inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('claim_court_accept_' ~ case.id) }}">
                        <input type="hidden" name="court_id" value="{{ proposal.proposed.id }}">
                        <button type="submit" data-testid="claim-court-accept" class="py-1.5 px-3 inline-flex items-center text-xs font-semibold rounded-lg bg-amber-600 text-white hover:bg-amber-700">
                            {{ 'case.claim.edit.court_accept'|trans }}
                        </button>
                    </form>
                </div>
            {% else %}
                <p class="font-semibold">{{ 'case.claim.edit.court_unresolved_title'|trans }}</p>
                <p class="mt-0.5">{% if proposal.explanationKey %}{{ proposal.explanationKey|trans(proposal.explanationParams) }} {% endif %}{{ 'case.claim.edit.court_unresolved_body'|trans }}</p>
                {% if proposal.candidates|length > 0 %}
                    <p class="mt-1 text-xs">{{ 'case.claim.edit.court_candidates'|trans }}: {{ proposal.candidates|map(c => c.name)|join(', ') }}</p>
                {% endif %}
            {% endif %}
        </div>
    </div>
</div>
