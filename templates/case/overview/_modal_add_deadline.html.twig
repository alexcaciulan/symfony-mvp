{# Pas 4.3 — Modal Preline „Adaugă termen custom" (JUDECATA). Trigger via
   `data-hs-overlay="#hs-modal-add-deadline"` din `_deadlines_header`. Submit
   către `case_deadline_add` cu CSRF nativ form. #}
{% from 'case/overview/_icons.html.twig' import icon_calendar %}

<div id="hs-modal-add-deadline"
     class="hs-overlay hidden size-full fixed top-0 start-0 z-[80] overflow-x-hidden overflow-y-auto pointer-events-none"
     role="dialog"
     tabindex="-1"
     aria-labelledby="hs-modal-add-deadline-title">
    <div class="hs-overlay-open:mt-7 hs-overlay-open:opacity-100 hs-overlay-open:duration-500 mt-0 opacity-0 ease-out transition-all sm:max-w-lg sm:w-full m-3 sm:mx-auto">
        <form method="post" action="{{ path('case_deadline_add', {caseId: case.id}) }}" class="flex flex-col bg-white border border-slate-200 shadow-lg rounded-2xl pointer-events-auto dark:bg-slate-900 dark:border-slate-800">
            <input type="hidden" name="add_deadline[_token]" value="{{ csrf_token('add_deadline') }}">

            <div class="flex justify-between items-center py-4 px-5 border-b border-slate-100 dark:border-slate-800">
                <div class="flex items-center gap-3">
                    <span class="inline-flex items-center justify-center size-9 rounded-lg bg-blue-100 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400">
                        {{ icon_calendar('size-5') }}
                    </span>
                    <h3 id="hs-modal-add-deadline-title" class="font-bold text-slate-900 dark:text-white">{{ 'case_overview.deadlines.modal_add.title'|trans }}</h3>
                </div>
                <button type="button"
                        class="size-8 inline-flex justify-center items-center rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 hover:bg-slate-200 dark:text-slate-300 dark:hover:bg-slate-700"
                        aria-label="{{ 'case_overview.modal.aria_close'|trans }}"
                        data-hs-overlay="#hs-modal-add-deadline">
                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            <div class="p-5 space-y-4">
                <p class="text-sm text-slate-600 dark:text-slate-400">{{ 'case_overview.deadlines.modal_add.intro'|trans }}</p>

                <div>
                    <label for="add_deadline_deadlineDate" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">{{ 'case_overview.deadlines.modal_add.field_date_label'|trans }}</label>
                    <input type="date"
                           id="add_deadline_deadlineDate"
                           name="add_deadline[deadlineDate]"
                           required
                           min="{{ 'now'|date('Y-m-d') }}"
                           class="w-full py-2 px-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>

                <div>
                    <label for="add_deadline_description" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">{{ 'case_overview.deadlines.modal_add.field_description_label'|trans }}</label>
                    <input type="text"
                           id="add_deadline_description"
                           name="add_deadline[description]"
                           maxlength="255"
                           placeholder="{{ 'case_overview.deadlines.modal_add.field_description_placeholder'|trans }}"
                           class="w-full py-2 px-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
            </div>

            <div class="flex justify-end items-center gap-x-2 py-3 px-5 border-t border-slate-100 dark:border-slate-800">
                <button type="button"
                        class="py-2 px-3 inline-flex items-center text-sm font-medium rounded-lg border border-slate-200 bg-white text-slate-800 hover:bg-slate-50 dark:bg-slate-900 dark:border-slate-700 dark:text-slate-200"
                        data-hs-overlay="#hs-modal-add-deadline">
                    {{ 'case_overview.deadlines.modal_add.cancel'|trans }}
                </button>
                <button type="submit"
                        class="py-2 px-4 inline-flex items-center text-sm font-semibold rounded-lg bg-lex-navy text-white hover:bg-lex-navy/90 transition">
                    {{ 'case_overview.deadlines.modal_add.submit'|trans }}
                </button>
            </div>
        </form>
    </div>
</div>
