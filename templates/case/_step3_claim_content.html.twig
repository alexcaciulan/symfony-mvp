{% extends 'case/wizard.html.twig' %}

{# Pas 3.3 wizard step 3 — Creanță.
   Mockup: docs/LexRecovery/mockups/v2/03-wizard/step3-creanta.html.
   Step3ClaimLiveComponent owns both the form rendering AND the sidebar
   calculations (ComponentWithFormTrait). Form is rebuilt from the
   `initialFormData` LiveProp on every re-render, so `data-model` updates
   from the user typing fire debounced 300ms re-renders without losing the
   form or its validation errors. #}

{% block wizard_max_width %}max-w-6xl{% endblock %}
{% block wizard_subtitle %}{{ 'wizard.step3.subtitle'|trans }}{% endblock %}
{% block wizard_breadcrumb_step %} · {{ 'wizard.step.claim'|trans }}{% endblock %}

{% block wizard_step_content %}
    {{ include('case/_prefill_conflicts.html.twig', { conflicts_form_id: 'step3-claim-form' }) }}

    {# The component owns the form, the sidebar AND the positions table, so
       editing a sum or a due date recomputes per-row interest and the totals
       off the same figures the submit path uses. #}
    {{ component('Step3ClaimLiveComponent', {
        initialFormData: dto,
        form: form,
        rows: claim_items_live|default([]),
        reviewThreshold: claim_items_review_threshold|default(0.6),
        tableConfirmed: claim_items_table_confirmed|default(false),
        claimItemsErrors: claim_items_errors|default([]),
    }) }}

    {# Navigation bar — outside the LiveComponent. Continue submits via
       form="step3-claim-form" (HTML5 form attribute on the button). #}
    <div class="mt-6 flex items-center justify-between gap-3">
        <a href="{{ path('case_wizard_debtor') }}" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition no-underline">
            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
            <span>{{ 'wizard.button.back'|trans }}</span>
        </a>
        <button type="submit" form="step3-claim-form" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-gradient-to-br from-lex-navy to-lex-navy-dark text-white text-sm font-semibold hover:shadow-lg hover:shadow-lex-navy/20 transition shadow-sm">
            <span>{{ 'wizard.step3.button.continue'|trans }}</span>
            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </button>
    </div>
{% endblock %}
