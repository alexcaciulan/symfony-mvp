{% extends 'case/wizard.html.twig' %}

{# Pas 3.2 wizard step 3 — Creanță.
   Mockup: docs/LexRecovery/mockups/v2/03-wizard/step3-creanta.html.
   Page-level h1 + subtitle + breadcrumb come from wizard.html.twig shell via
   block overrides below. Grid 3-col on lg: form on left (col-span-2), dark
   navy sidebar with server-rendered calculations on right. Pas 3.3 replaces
   the sidebar with Step3ClaimLiveComponent for instant updates as the user
   edits inputs. In 3.2 calcule update only on form re-render (server-rendered).
   Auto-filled fields (detected via AutoFilledMarker's `data-auto-filled`
   attribute) get a ⚡ auto badge + blue-tinted input styling via shared macros. #}

{% block wizard_max_width %}max-w-6xl{% endblock %}
{% block wizard_subtitle %}{{ 'wizard.step3.subtitle'|trans }}{% endblock %}
{% block wizard_breadcrumb_step %} · {{ 'wizard.step.claim'|trans }}{% endblock %}

{% import 'case/_wizard_macros.html.twig' as f %}

{% set has_form_errors = form.vars.errors|length > 0 %}

{% block wizard_step_content %}
    {# Pas 3.3 — Step3ClaimLiveComponent wraps both the form and the sidebar
       so `data-model` on form inputs binds to the LiveProps (the bundle
       walks up to the closest `[data-controller~="live"]` ancestor). The
       form is passed in via the `form_slot` block. Re-renders are debounced
       300ms by default. #}
    <twig:Step3ClaimLiveComponent
        amount="{{ dto.amount }}"
        dueDate="{{ dto.dueDate ? dto.dueDate|date('Y-m-d') : '' }}"
        relationshipType="{{ dto.relationshipType ? dto.relationshipType.value : '' }}"
        currency="{{ dto.currency }}"
    >
        <twig:block name="form_slot">
            {# `f` macros must be re-imported inside the component block — the
               outer-template import is invisible across the component
               render boundary. #}
            {% import 'case/_wizard_macros.html.twig' as f %}
            {{ form_start(form, { attr: {
                'id': 'step3-claim-form',
                'class': 'space-y-5',
                'novalidate': 'novalidate',
            }}) }}
                {% if has_form_errors %}
                    <div role="alert" class="bg-red-50 dark:bg-red-950/30 border border-red-200 dark:border-red-900/60 rounded-lg p-4">
                        <div class="flex items-start gap-3">
                            <svg class="size-5 text-red-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12c0 4.97-4.03 9-9 9s-9-4.03-9-9 4.03-9 9-9 9 4.03 9 9z"/></svg>
                            <div class="text-sm text-red-800 dark:text-red-200">
                                {{ form_errors(form) }}
                            </div>
                        </div>
                    </div>
                {% endif %}

                <section class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 space-y-5 shadow-soft">
                    <h3 class="text-base font-semibold text-slate-900 dark:text-slate-100">{{ 'wizard.step3.section.main_data'|trans }}</h3>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            {{ f.field_label(form.amount, 'wizard.step3.field.amount', false) }}
                            <div class="relative">
                                {{ form_widget(form.amount, { attr: {
                                    class: f.input_classes(form.amount, 'pr-14 tnum')|trim,
                                    inputmode: 'decimal',
                                    placeholder: '47500.00',
                                    'data-model': 'debounce(300)|amount',
                                }}) }}
                                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-sm text-slate-500 dark:text-slate-400 pointer-events-none">{{ dto.currency ?? 'RON' }}</span>
                            </div>
                            {{ form_errors(form.amount) }}
                        </div>

                        <div>
                            {{ f.field_label(form.currency, 'wizard.step3.field.currency', false) }}
                            {{ form_widget(form.currency, { attr: {
                                class: f.input_classes(form.currency)|trim,
                                'data-model': 'currency',
                            }}) }}
                            {{ form_errors(form.currency) }}
                        </div>

                        <div>
                            {{ f.field_label(form.dueDate, 'wizard.step3.field.due_date', false) }}
                            {{ form_widget(form.dueDate, { attr: {
                                class: f.input_classes(form.dueDate)|trim,
                                'data-model': 'debounce(300)|dueDate',
                            }}) }}
                            <p class="mt-1 text-[11px] text-slate-500">{{ 'wizard.step3.help.due_date'|trans }}</p>
                            {{ form_errors(form.dueDate) }}
                        </div>

                        <div>
                            {{ f.field_label(form.legalGround, 'wizard.step3.field.legal_ground', true) }}
                            {{ form_widget(form.legalGround, { attr: { class: f.input_classes(form.legalGround)|trim }}) }}
                            {{ form_errors(form.legalGround) }}
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">{{ 'wizard.step3.field.relationship_type'|trans }}</label>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            {# Single visible choice — Step3ClaimType restricts to COMERCIAL per C4. CIVIL is hidden until B2C/P2P post-MVP. #}
                            <div class="relative flex rounded-lg border-2 border-blue-500 bg-gradient-to-br from-blue-50 to-blue-100/30 dark:from-blue-950/30 p-3">
                                {{ form_widget(form.relationshipType, { attr: {
                                    'class': 'sr-only',
                                    'data-model': 'relationshipType',
                                }}) }}
                                <div class="flex flex-col">
                                    <span class="text-sm font-bold text-blue-900 dark:text-blue-200">{{ 'enum.relationship_type.COMERCIAL'|trans }}</span>
                                    <span class="text-xs text-slate-600 dark:text-slate-400 mt-0.5">{{ 'wizard.step3.relationship.comercial_hint'|trans }}</span>
                                </div>
                                <svg class="ml-auto size-5 text-blue-600 dark:text-blue-400 self-start" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                            </div>
                            <div class="relative flex rounded-lg border-2 border-slate-200 dark:border-slate-700 p-3 opacity-60 cursor-not-allowed" title="{{ 'wizard.step3.relationship.civil_disabled_title'|trans }}">
                                <div class="flex flex-col">
                                    <span class="text-sm font-semibold text-slate-600">{{ 'enum.relationship_type.CIVIL'|trans }}</span>
                                    <span class="text-xs text-slate-500 mt-0.5">{{ 'wizard.step3.relationship.civil_disabled_hint'|trans }}</span>
                                </div>
                            </div>
                        </div>
                        {{ form_errors(form.relationshipType) }}
                    </div>

                    <div>
                        {{ f.field_label(form.description, 'wizard.step3.field.description', true) }}
                        {{ form_widget(form.description, { attr: {
                            class: f.input_classes(form.description)|trim,
                            rows: 3,
                            placeholder: 'wizard.step3.placeholder.description'|trans,
                        }}) }}
                        {{ form_errors(form.description) }}
                    </div>
                </section>
            {{ form_end(form) }}
        </twig:block>
    </twig:Step3ClaimLiveComponent>

    {# Navigation bar — OUTSIDE the grid, full width, per Step 1/2 pattern.
       Continue submits via form="step3-claim-form" (HTML5 form attribute). #}
    <div class="mt-6 flex items-center justify-between gap-3">
        <a href="{{ path('case_wizard_debtor') }}" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition no-underline">
            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
            <span>{{ 'wizard.button.back'|trans }}</span>
        </a>
        <button type="submit" form="step3-claim-form" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-gradient-to-br from-lex-navy to-lex-navy-dark text-white text-sm font-semibold hover:shadow-lg hover:shadow-lex-navy/20 transition shadow-sm">
            <span>{{ 'wizard.step3.button.continue'|trans }}</span>
            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </button>
    </div>
{% endblock %}
