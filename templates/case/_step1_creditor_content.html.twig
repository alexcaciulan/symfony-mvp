{% extends 'case/wizard.html.twig' %}

{# Pas 3.2 wizard step 1 — Creditor.
   Mockup: docs/LexRecovery/mockups/v2/03-wizard/step1-creditor.html.
   Page-level h1 + subtitle + breadcrumb come from wizard.html.twig shell
   via block overrides below. personType is rendered as 2 radio cards.
   Auto-filled fields (detected via AutoFilledMarker's `data-auto-filled`
   attribute) get a ⚡ auto badge + blue-tinted input styling. #}

{% block wizard_max_width %}max-w-4xl{% endblock %}
{% block wizard_subtitle %}{{ 'wizard.step1.subtitle'|trans }}{% endblock %}
{% block wizard_breadcrumb_step %} · {{ 'wizard.step.creditor'|trans }}{% endblock %}

{% import 'case/_wizard_macros.html.twig' as f %}

{% set has_form_errors = form.vars.errors|length > 0 %}

{% block wizard_step_content %}
    {# Toggle bar — Pas 3.2 keeps "Creditor nou" active by default; the
       existing-creditor autocomplete flow ships in Pas 3.3 (UX Autocomplete). #}
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-5 mb-6 shadow-soft">
        <div class="grid grid-cols-2 gap-2">
            <button type="button" disabled aria-disabled="true"
                    title="{{ 'wizard.step1.toggle.existing_disabled_title'|trans }}"
                    class="flex items-center justify-center gap-2 p-3 rounded-lg border-2 border-slate-200 dark:border-slate-700 text-sm font-medium text-slate-400 cursor-not-allowed">
                <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                <span>{{ 'wizard.step1.toggle.existing'|trans }}</span>
            </button>
            <button type="button" aria-pressed="true"
                    class="flex items-center justify-center gap-2 p-3 rounded-lg border-2 border-blue-500 bg-gradient-to-br from-blue-50 to-blue-100/50 dark:from-blue-950/40 dark:to-blue-950/20 text-sm font-bold text-blue-700 dark:text-blue-300">
                <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
                <span>{{ 'wizard.step1.toggle.new'|trans }}</span>
            </button>
        </div>
    </div>

    {{ form_start(form, { attr: {
        'id': 'step1-creditor-form',
        'class': 'bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 space-y-6 shadow-soft',
        'novalidate': 'novalidate',
    }}) }}
        {% if has_form_errors %}
            <div role="alert" class="bg-red-50 dark:bg-red-950/30 border border-red-200 dark:border-red-900/60 rounded-lg p-4">
                <div class="flex items-start gap-3">
                    <svg class="size-5 text-red-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12c0 4.97-4.03 9-9 9s-9-4.03-9-9 4.03-9 9-9 9 4.03 9 9z"/></svg>
                    <div class="text-sm text-red-800 dark:text-red-200">
                        {{ form_errors(form) }}
                    </div>
                </div>
            </div>
        {% endif %}

        {# personType — rendered as 2 radio cards (mockup parity). Hidden <input type="radio">
           per option carries the submitted value; visual styling lives on the wrapping <label>.
           First choice is highlighted by default when the form has no submitted value yet so the
           mockup's "selected card" state is visible immediately. Calling form_widget below the
           cards (discarded into _) marks the original ChoiceType select as rendered, preventing
           form_end's form_rest() from emitting a duplicate dropdown. #}
        {% set effective_person_type = form.personType.vars.value ?: form.personType.vars.choices|first.value %}
        <div>
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">{{ 'wizard.step1.field.person_type'|trans }}</label>
            <div class="grid grid-cols-2 gap-3 max-w-md">
                {% for choice in form.personType.vars.choices %}
                    {% set is_selected = effective_person_type == choice.value %}
                    <label class="relative flex items-center cursor-pointer rounded-lg border-2 p-3 transition
                        {% if is_selected %}border-blue-500 bg-gradient-to-br from-blue-50 to-blue-100/30 dark:from-blue-950/30 dark:to-blue-950/10
                        {% else %}border-slate-200 dark:border-slate-700 hover:border-slate-300 dark:hover:border-slate-600{% endif %}">
                        <input type="radio" name="{{ form.personType.vars.full_name }}" value="{{ choice.value }}"
                               {% if is_selected %}checked{% endif %}
                               class="sr-only">
                        <span class="text-sm {{ is_selected ? 'font-bold text-blue-900 dark:text-blue-200' : 'font-semibold text-slate-700 dark:text-slate-300' }}">{{ choice.label|trans }}</span>
                        {% if is_selected %}
                            <svg class="ml-auto size-5 text-blue-600 dark:text-blue-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        {% endif %}
                    </label>
                {% endfor %}
            </div>
            {{ form_errors(form.personType) }}
        </div>
        {% set _ = form_widget(form.personType) %}

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="md:col-span-2">
                {{ f.field_label(form.name, 'wizard.step1.field.name', false) }}
                {{ form_widget(form.name, { attr: { class: f.input_classes(form.name)|trim }}) }}
                {{ form_errors(form.name) }}
            </div>

            <div>
                {{ f.field_label(form.cui, 'wizard.step1.field.cui', true) }}
                {{ form_widget(form.cui, { attr: { class: f.input_classes(form.cui, 'font-mono')|trim, placeholder: 'RO12345678' }}) }}
                {{ form_errors(form.cui) }}
            </div>

            <div>
                {{ f.field_label(form.onrcNumber, 'wizard.step1.field.onrc_number', true) }}
                {{ form_widget(form.onrcNumber, { attr: { class: f.input_classes(form.onrcNumber)|trim, placeholder: 'J40/1234/2018' }}) }}
                {{ form_errors(form.onrcNumber) }}
            </div>

            <div>
                {{ f.field_label(form.personalId, 'wizard.step1.field.personal_id', true) }}
                {{ form_widget(form.personalId, { attr: { class: f.input_classes(form.personalId, 'font-mono')|trim }}) }}
                {{ form_errors(form.personalId) }}
            </div>

            <div>
                {{ f.field_label(form.legalRepresentative, 'wizard.step1.field.legal_representative', true) }}
                {{ form_widget(form.legalRepresentative, { attr: { class: f.input_classes(form.legalRepresentative)|trim }}) }}
                {{ form_errors(form.legalRepresentative) }}
            </div>

            <div class="md:col-span-2">
                {{ f.field_label(form.address, 'wizard.step1.field.address', false) }}
                {{ form_widget(form.address, { attr: { class: f.input_classes(form.address)|trim, rows: 2 }}) }}
                {{ form_errors(form.address) }}
            </div>

            <div class="md:col-span-2">
                {{ f.field_label(form.iban, 'wizard.step1.field.iban', true) }}
                {{ form_widget(form.iban, { attr: { class: f.input_classes(form.iban, 'font-mono')|trim, placeholder: 'RO49 RNCB 0082 0044 8001 0001' }}) }}
                <p class="mt-1 text-[11px] text-slate-500">{{ 'wizard.step1.help.iban_format'|trans }}</p>
                {{ form_errors(form.iban) }}
            </div>

            <div>
                {{ f.field_label(form.email, 'wizard.step1.field.email', true) }}
                {{ form_widget(form.email, { attr: { class: f.input_classes(form.email)|trim }}) }}
                {{ form_errors(form.email) }}
            </div>

            <div>
                {{ f.field_label(form.phone, 'wizard.step1.field.phone', true) }}
                {{ form_widget(form.phone, { attr: { class: f.input_classes(form.phone)|trim }}) }}
                {{ form_errors(form.phone) }}
            </div>
        </div>

        {# Pas 3.3 wires `creditorId` to UX Autocomplete; rendered hidden for now. #}
        {{ form_widget(form.creditorId, { attr: { class: 'hidden' }}) }}

        {# COSMETIC ONLY — NOT connected to DTO/backend.
           Cabinet creditor library is post-MVP (Pas 6.x); checkbox visible per
           mockup parity but submission ignores the value. Wire to a future
           `saveToLibrary` field on Step1CreditorData when the library feature ships. #}
        <label class="flex items-center gap-2 text-sm pt-3 border-t border-slate-100 dark:border-slate-800">
            <input type="checkbox" name="_save_to_library_cosmetic" disabled
                   class="size-4 rounded border-slate-300 dark:border-slate-600 text-blue-600 focus:ring-blue-500 bg-white dark:bg-slate-800">
            <span class="text-slate-700 dark:text-slate-300">{{ 'wizard.step1.save_to_library'|trans }}</span>
        </label>
    {{ form_end(form) }}

    {# Navigation bar — outside the form card, per v2 mockup. The Continue button
       still submits the form above via the HTML5 `form="..."` attribute. #}
    <div class="mt-6 flex items-center justify-between gap-3">
        <a href="{{ path('case_wizard_documents') }}" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition no-underline">
            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
            <span>{{ 'wizard.button.back'|trans }}</span>
        </a>
        <button type="submit" form="step1-creditor-form" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-gradient-to-br from-lex-navy to-lex-navy-dark text-white text-sm font-semibold hover:shadow-lg hover:shadow-lex-navy/20 transition shadow-sm">
            <span>{{ 'wizard.step1.button.continue'|trans }}</span>
            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </button>
    </div>
{% endblock %}
