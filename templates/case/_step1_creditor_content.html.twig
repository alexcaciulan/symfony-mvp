{% extends 'case/wizard.html.twig' %}

{# Wizard step 1: creditor.
   Mockup: docs/LexRecovery/mockups/v2/03-wizard/step1-creditor.html.
   Page-level h1 + subtitle + breadcrumb come from wizard.html.twig shell
   via block overrides below. personType is fixed to PJ (hidden input).
   Auto-filled fields (detected via AutoFilledMarker's `data-auto-filled`
   attribute) get a ⚡ auto badge + blue-tinted input styling. #}

{% block wizard_max_width %}max-w-4xl{% endblock %}
{% block wizard_subtitle %}{{ 'wizard.step1.subtitle'|trans }}{% endblock %}
{% block wizard_breadcrumb_step %} · {{ 'wizard.step.creditor'|trans }}{% endblock %}

{% import 'case/_wizard_macros.html.twig' as f %}

{% set has_form_errors = form.vars.errors|length > 0 %}

{% block wizard_step_content %}
    {{ include('case/_prefill_conflicts.html.twig', { conflicts_form_id: 'step1-creditor-form' }) }}

    <div data-controller="creditor-mode">
        {# Pas 3.3 — UX Autocomplete picker for creditors from the user's library.
           The select sits at the top of the form; manual fields below auto-hide
           (creditor-mode_controller.js) when an existing creditor is picked. #}
        <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-5 mb-6 shadow-soft">
            <div class="flex items-start gap-3 mb-3">
                <svg class="size-5 text-blue-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                <div class="flex-1">
                    <div class="text-sm font-semibold text-slate-900 dark:text-slate-100">{{ 'wizard.step1.autocomplete.title'|trans }}</div>
                    <p class="text-xs text-slate-500 mt-0.5">{{ 'wizard.step1.autocomplete.hint'|trans }}</p>
                </div>
            </div>
            {{ form_widget(form.creditorEntity, { attr: {
                'data-creditor-mode-target': 'select',
                'data-action': 'change->creditor-mode#toggle',
                'form': 'step1-creditor-form',
            }}) }}
        </div>

    {# The ANAF lookup, triggered by the explicit sync button, fills the
       registered office, including the structured county + locality that decide
       where the stamp duty is paid (OUG 80/2013 art. 40 alin. 1). Same
       controller as the debtor in Step 2. #}
    {% set anaf_lookup_url = path('api_anaf_lookup', { cui: '0000000001' })|replace({ '0000000001': '__CUI__' }) %}
    {{ form_start(form, { attr: {
        'id': 'step1-creditor-form',
        'class': 'bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 space-y-6 shadow-soft',
        'novalidate': 'novalidate',
        'data-creditor-mode-target': 'manualFields',
        'data-controller': 'party-anaf-lookup',
        'data-party-anaf-lookup-url-value': anaf_lookup_url,
        'data-party-anaf-lookup-invalid-msg-value': 'exception.anaf.cui_invalid'|trans,
        'data-party-anaf-lookup-rate-limited-msg-value': 'exception.anaf.rate_limited'|trans,
        'data-party-anaf-lookup-not-found-msg-value': 'exception.anaf.not_found'|trans,
        'data-party-anaf-lookup-unavailable-msg-value': 'exception.anaf.unavailable'|trans,
        'data-party-anaf-lookup-success-msg-value': 'wizard.anaf.sync_success'|trans,
        'data-party-anaf-lookup-undone-msg-value': 'wizard.anaf.undo_done'|trans,
        'data-party-anaf-lookup-fiscal-domicile-msg-value': 'wizard.anaf.fiscal_domicile_differs'|trans,
        'data-party-anaf-lookup-postal-code-missing-msg-value': 'wizard.anaf.postal_code_missing'|trans,
        'data-party-anaf-lookup-already-synced-title-value': 'wizard.anaf.already_synced'|trans,
    }}) }}
        {% if has_form_errors %}
            <div role="alert" class="bg-red-50 dark:bg-red-950/30 border border-red-200 dark:border-red-900/60 rounded-lg p-4">
                <div class="flex items-start gap-3">
                    <svg class="size-5 text-red-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12c0 4.97-4.03 9-9 9s-9-4.03-9-9 4.03-9 9-9 9 4.03 9 9z"/></svg>
                    <div class="text-sm text-red-800 dark:text-red-200">
                        {{ form_errors(form) }}
                    </div>
                </div>
            </div>
        {% endif %}

        {# The creditor is always a legal person: the product targets B2B claims,
           so the PF/PJ choice is not offered. A PFA still fits here, since it
           has a CUI and a trade register number. The form type accepts only PJ. #}
        <input type="hidden" name="{{ form.personType.vars.full_name }}" value="{{ constant('App\\Enum\\PersonType::PJ').value }}">
        {% do form.personType.setRendered %}
        {% do form.personalId.setRendered %}

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="md:col-span-2">
                {{ f.field_label(form.name, 'wizard.step1.field.name', false, true) }}
                {{ form_widget(form.name, { attr: { class: f.input_classes(form.name)|trim, 'data-party-anaf-lookup-target': 'name' }}) }}
                {{ f.field_errors(form.name) }}
            </div>

            <div>
                <div class="flex items-center justify-between gap-2">
                    {{ f.field_label(form.cui, 'wizard.step1.field.cui', false, true) }}
                    <div class="flex items-center gap-3">
                        {{ f.anaf_undo_button() }}
                        {{ f.anaf_sync_button() }}
                    </div>
                </div>
                <div class="relative">
                    {{ form_widget(form.cui, { attr: {
                        class: f.input_classes(form.cui, 'font-mono')|trim,
                        placeholder: 'RO12345678',
                        'data-party-anaf-lookup-target': 'cui',
                    }}) }}
                    <span data-party-anaf-lookup-target="spinner"
                          class="hidden absolute right-3 top-1/2 -translate-y-1/2 size-4 border-2 border-blue-500 border-t-transparent rounded-full animate-spin"
                          aria-hidden="true"></span>
                </div>
                <p class="mt-1 text-[11px] text-slate-500">{{ 'wizard.step1.help.anaf_lookup'|trans }}</p>
                <div data-party-anaf-lookup-target="badge" hidden
                     class="mt-1 flex items-center gap-1.5 text-[11px] font-medium text-emerald-700 dark:text-emerald-300">
                    <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    <span>{{ 'wizard.anaf.synced'|trans }}</span>
                </div>
                {{ f.field_errors(form.cui) }}
            </div>

            <div>
                {{ f.field_label(form.onrcNumber, 'wizard.step1.field.onrc_number', false, true) }}
                {{ form_widget(form.onrcNumber, { attr: { class: f.input_classes(form.onrcNumber)|trim, placeholder: 'J40/1234/2018' }}) }}
                {{ f.field_errors(form.onrcNumber) }}
            </div>

            <div>
                {{ f.field_label(form.legalRepresentative, 'wizard.step1.field.legal_representative', true) }}
                {{ form_widget(form.legalRepresentative, { attr: { class: f.input_classes(form.legalRepresentative)|trim }}) }}
                {{ f.field_errors(form.legalRepresentative) }}
            </div>

            <div class="md:col-span-2">
                {{ f.field_label(form.address, 'wizard.step1.field.address', false, true) }}
                {{ form_widget(form.address, { attr: { class: f.input_classes(form.address)|trim, rows: 2, 'data-party-anaf-lookup-target': 'address' }}) }}
                {{ f.field_errors(form.address) }}
            </div>

            {# County + locality of the registered office: they select the town hall
               that collects the stamp duty. Surfaced (not hidden) so the lawyer can
               correct what ANAF returned, since a wrong town hall means the duty is
               treated as unpaid. #}
            <div>
                {{ f.field_label(form.addressCounty, 'wizard.step1.field.address_county', true) }}
                {{ form_widget(form.addressCounty, { attr: { class: f.input_classes(form.addressCounty)|trim, 'data-party-anaf-lookup-target': 'addressCounty' }}) }}
                {{ f.field_errors(form.addressCounty) }}
            </div>

            <div>
                {{ f.field_label(form.addressLocality, 'wizard.step1.field.address_locality', true) }}
                {{ form_widget(form.addressLocality, { attr: { class: f.input_classes(form.addressLocality)|trim, 'data-party-anaf-lookup-target': 'addressLocality' }}) }}
                <p class="mt-1 text-[11px] text-slate-500">{{ 'wizard.step1.help.stamp_duty_uat'|trans }}</p>
                {{ f.field_errors(form.addressLocality) }}
            </div>

            <div class="md:col-span-2">
                {{ f.field_label(form.iban, 'wizard.step1.field.iban', true) }}
                {{ form_widget(form.iban, { attr: { class: f.input_classes(form.iban, 'font-mono')|trim, placeholder: 'RO49 RNCB 0082 0044 8001 0001' }}) }}
                <p class="mt-1 text-[11px] text-slate-500">{{ 'wizard.step1.help.iban_format'|trans }}</p>
                {{ f.field_errors(form.iban) }}
            </div>

            <div class="md:col-span-2">
                {{ f.field_label(form.bankName, 'wizard.step1.field.bank_name', true) }}
                {{ form_widget(form.bankName, { attr: { class: f.input_classes(form.bankName)|trim, placeholder: 'Banca Transilvania' }}) }}
                {{ f.field_errors(form.bankName) }}
            </div>

            <div>
                {{ f.field_label(form.email, 'wizard.step1.field.email', true) }}
                {{ form_widget(form.email, { attr: { class: f.input_classes(form.email)|trim }}) }}
                {{ f.field_errors(form.email) }}
            </div>

            <div>
                {{ f.field_label(form.phone, 'wizard.step1.field.phone', true) }}
                {{ form_widget(form.phone, { attr: { class: f.input_classes(form.phone)|trim }}) }}
                {{ f.field_errors(form.phone) }}
            </div>
        </div>

        {# Hidden int — populated by Step1CreditorType POST_SUBMIT listener when
           the autocomplete above picks an existing creditor. #}
        {{ form_widget(form.creditorId, { attr: { class: 'hidden', style: 'display:none' }}) }}
        {{ form_widget(form.anafCheckedAt, { attr: { 'data-party-anaf-lookup-target': 'anafCheckedAt' }}) }}

        {# COSMETIC ONLY — NOT connected to DTO/backend.
           Cabinet creditor library is post-MVP (Pas 6.x). Shared partial with
           Step 2 to guarantee byte-identical render (CSS scope differs between
           server-rendered Step 1 and LC-rendered Step 2). #}
        {{ include('case/_save_to_library_cosmetic.html.twig', { label_key: 'wizard.step1.save_to_library' }) }}
    {{ form_end(form) }}

    {# Navigation bar — outside the form card, per v2 mockup. The Continue button
       still submits the form above via the HTML5 `form="..."` attribute. #}
    <div class="mt-6 flex items-center justify-between gap-3">
        <a href="{{ path('case_wizard_documents') }}" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition no-underline">
            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
            <span>{{ 'wizard.button.back'|trans }}</span>
        </a>
        <button type="submit" form="step1-creditor-form" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-gradient-to-br from-lex-navy to-lex-navy-dark text-white text-sm font-semibold hover:shadow-lg hover:shadow-lex-navy/20 transition shadow-sm">
            <span>{{ 'wizard.step1.button.continue'|trans }}</span>
            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </button>
    </div>
    </div>{# /data-controller="creditor-mode" #}
{% endblock %}
