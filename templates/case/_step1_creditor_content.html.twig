{% extends 'case/wizard.html.twig' %}

{# Pas 3.2 wizard step 1 — Creditor.
   2-col layout (form on left, help/tips on right). Fields rendered with the
   default Symfony form theme; `data-auto-filled="true"` attribute (set by
   AutoFilledMarker in Pas 3.1) is read by Pas 3.3 Stimulus to show the
   "auto · N%" badge. For Pas 3.2 we only mark the form field as such via
   the attribute — visible badge is wired with the LiveComponent. #}

{% block wizard_step_content %}
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2">
        {{ form_start(form, { attr: {
            'class': 'bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-soft p-6 space-y-5',
            'novalidate': 'novalidate',
        }}) }}
            <header class="mb-2">
                <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">{{ 'wizard.step1.title'|trans }}</h2>
                <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{{ 'wizard.step1.subtitle'|trans }}</p>
            </header>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    {{ form_label(form.personType) }}
                    {{ form_widget(form.personType, { attr: { 'class': 'mt-1 block w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800' }}) }}
                    {{ form_errors(form.personType) }}
                </div>
                <div>
                    {{ form_label(form.name) }}
                    {{ form_widget(form.name, { attr: { 'class': 'mt-1 block w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800' }}) }}
                    {{ form_errors(form.name) }}
                </div>
                <div>
                    {{ form_label(form.cui) }}
                    {{ form_widget(form.cui, { attr: { 'class': 'mt-1 block w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800' }}) }}
                    {{ form_errors(form.cui) }}
                </div>
                <div>
                    {{ form_label(form.onrcNumber) }}
                    {{ form_widget(form.onrcNumber, { attr: { 'class': 'mt-1 block w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800' }}) }}
                    {{ form_errors(form.onrcNumber) }}
                </div>
                <div>
                    {{ form_label(form.personalId) }}
                    {{ form_widget(form.personalId, { attr: { 'class': 'mt-1 block w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800' }}) }}
                    {{ form_errors(form.personalId) }}
                </div>
                <div>
                    {{ form_label(form.legalRepresentative) }}
                    {{ form_widget(form.legalRepresentative, { attr: { 'class': 'mt-1 block w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800' }}) }}
                    {{ form_errors(form.legalRepresentative) }}
                </div>
            </div>

            <div>
                {{ form_label(form.address) }}
                {{ form_widget(form.address, { attr: { 'class': 'mt-1 block w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800', 'rows': 3 }}) }}
                {{ form_errors(form.address) }}
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    {{ form_label(form.email) }}
                    {{ form_widget(form.email, { attr: { 'class': 'mt-1 block w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800' }}) }}
                    {{ form_errors(form.email) }}
                </div>
                <div>
                    {{ form_label(form.phone) }}
                    {{ form_widget(form.phone, { attr: { 'class': 'mt-1 block w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800' }}) }}
                    {{ form_errors(form.phone) }}
                </div>
                <div>
                    {{ form_label(form.iban) }}
                    {{ form_widget(form.iban, { attr: { 'class': 'mt-1 block w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800' }}) }}
                    {{ form_errors(form.iban) }}
                </div>
            </div>

            {{ form_widget(form.creditorId, { attr: { 'class': 'hidden' }}) }}

            {{ form_errors(form) }}

            <div class="flex items-center justify-between pt-2 border-t border-slate-200 dark:border-slate-800">
                <a href="{{ path('case_wizard_documents') }}" class="text-sm font-medium text-slate-600 dark:text-slate-300 hover:underline">
                    {{ 'wizard.button.back'|trans }}
                </a>
                <button type="submit" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-gradient-to-br from-lex-navy to-lex-navy-dark text-white text-sm font-medium hover:opacity-90">
                    <span>{{ 'wizard.button.continue'|trans }}</span>
                    <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </button>
            </div>
        {{ form_end(form) }}
    </div>

    <aside class="lg:col-span-1">
        <div class="bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 rounded-2xl p-5">
            <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">{{ 'wizard.step1.help.title'|trans }}</h3>
            <p class="mt-2 text-xs text-slate-600 dark:text-slate-400">{{ 'wizard.step1.help.body'|trans }}</p>
        </div>
    </aside>
</div>
{% endblock %}
