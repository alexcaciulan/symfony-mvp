{# @var key    string  Registered table key (see TableDefinitionInterface::key()). #}
{# @var height string  Optional fixed CSS height. Empty = auto-height (grows with the page rows). #}
{% props key, height = '' %}

{% set config = table_config(key)|merge({ height: height }) %}

<div
    data-controller="tabulator"
    data-tabulator-config-value="{{ config|json_encode|e('html_attr') }}"
    class="bg-white dark:bg-slate-900 rounded-2xl shadow-soft border border-slate-200 dark:border-slate-800 overflow-hidden"
></div>
