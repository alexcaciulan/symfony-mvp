{# @var deadline_label string #}
{# @var due_at \DateTimeInterface|null #}
{# @var priority string|null  one of: low, medium, high, urgent (default medium) #}
{# @var description string|null #}
{% set border_color = {
    low:    'border-l-gray-300 dark:border-l-gray-600',
    medium: 'border-l-blue-400 dark:border-l-blue-500',
    high:   'border-l-amber-400 dark:border-l-amber-500',
    urgent: 'border-l-red-500 dark:border-l-red-400',
} %}
{% set color = border_color[priority ?? 'medium'] ?? border_color.medium %}
<article {{ attributes.defaults({
    class: 'border-l-4 ' ~ color ~ ' bg-white dark:bg-gray-800 rounded-r-lg p-4 shadow-sm',
}) }}>
    <header class="flex items-start justify-between gap-4">
        <h3 class="font-medium text-gray-900 dark:text-gray-100">{{ deadline_label }}</h3>
        {% if due_at %}
            <time datetime="{{ due_at|date('c') }}" class="text-xs text-gray-500 dark:text-gray-400 shrink-0">
                {{ due_at|date('d.m.Y') }}
            </time>
        {% endif %}
    </header>
    {% if description ?? null %}
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">{{ description }}</p>
    {% endif %}
</article>
