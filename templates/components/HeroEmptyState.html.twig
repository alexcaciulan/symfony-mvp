{# @var title string                Main heading. #}
{# @var description string|null     Subtitle paragraph. #}
{# @var cta_label string|null       Primary CTA label. #}
{# @var cta_path string|null        Primary CTA href (already-built URL — pass `path('route')` at the call site). #}
{# @var secondary_label string|null Optional secondary action label. #}
{# @var secondary_path string|null  Optional secondary action href. #}
{# @var icon_color string|null      Color slot for the icon backdrop. One of: blue, navy, green, amber, purple. Default 'blue'. #}

{% set icon_color = icon_color|default('blue') %}
{% set icon_palette = {
    blue:   { bg: 'from-blue-50 to-blue-100 dark:from-blue-950/50 dark:to-blue-900/30', text: 'text-blue-600 dark:text-blue-400', blur: 'from-blue-400 to-indigo-500' },
    navy:   { bg: 'from-blue-50 to-slate-100 dark:from-blue-950/50 dark:to-slate-900/30', text: 'text-lex-navy dark:text-blue-400', blur: 'from-lex-navy to-lex-navy-dark' },
    green:  { bg: 'from-green-50 to-green-100 dark:from-green-950/50 dark:to-green-900/30', text: 'text-green-600 dark:text-green-400', blur: 'from-green-400 to-emerald-500' },
    amber:  { bg: 'from-amber-50 to-amber-100 dark:from-amber-950/50 dark:to-amber-900/30', text: 'text-amber-600 dark:text-amber-400', blur: 'from-amber-400 to-orange-500' },
    purple: { bg: 'from-purple-50 to-purple-100 dark:from-purple-950/50 dark:to-purple-900/30', text: 'text-purple-600 dark:text-purple-400', blur: 'from-purple-400 to-indigo-500' },
} %}
{% set p = icon_palette[icon_color] ?? icon_palette.blue %}

<div {{ attributes.defaults({
    class: 'max-w-3xl mx-auto text-center py-12',
}) }}>
    <div class="relative inline-flex mb-6">
        <div class="absolute inset-0 bg-gradient-to-br {{ p.blur }} rounded-2xl blur-2xl opacity-20" aria-hidden="true"></div>
        <div class="relative inline-flex items-center justify-center size-20 rounded-2xl bg-gradient-to-br {{ p.bg }} {{ p.text }} shadow-soft">
            {% block icon %}
                <svg class="size-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            {% endblock %}
        </div>
    </div>

    <h1 class="text-3xl md:text-4xl font-bold tracking-tight">{{ title }}</h1>

    {% if description is defined and description %}
        <p class="mt-3 text-base text-slate-600 dark:text-slate-400 max-w-xl mx-auto">{{ description }}</p>
    {% endif %}

    {% if (cta_label is defined and cta_label) or (secondary_label is defined and secondary_label) %}
        <div class="mt-7 flex flex-col sm:flex-row gap-3 justify-center">
            {% if cta_label is defined and cta_label %}
                <a href="{{ cta_path|default('#') }}" class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-lg bg-gradient-to-br from-lex-navy to-lex-navy-dark text-white font-semibold hover:shadow-lg hover:shadow-lex-navy/20 transition shadow-sm no-underline">
                    <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                    {{ cta_label }}
                </a>
            {% endif %}
            {% if secondary_label is defined and secondary_label %}
                <a href="{{ secondary_path|default('#') }}" class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-lg bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 font-medium border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 transition no-underline">
                    {{ secondary_label }}
                </a>
            {% endif %}
        </div>
    {% endif %}
</div>
