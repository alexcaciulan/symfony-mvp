{# Pas 3.3 — wraps the Step 3 form + sidebar. ComponentWithFormTrait
   exposes `form` (the FormView built from `initialFormData`) and `formValues`
   to the template. `data-model` on inputs binds to `formValues[<field>]`;
   re-renders are debounced 300ms.

   The form is rendered INSIDE this LC template (not via a parent slot) so
   that LC re-renders rebuild the form from `initialFormData` and avoid the
   slot-context crash (the parent's `form` variable doesn't propagate into
   the embedded re-render context).

   Court resolver is intentionally NOT wired here — see Step3ClaimLiveComponent
   PHP docblock. #}
{% import 'case/_wizard_macros.html.twig' as f %}

{% set interest = this.getInterest() %}
{% set stamp_duty = this.getStampDuty() %}
{% set due_in_future = this.isDueDateInFuture() %}
{% set amount = this.getAmount() %}
{% set currency = this.getCurrency() %}
{% set has_form_errors = form.vars.errors|length > 0 %}

<div{{ attributes.defaults({ 'class': 'grid grid-cols-1 lg:grid-cols-3 gap-6' }) }}>
    <div class="lg:col-span-2 space-y-5">
        {{ form_start(form, { attr: {
            'id': 'step3-claim-form',
            'class': 'space-y-5',
            'novalidate': 'novalidate',
        }}) }}
            {% if has_form_errors %}
                <div role="alert" class="bg-red-50 dark:bg-red-950/30 border border-red-200 dark:border-red-900/60 rounded-lg p-4">
                    <div class="flex items-start gap-3">
                        <svg class="size-5 text-red-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12c0 4.97-4.03 9-9 9s-9-4.03-9-9 4.03-9 9-9 9 4.03 9 9z"/></svg>
                        <div class="text-sm text-red-800 dark:text-red-200">
                            {{ form_errors(form) }}
                        </div>
                    </div>
                </div>
            {% endif %}

            <section class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 space-y-5 shadow-soft">
                <h3 class="text-base font-semibold text-slate-900 dark:text-slate-100">{{ 'wizard.step3.section.main_data'|trans }}</h3>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    {# data-model bindings come from the form-level `on(change)|*`
                       attribute auto-applied by ComponentWithFormTrait — on blur of
                       any field the LC re-renders and the sidebar recomputes. No
                       per-field data-model needed (and ones referencing standalone
                       LiveProps would silently no-op now that the props live in
                       `formValues`). #}
                    {# With positions the scalar amount is a denormalisation of their
                       sum, not an independent figure: showing it editable let the
                       field disagree with both the table and what gets persisted. #}
                    {% set derived_from_positions = this.isPositionDriven %}
                    <div>
                        {{ f.field_label(form.amount, 'wizard.step3.field.amount', false, true) }}
                        <div class="relative">
                            {{ form_widget(form.amount, { attr: {
                                class: f.input_classes(form.amount, 'pr-14 tnum' ~ (derived_from_positions ? ' bg-slate-50 dark:bg-slate-800/60 text-slate-600 dark:text-slate-300' : ''))|trim,
                                inputmode: 'decimal',
                                placeholder: '47500.00',
                                readonly: derived_from_positions,
                                value: derived_from_positions ? this.positionPrincipal|number_format(2, '.', '') : null,
                            }}) }}
                            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-sm text-slate-500 dark:text-slate-400 pointer-events-none">{{ derived_from_positions ? 'RON' : currency }}</span>
                        </div>
                        {% if derived_from_positions %}
                            <p class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">{{ 'wizard.step3.derived_from_positions.amount'|trans({ '%count%': this.positionCount }) }}</p>
                        {% endif %}
                        {{ f.field_errors(form.amount) }}
                    </div>

                    <div>
                        {{ f.field_label(form.currency, 'wizard.step3.field.currency', false, true) }}
                        {{ form_widget(form.currency, { attr: {
                            class: f.input_classes(form.currency)|trim,
                        }}) }}
                        {{ f.field_errors(form.currency) }}
                    </div>

                    <div>
                        {{ f.field_label(form.dueDate, 'wizard.step3.field.due_date', false, true) }}
                        {{ form_widget(form.dueDate, { attr: {
                            class: f.input_classes(form.dueDate, derived_from_positions ? 'bg-slate-50 dark:bg-slate-800/60 text-slate-600 dark:text-slate-300' : '')|trim,
                            readonly: derived_from_positions,
                            value: derived_from_positions and this.positionDueDate ? this.positionDueDate : null,
                        }}) }}
                        <p class="mt-1 text-[11px] text-slate-500">
                            {{ derived_from_positions ? 'wizard.step3.derived_from_positions.due_date'|trans : 'wizard.step3.help.due_date'|trans }}
                        </p>
                        {{ f.field_errors(form.dueDate) }}
                    </div>

                    <div>
                        {{ f.field_label(form.legalGround, 'wizard.step3.field.legal_ground', true) }}
                        {{ form_widget(form.legalGround, { attr: { class: f.input_classes(form.legalGround)|trim }}) }}
                        {{ f.field_errors(form.legalGround) }}
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">
                        {{ 'wizard.step3.field.relationship_type'|trans }}
                        <span class="text-red-500 dark:text-red-400 ml-0.5" aria-hidden="true">*</span>
                    </label>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        {# Single visible choice — Step3ClaimType restricts to COMERCIAL per C4. CIVIL is hidden until B2C/P2P post-MVP. #}
                        <div class="relative flex rounded-lg border-2 border-blue-500 bg-gradient-to-br from-blue-50 to-blue-100/30 dark:from-blue-950/30 p-3">
                            {{ form_widget(form.relationshipType, { attr: {
                                'class': 'sr-only',
                            }}) }}
                            <div class="flex flex-col">
                                <span class="text-sm font-bold text-blue-900 dark:text-blue-200">{{ 'enum.relationship_type.COMERCIAL'|trans }}</span>
                                <span class="text-xs text-slate-600 dark:text-slate-400 mt-0.5">{{ 'wizard.step3.relationship.comercial_hint'|trans }}</span>
                            </div>
                            <svg class="ml-auto size-5 text-blue-600 dark:text-blue-400 self-start" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        </div>
                        <div class="relative flex rounded-lg border-2 border-slate-200 dark:border-slate-700 p-3 opacity-60 cursor-not-allowed" title="{{ 'wizard.step3.relationship.civil_disabled_title'|trans }}">
                            <div class="flex flex-col">
                                <span class="text-sm font-semibold text-slate-600">{{ 'enum.relationship_type.CIVIL'|trans }}</span>
                                <span class="text-xs text-slate-500 mt-0.5">{{ 'wizard.step3.relationship.civil_disabled_hint'|trans }}</span>
                            </div>
                        </div>
                    </div>
                    {{ f.field_errors(form.relationshipType) }}
                </div>

                <div>
                    {{ f.field_label(form.description, 'wizard.step3.field.description', true) }}
                    {{ form_widget(form.description, { attr: {
                        class: f.input_classes(form.description)|trim,
                        rows: 3,
                        placeholder: 'wizard.step3.placeholder.description'|trans,
                    }}) }}
                    {{ f.field_errors(form.description) }}
                </div>
            </section>

            <section class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 space-y-5 shadow-soft">
                <div>
                    <h3 class="text-base font-semibold text-slate-900 dark:text-slate-100">{{ 'wizard.step3.section.accessories'|trans }}</h3>
                    <p class="mt-1 text-[11px] text-slate-500">{{ 'wizard.step3.help.accessories'|trans }}</p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="sm:col-span-2">
                        {{ f.field_label(form.penaltyType, 'wizard.step3.field.penalty_type', false, true) }}
                        {{ form_widget(form.penaltyType, { attr: { class: f.input_classes(form.penaltyType)|trim }}) }}
                        {{ f.field_errors(form.penaltyType) }}
                    </div>

                    <div>
                        {{ f.field_label(form.contractualPenaltyRate, 'wizard.step3.field.contractual_penalty_rate', true) }}
                        {{ form_widget(form.contractualPenaltyRate, { attr: {
                            class: f.input_classes(form.contractualPenaltyRate)|trim,
                            inputmode: 'decimal',
                            placeholder: '0.10',
                        }}) }}
                        <p class="mt-1 text-[11px] text-slate-500">{{ 'wizard.step3.help.contractual_penalty_rate'|trans }}</p>
                        {{ f.field_errors(form.contractualPenaltyRate) }}
                    </div>

                    <div>
                        {{ f.field_label(form.contractReference, 'wizard.step3.field.contract_reference', true) }}
                        {{ form_widget(form.contractReference, { attr: {
                            class: f.input_classes(form.contractReference)|trim,
                            placeholder: 'art. 3 din Contract',
                        }}) }}
                        {{ f.field_errors(form.contractReference) }}
                    </div>
                </div>
            </section>

            <section class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 space-y-5 shadow-soft">
                <h3 class="text-base font-semibold text-slate-900 dark:text-slate-100">{{ 'wizard.step3.section.invoice_contract'|trans }}</h3>

                {# Invoice number and date are per invoice: with several of them
                   each one already appears in the positions table above, so a
                   single value here would name one and hide the rest. The
                   contract is shared across the invoices (the art. 99 cause), so
                   it stays. #}
                {% set per_invoice_in_table = this.isPositionDriven %}
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    {% if per_invoice_in_table %}
                        <div class="sm:col-span-2 rounded-lg bg-slate-50 dark:bg-slate-800/60 px-3 py-2.5 text-xs text-slate-600 dark:text-slate-300">
                            {{ 'wizard.step3.invoice_in_table'|trans({ '%count%': this.positionCount }) }}
                        </div>
                        {{ form_widget(form.invoiceNumber, { attr: { class: 'hidden' }}) }}
                        {{ form_widget(form.invoiceDate, { attr: { class: 'hidden' }}) }}
                    {% else %}
                        <div>
                            {{ f.field_label(form.invoiceNumber, 'wizard.step3.field.invoice_number', true) }}
                            {{ form_widget(form.invoiceNumber, { attr: { class: f.input_classes(form.invoiceNumber)|trim }}) }}
                            {{ f.field_errors(form.invoiceNumber) }}
                        </div>
                        <div>
                            {{ f.field_label(form.invoiceDate, 'wizard.step3.field.invoice_date', true) }}
                            {{ form_widget(form.invoiceDate, { attr: { class: f.input_classes(form.invoiceDate)|trim }}) }}
                            {{ f.field_errors(form.invoiceDate) }}
                        </div>
                    {% endif %}
                    <div>
                        {{ f.field_label(form.contractNumber, 'wizard.step3.field.contract_number', true) }}
                        {{ form_widget(form.contractNumber, { attr: { class: f.input_classes(form.contractNumber)|trim }}) }}
                        {{ f.field_errors(form.contractNumber) }}
                    </div>
                    <div>
                        {{ f.field_label(form.contractDate, 'wizard.step3.field.contract_date', true) }}
                        {{ form_widget(form.contractDate, { attr: { class: f.input_classes(form.contractDate)|trim }}) }}
                        {{ f.field_errors(form.contractDate) }}
                    </div>
                </div>
            </section>

            <section class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 space-y-5 shadow-soft">
                <div>
                    <h3 class="text-base font-semibold text-slate-900 dark:text-slate-100">{{ 'wizard.step3.section.legal_costs'|trans }}</h3>
                    <p class="mt-1 text-[11px] text-slate-500">{{ 'wizard.step3.help.legal_costs'|trans }}</p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 items-start">
                    <div>
                        {{ f.field_label(form.legalCostsFixed, 'wizard.step3.field.legal_costs_fixed') }}
                        {{ form_widget(form.legalCostsFixed, { attr: {
                            class: f.input_classes(form.legalCostsFixed)|trim,
                            inputmode: 'decimal',
                            placeholder: '250.00',
                        }}) }}
                        {{ f.field_errors(form.legalCostsFixed) }}
                    </div>
                    <div>
                        {{ f.field_label(form.legalCostsCurrency, 'wizard.step3.field.legal_costs_currency') }}
                        {{ form_widget(form.legalCostsCurrency, { attr: { class: f.input_classes(form.legalCostsCurrency)|trim }}) }}
                        {{ f.field_errors(form.legalCostsCurrency) }}
                    </div>
                    <div>
                        {{ f.field_label(form.legalCostsSuccessPercent, 'wizard.step3.field.legal_costs_success_percent') }}
                        {{ form_widget(form.legalCostsSuccessPercent, { attr: {
                            class: f.input_classes(form.legalCostsSuccessPercent)|trim,
                            inputmode: 'decimal',
                            placeholder: '5.00',
                        }}) }}
                        {{ f.field_errors(form.legalCostsSuccessPercent) }}
                    </div>
                </div>
            </section>
        {{ form_end(form) }}
    </div>

    <aside class="lg:sticky lg:top-20 self-start">
        <div class="bg-gradient-to-br from-lex-navy to-lex-navy-dark text-white rounded-2xl shadow-lg overflow-hidden">
            <div class="px-5 py-4 border-b border-white/10 flex items-center gap-2">
                <span class="size-2 rounded-full bg-green-400 animate-pulse" aria-hidden="true"></span>
                <h3 class="text-sm font-semibold">{{ 'wizard.step3.sidebar.title'|trans }}</h3>
                <span class="ml-auto text-[10px] uppercase tracking-wider text-white/50">{{ 'wizard.step3.sidebar.computed_at'|trans({ '%date%': 'now'|date('d.m.Y') }) }}</span>
            </div>

            <div class="px-5 py-4 space-y-4">
                {# Foreign currency is converted to RON first; the whole sidebar
                   then displays RON so the principal/interest/total stay consistent. #}
                {% set conv = this.getConversion %}
                {% set positions_mode = this.isPositionDriven %}
                {% set display_currency = (positions_mode or conv is not null) ? 'RON' : currency %}
                {% set display_principal = positions_mode ? this.positionPrincipal : (conv is not null ? conv.ronAmount : amount) %}
                {# With positions, the accessory is their sum, computed once by the
                   controller on exactly the rows the submit path will persist. #}
                {% set accessory_total = positions_mode ? this.positionAccessory : (interest is not null ? interest.total : null) %}
                <div>
                    <div class="text-[10px] text-white/60 uppercase tracking-wide font-medium">{{ 'wizard.step3.sidebar.principal_label'|trans }}</div>
                    {% if display_principal is not null and display_principal > 0 %}
                        <div class="mt-1 text-2xl font-bold tnum">{{ display_principal|number_format(2, '.', ',') }} <span class="text-sm font-normal text-white/70">{{ display_currency }}</span></div>
                        {% if conv is not null %}
                            <div class="mt-1 text-[11px] text-white/60">{{ 'wizard.step3.sidebar.conversion_line'|trans({ '%amount%': conv.originalAmount|number_format(2, '.', ','), '%currency%': conv.originalCurrency, '%rate%': conv.rate|number_format(4, '.', ','), '%date%': conv.rateDate ? conv.rateDate|date('d.m.Y') : '', '%ron%': conv.ronAmount|number_format(2, '.', ',') }) }}</div>
                        {% endif %}
                    {% else %}
                        <div class="mt-1 text-xs text-white/60">{{ 'wizard.step3.sidebar.principal_placeholder'|trans }}</div>
                    {% endif %}
                </div>

                <div>
                    <div class="text-[10px] text-white/60 uppercase tracking-wide font-medium">{{ 'wizard.step3.sidebar.interest_label'|trans }}</div>
                    {% if positions_mode %}
                        {% if accessory_total is null %}
                            <div class="mt-1 text-xs text-white/60">{{ 'wizard.step3.sidebar.interest_placeholder'|trans }}</div>
                        {% else %}
                            <div class="mt-1 text-2xl font-bold tnum text-amber-300">+ {{ accessory_total|number_format(2, '.', ',') }} <span class="text-sm font-normal text-white/70">{{ display_currency }}</span></div>
                            <div class="mt-1 text-[11px] text-white/50">{{ 'wizard.step3.sidebar.interest_from_positions'|trans({'%count%': this.positionCount}) }}</div>
                        {% endif %}
                    {% elseif interest is null %}
                        {% if due_in_future %}
                            <div class="mt-1 text-xs text-amber-300">{{ 'wizard.step3.live.error.due_date_future'|trans }}</div>
                        {% elseif currency != 'RON' and conv is null %}
                            <div class="mt-1 text-xs text-amber-300">{{ 'wizard.step3.live.error.exchange_rate_missing'|trans }}</div>
                        {% else %}
                            <div class="mt-1 text-xs text-white/60">{{ 'wizard.step3.sidebar.interest_placeholder'|trans }}</div>
                        {% endif %}
                    {% else %}
                        <div class="mt-1 text-2xl font-bold tnum text-amber-300">+ {{ interest.total|number_format(2, '.', ',') }} <span class="text-sm font-normal text-white/70">{{ display_currency }}</span></div>
                        {% if interest.breakdown|length > 0 %}
                            {% set last = interest.breakdown|last %}
                            <div class="mt-1 text-[11px] text-white/50">{{ 'wizard.step3.sidebar.interest_last_rate'|trans({ '%rate%': last.applicableRate|number_format(2) }) }}</div>
                        {% endif %}
                    {% endif %}
                </div>

                {% if accessory_total is not null and display_principal is not null %}
                    <div class="pt-3 border-t border-white/10">
                        <div class="text-[10px] text-white/60 uppercase tracking-wide font-medium">{{ 'wizard.step3.sidebar.total_label'|trans }}</div>
                        <div class="mt-1 text-3xl font-bold tnum text-green-300">{{ (display_principal + accessory_total)|number_format(2, '.', ',') }} <span class="text-base font-normal text-white/70">{{ display_currency }}</span></div>
                    </div>
                {% endif %}

                {% if interest is not null and interest.breakdown|length > 0 %}
                    <div class="hs-accordion-group bg-black/20 rounded-lg overflow-hidden">
                        <div class="hs-accordion" id="acc-bnr-live">
                            <button type="button" class="hs-accordion-toggle inline-flex items-center justify-between gap-x-3 w-full text-xs font-medium text-white py-2.5 px-3 hover:bg-white/5 transition" aria-expanded="false">
                                <span class="inline-flex items-center gap-2">
                                    <svg class="hs-accordion-active:rotate-90 size-3.5 text-white/60 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                                    <span>{{ 'wizard.step3.sidebar.bnr_breakdown'|trans }}</span>
                                </span>
                                <span class="text-[10px] text-white/50">{{ 'wizard.step3.sidebar.periods'|trans({ '%count%': interest.breakdown|length }) }}</span>
                            </button>
                            <div class="hs-accordion-content hidden w-full overflow-hidden transition-[height] duration-300" role="region">
                                <table class="w-full text-[11px]">
                                    <thead class="text-white/50 border-t border-white/10">
                                        <tr>
                                            <th class="px-3 py-1.5 text-left font-medium">{{ 'wizard.step3.sidebar.period_column'|trans }}</th>
                                            <th class="px-2 py-1.5 text-right font-medium">{{ 'wizard.step3.sidebar.rate_column'|trans }}</th>
                                            <th class="px-3 py-1.5 text-right font-medium">{{ 'wizard.step3.sidebar.interest_column'|trans }}</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-white/10">
                                        {% for p in interest.breakdown %}
                                            <tr>
                                                <td class="px-3 py-1.5 text-white/80 tnum">{{ p.startDate|date('d.m.y') }} → {{ p.endDate|date('d.m.y') }}</td>
                                                <td class="px-2 py-1.5 text-right tnum">{{ p.applicableRate|number_format(2) }}%</td>
                                                <td class="px-3 py-1.5 text-right tnum">{{ p.periodInterest|number_format(2) }}</td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                {% endif %}

                <div class="grid grid-cols-2 gap-3 pt-3 border-t border-white/10">
                    <div>
                        <div class="text-[10px] text-white/60 uppercase tracking-wide font-medium">{{ 'wizard.step3.sidebar.stamp_duty_label'|trans }}</div>
                        <div class="mt-0.5 text-base font-semibold tnum">{{ stamp_duty.amount|number_format(2, '.', ',') }}</div>
                    </div>
                    {% if accessory_total is not null and display_principal is not null %}
                        <div>
                            <div class="text-[10px] text-white/60 uppercase tracking-wide font-medium">{{ 'wizard.step3.sidebar.total_plus_stamp'|trans }}</div>
                            <div class="mt-0.5 text-base font-semibold tnum">{{ (display_principal + accessory_total + stamp_duty.amount)|number_format(2, '.', ',') }}</div>
                        </div>
                    {% endif %}
                </div>

                <div class="pt-3 border-t border-white/10">
                    <div class="text-[10px] text-white/60 uppercase tracking-wide font-medium mb-1.5">{{ 'wizard.step3.sidebar.court_label'|trans }}</div>
                    <div class="bg-black/20 rounded-lg p-3 flex gap-2.5">
                        <svg class="size-5 text-blue-300 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5"/></svg>
                        <div class="text-sm">
                            <div class="font-medium">{{ 'wizard.step3.live.court.indeterminate'|trans }}</div>
                            <div class="text-xs text-white/60 mt-0.5">{{ 'wizard.step3.live.court.computed_at_step4'|trans }}</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="px-5 py-3 bg-black/20 text-[11px] text-white/60 flex items-start gap-2">
                <svg class="size-3.5 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span>{{ 'wizard.step3.sidebar.footer_note'|trans }}</span>
            </div>
        </div>
    </aside>
</div>
