{# Pas 3.3 — interactive debtor collection.
   Replaces the Pas 3.2 static CollectionType + non-JS "+ Adaugă debitor"
   button. LiveActions `addDebtor` / `removeDebtor(index)` mutate the bound
   Step2DebtorsData DTO and the bundle re-renders only the form chunk —
   partially-typed input is preserved across mutations.
   Mockup: docs/LexRecovery/mockups/v2/03-wizard/step2-debitor.html. #}
{% import 'case/_wizard_macros.html.twig' as f %}

<div{{ attributes.defaults({ 'class': 'space-y-5' }) }}>
    {{ form_start(form, { attr: {
        'id': 'step2-debtors-form',
        'action': path('case_wizard_debtor'),
        'method': 'POST',
        'class': 'space-y-5',
        'novalidate': 'novalidate',
    }}) }}
        {% set has_form_errors = form.vars.errors|length > 0 or form.debtors.vars.errors|length > 0 %}
        {% if has_form_errors %}
            <div role="alert" class="bg-red-50 dark:bg-red-950/30 border border-red-200 dark:border-red-900/60 rounded-lg p-4">
                <div class="flex items-start gap-3">
                    <svg class="size-5 text-red-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12c0 4.97-4.03 9-9 9s-9-4.03-9-9 4.03-9 9-9 9 4.03 9 9z"/></svg>
                    <div class="text-sm text-red-800 dark:text-red-200">
                        {{ form_errors(form) }}
                        {{ form_errors(form.debtors) }}
                    </div>
                </div>
            </div>
        {% endif %}

        {% set entry_count = form.debtors|length %}
        {% for entry in form.debtors %}
            {% set entry_index = loop.index0 %}
            {% set entry_dto = initialFormData.debtors[entry_index] ?? null %}
            {# Each debtor entry runs its OWN person-type-toggle controller —
               PF entries hide CUI/ONRC/administrator + the ANAF lookup wrapper,
               PJ entries hide CNP. Stimulus auto-initializes the controller on
               each new entry rendered by LiveCollectionTrait (add debitor). #}
            <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 space-y-6 shadow-soft"
                 data-controller="person-type-toggle">
                <header class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800">
                    <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">
                        {{ 'wizard.step2.entry_heading'|trans({ '%index%': loop.index }) }}
                    </h3>
                    <div class="flex items-center gap-2">
                        {% if entry_dto is not null and entry_dto.anafStatus is not null %}
                            <span class="inline-flex items-center gap-1 text-[11px] font-medium text-emerald-700 bg-emerald-50 dark:bg-emerald-950/40 dark:text-emerald-300 px-2 py-0.5 rounded-full"
                                  data-debtor-anaf-lookup-target="badge">
                                <svg class="size-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                <span>{{ ('enum.anaf_status.' ~ entry_dto.anafStatus.value)|trans }}</span>
                            </span>
                        {% endif %}
                        {% if entry_count > 1 %}
                            <button type="button"
                                    data-action="live#action"
                                    data-live-action-param="removeCollectionItem"
                                    data-live-name-param="step2_debtors[debtors]"
                                    data-live-index-param="{{ entry_index }}"
                                    title="{{ 'wizard.step2.button.remove_debtor'|trans }}"
                                    class="inline-flex items-center justify-center size-7 rounded-md text-slate-400 hover:text-red-600 hover:bg-red-50 dark:hover:bg-red-950/30 transition">
                                <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M1 7h22M9 7V4a1 1 0 011-1h4a1 1 0 011 1v3"/></svg>
                                <span class="sr-only">{{ 'wizard.step2.button.remove_debtor'|trans }}</span>
                            </button>
                        {% endif %}
                    </div>
                </header>

                {# personType radio cards — same CSS-only pattern as Step 1:
                   border + checkmark toggle via `peer-checked:*` / `has-[:checked]:*`.
                   Pre-3.4 relied on Live Component re-render on each radio
                   click (POST /_components/...); CSS-only drops the round-trip
                   while keeping the visual swap instant. #}
                {% set effective_person_type = entry.personType.vars.value ?: entry.personType.vars.choices|first.value %}
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">{{ 'wizard.step2.field.person_type'|trans }}</label>
                    <div class="grid grid-cols-2 gap-3 max-w-md">
                        {% for choice in entry.personType.vars.choices %}
                            <label class="relative flex items-center cursor-pointer rounded-lg border-2 p-3 transition
                                          border-slate-200 dark:border-slate-700 hover:border-slate-300 dark:hover:border-slate-600
                                          has-[:checked]:border-blue-500
                                          has-[:checked]:bg-gradient-to-br has-[:checked]:from-blue-50 has-[:checked]:to-blue-100/30
                                          dark:has-[:checked]:from-blue-950/30 dark:has-[:checked]:to-blue-950/10">
                                <input type="radio" name="{{ entry.personType.vars.full_name }}" value="{{ choice.value }}"
                                       {% if effective_person_type == choice.value %}checked{% endif %}
                                       class="peer sr-only"
                                       data-person-type-toggle-target="radio"
                                       data-action="change->person-type-toggle#update">
                                <span class="text-sm font-semibold text-slate-700 dark:text-slate-300
                                             peer-checked:font-bold peer-checked:text-blue-900 dark:peer-checked:text-blue-200">
                                    {{ choice.label|trans }}
                                </span>
                                <svg class="ml-auto size-5 text-blue-600 dark:text-blue-400 hidden peer-checked:block"
                                     fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                                </svg>
                            </label>
                        {% endfor %}
                    </div>
                    {{ f.field_errors(entry.personType) }}
                </div>
                {% set _ = form_widget(entry.personType) %}

                {# CUI input wired to debtor-anaf-lookup Stimulus controller.
                   The controller-root wraps the whole entry so it can find
                   the name/address/badge targets — but Stimulus only triggers
                   `blur->debtor-anaf-lookup#lookup` on the CUI input. #}
                {# URL generator validates against the route's `(RO)?\d{2,10}`
                   requirement, so `__CUI__` can't be passed directly. Build the
                   URL with a placeholder of 10 digits, then string-replace it
                   to the JS template token at render time. #}
                {% set anaf_lookup_url = path('api_anaf_lookup', { cui: '0000000001' })|replace({ '0000000001': '__CUI__' }) %}
                <div data-controller="debtor-anaf-lookup"
                     data-debtor-anaf-lookup-url-value="{{ anaf_lookup_url }}"
                     data-debtor-anaf-lookup-invalid-msg-value="{{ 'exception.anaf.cui_invalid'|trans }}"
                     data-debtor-anaf-lookup-unavailable-msg-value="{{ 'exception.anaf.unavailable'|trans }}"
                     class="space-y-6">
                    <div class="relative" data-person-type-toggle-target="pjOnly">
                        {{ f.field_label(entry.cui, 'wizard.step2.field.cui', false, true) }}
                        {{ form_widget(entry.cui, { attr: {
                            class: f.input_classes(entry.cui, 'font-mono')|trim,
                            placeholder: 'RO12345678',
                            'data-debtor-anaf-lookup-target': 'cui',
                            'data-action': 'blur->debtor-anaf-lookup#lookup',
                        }}) }}
                        <span data-debtor-anaf-lookup-target="spinner"
                              class="hidden absolute right-3 top-9 text-blue-600">
                            <svg class="size-4 animate-spin" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                        </span>
                        <p class="mt-1.5 text-[11px] text-slate-500">{{ 'wizard.step2.help.anaf_pas33'|trans }}</p>
                        {{ f.field_errors(entry.cui) }}
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="md:col-span-2">
                            {{ f.field_label(entry.name, 'wizard.step2.field.name', false, true) }}
                            {{ form_widget(entry.name, { attr: {
                                class: f.input_classes(entry.name)|trim,
                                'data-debtor-anaf-lookup-target': 'name',
                            }}) }}
                            {{ f.field_errors(entry.name) }}
                        </div>

                        <div data-person-type-toggle-target="pjOnly">
                            {{ f.field_label(entry.onrcNumber, 'wizard.step2.field.onrc_number', false, true) }}
                            {{ form_widget(entry.onrcNumber, { attr: { class: f.input_classes(entry.onrcNumber, 'font-mono')|trim, placeholder: 'J40/8765/2019' }}) }}
                            {{ f.field_errors(entry.onrcNumber) }}
                        </div>

                        <div data-person-type-toggle-target="pfOnly">
                            {{ f.field_label(entry.personalId, 'wizard.step2.field.personal_id', false, true) }}
                            {{ form_widget(entry.personalId, { attr: { class: f.input_classes(entry.personalId, 'font-mono')|trim }}) }}
                            {{ f.field_errors(entry.personalId) }}
                        </div>

                        <div class="md:col-span-2">
                            {{ f.field_label(entry.address, 'wizard.step2.field.address', false, true) }}
                            {{ form_widget(entry.address, { attr: {
                                class: f.input_classes(entry.address)|trim,
                                rows: 2,
                                'data-debtor-anaf-lookup-target': 'address',
                            }}) }}
                            {{ f.field_errors(entry.address) }}
                        </div>

                        {# County + locality drive competent-court resolution at step 4.
                           Auto-filled by the ANAF lookup; editable as manual fallback. #}
                        <div>
                            {{ f.field_label(entry.addressCounty, 'wizard.step2.field.address_county', true) }}
                            {{ form_widget(entry.addressCounty, { attr: {
                                class: f.input_classes(entry.addressCounty)|trim,
                                'data-debtor-anaf-lookup-target': 'addressCounty',
                            }}) }}
                            {{ f.field_errors(entry.addressCounty) }}
                        </div>

                        <div>
                            {{ f.field_label(entry.addressLocality, 'wizard.step2.field.address_locality', true) }}
                            {{ form_widget(entry.addressLocality, { attr: {
                                class: f.input_classes(entry.addressLocality)|trim,
                                'data-debtor-anaf-lookup-target': 'addressLocality',
                            }}) }}
                            {{ f.field_errors(entry.addressLocality) }}
                        </div>

                        <div class="md:col-span-2" data-person-type-toggle-target="pjOnly">
                            {{ f.field_label(entry.administrator, 'wizard.step2.field.administrator', true) }}
                            {{ form_widget(entry.administrator, { attr: { class: f.input_classes(entry.administrator)|trim }}) }}
                            {{ f.field_errors(entry.administrator) }}
                        </div>

                        <div>
                            {{ f.field_label(entry.email, 'wizard.step2.field.email', true) }}
                            {{ form_widget(entry.email, { attr: { class: f.input_classes(entry.email)|trim }}) }}
                            {{ f.field_errors(entry.email) }}
                        </div>

                        <div>
                            {{ f.field_label(entry.phone, 'wizard.step2.field.phone', true) }}
                            {{ form_widget(entry.phone, { attr: { class: f.input_classes(entry.phone)|trim }}) }}
                            {{ f.field_errors(entry.phone) }}
                        </div>

                        <div class="md:col-span-2">
                            {{ f.field_label(entry.iban, 'wizard.step2.field.iban', true) }}
                            {{ form_widget(entry.iban, { attr: { class: f.input_classes(entry.iban, 'font-mono')|trim, placeholder: 'RO49 RNCB 0082 0044 8001 0001' }}) }}
                            {{ f.field_errors(entry.iban) }}
                        </div>
                    </div>

                    {# ANAF metadata — populated by Stimulus on successful lookup.
                       Both are unmapped HiddenType fields on Step2DebtorEntryType;
                       SUBMIT listener bridges the raw string back to the typed
                       DTO properties (`?AnafStatus`, `?DateTimeImmutable`). #}
                    {{ form_widget(entry.anafStatus, { attr: { 'data-debtor-anaf-lookup-target': 'anafStatus' }}) }}
                    {{ form_widget(entry.anafCheckedAt, { attr: { 'data-debtor-anaf-lookup-target': 'anafCheckedAt' }}) }}
                </div>

                {# BPI verification panel — unchanged from Pas 3.2. #}
                <div class="bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-900/60 rounded-lg p-4 space-y-3">
                    <div class="flex items-start gap-2.5">
                        <svg class="size-5 text-amber-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12c0 4.97-4.03 9-9 9s-9-4.03-9-9 4.03-9 9-9 9 4.03 9 9z"/></svg>
                        <div class="text-sm">
                            <div class="font-semibold text-amber-900 dark:text-amber-200">{{ 'wizard.step2.bpi.title'|trans }}</div>
                            <p class="mt-0.5 text-xs text-amber-800 dark:text-amber-200/80">{{ 'wizard.step2.bpi.body'|trans|raw }}</p>
                        </div>
                    </div>

                    <label class="flex items-start gap-2 cursor-pointer">
                        {{ form_widget(entry.bpiVerifiedToday, { attr: {
                            'class': 'mt-0.5 rounded border-amber-400 text-amber-600 focus:ring-amber-500',
                        }}) }}
                        <span class="text-sm font-medium text-amber-900 dark:text-amber-200">{{ 'wizard.step2.field.bpi_verified_today'|trans }}</span>
                    </label>

                    <label class="flex items-start gap-2 cursor-pointer pt-2 border-t border-amber-200 dark:border-amber-900/40">
                        {{ form_widget(entry.inInsolvency, { attr: {
                            'class': 'mt-0.5 rounded border-red-400 text-red-600 focus:ring-red-500',
                        }}) }}
                        <span class="text-sm text-red-700 dark:text-red-300">{{ 'wizard.step2.field.in_insolvency'|trans }}</span>
                    </label>
                </div>

                {% if loop.last %}
                    {{ include('case/_save_to_library_cosmetic.html.twig', { label_key: 'wizard.step2.save_to_library' }) }}
                {% endif %}
            </div>
        {% endfor %}

        {# LiveAction add-debtor button — uses LiveCollectionTrait's
           `addCollectionItem` which appends to `step2_debtors[debtors]` in
           `formValues`. No full page reload, partial re-render only.
           Disabled when cap of 5 is reached so the UI mirrors a server-side
           cap check that we keep for safety in a future submit handler. #}
        <button type="button"
                data-action="live#action"
                data-live-action-param="addCollectionItem"
                data-live-name-param="step2_debtors[debtors]"
                {% if entry_count >= constant('App\\Twig\\Components\\Step2DebtorsLiveComponent::MAX_DEBTORS') %}disabled aria-disabled="true"{% endif %}
                class="w-full flex items-center justify-center gap-2 p-3 rounded-lg border-2 border-blue-500 bg-gradient-to-br from-blue-50 to-blue-100/50 dark:from-blue-950/40 dark:to-blue-950/20 text-sm font-bold text-blue-700 dark:text-blue-300 hover:from-blue-100 hover:to-blue-200/60 dark:hover:from-blue-950/60 dark:hover:to-blue-900/40 transition disabled:opacity-50 disabled:cursor-not-allowed">
            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
            <span>
                {% if entry_count >= constant('App\\Twig\\Components\\Step2DebtorsLiveComponent::MAX_DEBTORS') %}
                    {{ 'wizard.step2.button.max_reached'|trans }}
                {% else %}
                    {{ 'wizard.step2.button.add_debtor'|trans }}
                {% endif %}
            </span>
        </button>
    {{ form_end(form) }}
</div>
