{# @var status_label string|null   Display text. Required unless `status` is passed. #}
{# @var status_color string|null   One of: slate, gray, blue, sky, indigo, violet, purple, amber, orange, emerald, green, teal, red. Default slate. #}
{# @var status \App\Enum\CaseStatus|null  Optional: must expose `label()` (i18n key) and `color()` (palette token). For enums without color() (e.g. ExtractionStatus), pass status_label + status_color explicitly. #}
{# @var pulse bool|null             Show animated pulse on dot indicator (active/in-progress statuses). Default false. #}
{# @var show_dot bool|null          Show colored dot indicator before label. Default true. #}

{# Explicit props declaration — required by Symfony UX 2.x template-only components
   so non-scalar values (like CaseStatus enum) are forwarded as props instead of being
   stringified into HTML attributes. #}
{% props status = null, status_label = null, status_color = null, pulse = false, show_dot = true %}

{% if status is defined and status %}
    {# Restricted to enums exposing color() + label() — currently CaseStatus only.
       For ExtractionStatus or other enums without color(), pass status_label + status_color explicitly. #}
    {% set status_color = status.color() %}
    {% set status_label = (status.label())|trans %}
{% endif %}

{% set color = status_color|default('slate') %}
{% set dot = show_dot ?? true %}

{# Palette: maps token name → bg + text classes for badge + dot color. Order: bg light/dark, text light/dark, dot solid color. #}
{% set palette = {
    slate:   { badge: 'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300',     dot: 'bg-slate-400' },
    gray:    { badge: 'bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300',         dot: 'bg-gray-400' },
    blue:    { badge: 'bg-blue-100 text-blue-800 dark:bg-blue-950/40 dark:text-blue-300',      dot: 'bg-blue-500' },
    sky:     { badge: 'bg-sky-100 text-sky-800 dark:bg-sky-950/40 dark:text-sky-300',          dot: 'bg-sky-500' },
    indigo:  { badge: 'bg-indigo-100 text-indigo-800 dark:bg-indigo-950/40 dark:text-indigo-300', dot: 'bg-indigo-500' },
    violet:  { badge: 'bg-violet-100 text-violet-800 dark:bg-violet-950/40 dark:text-violet-300', dot: 'bg-violet-500' },
    purple:  { badge: 'bg-purple-100 text-purple-800 dark:bg-purple-950/40 dark:text-purple-300', dot: 'bg-purple-500' },
    amber:   { badge: 'bg-amber-100 text-amber-800 dark:bg-amber-950/40 dark:text-amber-300',  dot: 'bg-amber-500' },
    orange:  { badge: 'bg-orange-100 text-orange-800 dark:bg-orange-950/40 dark:text-orange-300', dot: 'bg-orange-500' },
    emerald: { badge: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-300', dot: 'bg-emerald-500' },
    green:   { badge: 'bg-green-100 text-green-800 dark:bg-green-950/40 dark:text-green-300',  dot: 'bg-green-500' },
    teal:    { badge: 'bg-teal-100 text-teal-800 dark:bg-teal-950/40 dark:text-teal-300',      dot: 'bg-teal-500' },
    red:     { badge: 'bg-red-100 text-red-800 dark:bg-red-950/40 dark:text-red-300',          dot: 'bg-red-500' },
} %}

{% set classes = palette[color] ?? palette.slate %}

<span {{ attributes.defaults({
    class: 'inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wide ' ~ classes.badge,
}) }}>
    {% if dot %}
        <span class="size-1.5 rounded-full {{ classes.dot }} {{ (pulse|default(false)) ? 'soft-pulse' : '' }}" aria-hidden="true"></span>
    {% endif %}
    {{ status_label }}
</span>
