{# @var icon string|null  Iconify name (e.g., "heroicons:document-magnifying-glass") #}
{# @var title string  Heading text #}
{# @var description string|null  Supporting paragraph #}
{# @var cta_label string|null  CTA button label #}
{# @var cta_url string|null  CTA button href #}
<div {{ attributes.defaults({
    class: 'flex flex-col items-center justify-center text-center py-16 px-6 rounded-xl border border-dashed border-gray-200 dark:border-gray-700 bg-white/50 dark:bg-gray-900/30',
}) }}>
    {% if icon ?? null %}
        <div class="mb-4 text-gray-400 dark:text-gray-500">
            <twig:ux:icon name="{{ icon }}" class="w-12 h-12" />
        </div>
    {% endif %}
    <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100">{{ title }}</h2>
    {% if description ?? null %}
        <p class="mt-2 max-w-md text-sm text-gray-600 dark:text-gray-400">{{ description }}</p>
    {% endif %}
    {% if (cta_label ?? null) and (cta_url ?? null) %}
        <a href="{{ cta_url }}" class="mt-6 inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-white hover:bg-primary-light transition-colors">
            {{ cta_label }}
        </a>
    {% endif %}
</div>
