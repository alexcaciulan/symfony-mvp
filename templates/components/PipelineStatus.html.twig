{# @var status \App\Enum\CaseStatus  Current case status. Derives stage position. #}
{# Renders 5-stage linear pipeline: Amiabil → Somație → Cerere depusă → Decizie (ordonanță/respinsă) → Executare/Final. #}
{# Visual: filled circles for completed/current stages, outlined for pending. #}

{% set stages = [
    { key: 'amicable', label: 'pipeline.stage.amicable', icon_path: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' },
    { key: 'notice',   label: 'pipeline.stage.notice',   icon_path: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
    { key: 'filed',    label: 'pipeline.stage.filed',    icon_path: 'M5 13l4 4L19 7' },
    { key: 'decision', label: 'pipeline.stage.decision', icon_path: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z' },
    { key: 'final',    label: 'pipeline.stage.final',    icon_path: 'M5 8l4-4m0 0l4 4m-4-4v12m13-4l-4 4m0 0l-4-4m4 4V8' },
] %}

{# Map CaseStatus → stage index (0-based). #}
{% set stage_index = {
    'AMIABIL': 0,
    'SOMATIE_TRIMISA': 1,
    'CERERE_GENERATA': 2,
    'CERERE_DEPUSA': 2,
    'DOSAR_INREGISTRAT': 2,
    'TERMEN_FIXAT': 2,
    'ORDONANTA_EMISA': 3,
    'IN_ANULARE': 3,
    'RESPINSA': 3,
    'DEFINITIVA': 4,
    'EXECUTARE': 4,
    'INCHIS_SUCCES': 4,
    'INCHIS_FARA_RECUPERARE': 4,
} %}
{% set current = stage_index[status.value] ?? 0 %}
{# Terminal failure: rejected => mark stage 3 as red instead of green completion. #}
{% set is_rejected = status.value == 'RESPINSA' %}

<ol {{ attributes.defaults({
    class: 'flex items-center gap-2 w-full',
}) }} aria-label="{{ 'pipeline.aria_label'|trans }}">
    {% for stage in stages %}
        {% set idx = loop.index0 %}
        {% set is_completed = idx < current %}
        {% set is_current = idx == current %}
        {% set is_failed = is_current and is_rejected %}

        <li class="flex-1 flex items-center gap-2 min-w-0">
            <div class="flex items-center justify-center size-7 rounded-full shrink-0
                {% if is_failed %}bg-red-500 text-white
                {% elseif is_completed %}bg-emerald-500 text-white
                {% elseif is_current %}bg-lex-navy text-white ring-4 ring-lex-navy/20
                {% else %}bg-white dark:bg-slate-800 text-slate-400 border-2 border-slate-200 dark:border-slate-700
                {% endif %}">
                {% if is_completed and not is_failed %}
                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                {% else %}
                    <span class="text-xs font-bold">{{ idx + 1 }}</span>
                {% endif %}
            </div>
            <div class="min-w-0 hidden md:block">
                <div class="text-[10px] font-bold uppercase tracking-wide text-slate-400">{{ ('pipeline.step_label'|trans({'%num%': idx + 1})) }}</div>
                <div class="text-xs font-semibold truncate {{ is_current ? 'text-lex-navy dark:text-blue-400' : 'text-slate-700 dark:text-slate-300' }}">{{ stage.label|trans }}</div>
            </div>
            {% if not loop.last %}
                <div class="flex-1 h-0.5 {{ is_completed ? 'bg-emerald-300 dark:bg-emerald-700' : 'bg-slate-200 dark:bg-slate-800' }} mx-1 min-w-[12px]" aria-hidden="true"></div>
            {% endif %}
        </li>
    {% endfor %}
</ol>
