{% extends 'base.html.twig' %}

{% block title %}{{ 'login.title'|trans }}{% endblock %}

{% block body_class %}auth-bg{% endblock %}

{% block layout %}
    {# Floating dark-mode toggle (split layout has no topbar). #}
    <div class="absolute top-4 right-4 z-10">
        <button type="button"
                data-controller="dark-mode-toggle"
                data-action="click->dark-mode-toggle#toggle"
                aria-label="{{ 'layout.topbar.toggle_dark'|trans }}"
                class="p-2 rounded-lg bg-white/80 dark:bg-slate-800/80 backdrop-blur hover:bg-white dark:hover:bg-slate-800 shadow-sm text-slate-600 dark:text-slate-300">
            <svg class="size-5 hidden dark:inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
            <svg class="size-5 inline dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
        </button>
    </div>

    {# Split 2-col auth layout: branding gradient (lg+) + form (centered). #}
    <main class="min-h-screen grid lg:grid-cols-2">

        {{ include('_auth_branding.html.twig') }}

        <div class="flex flex-col items-center justify-center px-6 py-12 lg:py-0">

            {# Mobile brand header — visible only when branding side is hidden. #}
            <div class="lg:hidden flex flex-col items-center gap-2 mb-8 text-center">
                <div class="inline-flex items-center justify-center size-12 rounded-xl bg-gradient-to-br from-lex-navy to-lex-navy-dark text-white shadow-lg">
                    <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16l-3-3m3 3l3-3"/></svg>
                </div>
                <h1 class="text-2xl font-bold tracking-tight">{{ 'layout.brand'|trans }}</h1>
                <p class="text-sm text-slate-500 dark:text-slate-400">{{ 'auth.branding.tagline_short'|trans }}</p>
            </div>

            <div class="w-full max-w-md">

                {% if app.user %}
                    <div class="mb-4 px-4 py-3 rounded-lg bg-blue-50 text-blue-800 border border-blue-200 dark:bg-blue-950/40 dark:text-blue-200 dark:border-blue-900 text-sm">
                        {{ 'login.logged_in_as'|trans }} <strong>{{ app.user.userIdentifier }}</strong>.
                        <form method="post" action="{{ path('app_logout') }}" class="inline">
                            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('logout') }}">
                            <button type="submit" class="font-semibold underline bg-transparent border-0 p-0 cursor-pointer text-inherit">{{ 'login.logout'|trans }}</button>
                        </form>
                    </div>
                {% endif %}

                <div class="mb-6">
                    <h2 class="text-2xl font-bold tracking-tight">{{ 'login.heading'|trans }}</h2>
                    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{{ 'login.subheading'|trans }}</p>
                </div>

                {{ include('_auth_flashes.html.twig') }}

                {% if error %}
                    <div class="px-4 py-3 mb-4 rounded-lg bg-red-50 text-red-800 border border-red-200 dark:bg-red-950/40 dark:text-red-200 dark:border-red-900 text-sm" role="alert">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                <form method="post" class="space-y-4" data-turbo="false">
                    <div>
                        <label for="username" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">{{ 'login.label_email'|trans }}</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400" aria-hidden="true">
                                <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                            </span>
                            <input type="email" value="{{ last_username }}" name="_username" id="username"
                                   class="w-full pl-9 pr-3 py-2.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                   autocomplete="email" required autofocus>
                        </div>
                    </div>

                    <div>
                        <div class="flex items-center justify-between mb-1.5">
                            <label for="password" class="block text-sm font-medium text-slate-700 dark:text-slate-300">{{ 'login.label_password'|trans }}</label>
                            <a href="{{ path('app_forgot_password') }}" class="text-xs font-medium text-blue-600 dark:text-blue-400 hover:underline">{{ 'login.forgot_password'|trans }}</a>
                        </div>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400" aria-hidden="true">
                                <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                            </span>
                            <input type="password" name="_password" id="password"
                                   class="w-full pl-9 pr-3 py-2.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                   autocomplete="current-password" required>
                        </div>
                    </div>

                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                    <button type="submit" class="w-full mt-2 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-gradient-to-br from-lex-navy to-lex-navy-dark text-white font-semibold hover:from-lex-navy-dark hover:to-slate-900 transition shadow-sm">
                        {{ 'login.submit'|trans }}
                        <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                    </button>
                </form>

                <div class="my-6 flex items-center gap-3">
                    <div class="flex-1 h-px bg-slate-200 dark:bg-slate-800"></div>
                    <span class="text-xs text-slate-400">{{ 'auth.or'|trans }}</span>
                    <div class="flex-1 h-px bg-slate-200 dark:bg-slate-800"></div>
                </div>

                <p class="text-center text-sm text-slate-600 dark:text-slate-400">
                    {{ 'login.no_account'|trans }}
                    <a href="{{ path('app_register') }}" class="font-semibold text-blue-600 dark:text-blue-400 hover:underline no-underline">{{ 'login.register_link'|trans }} →</a>
                </p>
            </div>

            <div class="mt-12 lg:mt-8 flex items-center gap-4 text-xs text-slate-400">
                <a href="#" class="hover:text-slate-600 dark:hover:text-slate-300 no-underline">{{ 'layout.footer.terms'|trans }}</a>
                <a href="#" class="hover:text-slate-600 dark:hover:text-slate-300 no-underline">GDPR</a>
            </div>
        </div>
    </main>
{% endblock %}
