{# Transparent overlay pages: only the continuous annex number, bottom right, on a white
   patch so it stays legible over a scan. Laid over the annex pages by qpdf. #}
<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <style>
        @page { margin: 0; }
        body { margin: 0; padding: 0; font-family: 'DejaVu Sans', sans-serif; }
        .page { position: relative; width: 100%; height: 100%; page-break-after: always; }
        .page:last-child { page-break-after: auto; }
        .number { position: absolute; right: 8mm; bottom: 6mm; background: #ffffff; border: 0.5pt solid #6b7280; padding: 1pt 5pt; font-size: 9pt; color: #111827; }
    </style>
</head>
<body>
{% for number in numbers %}
    <div class="page"><div class="number">{{ number }}</div></div>
{% endfor %}
</body>
</html>
