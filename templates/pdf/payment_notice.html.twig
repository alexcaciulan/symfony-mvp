{# Text agreed with the consulting lawyer, one variant per accessory type. Keep
   the wording verbatim; CPC art. 1.015: the 15-day term is statutory. #}
{% set creditor = case.creditor %}
{% set debtor = recipientDebtor %}
{% set noticeDate = refDate|default(today) %}
{% set noticeDateText = noticeDate|date('d.m.Y') %}
{% set label = accessoryLabel ? accessoryLabel.phrase()|trans : null %}
{# Sets the contract and document phrases the sections quote. The contract is
   named only when the claim rests on one identified contract. #}
{% set contractDescriptor = null %}
{% if namedContract %}
    {% if namedContract.number and namedContract.date %}
        {% set contractDescriptor = 'pdf.summons.contract.number_and_date'|trans({'%number%': namedContract.number, '%date%': namedContract.date|date('d.m.Y')}) %}
    {% elseif namedContract.number %}
        {% set contractDescriptor = 'pdf.summons.contract.number_only'|trans({'%number%': namedContract.number}) %}
    {% else %}
        {% set contractDescriptor = 'pdf.summons.contract.date_only'|trans({'%date%': namedContract.date|date('d.m.Y')}) %}
    {% endif %}
{% endif %}
{% if contractDescriptor %}
    {% set documentsGenitive = 'pdf.summons.documents.genitive_with_contract'|trans({'%contract%': contractDescriptor}) %}
    {% set documentsAccusative = 'pdf.summons.documents.accusative_with_contract'|trans({'%contract%': contractDescriptor}) %}
    {% set contractDocument = 'pdf.summons.contract.named'|trans({'%contract%': contractDescriptor}) %}
{% else %}
    {% set documentsGenitive = 'pdf.summons.documents.genitive'|trans %}
    {% set documentsAccusative = 'pdf.summons.documents.accusative'|trans %}
    {% set contractDocument = 'pdf.summons.contract.unnamed'|trans %}
{% endif %}
<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <title>{{ 'pdf.summons.title'|trans }}</title>
    <style>
        @page { margin: 2cm 2.2cm; }
        body { font-family: 'DejaVu Sans', sans-serif; font-size: 10.5pt; color: #111827; line-height: 1.5; }
        p { margin: 5pt 0; text-align: justify; }
        h1 { font-size: 14pt; text-align: center; margin: 14pt 0 10pt 0; letter-spacing: 1pt; }
        h2 { font-size: 10.5pt; margin: 14pt 0 6pt 0; }
        .party { margin: 0 0 10pt 0; }
        .party .ptitle { font-weight: bold; }
        .party .pname { font-weight: bold; }
        .subject { margin: 10pt 0; }
        .subject strong { display: block; }
        ul.composition { margin: 4pt 0 4pt 18pt; padding: 0; }
        ul.composition li { margin: 2pt 0; }
        blockquote { margin: 6pt 18pt; font-style: italic; text-align: justify; }
        table.grid { width: 100%; border-collapse: collapse; margin: 8pt 0; }
        table.grid th, table.grid td { border: 1px solid #9ca3af; padding: 4pt 5pt; font-size: 8.5pt; vertical-align: top; }
        table.grid th { background: #f3f4f6; text-align: center; font-weight: bold; }
        table.grid td.num { text-align: right; white-space: nowrap; }
        table.grid td.center { text-align: center; }
        .fx { font-size: 7.5pt; color: #4b5563; }
        .total { font-weight: bold; margin: 6pt 0; }
        .note { font-size: 8.5pt; color: #4b5563; }
        .somam { text-align: center; font-weight: bold; letter-spacing: 1pt; margin: 12pt 0 8pt 0; }
        .closing { margin-top: 22pt; page-break-inside: avoid; }
    </style>
</head>
<body>

{% include 'pdf/summons/_parties.html.twig' %}
{% include 'pdf/summons/_intro.html.twig' %}

<h1>{{ 'pdf.summons.heading'|trans }}</h1>

<p>{{ 'pdf.summons.summary_intro'|trans({'%debtor%': debtor ? debtor.name : '', '%total%': grandTotal|number_format(2, ',', '.')}) }}</p>
{% include 'pdf/summons/_composition.html.twig' with {terminator: '.'} %}
<p>{% if isContractual %}{{ 'pdf.summons.continues_contractual'|trans({'%label%': label}) }}{% else %}{{ 'pdf.summons.continues_legal'|trans }}{% endif %}</p>

{% include 'pdf/summons/_section_principal.html.twig' %}

{% if isContractual %}
    {% include 'pdf/summons/_section_contractual.html.twig' %}
{% else %}
    {% include 'pdf/summons/_section_legal_interest.html.twig' %}
{% endif %}

{% include 'pdf/summons/_section_imputation.html.twig' %}
{% include 'pdf/summons/_closing.html.twig' %}

</body>
</html>
