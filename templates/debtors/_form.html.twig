{# Shared debtor form body. Expects `form` and `submit_label`. #}
{% import 'case/_wizard_macros.html.twig' as f %}
{% set input_class = 'w-full px-3 py-2 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-lex-navy/40 focus:border-lex-navy transition' %}
{% set label_class = 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1' %}

{# Plain submission: a Turbo render of the 422 page is turned into a full
   reload (the tracked importmap scripts carry a per-response CSP nonce), which
   would drop the validation errors. #}
{{ form_start(form, {'attr': {'novalidate': 'novalidate', 'data-turbo': 'false'}}) }}
    {% if form.vars.errors|length > 0 %}
        <div role="alert" class="mb-4 rounded-lg border border-red-200 dark:border-red-900/60 bg-red-50 dark:bg-red-950/30 p-4 text-sm text-red-800 dark:text-red-200">{{ form_errors(form) }}</div>
    {% endif %}
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="sm:col-span-2">
            {{ form_label(form.name, null, {'label_attr': {'class': label_class}}) }}
            {{ form_widget(form.name, {'attr': {'class': input_class}}) }}
            {{ f.field_errors(form.name) }}
        </div>

        <div>
            {{ form_label(form.cui, null, {'label_attr': {'class': label_class}}) }}
            {{ form_widget(form.cui, {'attr': {'class': input_class ~ ' font-mono'}}) }}
            {{ f.field_errors(form.cui) }}
        </div>

        <div>
            {{ form_label(form.onrcNumber, null, {'label_attr': {'class': label_class}}) }}
            {{ form_widget(form.onrcNumber, {'attr': {'class': input_class, 'placeholder': 'J40/1234/2018'}}) }}
            {{ f.field_errors(form.onrcNumber) }}
        </div>

        <div class="sm:col-span-2">
            {{ form_label(form.administrator, null, {'label_attr': {'class': label_class}}) }}
            {{ form_widget(form.administrator, {'attr': {'class': input_class}}) }}
            {{ f.field_errors(form.administrator) }}
        </div>

        <div class="sm:col-span-2">
            {{ form_label(form.address, null, {'label_attr': {'class': label_class}}) }}
            {{ form_widget(form.address, {'attr': {'class': input_class, 'rows': 2}}) }}
            {{ f.field_errors(form.address) }}
        </div>

        <div>
            {{ form_label(form.addressCounty, null, {'label_attr': {'class': label_class}}) }}
            {{ form_widget(form.addressCounty, {'attr': {'class': input_class}}) }}
            {{ f.field_errors(form.addressCounty) }}
        </div>

        <div>
            {{ form_label(form.addressLocality, null, {'label_attr': {'class': label_class}}) }}
            {{ form_widget(form.addressLocality, {'attr': {'class': input_class}}) }}
            <p class="mt-1 text-[11px] text-slate-500">{{ 'library.debtors.form.court_hint'|trans }}</p>
            {{ f.field_errors(form.addressLocality) }}
        </div>

        <div class="sm:col-span-2">
            {{ form_label(form.iban, null, {'label_attr': {'class': label_class}}) }}
            {{ form_widget(form.iban, {'attr': {'class': input_class ~ ' font-mono'}}) }}
            {{ f.field_errors(form.iban) }}
        </div>

        <div>
            {{ form_label(form.email, null, {'label_attr': {'class': label_class}}) }}
            {{ form_widget(form.email, {'attr': {'class': input_class}}) }}
            {{ f.field_errors(form.email) }}
        </div>

        <div>
            {{ form_label(form.phone, null, {'label_attr': {'class': label_class}}) }}
            {{ form_widget(form.phone, {'attr': {'class': input_class}}) }}
            {{ f.field_errors(form.phone) }}
        </div>
    </div>

    <div class="mt-6 flex items-center justify-end gap-3">
        <a href="{{ path('app_debtors') }}" class="py-2 px-4 rounded-lg text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition no-underline">{{ 'library.debtors.form.cancel'|trans }}</a>
        <button type="submit" class="py-2 px-4 rounded-lg bg-lex-navy hover:bg-lex-navy-dark text-white text-sm font-semibold transition">{{ submit_label|trans }}</button>
    </div>
{{ form_end(form) }}
