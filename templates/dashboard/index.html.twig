{% extends 'base.html.twig' %}

{% block title %}{{ 'dashboard.cases.title'|trans }} - {{ parent() }}{% endblock %}

{% block breadcrumb %}
    <li class="font-medium text-slate-700 dark:text-slate-300">{{ 'dashboard.cases.heading'|trans }}</li>
{% endblock %}

{% block body %}
<div class="space-y-6">

    {# Page header #}
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-3">
        <div>
            <h1 class="text-2xl md:text-3xl font-bold tracking-tight">{{ 'dashboard.cases.heading'|trans }}</h1>
            {% set greeting_name = app.user.fullName ?: app.user.email %}
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{{ 'dashboard.cases.greeting_subtitle'|trans({'%name%': greeting_name}) }}</p>
        </div>
    </div>

    {% if not has_cases %}

        <twig:HeroEmptyState
            title="{{ 'dashboard.cases.empty_heading'|trans }}"
            description="{{ 'dashboard.cases.empty_subtitle'|trans }}"
            cta_label="{{ 'dashboard.cases.create_first'|trans }}"
            cta_path="{{ path('case_wizard_start') }}"
            icon_color="blue"
        />

        <div class="mt-12 max-w-5xl mx-auto">
            <h2 class="text-center text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-8">{{ 'dashboard.cases.how_it_works'|trans }}</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                {% for step in ['extract', 'op_request', 'enforcement'] %}
                    {% set palettes = {
                        extract:     { num_color: 'from-amber-400 to-amber-600', num_shadow: 'shadow-amber-500/30', icon_color: 'text-amber-500', icon_path: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
                        op_request:  { num_color: 'from-blue-400 to-blue-600', num_shadow: 'shadow-blue-500/30', icon_color: 'text-blue-500', icon_path: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10' },
                        enforcement: { num_color: 'from-green-400 to-green-600', num_shadow: 'shadow-green-500/30', icon_color: 'text-green-500', icon_path: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z' },
                    } %}
                    {% set p = palettes[step] %}
                    <div class="relative bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 hover:shadow-card transition">
                        <div class="absolute -top-3 left-6 inline-flex items-center justify-center size-7 rounded-lg bg-gradient-to-br {{ p.num_color }} text-white text-xs font-bold shadow-md {{ p.num_shadow }}">{{ loop.index }}</div>
                        <div class="{{ p.icon_color }} mb-3 mt-2">
                            <svg class="size-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="{{ p.icon_path }}"/></svg>
                        </div>
                        <h3 class="text-base font-semibold">{{ ('dashboard.cases.how.' ~ step ~ '.title')|trans }}</h3>
                        <p class="mt-1.5 text-xs text-slate-600 dark:text-slate-400 leading-relaxed">{{ ('dashboard.cases.how.' ~ step ~ '.description')|trans }}</p>
                    </div>
                {% endfor %}
            </div>
        </div>

    {% else %}

        {# KPI cards #}
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <twig:KpiCard
                label="{{ 'dashboard.cases.kpi.active'|trans }}"
                value="{{ kpis.active_count }}"
                hint="{{ 'dashboard.cases.kpi.active_hint'|trans }}"
            />
            <twig:KpiCard
                label="{{ 'dashboard.cases.kpi.deadlines'|trans }}"
                value="{{ kpis.deadlines_7d }}"
                hint="{{ 'dashboard.cases.kpi.deadlines_hint'|trans }}"
                emphasize="{{ kpis.deadlines_7d > 0 }}"
            />
            <twig:KpiCard
                label="{{ 'dashboard.cases.kpi.overdue'|trans }}"
                value="{{ kpis.overdue }}"
                hint="{{ 'dashboard.cases.kpi.overdue_hint'|trans }}"
                accent="red"
                emphasize="{{ kpis.overdue > 0 }}"
            />
            <twig:KpiCard
                label="{{ 'dashboard.cases.kpi.amount_active'|trans }}"
                value="{{ kpis.amount_active|number_format(0, '.', '.') }}"
                unit="RON"
                hint="{{ 'dashboard.cases.kpi.amount_active_hint'|trans }}"
            />
        </div>

        {# Two-column: deadlines + (future portal feed). #}
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

            <twig:DeadlineList
                items="{{ upcoming_deadlines }}"
                title="{{ 'dashboard.cases.deadlines_title'|trans }}"
                subtitle="{{ 'dashboard.cases.deadlines_count'|trans({'%count%': kpis.deadlines_7d}) }}"
            />

            {# Placeholder card — live portal feed wired at the UI phase. Keeps layout balanced. #}
            <section class="bg-white dark:bg-slate-900 rounded-2xl shadow-soft border border-slate-200 dark:border-slate-800 overflow-hidden">
                <div class="px-5 py-4 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
                    <div class="flex items-center gap-2.5">
                        <span class="inline-flex items-center justify-center size-7 rounded-lg bg-gradient-to-br from-purple-50 to-purple-100 dark:from-purple-950/50 dark:to-purple-900/30 text-purple-600 dark:text-purple-400" aria-hidden="true">
                            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5"/></svg>
                        </span>
                        <h2 class="text-sm font-semibold">{{ 'dashboard.cases.portal_feed_title'|trans }}</h2>
                    </div>
                    <span class="text-xs text-slate-400">{{ 'dashboard.cases.coming_soon'|trans }}</span>
                </div>
                <div class="px-5 py-12 text-center text-sm text-slate-500 dark:text-slate-400">
                    {{ 'dashboard.cases.portal_feed_empty'|trans }}
                </div>
            </section>

        </div>

        {# Recent cases preview (top 5). Full filterable list is a separate page. #}
        <section class="bg-white dark:bg-slate-900 rounded-2xl shadow-soft border border-slate-200 dark:border-slate-800 overflow-hidden">
            <div class="px-5 py-4 border-b border-slate-100 dark:border-slate-800 flex flex-col md:flex-row md:items-center md:justify-between gap-3">
                <h2 class="text-sm font-semibold">{{ 'dashboard.recent.heading'|trans }}</h2>
                <a href="{{ path('app_cases') }}"
                   class="inline-flex items-center gap-1 text-sm font-medium text-blue-600 dark:text-blue-400 hover:underline no-underline">
                    {{ 'dashboard.recent.view_all'|trans }}
                    <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                </a>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="bg-slate-50 dark:bg-slate-950/50 text-[10px] uppercase tracking-wide text-slate-500 dark:text-slate-400">
                        <tr>
                            <th class="px-5 py-3 text-left font-semibold">{{ 'dashboard.cases.col_id'|trans }}</th>
                            <th class="px-5 py-3 text-left font-semibold">{{ 'dashboard.cases.col_court'|trans }}</th>
                            <th class="px-5 py-3 text-right font-semibold">{{ 'dashboard.cases.col_amount'|trans }}</th>
                            <th class="px-5 py-3 text-left font-semibold">{{ 'dashboard.cases.col_status'|trans }}</th>
                            <th class="px-5 py-3 text-left font-semibold">{{ 'dashboard.cases.col_date'|trans }}</th>
                            <th class="px-5 py-3 text-right font-semibold">{{ 'dashboard.cases.col_actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                        {% for case in recent_cases %}
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/30 transition">
                                <td class="px-5 py-3">
                                    <a href="{{ path('case_overview', {id: case.id}) }}" class="font-mono font-medium hover:underline no-underline">#{{ case.id }}</a>
                                </td>
                                <td class="px-5 py-3 text-slate-700 dark:text-slate-300">{{ case.court ? case.court.name : '—' }}</td>
                                <td class="px-5 py-3 text-right font-medium tnum">{{ case.amount ? (case.amount|number_format(2, ',', '.') ~ ' RON') : '—' }}</td>
                                <td class="px-5 py-3">
                                    <twig:StatusBadge status="{{ case.status }}" />
                                </td>
                                <td class="px-5 py-3 text-xs text-slate-500 dark:text-slate-400">{{ case.createdAt|date('d.m.Y') }}</td>
                                <td class="px-5 py-3 text-right">
                                    <a href="{{ path('case_overview', {id: case.id}) }}" class="text-sm font-medium text-blue-600 dark:text-blue-400 hover:underline no-underline">{{ 'dashboard.cases.view'|trans }}</a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>

    {% endif %}

</div>
{% endblock %}
