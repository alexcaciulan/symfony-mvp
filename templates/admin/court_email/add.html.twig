{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Adaugă o adresă de e-mail{% endblock %}

{% block main %}
<div style="max-width: 640px;">
    <div style="margin-bottom: 20px;">
        <a href="{{ back_url }}" style="color: #2563eb; text-decoration: none; font-size: 14px;">Înapoi la instanță</a>
    </div>

    <p style="font-size: 14px; color: #374151; margin: 0 0 20px 0;">{{ court.name }}</p>
    <p style="font-size: 13px; color: #6b7280; margin: 0 0 20px 0;">Adresa se adaugă după verificarea pe o sursă oficială a instanței (pagina instanței, portal.just.ro) și intră direct confirmată, deci se folosește la depunere pentru toate dosarele acestei instanțe. Adresele nominale nu se acceptă.</p>

    <div style="background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 24px;">
        <form method="post" action="{{ path('admin_court_email_add', {courtId: court.id}) }}" data-testid="admin-court-email-add-form">
            <input type="hidden" name="_token" value="{{ csrf_token('court_email_add_' ~ court.id) }}">
            <label for="email" style="display: block; font-size: 14px; font-weight: 500; margin-bottom: 6px;">E-mail</label>
            <input type="email" name="email" id="email" required maxlength="254" autocomplete="off" style="width: 100%; padding: 8px 12px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 14px; margin-bottom: 12px;">
            <label for="purpose" style="display: block; font-size: 14px; font-weight: 500; margin-bottom: 6px;">Scop</label>
            <select name="purpose" id="purpose" required style="width: 100%; padding: 8px 12px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 14px; margin-bottom: 20px;">
                {% for label, purpose in purposes %}
                    <option value="{{ purpose.value }}">{{ label }}</option>
                {% endfor %}
            </select>
            <label for="source_url" style="display: block; font-size: 14px; font-weight: 500; margin-bottom: 6px;">Link-ul paginii unde a fost verificată adresa (opțional)</label>
            <input type="url" name="source_url" id="source_url" maxlength="500" placeholder="https://" autocomplete="off" style="width: 100%; padding: 8px 12px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 14px; margin-bottom: 20px;">
            <label style="display: flex; gap: 8px; align-items: flex-start; font-size: 14px; margin-bottom: 20px;">
                <input type="checkbox" name="statement_confirmed" value="1" required style="margin-top: 3px;">
                <span>{{ statement }}</span>
            </label>
            <div style="display: flex; gap: 10px;">
                <button type="submit" style="padding: 8px 20px; background: #2563eb; color: #fff; border: none; border-radius: 6px; font-size: 14px; font-weight: 500; cursor: pointer;">Adaugă și confirmă</button>
                <a href="{{ back_url }}" style="padding: 8px 20px; background: #f3f4f6; color: #374151; border: 1px solid #d1d5db; border-radius: 6px; font-size: 14px; font-weight: 500; text-decoration: none;">Anulează</a>
            </div>
        </form>
    </div>
</div>
{% endblock %}
