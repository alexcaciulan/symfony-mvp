{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Deblocare transmitere · #{{ submission.id }}{% endblock %}

{# Metadata only: statuses, codes and attempts. No subject, body, statements or .eml
   copies. The effect of each action is written before its button, and each button
   is named after what it does (FilingSubmissionService::closeByAdmin and
   UncertainPartResolver::adminOverride). #}
{% block main %}
{% set btn = 'padding: 6px 14px; border: none; border-radius: 6px; color: #fff; cursor: pointer;' %}
{% set effect = 'margin: 4px 0 8px 0; font-size: 13px; color: #374151;' %}
<div style="max-width: 760px;">
    <div style="margin-bottom: 20px;">
        <a href="{{ back_url }}" style="color: #2563eb; text-decoration: none; font-size: 14px;">Înapoi la transmitere</a>
    </div>

    <p style="font-size: 13px; color: #6b7280; margin: 0 0 20px 0;">Acțiunile de aici doar deblochează dosarul. Deblocarea nu declară primirea și nu schimbă data depunerii. Motivul este obligatoriu și se păstrează în jurnalul de audit.</p>

    <div style="background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 20px; margin-bottom: 20px; font-size: 14px;">
        <p style="margin: 0 0 8px 0;">Dosar #{{ submission.legalCase.id }} ({{ submission.legalCase.status.label|trans }}) · transmitere: <strong data-testid="admin-submission-status">{{ submission.deliveryStatus.label|trans }}</strong>{% if submission.reviewReason %} · motiv: {{ submission.reviewReason|trans }}{% endif %}</p>
        <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
            <tr style="text-align: left; color: #6b7280;"><th style="padding: 4px;">E-mail</th><th style="padding: 4px;">Stare</th><th style="padding: 4px;">Încercări</th><th style="padding: 4px;">Ultimul cod SMTP</th></tr>
            {% for part in submission.parts %}
                <tr>
                    <td style="padding: 4px;">{{ part.sequence }} din {{ part.total }}</td>
                    <td style="padding: 4px;">{{ part.status.label|trans }}</td>
                    <td style="padding: 4px;">
                        {% for attempt in part.attempts %}
                            #{{ attempt.attemptNo }} {{ attempt.source.label|trans }}, {{ attempt.outcome ? attempt.outcome.label|trans : '…' }} {{ attempt.startedAt|date('d.m.Y H:i', 'Europe/Bucharest') }}{% if not loop.last %}<br>{% endif %}
                        {% endfor %}
                    </td>
                    <td style="padding: 4px;">{{ part.lastSmtpCode ?? '-' }} {{ part.lastEnhancedStatus }}</td>
                </tr>
                {% if part.status.value == 'UNCERTAIN' %}
                    <tr><td colspan="4" style="padding: 8px 4px;">
                        <form method="post" action="{{ path('admin_filing_submission_part_override', {id: submission.id, sequence: part.sequence}) }}" data-testid="admin-override-form-{{ part.sequence }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('filing_override_' ~ submission.id ~ '_' ~ part.sequence) }}">
                            {% if part.sequence == 1 %}
                                <p style="{{ effect }}" data-testid="admin-override-effect-failed">Marchează ca netrimis: e-mailul cu cererea devine „eroare internă”, transmiterea se încheie fără confirmarea serverului, iar anexele în așteptare se anulează. Dosarul rămâne la „Cerere generată”; avocatul poate trimite din nou pachetul semnat sau depune cererea pe altă cale. Acceptarea cererii nu se poate marca de aici: o declară doar avocatul.</p>
                            {% else %}
                                <p style="{{ effect }}" data-testid="admin-override-effect-failed">Marchează ca netrimis: e-mailul {{ part.sequence }} devine „eroare internă”; cererea rămâne trimisă, iar avocatul poate trimite din nou anexele rămase sau închide transmiterea fără ele.</p>
                                <p style="{{ effect }}" data-testid="admin-override-effect-accepted">Marchează ca trimis: e-mailul {{ part.sequence }} se consideră acceptat de server, cu ora ultimei încercări; transmiterea continuă cu e-mailurile rămase sau se încheie.</p>
                            {% endif %}
                            <input type="text" name="reason" required minlength="10" maxlength="500" placeholder="Motiv (obligatoriu)" style="width: 100%; box-sizing: border-box; padding: 6px; border: 1px solid #d1d5db; border-radius: 6px; margin-bottom: 8px;">
                            <button type="submit" name="outcome" value="failed" style="{{ btn }} background: #2563eb;">Marchează ca netrimis</button>
                            {% if part.sequence > 1 %}
                                <button type="submit" name="outcome" value="accepted" style="{{ btn }} background: #047857; margin-left: 6px;">Marchează ca trimis</button>
                            {% endif %}
                        </form>
                    </td></tr>
                {% endif %}
            {% endfor %}
        </table>
    </div>

    {% if close_path %}
        <div style="background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 20px; font-size: 14px;">
            {% if close_path == 'late_review' %}
                <p style="{{ effect }}" data-testid="admin-close-effect">Încheie verificarea raportului de nelivrare: transmiterea revine la starea de dinaintea raportului și dosarul este deblocat. Dosarul, data depunerii declarată și numărul de la instanță rămân neschimbate; e-mailurile rămase nu se mai trimit.</p>
                {% set close_label = 'Încheie verificarea' %}
            {% elseif close_path == 'cancel' %}
                <p style="{{ effect }}" data-testid="admin-close-effect">Anulează transmiterea: niciun e-mail nu a fost acceptat de server, iar e-mailurile în așteptare se anulează. Dosarul rămâne la „Cerere generată”; avocatul poate trimite din nou sau depune cererea pe altă cale.</p>
                {% set close_label = 'Anulează transmiterea' %}
            {% else %}
                <p style="{{ effect }}" data-testid="admin-close-effect">Închide transmiterea fără e-mailurile rămase: cererea a fost acceptată de server; e-mailurile neplecate nu se mai trimit, iar anexele rămase se depun pe altă cale. Starea dosarului nu se schimbă.</p>
                {% set close_label = 'Închide fără e-mailurile rămase' %}
            {% endif %}
            <p style="margin: 0 0 8px 0; font-size: 13px; color: #6b7280;">Deblocarea nu declară primirea și nu schimbă data depunerii.</p>
            <form method="post" action="{{ path('admin_filing_submission_close', {id: submission.id}) }}" data-testid="admin-close-form">
                <input type="hidden" name="_token" value="{{ csrf_token('filing_admin_close_' ~ submission.id) }}">
                <input type="text" name="reason" required minlength="10" maxlength="500" placeholder="Motiv (obligatoriu)" style="width: 70%; padding: 6px; border: 1px solid #d1d5db; border-radius: 6px;">
                <button type="submit" style="{{ btn }} background: #b91c1c;" data-testid="admin-close-submit">{{ close_label }}</button>
            </form>
        </div>
    {% endif %}
</div>
{% endblock %}
