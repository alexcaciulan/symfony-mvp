{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Dashboard{% endblock %}

{% block main %}
    {# ── Utilizatori ── #}
    <h3 style="font-size: 16px; font-weight: 600; color: #374151; margin: 0 0 12px 0;">Utilizatori</h3>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 30px;">
        <div style="background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 20px; text-align: center;">
            <div style="font-size: 32px; font-weight: 700; color: #1e40af;">{{ totalUsers }}</div>
            <div style="font-size: 13px; color: #6b7280; margin-top: 4px;">Total</div>
        </div>
        <div style="background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 20px; text-align: center;">
            <div style="font-size: 32px; font-weight: 700; color: #059669;">{{ verifiedUsers }}</div>
            <div style="font-size: 13px; color: #6b7280; margin-top: 4px;">Verificați</div>
        </div>
        <div style="background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 20px; text-align: center;">
            <div style="font-size: 32px; font-weight: 700; color: #d97706;">{{ unverifiedUsers }}</div>
            <div style="font-size: 13px; color: #6b7280; margin-top: 4px;">Neverificați</div>
        </div>
        <div style="background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 20px; text-align: center;">
            <div style="font-size: 32px; font-weight: 700; color: #7c3aed;">{{ adminUsers }}</div>
            <div style="font-size: 13px; color: #6b7280; margin-top: 4px;">Administratori</div>
        </div>
    </div>

    {# ── Dosare ── #}
    <h3 style="font-size: 16px; font-weight: 600; color: #374151; margin: 0 0 12px 0;">Dosare</h3>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 30px;">
        <div style="background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 20px; text-align: center;">
            <div style="font-size: 32px; font-weight: 700; color: #1e40af;">{{ totalCases }}</div>
            <div style="font-size: 13px; color: #6b7280; margin-top: 4px;">Total dosare</div>
        </div>
        <div style="background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 20px; text-align: center;">
            <div style="font-size: 32px; font-weight: 700; color: #0891b2;">{{ activeCases }}</div>
            <div style="font-size: 13px; color: #6b7280; margin-top: 4px;">Active</div>
        </div>
        <div style="background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 20px; text-align: center;">
            <div style="font-size: 32px; font-weight: 700; color: #059669;">{{ rulingsIssuedThisMonth }}</div>
            <div style="font-size: 13px; color: #6b7280; margin-top: 4px;">Ordonanțe emise luna curentă</div>
        </div>
    </div>

    {# Court addresses: none of these numbers says a court accepts filings by email. #}
    <h3 style="font-size: 16px; font-weight: 600; color: #374151; margin: 0 0 12px 0;">Instanțe</h3>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 30px;">
        <div style="background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 20px; text-align: center;" data-testid="dashboard-courts-without-address">
            <div style="font-size: 32px; font-weight: 700; color: #d97706;">{{ courtsWithoutValidatedAddress }}</div>
            <div style="font-size: 13px; color: #6b7280; margin-top: 4px;">Instanțe fără adresă validată</div>
        </div>
        <a href="{{ proposedCourtAddressesUrl }}" style="display: block; text-decoration: none; background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 20px; text-align: center;" data-testid="dashboard-proposed-addresses">
            <div style="font-size: 32px; font-weight: 700; color: #1e40af;">{{ proposedCourtAddresses }}</div>
            <div style="font-size: 13px; color: #6b7280; margin-top: 4px;">Adrese de verificat</div>
        </a>
        <a href="{{ lawyerSuggestionsUrl }}" style="display: block; text-decoration: none; background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 20px; text-align: center;" data-testid="dashboard-lawyer-suggestions">
            <div style="font-size: 32px; font-weight: 700; color: #1e40af;">{{ lawyerSuggestions }}</div>
            <div style="font-size: 13px; color: #6b7280; margin-top: 4px;">Adrese sugerate de avocați</div>
        </a>
        <a href="{{ openCourtEmailReportsUrl }}" style="display: block; text-decoration: none; background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 20px; text-align: center;" data-testid="dashboard-open-address-reports">
            <div style="font-size: 32px; font-weight: 700; color: #dc2626;">{{ openCourtEmailReports }}</div>
            <div style="font-size: 13px; color: #6b7280; margin-top: 4px;">Rapoarte de verificat</div>
        </a>
        <div style="background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 20px; text-align: center;" data-testid="dashboard-expired-validations">
            <div style="font-size: 32px; font-weight: 700; color: #dc2626;">{{ expiredCourtAddressValidations }}</div>
            <div style="font-size: 13px; color: #6b7280; margin-top: 4px;">Validări expirate</div>
        </div>
    </div>

    {# ── Monetizare ── #}
    <h3 style="font-size: 16px; font-weight: 600; color: #374151; margin: 0 0 12px 0;">Monetizare</h3>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 30px;">
        <div style="background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 20px; text-align: center;">
            <div style="font-size: 32px; font-weight: 700; color: #d97706;">{{ pendingInvoices }}</div>
            <div style="font-size: 13px; color: #6b7280; margin-top: 4px;">Facturi în așteptare</div>
        </div>
    </div>
{% endblock %}
