{% extends 'base.html.twig' %}

{% block title %}{{ 'library.creditors.title'|trans }} - {{ parent() }}{% endblock %}

{% block breadcrumb %}
    <li class="font-medium text-slate-700 dark:text-slate-300">{{ 'library.creditors.heading'|trans }}</li>
{% endblock %}

{% block body %}
<div class="space-y-6">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-3">
        <div>
            <h1 class="text-2xl md:text-3xl font-bold tracking-tight">{{ 'library.creditors.heading'|trans }}</h1>
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{{ 'library.creditors.subtitle'|trans }}</p>
        </div>
        <a href="{{ path('app_creditors_new') }}" class="inline-flex items-center gap-1.5 py-1.5 px-3 rounded-lg bg-lex-navy hover:bg-lex-navy-dark text-white text-sm font-semibold transition no-underline self-start">
            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
            {{ 'library.creditors.new_button'|trans }}
        </a>
    </div>

    <twig:DataTable key="creditors" />
</div>
{% endblock %}
