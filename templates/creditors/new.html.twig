{% extends 'base.html.twig' %}

{% block title %}{{ 'library.creditors.new.title'|trans }} - {{ parent() }}{% endblock %}

{% block breadcrumb %}
    <li><a href="{{ path('app_creditors') }}" class="text-slate-500 hover:text-slate-700 dark:hover:text-slate-300 no-underline">{{ 'library.creditors.heading'|trans }}</a></li>
    <li class="text-slate-400" aria-hidden="true">/</li>
    <li class="font-medium text-slate-700 dark:text-slate-300">{{ 'library.creditors.new.heading'|trans }}</li>
{% endblock %}

{% block body %}
<div class="max-w-3xl mx-auto space-y-6">
    <div>
        <h1 class="text-2xl md:text-3xl font-bold tracking-tight">{{ 'library.creditors.new.heading'|trans }}</h1>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{{ 'library.creditors.new.subtitle'|trans }}</p>
    </div>

    <div class="bg-white dark:bg-slate-900 rounded-xl shadow-card border border-slate-200 dark:border-slate-800 p-6 sm:p-8">
        {{ include('creditors/_form.html.twig', {submit_label: 'library.creditors.form.create_submit'}) }}
    </div>
</div>
{% endblock %}
