{% extends 'base.html.twig' %}

{% block title %}{{ 'library.creditors.edit.title'|trans }} - {{ parent() }}{% endblock %}

{% block breadcrumb %}
    <li><a href="{{ path('app_creditors') }}" class="text-slate-500 hover:text-slate-700 dark:hover:text-slate-300 no-underline">{{ 'library.creditors.heading'|trans }}</a></li>
    <li class="text-slate-400" aria-hidden="true">/</li>
    <li class="font-medium text-slate-700 dark:text-slate-300">{{ creditor.name }}</li>
{% endblock %}

{% block body %}
<div class="max-w-3xl mx-auto space-y-6">
    <div>
        <h1 class="text-2xl md:text-3xl font-bold tracking-tight">{{ 'library.creditors.edit.heading'|trans }}</h1>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{{ 'library.creditors.edit.subtitle'|trans }}</p>
    </div>

    {# The creditor is shared by the cases below: an edit reaches their future
       regenerations, not the documents already generated. #}
    {% if cases|length > 0 %}
        <div class="rounded-lg border border-amber-200 dark:border-amber-900/60 bg-amber-50 dark:bg-amber-950/30 p-4 text-sm text-amber-900 dark:text-amber-200" data-testid="creditor-shared-warning">
            {{ 'library.creditors.edit.shared_warning'|trans({'%count%': cases|length}) }}
        </div>
    {% endif %}

    <div class="bg-white dark:bg-slate-900 rounded-xl shadow-card border border-slate-200 dark:border-slate-800 p-6 sm:p-8">
        {{ include('creditors/_form.html.twig', {submit_label: 'library.creditors.form.update_submit'}) }}
    </div>
</div>
{% endblock %}
