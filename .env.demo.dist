# Config for the isolated demo stack (scripts/demo.sh + scripts/expose-demo.sh).
# Copy to .env.demo (gitignored) and fill in the public hostnames.

# Public base URL of the demo, without trailing slash. Used for APP_BASE_URL,
# DEFAULT_URI, the Mercure public URL and the Mercure CORS origin.
DEMO_PUBLIC_URL=https://demo.example.ro

# Named tunnel only: hostname routed to the demo Mailpit UI. Leave empty to keep
# Mailpit local-only (http://localhost:8035).
DEMO_MAIL_HOST=mail.demo.example.ro

# Quick tunnel only: also expose Mailpit over its own public URL, so the tester
# can open the verification and password-reset emails.
DEMO_EXPOSE_MAIL=true

# Basic auth for the Mailpit UI ("user:password"). Mailpit shows every message
# the app sends, so set this whenever Mailpit is reachable publicly.
DEMO_MAIL_AUTH=avocat:schimba-ma

# Named Cloudflare tunnel (cloudflared tunnel create <name>).
DEMO_TUNNEL_NAME=lexdemo

# Host ports for the demo stack. Must not collide with the dev stack
# (8080 / 8025 / 3307 / 3000).
DEMO_APP_PORT=8090
DEMO_MAIL_PORT=8035
DEMO_DB_PORT=3317

DEMO_APP_ENV=dev

# Extraction. ANTHROPIC_API_KEY is inherited from the main checkout's .env.local
# (scripts/demo.sh feeds that file to compose), so it does not belong here.
# Skipping the two lower cascade tiers leaves AI Vision as the only strategy;
# without it a PDF with a text layer stops at pdf_parser and never reaches AI.
EXTRACTION_SKIP_STRATEGIES=pdf_parser,ocr_text
