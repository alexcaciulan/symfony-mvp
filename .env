# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
# DEV-ONLY throwaway. Prod MUST override APP_SECRET via Coolify env / secrets vault
# (real env wins over .env); the previously committed value is compromised, do not reuse.
APP_SECRET=97841a510c863d43060e45dd0dac8bddbf6f8d00563fd3fbe6bb77f49f581118
# Proxy chain trusted for X-Forwarded-* (dev default: loopback + private docker net).
# In prod pin the exact Traefik/Coolify ingress CIDR; avoid ranges overlapping untrusted hops.
TRUSTED_PROXIES=127.0.0.1,::1,private_ranges
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost:8080
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# For Docker (default):
DATABASE_URL="mysql://app:app_password@database:3306/symfony_mvp?serverVersion=8.0&charset=utf8mb4"
#
# For local development (non-Docker), override in .env.local with:
# DATABASE_URL="mysql://root:@127.0.0.1:3306/symfony_mvp?serverVersion=8.0.36&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# For Docker: use mailpit service. Tests override with null://null (see .env.test).
MAILER_DSN=smtp://mailer:1025
MAILER_FROM=noreply@recuperare-creante.ro
###< symfony/mailer ###

# Absolute base URL for clickable links in notification emails (headless cron/worker).
APP_BASE_URL=http://localhost:8080

###> symfony/mercure-bundle ###
# See https://symfony.com/doc/current/mercure.html#configuration
# Internal URL — PHP container publishes here.
MERCURE_URL=http://mercure/.well-known/mercure
# Public URL — browser connects via host port mapping (compose.override.yaml maps 3000:80).
MERCURE_PUBLIC_URL=http://localhost:3000/.well-known/mercure
# JWT secret (>= 32 chars). MUST be regenerated for staging/prod.
MERCURE_JWT_SECRET="!ChangeThisInProd!aMinimum32CharsSecret!"
###< symfony/mercure-bundle ###

###> app/ocr ###
# Tesseract language codes (ISO 639-3, 3-letter — `ron` for Romanian, NOT `ro`/`rum`/`rom`).
# Used by App\Service\Ocr\TesseractOcrService for the `-l` parameter.
OCR_LANGUAGES=ron+eng
###< app/ocr ###

###> app/llm ###
# Anthropic Claude API credentials. Empty in dev — strategies fall back to Stub
# when the key is missing (Pas 2.5.7+). Set in production / staging via Coolify.
ANTHROPIC_API_KEY=
# Default model for text-only extraction (Pas 2.5.7 OcrTextExtractionStrategy).
# AiVision (Pas 2.5.8) may opt for opus-4-7 per call when needed.
ANTHROPIC_MODEL=claude-sonnet-4-6
# Confidence threshold below which the orchestrator (DataExtractionService) keeps
# trying the next strategy in the cascade. Match the constant default in
# DataExtractionService::DEFAULT_CONFIDENCE_THRESHOLD; this env var lets ops
# tune the cutoff without redeploying code.
EXTRACTION_CONFIDENCE_THRESHOLD=0.6
# Dev-only knob — leave empty in production. Set to a strategy key
# (`pdf_parser` | `ocr_text` | `ai_vision` | `stub`) in .env.local to force
# the cascade to use ONLY that tier. Useful for testing a specific strategy
# in isolation without contriving a document that bypasses higher priorities.
EXTRACTION_FORCE_STRATEGY=
# Dev-only knob — leave empty in production. Comma-separated list of strategy
# keys to mute (e.g. `ocr_text` to skip OCR+AI text and benchmark
# PdfParser→AiVision; or `ocr_text,ai_vision` to exercise only the local
# tiers). Skip wins over force — listed strategies never run.
EXTRACTION_SKIP_STRATEGIES=
###< app/llm ###

###> app/einvoicing ###
# Active e-invoicing provider: stub | oblio | smartbill. Default fallback used
# when the admin-editable AppSetting (einvoice_provider) is unset. Keep `stub`
# in dev (zero network, never touches ANAF); set a real provider in prod.
EINVOICE_PROVIDER=stub
# Oblio credentials (Setari > Date Cont). Leave empty in dev. CIF = your SRL's.
OBLIO_EMAIL=
OBLIO_SECRET=
OBLIO_CIF=
# Whether to push issued invoices to e-Factura/SPV (provider module must be active).
OBLIO_EFACTURA=true
# SmartBill credentials (email + API token). Leave empty in dev.
SMARTBILL_EMAIL=
SMARTBILL_TOKEN=
SMARTBILL_CIF=
SMARTBILL_EFACTURA=true
###< app/einvoicing ###

###> app/payments ###
# Active payment gateway: stub | netopia. Keep `stub` in dev (no real money,
# manual "mark as paid" checkout). Set `netopia` once a merchant POS is active.
PAYMENT_GATEWAY=stub
# Netopia (formerly mobilPay) API v2 credentials. Leave empty in dev; fill in
# .env.local from the Netopia dashboard once the merchant account is activated.
# POS signature format: XXXX-XXXX-XXXX-XXXX-XXXX.
NETOPIA_POS_SIGNATURE=
NETOPIA_API_KEY=
# Optional override for the IPN JWT public key. Leave EMPTY: NetopiaApiClient
# ships Netopia's fixed platform key (same for Sandbox and Live) as the default.
# Only set this if Netopia rotates the key.
NETOPIA_PUBLIC_KEY=
# false = sandbox (secure.sandbox.netopia-payments.com), true = live.
NETOPIA_IS_LIVE=false
# Absolute URLs Netopia calls/redirects back to. NOTIFY = server-to-server IPN
# (the source of truth), RETURN = browser landing after the hosted page.
NETOPIA_NOTIFY_URL=http://localhost:8080/webhook/netopia
NETOPIA_RETURN_URL=http://localhost:8080/subscription/return
###< app/payments ###
