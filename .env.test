# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
OCR_LANGUAGES=ron+eng
ANTHROPIC_API_KEY=__MOCK_DO_NOT_USE__
ANTHROPIC_MODEL=claude-opus-4-8
EXTRACTION_REVIEW_THRESHOLD=0.6
# The test database is isolated via `dbname_suffix: _test` in the when@test
# section of config/packages/doctrine.yaml (dev `symfony_mvp` becomes
# `symfony_mvp_test`), so no DATABASE_URL override is needed here.
#
# Collect emails without hitting SMTP; MailerAssertionsTrait still records them.
# NOTE: the Docker container injects a real MAILER_DSN (smtp://mailer:1025) that
# would otherwise win over this line, so tests/bootstrap.php clears it before
# booting the dotenv so this value takes effect.
MAILER_DSN=null://null
APP_BASE_URL=http://localhost
# Court filings never leave the test process: the transport is a null one, wrapped
# by a recorder in config/services_test.yaml. tests/bootstrap.php clears the
# container's real value first, as for MAILER_DSN.
COURT_FILING_MAILER_DSN=null://null
COURT_FILING_RECIPIENT_OVERRIDE=instanta-simulata@example.test
COURT_FILING_LIVE=0
# The decided retry schedule, pinned so the strategy test reads it.
COURT_FILING_RETRY_DELAY_MS=300000
COURT_FILING_RETRY_MAX_DELAY_MS=7200000
COURT_FILING_REDELIVER_TIMEOUT=600
COURT_FILING_SENDING_STALE_SECONDS=180
